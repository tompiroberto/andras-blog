---
/**
 * Gallery: every photo (src/lib/photos.ts), newest first. A click opens a large view with the
 * description, place and date; arrows / swipe-free buttons step through the photos.
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import { getPhotos } from '../../lib/photos';
import { HTML_LANG, langStaticPaths, localePath, t, type Lang } from '../../i18n';

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const fmt = new Intl.DateTimeFormat(HTML_LANG[lang], { year: 'numeric', month: 'long', day: 'numeric' });
const photos = await Promise.all(
  (await getPhotos()).map(async (p) => ({
    ...p,
    large: (await getImage({ src: p.image, width: Math.min(1800, p.image.width) })).src,
    when: p.date ? fmt.format(p.date) : '',
    thumb: (await getImage({ src: p.image, width: 96, height: 96, fit: 'cover' })).src,
  })),
);
const pinned = photos.map((p, i) => ({ p, i })).filter(({ p }) => p.lat !== undefined && p.lng !== undefined);
---

<BaseLayout lang={lang} title={t(lang, 'gallery.title')} description={t(lang, 'gallery.lead')}>
  <section class="section gallery" data-dev-add="photo">
    <div class="container">
      <p class="gallery__back">
        <a href={localePath(lang)}><Icon name="arrow-left" size={18} />{t(lang, 'posts.back')}</a>
      </p>
      <SectionHeading icon="camera" as="h1">{t(lang, 'gallery.title')}</SectionHeading>
      <p class="gallery__lead">{t(lang, 'gallery.lead')}</p>

      {photos.length === 0 && <p class="gallery__empty">{t(lang, 'gallery.empty')}</p>}

      {
        pinned.length > 0 && (
          <div class="gmap" data-gmap>
            <div class="gmap__stage" data-gmap-stage>
              <img class="gmap__land" src="/world-land.svg" alt="" draggable="false" />
              {pinned.map(({ p, i }) => (
                <button
                  type="button"
                  class="gmap__pin"
                  style={`left:${((p.lng! + 180) / 360) * 100}%;top:${((90 - p.lat!) / 180) * 100}%`}
                  data-pin={i}
                  aria-label={p.place ? `${p.caption} – ${p.place}` : p.caption}
                >
                  <img src={p.thumb} alt="" loading="lazy" />
                  <span class="gmap__tip">{p.caption}{p.place && <small>{p.place}</small>}</span>
                </button>
              ))}
            </div>
            <div class="gmap__zoom">
              <button type="button" data-gmap-zoom="1" aria-label="+">+</button>
              <button type="button" data-gmap-zoom="-1" aria-label="−">−</button>
            </div>
            <p class="gmap__hint">{t(lang, 'gallery.mapHint')}</p>
          </div>
        )
      }

      <ul class="gallery__grid">
        {
          photos.map((p, i) => (
            <li class="gallery__item">
              <button type="button" class="gallery__open" data-index={i} data-large={p.large} data-caption={p.caption} data-place={p.place ?? ''} data-when={p.when} data-post={p.post ? localePath(lang, `posts/${p.post}`) : ''}>
                <Image src={p.image} alt={p.caption} widths={[360, 720]} sizes="(max-width: 600px) 100vw, 360px" loading={i < 6 ? 'eager' : 'lazy'} />
              </button>
              <p class="gallery__caption">{p.caption}</p>
              {(p.place || p.when) && (
                <p class="gallery__meta">
                  {p.place && (
                    <span>
                      <Icon name="map-pin" size={14} />
                      {p.place}
                    </span>
                  )}
                  {p.when && <span>{p.when}</span>}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label={t(lang, 'gallery.title')}>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" data-lb-img />
      <figcaption class="lightbox__text">
        <strong data-lb-caption></strong>
        <span class="lightbox__meta" data-lb-meta></span>
        <a class="lightbox__post" hidden data-lb-post>{t(lang, 'gallery.toPost')}</a>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__close" aria-label={t(lang, 'facts.close')} data-lb-close><Icon name="x" size={22} /></button>
    <button type="button" class="lightbox__btn lightbox__prev" aria-label={t(lang, 'gallery.prev')} data-lb-step="-1"><Icon name="chevron-left" size={26} /></button>
    <button type="button" class="lightbox__btn lightbox__next" aria-label={t(lang, 'gallery.next')} data-lb-step="1"><Icon name="chevron-right" size={26} /></button>
  </dialog>
</BaseLayout>

<style>
  .gallery__back a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
  .gallery__lead {
    max-width: 640px;
    margin: 0 0 28px;
    font-size: var(--fs-body);
  }
  .gallery__empty {
    font-weight: 700;
  }
  .gmap {
    position: relative;
    margin: 0 0 32px;
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--violet-tint);
    box-shadow: var(--shadow-yellow);
    touch-action: none;
  }
  .gmap__stage {
    position: relative;
    aspect-ratio: 2 / 1;
    transform-origin: 0 0;
    cursor: grab;
  }
  .gmap__stage.is-dragging {
    cursor: grabbing;
  }
  .gmap__land {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }
  .gmap__pin {
    position: absolute;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 2px solid var(--ink);
    border-radius: 50% 50% 50% 0;
    background: var(--yellow);
    transform: translate(-50%, -100%) rotate(-45deg) scale(calc(1 / var(--gz, 1)));
    transform-origin: 50% 100%;
    box-shadow: 2px 2px 0 var(--ink);
    cursor: pointer;
    overflow: visible;
  }
  .gmap__pin img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    transform: rotate(45deg);
    pointer-events: none;
  }
  .gmap__tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    display: none;
    width: max-content;
    max-width: 220px;
    padding: 6px 10px;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    transform: translateX(-50%) rotate(45deg);
    transform-origin: 0 100%;
    pointer-events: none;
  }
  .gmap__tip small {
    display: block;
    font-weight: 400;
    color: var(--muted);
  }
  .gmap__pin:hover,
  .gmap__pin:focus-visible {
    z-index: 2;
    background: var(--violet);
  }
  .gmap__pin:hover .gmap__tip,
  .gmap__pin:focus-visible .gmap__tip {
    display: block;
  }
  .gmap__zoom {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    gap: 6px;
  }
  .gmap__zoom button {
    width: 38px;
    height: 38px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    font-size: 22px;
    font-weight: 800;
    line-height: 1;
  }
  .gmap__hint {
    position: absolute;
    left: 12px;
    bottom: 8px;
    margin: 0;
    font-size: var(--fs-tiny);
    color: var(--muted);
    pointer-events: none;
  }
  .gallery__grid {
    columns: 3 300px;
    column-gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery__item {
    break-inside: avoid;
    margin: 0 0 18px;
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-yellow);
  }
  .gallery__item:nth-child(even) {
    box-shadow: var(--shadow-violet);
  }
  .gallery__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }
  .gallery__open :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--t-med) var(--ease);
  }
  .gallery__open:hover :global(img),
  .gallery__open:focus-visible :global(img) {
    transform: scale(1.04);
  }
  .gallery__caption {
    margin: 0;
    padding: 12px 14px 0;
    font-weight: 700;
  }
  .gallery__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 4px 0 0;
    padding: 0 14px;
    font-size: var(--fs-tiny);
    color: var(--muted);
  }
  .gallery__meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .gallery__item > :last-child {
    padding-bottom: 12px;
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 10, 20, 0.94);
    color: #fff;
    zoom: var(--inv-zoom, 1);
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: 100%;
    margin: 0;
    padding: 56px 64px 24px;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: calc(100vh - 170px);
    object-fit: contain;
    border-radius: 8px;
  }
  .lightbox__text {
    display: grid;
    gap: 4px;
    max-width: 720px;
    text-align: center;
  }
  .lightbox__text strong {
    font-size: 18px;
  }
  .lightbox__meta {
    font-size: 14px;
    opacity: 0.8;
  }
  .lightbox__post {
    justify-self: center;
    color: #ffd84d;
    font-weight: 700;
  }
  .lightbox__post[hidden] {
    display: none;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .lightbox__btn:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .lightbox__close {
    top: 14px;
    right: 14px;
  }
  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__prev {
    left: 10px;
  }
  .lightbox__next {
    right: 10px;
  }
  @media (max-width: 600px) {
    .lightbox__figure {
      padding: 64px 12px 80px;
    }
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 16px;
      transform: none;
    }
  }
</style>

<script>
  // ---- gallery map: zoom (+/−, wheel) and drag; a pin opens its photo ----
  const gmap = document.querySelector<HTMLElement>('[data-gmap]');
  if (gmap) {
    const stage = gmap.querySelector<HTMLElement>('[data-gmap-stage]')!;
    let z = 1;
    let x = 0;
    let y = 0;
    const clamp = () => {
      const w = gmap.clientWidth;
      const h = stage.offsetHeight;
      x = Math.min(0, Math.max(w - w * z, x));
      y = Math.min(0, Math.max(h - h * z, y));
    };
    const apply = () => {
      clamp();
      stage.style.transform = `translate(${x}px, ${y}px) scale(${z})`;
      stage.style.setProperty('--gz', String(z));
    };
    const zoomAt = (factor: number, cx: number, cy: number) => {
      const nz = Math.min(12, Math.max(1, z * factor));
      x = cx - ((cx - x) * nz) / z;
      y = cy - ((cy - y) * nz) / z;
      z = nz;
      apply();
    };
    gmap.querySelectorAll<HTMLButtonElement>('[data-gmap-zoom]').forEach((b) =>
      b.addEventListener('click', () => zoomAt(Number(b.dataset.gmapZoom) > 0 ? 1.6 : 1 / 1.6, gmap.clientWidth / 2, stage.offsetHeight / 2)),
    );
    gmap.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const r = gmap.getBoundingClientRect();
        zoomAt(e.deltaY < 0 ? 1.25 : 0.8, e.clientX - r.left, e.clientY - r.top);
      },
      { passive: false },
    );
    let drag: { px: number; py: number; x: number; y: number; moved: boolean } | null = null;
    stage.addEventListener('pointerdown', (e) => {
      drag = { px: e.clientX, py: e.clientY, x, y, moved: false };
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.px;
      const dy = e.clientY - drag.py;
      if (Math.abs(dx) + Math.abs(dy) > 4) {
        drag.moved = true;
        stage.classList.add('is-dragging');
      }
      x = drag.x + dx;
      y = drag.y + dy;
      apply();
    });
    window.addEventListener('pointerup', () => {
      setTimeout(() => (drag = null));
      stage.classList.remove('is-dragging');
    });
    // start zoomed to where the photos are (all in Europe → Europe fills the map)
    const fit = () => {
      const pts = Array.from(gmap.querySelectorAll<HTMLElement>('[data-pin]')).map((p) => [parseFloat(p.style.left) / 100, parseFloat(p.style.top) / 100]);
      const xs = pts.map((p) => p[0]);
      const ys = pts.map((p) => p[1]);
      const span = Math.max(Math.max(...xs) - Math.min(...xs), (Math.max(...ys) - Math.min(...ys)) / 2, 0.02);
      z = Math.min(6, Math.max(1, 0.6 / span));
      const w = gmap.clientWidth;
      const h = stage.offsetHeight;
      x = w / 2 - ((Math.max(...xs) + Math.min(...xs)) / 2) * w * z;
      y = h / 2 - ((Math.max(...ys) + Math.min(...ys)) / 2) * h * z;
      apply();
    };
    fit();
    gmap.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach((pin) =>
      pin.addEventListener('click', () => {
        if (drag?.moved) return;
        document.querySelectorAll<HTMLButtonElement>('.gallery__open')[Number(pin.dataset.pin)]?.click();
      }),
    );
  }

  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery__open'));
  if (box && items.length) {
    const img = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = box.querySelector<HTMLElement>('[data-lb-caption]')!;
    const meta = box.querySelector<HTMLElement>('[data-lb-meta]')!;
    const postLink = box.querySelector<HTMLAnchorElement>('[data-lb-post]')!;
    let at = 0;

    const show = (i: number) => {
      at = (i + items.length) % items.length;
      const d = items[at].dataset;
      img.src = d.large!;
      img.alt = d.caption!;
      caption.textContent = d.caption!;
      meta.textContent = [d.place, d.when].filter(Boolean).join(' · ');
      postLink.hidden = !d.post;
      if (d.post) postLink.href = d.post;
      if (!box.open) box.showModal();
    };

    items.forEach((b, i) => b.addEventListener('click', () => show(i)));
    box.querySelectorAll<HTMLButtonElement>('[data-lb-step]').forEach((b) => b.addEventListener('click', () => show(at + Number(b.dataset.lbStep))));
    box.querySelector('[data-lb-close]')!.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => {
      if (e.target === box || e.target === box.querySelector('.lightbox__figure')) box.close();
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(at - 1);
      if (e.key === 'ArrowRight') show(at + 1);
    });
  }
</script>
