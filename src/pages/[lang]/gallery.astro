---
/**
 * Gallery: every photo (src/lib/photos.ts), newest first. A click opens a large view with the
 * description, place and date; arrows / swipe-free buttons step through the photos.
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import { getPhotos } from '../../lib/photos';
import gallery from '../../data/gallery.json';

/** the main site: a copy on another host shows the photos uploaded there too (/gallery.json) */
const MAIN_SITE = import.meta.env.PUBLIC_MAIN_SITE || 'https://lambent-platypus-c39161.netlify.app';
import { HTML_LANG, langStaticPaths, localePath, t, type Lang } from '../../i18n';

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const fmt = new Intl.DateTimeFormat(HTML_LANG[lang], { year: 'numeric', month: 'long', day: 'numeric' });
const photos = await Promise.all(
  (await getPhotos(lang)).map(async (p) => ({
    ...p,
    large: p.image ? (await getImage({ src: p.image, width: Math.min(1800, p.image.width) })).src : p.src,
    when: p.date ? fmt.format(p.date) : '',
    thumb: p.image ? (await getImage({ src: p.image, width: 96, height: 96, fit: 'cover' })).src : p.video ? '' : p.src,
  })),
);
const pinned = photos.map((p, i) => ({ p, i })).filter(({ p }) => p.lat !== undefined && p.lng !== undefined);
---

<BaseLayout lang={lang} title={t(lang, 'gallery.title')} description={t(lang, 'gallery.lead')}>
  <section class="section gallery" data-dev-add="photo">
    <div class="container">
      <p class="gallery__back">
        <a href={localePath(lang)}><Icon name="arrow-left" size={18} />{t(lang, 'posts.back')}</a>
      </p>
      <SectionHeading icon="camera" as="h1">{t(lang, 'gallery.title')}</SectionHeading>
      <p class="gallery__lead">{t(lang, 'gallery.lead')}</p>

      {photos.length === 0 && <p class="gallery__empty" data-gallery-empty>{t(lang, 'gallery.empty')}</p>}

      {
        pinned.length > 0 && (
          <div class="gmap" data-gmap>
            <div class="gmap__stage" data-gmap-stage>
              <img class="gmap__land" src="/world-land.svg" alt="" draggable="false" />
              {pinned.map(({ p, i }) => (
                <button
                  type="button"
                  class="gmap__pin"
                  style={`left:${((p.lng! + 180) / 360) * 100}%;top:${((90 - p.lat!) / 180) * 100}%`}
                  data-pin={i}
                  aria-label={p.place ? `${p.caption} – ${p.place}` : p.caption}
                >
                  {p.thumb ? <img src={p.thumb} alt="" loading="lazy" /> : <span class="gmap__video">▶</span>}
                  <span class="gmap__tip">{p.caption}{p.place && <small>{p.place}</small>}</span>
                </button>
              ))}
            </div>
            <div class="gmap__zoom">
              <button type="button" data-gmap-zoom="1" aria-label="+">+</button>
              <button type="button" data-gmap-zoom="-1" aria-label="−">−</button>
            </div>
            <p class="gmap__hint">{t(lang, 'gallery.mapHint')}</p>
          </div>
        )
      }

      <!-- folders: one for each hashtag (and the empty ones made in developer mode) -->
      <div class="gal-folders" data-gal-folders>
        <div class="gal-folders__row" data-gal-folder-row></div>
        <form class="gal-folders__new" hidden data-gal-newfolder>
          <span>📁</span>
          <input type="text" maxlength="40" required placeholder={t(lang, 'gal.folderName')} data-gal-newfolder-in />
          <button type="submit">✓</button>
          <button type="button" data-gal-newfolder-x>✕</button>
        </form>
        <p class="gal-folders__empty" hidden data-gal-folder-empty>{t(lang, 'gal.folderEmpty')}</p>
      </div>
      <template data-gal-t-all>{t(lang, 'gal.all')}</template>
      <template data-gal-t-newfolder>{t(lang, 'gal.newFolder')}</template>
      <template data-gal-t-untagged>{t(lang, 'gal.untagged')}</template>
      <ul class="gallery__grid" data-gallery-grid data-live={import.meta.env.PUBLIC_STATIC_EXPORT === '1' ? MAIN_SITE : undefined} data-lang={lang}>
        {
          photos.map((p, i) => (
            <li class="gallery__item" data-key={p.key} data-tags={(p.tags ?? []).join(',')} data-files={p.files ? JSON.stringify(p.files) : undefined}>
              <button type="button" class="gallery__open" data-index={i} data-large={p.large} data-video={p.video ?? ''} data-caption={p.caption} data-place={p.place ?? ''} data-when={p.when} data-post={p.post ? localePath(lang, `posts/${p.post}`) : ''}>
                {p.video ? (
                  <span class="gallery__video">
                    <video src={`${p.video}#t=0.5`} preload="metadata" muted playsinline />
                    <span class="gallery__play" aria-hidden="true">▶</span>
                  </span>
                ) : p.image ? (
                  <Image src={p.image} alt={p.caption} widths={[360, 720]} sizes="(max-width: 600px) 100vw, 360px" loading={i < 6 ? 'eager' : 'lazy'} />
                ) : (
                  <img src={p.src} alt={p.caption} loading={i < 6 ? 'eager' : 'lazy'} />
                )}
              </button>
              <!-- developer mode: a place for the picture, or remove it from the gallery -->
              <span class="gallery__dev">
                <button type="button" data-gal-place title={t(lang, 'gal.edit')} aria-label={t(lang, 'gal.edit')}>✎</button>
                <button type="button" data-gal-del title={t(lang, 'gal.delete')} aria-label={t(lang, 'gal.delete')}>🗑</button>
              </span>
              <p class="gallery__caption">{p.caption}</p>
              <p class="gallery__tags" data-gal-tags>{(p.tags ?? []).map((x) => `#${x}`).join(' ')}</p>
              {(p.place || p.when) && (
                <p class="gallery__meta">
                  {p.place && (
                    <span>
                      <Icon name="map-pin" size={14} />
                      {p.place}
                    </span>
                  )}
                  {p.when && <span>{p.when}</span>}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label={t(lang, 'gallery.title')}>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" data-lb-img />
      <video class="lightbox__img" controls playsinline hidden data-lb-video></video>
      <figcaption class="lightbox__text">
        <strong data-lb-caption></strong>
        <span class="lightbox__meta" data-lb-meta></span>
        <a class="lightbox__post" hidden data-lb-post>{t(lang, 'gallery.toPost')}</a>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__close" aria-label={t(lang, 'facts.close')} data-lb-close><Icon name="x" size={22} /></button>
    <button type="button" class="lightbox__btn lightbox__prev" aria-label={t(lang, 'gallery.prev')} data-lb-step="-1"><Icon name="chevron-left" size={26} /></button>
    <button type="button" class="lightbox__btn lightbox__next" aria-label={t(lang, 'gallery.next')} data-lb-step="1"><Icon name="chevron-right" size={26} /></button>
  </dialog>
  <form class="gal-place" hidden data-gal-form>
    <strong>✎ {t(lang, 'gal.edit')}</strong>
    <textarea rows="3" maxlength="300" placeholder={t(lang, 'upload.caption')} data-gal-in-caption></textarea>
    <input type="text" maxlength="80" placeholder={t(lang, 'upload.place')} data-gal-in-place />
    <input type="text" maxlength="60" placeholder={t(lang, 'upload.coords')} data-gal-in-coords />
    <input type="text" maxlength="200" placeholder={t(lang, 'upload.tags')} data-gal-in-tags />
    <small data-gal-note></small>
    <div><button type="button" data-gal-cancel>✕</button><button type="submit">{t(lang, 'gal.save')}</button></div>
  </form>
  <script type="application/json" data-gal-data set:html={JSON.stringify(gallery)} />
  <template data-gal-tile>
    <li class="gallery__item">
      <button type="button" class="gallery__open"></button>
      <span class="gallery__dev">
        <button type="button" data-gal-place title={t(lang, 'gal.edit')} aria-label={t(lang, 'gal.edit')}>✎</button>
        <button type="button" data-gal-del title={t(lang, 'gal.delete')} aria-label={t(lang, 'gal.delete')}>🗑</button>
      </span>
      <p class="gallery__caption"></p>
      <p class="gallery__tags" data-gal-tags></p>
      <p class="gallery__meta"></p>
    </li>
  </template>
  <template data-gal-t-confirmdel>{t(lang, 'gal.confirmDelete')}</template>
  <template data-gal-t-saved>{t(lang, 'gal.saved')}</template>
  <template data-gal-t-nogeo>{t(lang, 'upload.noGeo')}</template>
  <template data-gal-t-key>{t(lang, 'dev.msgKey')}</template>
</BaseLayout>

<style>
  .gallery__item {
    position: relative;
  }
  .gallery__video {
    position: relative;
    display: block;
  }
  .gallery__video video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #000;
  }
  .gallery__play,
  .gmap__video {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 42px;
    text-shadow: 0 2px 10px rgb(0 0 0 / 0.6);
  }
  .gmap__video {
    position: static;
    width: 100%;
    height: 100%;
    font-size: 14px;
    background: var(--violet);
  }
  .gallery__dev {
    position: absolute;
    top: 8px;
    right: 8px;
    display: none;
    gap: 6px;
  }
  :global(html.dev-mode) .gallery__dev {
    display: flex;
  }
  .gallery__dev button {
    width: 34px;
    height: 34px;
    border: 2px solid #39d353;
    border-radius: 50%;
    background: #0d1117;
    font-size: 15px;
    cursor: pointer;
  }
  .gallery__tags {
    margin: 2px 0 0;
    color: var(--violet);
    font-size: 13px;
    font-weight: 700;
  }
  .gallery__tags:empty,
  .gallery__meta:empty {
    display: none;
  }
  .gallery__item[hidden] {
    display: none;
  }
  /* folders */
  .gal-folders {
    margin: 22px 0 6px;
  }
  .gal-folders__row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .gal-folders__row :global(.gal-folder) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 5px;
    border: 2px solid var(--ink);
    border-radius: 14px;
    background: var(--surface, #fff);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 150ms ease;
  }
  .gal-folders__row :global(.gal-folder:hover) {
    transform: translateY(-2px);
  }
  .gal-folders__row :global(.gal-folder.is-on) {
    background: var(--yellow);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .gal-folders__row :global(.gal-folder__cover) {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--violet-tint, #eee);
    font-size: 18px;
  }
  .gal-folders__row :global(.gal-folder__cover img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gal-folders__row :global(.gal-folder small) {
    color: var(--muted);
  }
  .gal-folders__row :global(.gal-folder__x) {
    display: none;
    margin-left: 2px;
    color: #c0392b;
  }
  :global(html.dev-mode:not(.dev-preview)) .gal-folders__row :global(.gal-folder__x) {
    display: inline;
  }
  .gal-folders__row :global(.gal-folder--new) {
    display: none;
    padding: 5px 14px;
    border-style: dashed;
    border-color: #1f8a3a;
    color: #1f8a3a;
  }
  :global(html.dev-mode:not(.dev-preview)) .gal-folders__row :global(.gal-folder--new) {
    display: inline-flex;
  }
  .gal-folders__new {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
  }
  .gal-folders__new[hidden],
  .gal-folders__empty[hidden] {
    display: none;
  }
  .gal-folders__new input {
    padding: 7px 10px;
    border: 2px solid #1f8a3a;
    border-radius: 10px;
    font: inherit;
  }
  .gal-folders__new button {
    padding: 6px 12px;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--surface, #fff);
    font: inherit;
    cursor: pointer;
  }
  .gal-folders__empty {
    margin: 12px 0 0;
    color: var(--muted);
    font-weight: 700;
  }
  .gallery__item.is-removed {
    opacity: 0.3;
    pointer-events: none;
  }
  .gal-place {
    position: fixed;
    z-index: 2000;
    display: grid;
    gap: 8px;
    width: min(320px, calc(100vw - 24px));
    padding: 14px;
    border: 2px solid #39d353;
    border-radius: 14px;
    background: #0d1117;
    color: #d6f5d6;
    font: 13px ui-monospace, Consolas, monospace;
  }
  .gal-place[hidden] {
    display: none;
  }
  .gal-place textarea,
  .gal-place input {
    padding: 8px 10px;
    border: 1px solid #30363d;
    border-radius: 8px;
    background: #010409;
    color: #e6edf3;
    font: inherit;
  }
  .gal-place div {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .gal-place button {
    padding: 7px 12px;
    border: 1px solid #39d353;
    border-radius: 8px;
    background: #161b22;
    color: #39d353;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .gallery__back a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
  .gallery__lead {
    max-width: 640px;
    margin: 0 0 28px;
    font-size: var(--fs-body);
  }
  .gallery__empty {
    font-weight: 700;
  }
  .gmap {
    position: relative;
    margin: 0 0 32px;
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--violet-tint);
    box-shadow: var(--shadow-yellow);
    touch-action: none;
  }
  .gmap__stage {
    position: relative;
    aspect-ratio: 2 / 1;
    transform-origin: 0 0;
    cursor: grab;
  }
  .gmap__stage.is-dragging {
    cursor: grabbing;
  }
  .gmap__land {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }
  .gmap__pin {
    position: absolute;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 2px solid var(--ink);
    border-radius: 50% 50% 50% 0;
    background: var(--yellow);
    transform: translate(-50%, -100%) rotate(-45deg) scale(calc(1 / var(--gz, 1)));
    transform-origin: 50% 100%;
    box-shadow: 2px 2px 0 var(--ink);
    cursor: pointer;
    overflow: visible;
  }
  .gmap__pin img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    transform: rotate(45deg);
    pointer-events: none;
  }
  .gmap__tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    display: none;
    width: max-content;
    max-width: 220px;
    padding: 6px 10px;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    transform: translateX(-50%) rotate(45deg);
    transform-origin: 0 100%;
    pointer-events: none;
  }
  .gmap__tip small {
    display: block;
    font-weight: 400;
    color: var(--muted);
  }
  .gmap__pin:hover,
  .gmap__pin:focus-visible {
    z-index: 2;
    background: var(--violet);
  }
  .gmap__pin:hover .gmap__tip,
  .gmap__pin:focus-visible .gmap__tip {
    display: block;
  }
  .gmap__zoom {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    gap: 6px;
  }
  .gmap__zoom button {
    width: 38px;
    height: 38px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    font-size: 22px;
    font-weight: 800;
    line-height: 1;
  }
  .gmap__hint {
    position: absolute;
    left: 12px;
    bottom: 8px;
    margin: 0;
    font-size: var(--fs-tiny);
    color: var(--muted);
    pointer-events: none;
  }
  .gallery__grid {
    columns: 3 300px;
    column-gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery__item {
    break-inside: avoid;
    margin: 0 0 18px;
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-yellow);
  }
  .gallery__item:nth-child(even) {
    box-shadow: var(--shadow-violet);
  }
  .gallery__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }
  .gallery__open :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--t-med) var(--ease);
  }
  .gallery__open:hover :global(img),
  .gallery__open:focus-visible :global(img) {
    transform: scale(1.04);
  }
  .gallery__caption {
    margin: 0;
    padding: 12px 14px 0;
    font-weight: 700;
  }
  .gallery__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 4px 0 0;
    padding: 0 14px;
    font-size: var(--fs-tiny);
    color: var(--muted);
  }
  .gallery__meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .gallery__item > :last-child {
    padding-bottom: 12px;
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 10, 20, 0.94);
    color: #fff;
    zoom: var(--inv-zoom, 1);
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: 100%;
    margin: 0;
    padding: 56px 64px 24px;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: calc(100vh - 170px);
    object-fit: contain;
    border-radius: 8px;
  }
  .lightbox__text {
    display: grid;
    gap: 4px;
    max-width: 720px;
    text-align: center;
  }
  .lightbox__text strong {
    font-size: 18px;
  }
  .lightbox__meta {
    font-size: 14px;
    opacity: 0.8;
  }
  .lightbox__post {
    justify-self: center;
    color: #ffd84d;
    font-weight: 700;
  }
  .lightbox__post[hidden] {
    display: none;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .lightbox__btn:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .lightbox__close {
    top: 14px;
    right: 14px;
  }
  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__prev {
    left: 10px;
  }
  .lightbox__next {
    right: 10px;
  }
  @media (max-width: 600px) {
    .lightbox__figure {
      padding: 64px 12px 80px;
    }
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 16px;
      transform: none;
    }
  }
</style>

<script>
  // ---- gallery map: zoom (+/−, wheel) and drag; a pin opens its photo ----
  const gmap = document.querySelector<HTMLElement>('[data-gmap]');
  if (gmap) {
    const stage = gmap.querySelector<HTMLElement>('[data-gmap-stage]')!;
    let z = 1;
    let x = 0;
    let y = 0;
    const clamp = () => {
      const w = gmap.clientWidth;
      const h = stage.offsetHeight;
      x = Math.min(0, Math.max(w - w * z, x));
      y = Math.min(0, Math.max(h - h * z, y));
    };
    const apply = () => {
      clamp();
      stage.style.transform = `translate(${x}px, ${y}px) scale(${z})`;
      stage.style.setProperty('--gz', String(z));
    };
    const zoomAt = (factor: number, cx: number, cy: number) => {
      const nz = Math.min(12, Math.max(1, z * factor));
      x = cx - ((cx - x) * nz) / z;
      y = cy - ((cy - y) * nz) / z;
      z = nz;
      apply();
    };
    gmap.querySelectorAll<HTMLButtonElement>('[data-gmap-zoom]').forEach((b) =>
      b.addEventListener('click', () => zoomAt(Number(b.dataset.gmapZoom) > 0 ? 1.6 : 1 / 1.6, gmap.clientWidth / 2, stage.offsetHeight / 2)),
    );
    gmap.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const r = gmap.getBoundingClientRect();
        zoomAt(e.deltaY < 0 ? 1.25 : 0.8, e.clientX - r.left, e.clientY - r.top);
      },
      { passive: false },
    );
    let drag: { px: number; py: number; x: number; y: number; moved: boolean } | null = null;
    stage.addEventListener('pointerdown', (e) => {
      drag = { px: e.clientX, py: e.clientY, x, y, moved: false };
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.px;
      const dy = e.clientY - drag.py;
      if (Math.abs(dx) + Math.abs(dy) > 4) {
        drag.moved = true;
        stage.classList.add('is-dragging');
      }
      x = drag.x + dx;
      y = drag.y + dy;
      apply();
    });
    window.addEventListener('pointerup', () => {
      setTimeout(() => (drag = null));
      stage.classList.remove('is-dragging');
    });
    // start zoomed to where the photos are (all in Europe → Europe fills the map)
    const fit = () => {
      const pts = Array.from(gmap.querySelectorAll<HTMLElement>('[data-pin]')).map((p) => [parseFloat(p.style.left) / 100, parseFloat(p.style.top) / 100]);
      const xs = pts.map((p) => p[0]);
      const ys = pts.map((p) => p[1]);
      const span = Math.max(Math.max(...xs) - Math.min(...xs), (Math.max(...ys) - Math.min(...ys)) / 2, 0.02);
      z = Math.min(6, Math.max(1, 0.6 / span));
      const w = gmap.clientWidth;
      const h = stage.offsetHeight;
      x = w / 2 - ((Math.max(...xs) + Math.min(...xs)) / 2) * w * z;
      y = h / 2 - ((Math.max(...ys) + Math.min(...ys)) / 2) * h * z;
      apply();
    };
    fit();
    gmap.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach((pin) =>
      pin.addEventListener('click', () => {
        if (drag?.moved) return;
        document.querySelectorAll<HTMLButtonElement>('.gallery__open')[Number(pin.dataset.pin)]?.click();
      }),
    );
  }

  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const list = () => Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery__item:not([hidden]) .gallery__open'));
  if (box) {
    let items = list();
    const img = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const vid = box.querySelector<HTMLVideoElement>('[data-lb-video]')!;
    box.addEventListener('close', () => vid.pause());
    const caption = box.querySelector<HTMLElement>('[data-lb-caption]')!;
    const meta = box.querySelector<HTMLElement>('[data-lb-meta]')!;
    const postLink = box.querySelector<HTMLAnchorElement>('[data-lb-post]')!;
    let at = 0;

    const show = (i: number) => {
      items = list();
      if (!items.length) return;
      at = (i + items.length) % items.length;
      const d = items[at].dataset;
      vid.pause();
      img.hidden = !!d.video;
      vid.hidden = !d.video;
      if (d.video) vid.src = d.video;
      else {
        img.src = d.large!;
        img.alt = d.caption!;
      }
      caption.textContent = d.caption!;
      meta.textContent = [d.place, d.when].filter(Boolean).join(' · ');
      postLink.hidden = !d.post;
      if (d.post) postLink.href = d.post;
      if (!box.open) box.showModal();
    };

    document.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('.gallery__open');
      if (b) show(list().indexOf(b));
    });
    box.querySelectorAll<HTMLButtonElement>('[data-lb-step]').forEach((b) => b.addEventListener('click', () => show(at + Number(b.dataset.lbStep))));
    box.querySelector('[data-lb-close]')!.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => {
      if (e.target === box || e.target === box.querySelector('.lightbox__figure')) box.close();
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(at - 1);
      if (e.key === 'ArrowRight') show(at + 1);
    });
  }
</script>

<script>
  /*
   * Folders (a hashtag each), developer mode (✎: description, place, hashtags; 🗑: out of the gallery;
   * ＋ new folder) and, on a copy on another host, the pictures uploaded on the main site since then.
   * Saved to GitHub (src/data/gallery.json); 🚀 Publish puts it online.
   */
  import { commitFiles, getToken } from '../../lib/githubCommit';
  import { geocode } from '../../lib/geocode';
  import { parseTags, showTags } from '../../lib/tags';

  type Meta = { caption?: string; place?: string; lat?: number; lng?: number; tags?: string[] };
  const grid = document.querySelector<HTMLElement>('[data-gallery-grid]');
  const form = document.querySelector<HTMLFormElement>('[data-gal-form]');
  const raw = document.querySelector('[data-gal-data]');
  if (grid && form && raw) {
    const data = JSON.parse(raw.textContent || '{}') as { hidden: string[]; meta: Record<string, Meta>; folders?: string[] };
    data.folders ??= [];
    const tx = (n: string) => document.querySelector<HTMLTemplateElement>(`[data-gal-t-${n}]`)?.content.textContent ?? '';
    const tilesAll = () => Array.from(grid.querySelectorAll<HTMLElement>('.gallery__item:not(.is-removed)')).filter((li) => !li.dataset.gone);
    const tagsOf = (li: HTMLElement) => (li.dataset.tags ?? '').split(',').filter(Boolean);

    // ---- folders ----
    const row = document.querySelector<HTMLElement>('[data-gal-folder-row]')!;
    const newForm = document.querySelector<HTMLFormElement>('[data-gal-newfolder]')!;
    const emptyNote = document.querySelector<HTMLElement>('[data-gal-folder-empty]')!;
    let open = '';
    function applyFolder() {
      let shown = 0;
      for (const li of tilesAll()) {
        li.hidden = !!open && !tagsOf(li).includes(open);
        if (!li.hidden) shown++;
      }
      emptyNote.hidden = !open || shown > 0;
      row.querySelectorAll<HTMLElement>('[data-folder]').forEach((b) => b.classList.toggle('is-on', b.dataset.folder === open));
    }
    function renderFolders() {
      const count = new Map<string, number>();
      const cover = new Map<string, string>();
      for (const li of tilesAll())
        for (const tg of tagsOf(li)) {
          count.set(tg, (count.get(tg) ?? 0) + 1);
          if (!cover.has(tg)) {
            const img = li.querySelector<HTMLImageElement>('.gallery__open img');
            if (img) cover.set(tg, img.currentSrc || img.src);
          }
        }
      const names = [...new Set([...data.folders!, ...count.keys()])].sort((a, b) => (count.get(b) ?? 0) - (count.get(a) ?? 0) || a.localeCompare(b));
      const chip = (name: string, label: string, n: number, pic?: string) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'gal-folder';
        b.dataset.folder = name;
        const c = document.createElement('span');
        c.className = 'gal-folder__cover';
        if (pic) c.append(Object.assign(document.createElement('img'), { src: pic, alt: '' }));
        else c.textContent = name ? '📁' : '🗂';
        const s = document.createElement('span');
        s.append(label, ' ');
        s.append(Object.assign(document.createElement('small'), { textContent: `(${n})` }));
        b.append(c, s);
        // developer mode: an empty folder made by hand can go
        if (name && !count.get(name) && data.folders!.includes(name)) {
          const x = Object.assign(document.createElement('span'), { className: 'gal-folder__x', textContent: '✕', title: '✕' });
          x.addEventListener('click', async (ev) => {
            ev.stopPropagation();
            data.folders = data.folders!.filter((f) => f !== name);
            if (open === name) open = '';
            renderFolders();
            await save([`🗑 📁 ${name}`]).catch(() => {});
          });
          b.append(x);
        }
        return b;
      };
      const add = document.createElement('button');
      add.type = 'button';
      add.className = 'gal-folder gal-folder--new';
      add.textContent = `＋ ${tx('newfolder')}`;
      add.addEventListener('click', () => {
        newForm.hidden = false;
        newForm.querySelector('input')!.focus();
      });
      row.replaceChildren(chip('', tx('all'), tilesAll().length), ...names.map((n) => chip(n, `#${n}`, count.get(n) ?? 0, cover.get(n))), add);
      applyFolder();
    }
    row.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-folder]');
      if (!b) return;
      open = b.dataset.folder ?? '';
      applyFolder();
    });
    newForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = parseTags(newForm.querySelector('input')!.value)[0];
      if (!name) return;
      if (!data.folders!.includes(name)) data.folders!.push(name);
      newForm.hidden = true;
      newForm.reset();
      open = name;
      renderFolders();
      await save([`📁 ${name}`]).catch((err) => err instanceof Error && err.message !== 'no key' && window.alert(err.message));
    });
    newForm.querySelector('[data-gal-newfolder-x]')!.addEventListener('click', () => (newForm.hidden = true));

    // ---- developer mode: ✎ and 🗑 (for every tile, also those that arrive later) ----
    const key = () => {
      let k = getToken();
      if (!k) k = (window.prompt(tx('key')) ?? '').trim();
      return k;
    };
    const save = (lines: string[], extra: { path: string; delete: true }[] = []) => {
      const k = key();
      if (!k) return Promise.reject(new Error('no key'));
      return commitFiles(k, [{ path: 'src/data/gallery.json', text: `${JSON.stringify(data, null, 2)}\n` }, ...extra], 'Gallery: changed on the site', lines);
    };
    const inPlace = form.querySelector<HTMLInputElement>('[data-gal-in-place]')!;
    const inCaption = form.querySelector<HTMLTextAreaElement>('[data-gal-in-caption]')!;
    const inCoords = form.querySelector<HTMLInputElement>('[data-gal-in-coords]')!;
    const inTags = form.querySelector<HTMLInputElement>('[data-gal-in-tags]')!;
    const note = form.querySelector<HTMLElement>('[data-gal-note]')!;
    let item: HTMLElement | null = null;

    grid.addEventListener('click', async (e) => {
      const li = (e.target as Element).closest<HTMLElement>('.gallery__item');
      if (!li) return;
      if ((e.target as Element).closest('[data-gal-place]')) {
        item = li;
        const m = data.meta[li.dataset.key!] ?? {};
        inCaption.value = li.querySelector('.gallery__open')?.getAttribute('data-caption') ?? '';
        inPlace.value = m.place ?? li.querySelector('.gallery__open')?.getAttribute('data-place') ?? '';
        inCoords.value = m.lat !== undefined && m.lng !== undefined ? `${m.lat}, ${m.lng}` : '';
        inTags.value = showTags(tagsOf(li));
        note.textContent = '';
        const r = ((e.target as Element).closest('[data-gal-place]') as HTMLElement).getBoundingClientRect();
        form.hidden = false;
        form.style.left = `${Math.max(12, Math.min(window.innerWidth - form.offsetWidth - 12, r.right - form.offsetWidth))}px`;
        form.style.top = `${Math.max(12, Math.min(window.innerHeight - form.offsetHeight - 12, r.bottom + 8))}px`;
        inCaption.focus();
      } else if ((e.target as Element).closest('[data-gal-del]')) {
        const caption = li.querySelector('.gallery__open')?.getAttribute('data-caption') ?? '';
        if (!window.confirm(tx('confirmdel').replace('{name}', caption))) return;
        const files = li.dataset.files ? (JSON.parse(li.dataset.files) as string[]) : null;
        try {
          if (files) {
            // an uploaded photo / video: its files go
            const k = key();
            if (!k) return;
            await commitFiles(k, files.map((path) => ({ path, delete: true as const })), `Gallery: deleted ${caption}`, [`🗑 📷 ${caption}`]);
          } else {
            data.hidden.push(li.dataset.key!);
            await save([`🗑 📷 ${caption}`]);
          }
          li.classList.add('is-removed');
          renderFolders();
        } catch (err) {
          if (err instanceof Error && err.message !== 'no key') window.alert(err.message);
        }
      }
    });
    form.querySelector('[data-gal-cancel]')!.addEventListener('click', () => (form.hidden = true));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!item) return;
      const k = item.dataset.key!;
      const place = inPlace.value.trim();
      const caption = inCaption.value.trim();
      const tags = parseTags(inTags.value);
      const before = item.querySelector('.gallery__open')?.getAttribute('data-place') ?? '';
      const m = inCoords.value.trim().match(/^(-?\d{1,2}(?:[.,]\d+)?)\s*[,; ]\s*(-?\d{1,3}(?:[.,]\d+)?)$/);
      let lat: number | undefined;
      let lng: number | undefined;
      if (m) {
        lat = Number(m[1].replace(',', '.'));
        lng = Number(m[2].replace(',', '.'));
      } else if (place && place !== before) {
        const hit = (await geocode(place, document.documentElement.lang || 'en').catch(() => []))[0];
        if (!hit) return void (note.textContent = tx('nogeo'));
        lat = Math.round(hit.latitude * 1e5) / 1e5;
        lng = Math.round(hit.longitude * 1e5) / 1e5;
      }
      const old = data.meta[k] ?? {};
      data.meta[k] = {
        ...(caption ? { caption } : {}),
        ...(place ? { place } : {}),
        ...(lat !== undefined ? { lat, lng } : old.lat !== undefined && place === before ? { lat: old.lat, lng: old.lng } : {}),
        tags,
      };
      try {
        await save([`✎ 📷 ${caption}${place ? ` · 📍 ${place}` : ''}${tags.length ? ` · ${showTags(tags)}` : ''}`]);
        // show it at once
        const openBtn = item.querySelector<HTMLElement>('.gallery__open');
        if (openBtn) {
          openBtn.dataset.caption = caption;
          openBtn.dataset.place = place;
        }
        const cap = item.querySelector('.gallery__caption');
        if (cap && caption) cap.textContent = caption;
        item.dataset.tags = tags.join(',');
        const tagLine = item.querySelector('[data-gal-tags]');
        if (tagLine) tagLine.textContent = showTags(tags);
        renderFolders();
        note.textContent = tx('saved');
        window.setTimeout(() => (form.hidden = true), 900);
      } catch (err) {
        if (err instanceof Error && err.message !== 'no key') note.textContent = err.message;
      }
    });

    // ---- a copy on another host: the main site's pictures (and folders) ----
    const live = grid.dataset.live;
    if (live) {
      const fmt = new Intl.DateTimeFormat(document.documentElement.lang || 'hu', { year: 'numeric', month: 'long', day: 'numeric' });
      const tileTpl = document.querySelector<HTMLTemplateElement>('[data-gal-tile]')!;
      type Item = { key: string; caption: string; place: string; date: string; post: string; video: string; large: string; thumb: string; tags?: string[] };
      fetch(`${live}/gallery.json`, { cache: 'no-cache' })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then(({ items, folders }: { items: Item[]; folders?: string[] }) => {
          const byKey = new Map(items.map((x) => [x.key, x]));
          // removed on the main site; hashtags as there
          grid.querySelectorAll<HTMLElement>('.gallery__item').forEach((li) => {
            const x = li.dataset.key ? byKey.get(li.dataset.key) : undefined;
            if (!x) {
              li.hidden = true;
              li.dataset.gone = '1';
              return;
            }
            li.dataset.tags = (x.tags ?? []).join(',');
            const tagLine = li.querySelector('[data-gal-tags]');
            if (tagLine) tagLine.textContent = showTags(x.tags);
          });
          const have = new Set(Array.from(grid.querySelectorAll<HTMLElement>('.gallery__item')).map((li) => li.dataset.key));
          const lang = grid.dataset.lang ?? 'hu';
          for (const x of items.filter((y) => !have.has(y.key)).reverse()) {
            const li = tileTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
            li.dataset.key = x.key;
            li.dataset.tags = (x.tags ?? []).join(',');
            const b = li.querySelector<HTMLElement>('.gallery__open')!;
            const when = x.date ? fmt.format(new Date(x.date)) : '';
            Object.assign(b.dataset, {
              large: x.large ? live + x.large : '',
              video: x.video ? live + x.video : '',
              caption: x.caption,
              place: x.place,
              when,
              post: x.post ? `${live}/${lang}/posts/${x.post}/` : '',
            });
            if (x.video) {
              const v = document.createElement('video');
              v.src = `${live}${x.video}#t=0.5`;
              v.preload = 'metadata';
              v.muted = true;
              v.playsInline = true;
              v.style.cssText = 'display:block;width:100%;aspect-ratio:4/3;object-fit:cover;background:#000';
              b.append(v);
            } else {
              const img = document.createElement('img');
              img.src = live + x.thumb;
              img.alt = x.caption;
              img.loading = 'lazy';
              b.append(img);
            }
            li.querySelector('.gallery__caption')!.textContent = x.caption;
            li.querySelector('[data-gal-tags]')!.textContent = showTags(x.tags);
            li.querySelector('.gallery__meta')!.textContent = [x.place && `📍 ${x.place}`, when].filter(Boolean).join(' · ');
            grid.prepend(li);
          }
          data.folders = [...new Set([...(folders ?? []), ...data.folders!])];
          renderFolders();
          const empty = document.querySelector<HTMLElement>('[data-gallery-empty]');
          if (empty) empty.hidden = !!grid.querySelector('.gallery__item:not([hidden])');
        })
        .catch((err) => console.warn('[gallery] the main site could not be reached', err));
    }
    renderFolders();
  }
</script>
