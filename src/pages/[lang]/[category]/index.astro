---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Globe from '../../../components/Globe.astro';
import IconCircle from '../../../components/IconCircle.astro';
import PostCard from '../../../components/PostCard.astro';
import { LOCALES, localePath, t, type Lang } from '../../../i18n';
import { CATEGORIES, type Category } from '../../../lib/constants';
import { categoryMeta } from '../../../lib/categories';
import { getPosts } from '../../../lib/posts';

/** a copy on another host: posts written on the main site get a card too (/posts.json) */
const live = import.meta.env.PUBLIC_STATIC_EXPORT === '1' ? import.meta.env.PUBLIC_MAIN_SITE || 'https://lambent-platypus-c39161.netlify.app' : undefined;


export function getStaticPaths() {
  return LOCALES.flatMap((lang) => CATEGORIES.map((category) => ({ params: { lang, category } })));
}

const lang = Astro.params.lang as Lang;
const category = Astro.params.category as Category;
const meta = categoryMeta(category);
const posts = await getPosts(category);
// the card pattern for those: a post of this category if there is one (its colours and tag)
const sample = posts[0] ?? (await getPosts())[0];
const title = t(lang, meta.titleKey);
const intro = t(lang, meta.textKey);
---

<BaseLayout lang={lang} title={title} description={intro}>
  <header class="section page-header">
    <div class="bg-layer">
      <Globe size="min(620px, 110vw)" right="-14%" top="-30%" speed={80} />
    </div>
    <div class="container">
      <a class="link-arrow back-link" href={localePath(lang)}>{t(lang, 'posts.back')}</a>
      <div class="page-header__title">
        <IconCircle icon={meta.icon} variant={meta.tone} size="lg" />
        <h1>{title}</h1>
      </div>
      <p class="page-header__intro">{intro}</p>
    </div>
  </header>

  <section class="section post-list" aria-label={title} data-dev-add="post" data-dev-category={category}>
    <div class="bg-layer">
      <Globe size="min(700px, 120vw)" left="-24%" top="10%" speed={70} direction="ccw" />
    </div>
    <div class="container">
      <template data-card-soon>{t(lang, 'post.soon')}</template>
      <ul class="post-grid" data-post-grid data-live={live} data-category={category} data-lang={lang} data-cat-title={title} hidden={!posts.length && !live}>
        {
          posts.map((post, i) => (
            <li class="reveal" data-post-id={post.id}>
              <PostCard post={post} lang={lang} index={i} />
            </li>
          ))
        }
      </ul>
      {
        !posts.length && (
          <p class="empty" data-posts-empty>
            <IconCircle icon="sparkles" variant="yellow" size="sm" />
            {t(lang, 'posts.empty')}
          </p>
        )
      }
      {
        sample && (
          <template data-card-tpl>
            <li>
              <PostCard post={sample} lang={lang} index={0} />
            </li>
          </template>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: clamp(32px, 6vw, 72px) 0;
  }
  .page-header__title {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 16px;
  }
  .page-header__title h1 {
    font-size: clamp(36px, 6vw, 72px);
    margin: 0;
    min-width: 0;
  }
  .page-header__intro {
    font-size: var(--fs-tagline);
    color: var(--muted);
    max-width: 50ch;
    margin-top: 20px;
  }
  .back-link::after {
    order: -1;
    transform: rotate(180deg);
  }
  .back-link:hover::after {
    transform: rotate(180deg) translateX(4px);
  }
  .post-list {
    padding-top: clamp(40px, 6vw, 64px);
    padding-bottom: 0;
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, calc(300px * var(--tz))), 1fr));
    gap: clamp(24px, 3vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .post-grid > li {
    display: flex;
  }
  .post-grid > li > :global(*) {
    flex: 1;
  }
  .empty {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: var(--fs-tagline);
    font-weight: 700;
  }
</style>

<script>
  /*
   * A copy of the site on another host: posts written on the main site since the copy was made get a
   * card here (opening on the main site); posts deleted there are left out. Read from /posts.json.
   */
  // a post just written in developer mode: its card shows at once (like the others), marked "after 🚀 Publish"
  {
    const g = document.querySelector<HTMLElement>('[data-post-grid]');
    const t = document.querySelector<HTMLTemplateElement>('[data-card-tpl]');
    const soon = document.querySelector<HTMLTemplateElement>('[data-card-soon]')?.content.textContent ?? '';
    window.addEventListener('andras:post-created', (ev) => {
      const d = (ev as CustomEvent<{ slug: string; category: string; title: string; excerpt: string; date: string; cover: string; lang: string }>).detail;
      if (!g || !t || d.category !== g.dataset.category) return;
      const li = t.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.dataset.postId = d.slug;
      const cover = li.querySelector<HTMLElement>('.post-card__cover');
      if (cover && d.cover) {
        cover.innerHTML = '';
        cover.append(Object.assign(document.createElement('img'), { src: d.cover, alt: '', style: 'display:block;width:100%;height:100%;object-fit:cover' }));
      }
      li.querySelectorAll('.post-card__draft, .post-card__lang').forEach((n) => n.remove());
      const tag = li.querySelector('.post-card__tag');
      if (tag) {
        tag.textContent = g.dataset.catTitle ?? '';
        const mark = Object.assign(document.createElement('span'), { textContent: soon });
        mark.style.cssText = 'margin-left:6px;padding:3px 10px;border-radius:99px;background:#0d1117;color:#39d353;font-size:12px;font-weight:700';
        tag.after(mark);
      }
      li.querySelector('.ph-circle')?.replaceChildren();
      const h = li.querySelector('h3');
      if (h) h.textContent = d.title;
      const time = li.querySelector('time');
      if (time) time.textContent = d.date ? new Intl.DateTimeFormat(document.documentElement.lang || 'hu', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(`${d.date}T12:00:00`)) : '';
      const ex = li.querySelector('.post-card__excerpt');
      if (ex) ex.textContent = d.excerpt;
      const a = li.querySelector<HTMLAnchorElement>('.post-card__link');
      if (a) a.href = `/${d.lang}/posts/${d.slug}/`;
      g.hidden = false;
      document.querySelector<HTMLElement>('[data-posts-empty]')?.setAttribute('hidden', '');
      g.prepend(li);
      li.scrollIntoView({ block: 'center', behavior: 'smooth' });
    });
  }

  const grid = document.querySelector<HTMLElement>('[data-post-grid][data-live]');
  const tpl = document.querySelector<HTMLTemplateElement>('[data-card-tpl]');
  if (grid && tpl) {
    const live = grid.dataset.live!;
    const lang = grid.dataset.lang ?? 'hu';
    type P = { id: string; title: string; excerpt: string; category: string; lang: string; date: string; month: boolean; cover: string };
    fetch(`${live}/posts.json`, { cache: 'no-cache' })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then(({ items }: { items: P[] }) => {
        const mine = items.filter((x) => x.category === grid.dataset.category);
        const ids = new Set(mine.map((x) => x.id));
        grid.querySelectorAll<HTMLElement>('[data-post-id]').forEach((li) => {
          if (!ids.has(li.dataset.postId!)) li.remove();
        });
        const have = new Set(Array.from(grid.querySelectorAll<HTMLElement>('[data-post-id]')).map((li) => li.dataset.postId));
        const fmt = (d: string, month: boolean) =>
          new Intl.DateTimeFormat(document.documentElement.lang || 'hu', month ? { year: 'numeric', month: 'long' } : { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(d));
        for (const x of mine.filter((y) => !have.has(y.id)).reverse()) {
          const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          li.dataset.postId = x.id;
          const href = `${live}/${lang}/posts/${x.id}/`;
          const cover = li.querySelector<HTMLElement>('.post-card__cover');
          if (cover && x.cover) {
            cover.innerHTML = '';
            const img = document.createElement('img');
            img.src = live + x.cover;
            img.alt = '';
            img.loading = 'lazy';
            img.style.cssText = 'display:block;width:100%;height:100%;object-fit:cover';
            cover.append(img);
          }
          li.querySelectorAll('.post-card__draft, .post-card__lang').forEach((n) => n.remove());
          // this page's category, and no icon borrowed from the pattern's post
          const tag = li.querySelector('.post-card__tag');
          if (tag) tag.textContent = grid.dataset.catTitle ?? '';
          li.querySelector('.ph-circle')?.replaceChildren();
          const h = li.querySelector('h3');
          if (h) h.textContent = x.title;
          const time = li.querySelector('time');
          if (time) {
            if (x.date) time.textContent = fmt(x.date, x.month);
            else time.remove();
          }
          const ex = li.querySelector('.post-card__excerpt');
          if (ex) ex.textContent = x.excerpt;
          const a = li.querySelector<HTMLAnchorElement>('.post-card__link');
          if (a) {
            a.href = href;
            const hidden = a.querySelector('.visually-hidden');
            if (hidden) hidden.textContent = `: ${x.title}`;
          }
          grid.prepend(li);
        }
        grid.hidden = !grid.querySelector('[data-post-id]');
        const empty = document.querySelector<HTMLElement>('[data-posts-empty]');
        if (empty) empty.hidden = !grid.hidden;
      })
      .catch((err) => console.warn('[posts] the main site could not be reached', err));
  }
</script>

