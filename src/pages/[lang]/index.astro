---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import IconStrip from '../../components/IconStrip.astro';
import About from '../../components/About.astro';
import ExploreCards from '../../components/ExploreCards.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import PlansTimeline from '../../components/PlansTimeline.astro';
import MessageForm from '../../components/MessageForm.astro';
import { langStaticPaths, type Lang } from '../../i18n';
import { layoutCss, sectionOrder } from '../../lib/layout';

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const BLOCKS = { hero: Hero, icons: IconStrip, about: About, explore: ExploreCards, photos: PhotoGallery, plans: PlansTimeline, message: MessageForm };
const css = layoutCss();
---

<BaseLayout lang={lang}>
  {css && <style slot="head" is:inline set:html={css} />}
  {
    sectionOrder().map((id) => {
      const Block = BLOCKS[id];
      return <Block lang={lang} />;
    })
  }
</BaseLayout>
