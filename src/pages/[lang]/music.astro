---
/**
 * Music: the tracks uploaded in developer mode (src/content/music/*.yml + public/music/*), newest first,
 * with one shared player (play / pause, seek, next). In developer mode a track can be deleted here.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import { HTML_LANG, langStaticPaths, localePath, t, type Lang } from '../../i18n';
import calendar from '../../data/calendar.json';

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const fmt = new Intl.DateTimeFormat(HTML_LANG[lang], { year: 'numeric', month: 'long', day: 'numeric' });
const tracks = (await getCollection('music'))
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
// every hashtag, the most used first
const tagCount = new Map<string, number>();
for (const tr of tracks) for (const tg of tr.tags ?? []) tagCount.set(tg, (tagCount.get(tg) ?? 0) + 1);
const allTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).map(([tg]) => tg);
/** the main site: a copy on another host also plays the music uploaded there (/music.json) */
const MAIN_SITE = import.meta.env.PUBLIC_MAIN_SITE || 'https://lambent-platypus-c39161.netlify.app';
const live = import.meta.env.PUBLIC_STATIC_EXPORT === '1' ? MAIN_SITE : undefined;
// every calendar event with music is a playlist (the newest trip first); built in the browser, so a copy
// on another host can use the main site's calendar too
type CalEvent = { id: string; title: string; title_en?: string; country?: string; from: string; to: string; color: string; music?: string[] };
const calEvents = (calendar.events as CalEvent[]).filter((e) => e.music?.length);
---

<BaseLayout lang={lang} title={t(lang, 'music.title')} description={t(lang, 'music.lead')}>
  <section class="section music" data-dev-add="music">
    <div class="container">
      <p class="music__back">
        <a href={localePath(lang)}><Icon name="arrow-left" size={18} />{t(lang, 'posts.back')}</a>
      </p>
      <SectionHeading icon="headphones" as="h1">{t(lang, 'music.title')}</SectionHeading>
      <p class="music__lead">{t(lang, 'music.lead')}</p>

      {tracks.length === 0 && <p class="music__empty" data-music-empty>{t(lang, 'music.empty')}</p>}

      <!-- playlists: one for each calendar event that has music -->
      <section class="music__playlists" hidden data-music-playlists data-lang={lang} aria-label={t(lang, 'music.playlists')}>
        <h2 class="music__pl-title">🎧 {t(lang, 'music.playlists')}</h2>
        <div class="music__pl-row" data-pl-row></div>
      </section>
      <script type="application/json" data-pl-events set:html={JSON.stringify(calEvents)} />
      <template data-pl-songs>{t(lang, 'music.songs')}</template>
      <template data-pl-all>{t(lang, 'music.playAll')}</template>
      <p class="music__tags" data-music-tags hidden={allTags.length === 0}>
        <button type="button" class="tagchip is-on" data-tag="">{t(lang, 'music.all')}</button>
        {
          allTags.map((tg) => (
            <button type="button" class="tagchip" data-tag={tg}>
              #{tg}
            </button>
          ))
        }
      </p>
      <ol class="music__list" data-music-list data-live={live}>
        {
          tracks.map((tr, i) => (
            <li class="track" data-track={i} data-src={tr.file} data-id={tr.id} data-tags={(tr.tags ?? []).join(',')} data-meta={JSON.stringify(tr)}>
              <button type="button" class="track__play" data-track-play aria-label={`${t(lang, 'music.play')}: ${tr.title}`}>
                <span class="track__icon-play"><Icon name="play" size={22} /></span>
                <span class="track__icon-pause"><Icon name="pause" size={22} /></span>
              </button>
              <div class="track__body">
                <strong class="track__title">{tr.title}</strong>
                {tr.artist && <span class="track__artist">{tr.artist}</span>}
                {tr.about && <p class="track__about">{tr.about}</p>}
                {tr.place && <span class="track__place">📍 {tr.place}</span>}
                {tr.tags && tr.tags.length > 0 && <span class="track__tags">{tr.tags.map((tg) => `#${tg}`).join(' ')}</span>}
                <div class="track__bar" data-track-bar>
                  <span class="track__fill" data-track-fill />
                </div>
                <span class="track__time">
                  <span data-track-time>0:00</span>
                  {tr.date && <time datetime={tr.date.toISOString()}> · {fmt.format(tr.date)}</time>}
                </span>
              </div>
              <span class="track__eq" aria-hidden="true">
                <i />
                <i />
                <i />
                <i />
              </span>
              <button type="button" class="track__edit" data-track-edit title={t(lang, 'music.edit')} aria-label={t(lang, 'music.edit')}>✎</button>
              <button type="button" class="track__del" data-track-del title={t(lang, 'music.delete')} aria-label={t(lang, 'music.delete')}>
                <Icon name="trash-2" size={16} />
              </button>
            </li>
          ))
        }
      </ol>
      <audio preload="none" data-music-audio></audio>
      <!-- an empty track, filled for the music that comes from the main site (copies on other hosts) -->
      <template data-track-tpl>
        <li class="track" data-track>
          <button type="button" class="track__play" data-track-play aria-label={t(lang, 'music.play')}>
            <span class="track__icon-play"><Icon name="play" size={22} /></span>
            <span class="track__icon-pause"><Icon name="pause" size={22} /></span>
          </button>
          <div class="track__body">
            <strong class="track__title"></strong>
            <span class="track__artist"></span>
            <p class="track__about"></p>
            <span class="track__place"></span>
            <span class="track__tags"></span>
            <div class="track__bar" data-track-bar><span class="track__fill" data-track-fill></span></div>
            <span class="track__time"><span data-track-time>0:00</span><time></time></span>
          </div>
          <span class="track__eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <button type="button" class="track__del" data-track-del title={t(lang, 'music.delete')} aria-label={t(lang, 'music.delete')}><Icon name="trash-2" size={16} /></button>
        </li>
      </template>
      <!-- developer mode: rewrite a track's details -->
      <form class="track-form" hidden data-track-form>
        <strong>✎ {t(lang, 'music.edit')}</strong>
        <input type="text" maxlength="120" placeholder={t(lang, 'music.trackTitle')} data-tf="title" />
        <input type="text" maxlength="80" placeholder={t(lang, 'music.artist')} data-tf="artist" />
        <textarea rows="3" maxlength="300" placeholder={t(lang, 'music.about')} data-tf="about"></textarea>
        <input type="text" maxlength="200" placeholder={t(lang, 'music.tags')} data-tf="tags" />
        <input type="text" maxlength="80" placeholder={t(lang, 'music.place')} data-tf="place" />
        <small data-tf-note></small>
        <div><button type="button" data-tf-cancel>✕</button><button type="submit">{t(lang, 'gal.save')}</button></div>
      </form>
      <template data-music-saved>{t(lang, 'gal.saved')}</template>
      <template data-music-nogeo>{t(lang, 'upload.noGeo')}</template>
      <template data-music-confirm>{t(lang, 'music.deleteConfirm')}</template>
      <template data-music-deleted>{t(lang, 'music.deleted')}</template>
      <template data-music-needkey>{t(lang, 'dev.msgKey')}</template>
    </div>
  </section>
</BaseLayout>

<style>
  .music__back a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
  .music__lead,
  .music__empty {
    max-width: 640px;
    color: var(--muted);
  }
  .music__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0 0;
  }
  :global(.tagchip) {
    padding: 6px 14px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--surface, #fff);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  :global(.tagchip.is-on) {
    background: var(--yellow);
    box-shadow: 3px 3px 0 var(--ink);
  }
  /* playlists: one card per trip */
  .music__playlists {
    margin: 26px 0 0;
  }
  .music__playlists[hidden] {
    display: none;
  }
  .music__pl-title {
    margin: 0 0 12px;
    font-size: clamp(20px, 2.4vw, 26px);
  }
  .music__pl-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }
  :global(.plcard) {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 14px;
    border: 3px solid var(--ink);
    border-radius: 16px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 30%, var(--surface, #fff)), var(--surface, #fff));
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--c);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 160ms ease;
  }
  :global(.plcard:hover) {
    transform: translate(-2px, -2px);
  }
  :global(.plcard.is-on) {
    outline: 3px solid var(--yellow);
    outline-offset: 2px;
  }
  :global(.plcard img) {
    width: 36px;
    height: 24px;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    object-fit: cover;
  }
  :global(.plcard strong) {
    display: block;
    line-height: 1.2;
  }
  :global(.plcard small) {
    color: var(--muted);
    font-weight: 700;
  }
  :global(.plcard__play) {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--yellow);
    font-size: 15px;
  }
  /* small tiles side by side */
  .music__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .track[hidden],
  .music__tags[hidden],
  .track__artist:empty,
  .track__about:empty,
  .track__place:empty,
  .track__tags:empty {
    display: none;
  }
  .track__place,
  .track__tags {
    font-size: 13px;
    font-weight: 700;
    opacity: 0.85;
  }
  .track__tags {
    color: var(--violet);
  }
  .track.is-playing .track__tags {
    color: var(--yellow);
  }
  .track {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    grid-template-rows: auto 1fr;
    gap: 12px 14px;
    align-content: start;
    padding: 14px;
    border: 3px solid var(--ink);
    border-radius: var(--radius-card);
    background: var(--surface, #fff);
    box-shadow: 5px 5px 0 var(--ink);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }
  .track.is-playing {
    background: var(--violet);
    color: #fff;
    box-shadow: 5px 5px 0 var(--yellow);
    transform: translate(-2px, -2px);
  }
  .track__play {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    cursor: pointer;
  }
  .track__icon-pause,
  .track.is-playing .track__icon-play {
    display: none;
  }
  .track.is-playing .track__icon-pause {
    display: inline;
  }
  .track__body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .track__title {
    font-family: var(--font-heading);
    font-size: 18px;
  }
  .track__artist {
    font-weight: 700;
    opacity: 0.8;
  }
  .track__about {
    margin: 2px 0 0;
    font-size: 15px;
  }
  .track__bar {
    position: relative;
    height: 8px;
    margin-top: 8px;
    border: 2px solid currentColor;
    border-radius: 99px;
    cursor: pointer;
    overflow: hidden;
  }
  .track__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--yellow);
  }
  .track__time {
    font-size: 13px;
    opacity: 0.8;
  }
  .track__eq {
    position: absolute;
    top: 18px;
    right: 16px;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 26px;
  }
  .track__eq i {
    width: 5px;
    height: 6px;
    border-radius: 2px;
    background: currentColor;
    opacity: 0.25;
  }
  .track.is-playing .track__eq i {
    opacity: 1;
    background: var(--yellow);
    animation: eq 900ms ease-in-out infinite alternate;
  }
  .track.is-playing .track__eq i:nth-child(2) {
    animation-delay: -300ms;
  }
  .track.is-playing .track__eq i:nth-child(3) {
    animation-delay: -600ms;
  }
  .track.is-playing .track__eq i:nth-child(4) {
    animation-delay: -150ms;
  }
  @keyframes eq {
    from {
      height: 4px;
    }
    to {
      height: 26px;
    }
  }
  .track__body {
    grid-column: 1 / -1;
  }
  .track__edit {
    position: absolute;
    right: 54px;
    bottom: 10px;
    display: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 2px solid #39d353;
    border-radius: 50%;
    background: none;
    color: #39d353;
    font-size: 16px;
    cursor: pointer;
  }
  :global(html.dev-mode:not(.dev-preview)) .track__edit {
    display: grid;
  }
  .track-form {
    position: fixed;
    left: 50%;
    top: 50%;
    z-index: 2000;
    display: grid;
    gap: 8px;
    width: min(380px, calc(100vw - 24px));
    padding: 16px;
    border: 2px solid #39d353;
    border-radius: 14px;
    background: #0d1117;
    color: #d6f5d6;
    font: 13px ui-monospace, Consolas, monospace;
    translate: -50% -50%;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.5);
  }
  .track-form[hidden] {
    display: none;
  }
  .track-form input,
  .track-form textarea {
    padding: 8px 10px;
    border: 1px solid #30363d;
    border-radius: 8px;
    background: #010409;
    color: #e6edf3;
    font: inherit;
  }
  .track-form div {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .track-form button {
    padding: 7px 12px;
    border: 1px solid #39d353;
    border-radius: 8px;
    background: #161b22;
    color: #39d353;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .track__del {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 2px solid #d7263d;
    border-radius: 50%;
    background: none;
    color: #d7263d;
    cursor: pointer;
  }
  :global(html.dev-mode:not(.dev-preview)) .track__del {
    display: grid;
  }
  :global(html.dev-mode:not(.dev-preview)) .track__time {
    padding-right: 90px;
  }

  @media (prefers-reduced-motion: reduce) {
    .track.is-playing .track__eq i {
      animation: none;
      height: 18px;
    }
  }
</style>

<script>
  import { commitFiles, getToken } from '../../lib/githubCommit';

  // hashtag filter
  const tagBox = document.querySelector<HTMLElement>('[data-music-tags]');
  tagBox?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-tag]');
    if (!b) return;
    tagBox.querySelectorAll('[data-tag]').forEach((x) => x.classList.toggle('is-on', x === b));
    document.querySelectorAll('.plcard').forEach((x) => x.classList.remove('is-on'));
    const tag = b.dataset.tag;
    document.querySelectorAll<HTMLElement>('[data-track]').forEach((tr) => (tr.hidden = !!tag && !(tr.dataset.tags ?? '').split(',').includes(tag)));
  });

  // playlists: every calendar event with music; a click shows its songs and plays them one after the other
  type PlEvent = { id: string; title: string; title_en?: string; country?: string; from: string; color: string; music?: string[] };
  const plBox = document.querySelector<HTMLElement>('[data-music-playlists]');
  const plTpl = (n: string) => document.querySelector<HTMLTemplateElement>(`[data-pl-${n}]`)?.content.textContent ?? '';
  function renderPlaylists(events: PlEvent[]) {
    if (!plBox) return;
    const isHu = plBox.dataset.lang === 'hu';
    const have = new Set(Array.from(document.querySelectorAll<HTMLElement>('[data-track]')).map((tr) => tr.dataset.id));
    const row = plBox.querySelector<HTMLElement>('[data-pl-row]')!;
    const lists = events
      .map((e) => ({ e, ids: (e.music ?? []).filter((id) => have.has(id)) }))
      .filter((x) => x.ids.length)
      .sort((a, b) => b.e.from.localeCompare(a.e.from));
    row.replaceChildren(
      ...lists.map(({ e, ids }) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'plcard';
        b.dataset.pl = e.id;
        b.dataset.ids = ids.join(',');
        b.style.setProperty('--c', e.color);
        if (e.country) {
          const img = document.createElement('img');
          img.src = `/flags/${e.country.toLowerCase()}.svg`;
          img.alt = '';
          b.append(img);
        } else b.append(document.createElement('span'));
        const txt = document.createElement('span');
        const strong = document.createElement('strong');
        strong.textContent = isHu ? e.title : e.title_en || e.title;
        const small = document.createElement('small');
        small.textContent = plTpl('songs').replace('{n}', String(ids.length));
        txt.append(strong, small);
        const play = document.createElement('span');
        play.className = 'plcard__play';
        play.textContent = '▶';
        play.title = plTpl('all');
        b.append(txt, play);
        return b;
      }),
    );
    plBox.hidden = !lists.length;
  }
  plBox?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('.plcard');
    if (!b) return;
    const on = !b.classList.contains('is-on');
    plBox.querySelectorAll('.plcard').forEach((x) => x.classList.toggle('is-on', x === b && on));
    tagBox?.querySelectorAll('[data-tag]').forEach((x) => x.classList.toggle('is-on', !on && (x as HTMLElement).dataset.tag === ''));
    const ids = on ? (b.dataset.ids ?? '').split(',') : null;
    const shown: HTMLElement[] = [];
    document.querySelectorAll<HTMLElement>('[data-track]').forEach((tr) => {
      tr.hidden = !!ids && !ids.includes(tr.dataset.id ?? '');
      if (!tr.hidden) shown.push(tr);
    });
    // in the playlist's order
    if (ids) shown.sort((a, c) => ids.indexOf(a.dataset.id!) - ids.indexOf(c.dataset.id!)).forEach((tr) => tr.parentElement!.append(tr));
    if (on) shown[0]?.querySelector<HTMLButtonElement>('[data-track-play]')?.click();
  });

  /*
   * A copy of the site on another host: the music uploaded on the main site since the copy was made is
   * added (and what was removed there is left out) – read from the main site's /music.json.
   */
  type Track = { id: string; file: string; title: string; artist?: string; about?: string; tags?: string[]; place?: string; date: string };
  const list = document.querySelector<HTMLElement>('[data-music-list]');
  const liveSite = list?.dataset.live;
  const fromMain: Promise<void> = liveSite
    ? fetch(`${liveSite}/music.json`, { cache: 'no-cache' })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then(({ items }: { items: Track[] }) => {
          const ids = new Set(items.map((x) => x.id));
          list!.querySelectorAll<HTMLElement>('[data-track]').forEach((tr) => {
            if (!ids.has(tr.dataset.id ?? '')) tr.remove();
          });
          const have = new Set(Array.from(list!.querySelectorAll<HTMLElement>('[data-track]')).map((tr) => tr.dataset.id));
          const tpl = document.querySelector<HTMLTemplateElement>('[data-track-tpl]')!;
          const fmt = new Intl.DateTimeFormat(document.documentElement.lang || 'hu', { year: 'numeric', month: 'long', day: 'numeric' });
          for (const x of items.filter((y) => !have.has(y.id)).reverse()) {
            const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
            li.dataset.src = liveSite + x.file;
            li.dataset.id = x.id;
            li.dataset.tags = (x.tags ?? []).join(',');
            const set = (sel: string, text: string) => (li.querySelector(sel)!.textContent = text);
            set('.track__title', x.title);
            set('.track__artist', x.artist ?? '');
            set('.track__about', x.about ?? '');
            set('.track__place', x.place ? `📍 ${x.place}` : '');
            set('.track__tags', (x.tags ?? []).map((tg) => `#${tg}`).join(' '));
            set('time', x.date ? ` · ${fmt.format(new Date(x.date))}` : '');
            list!.prepend(li);
            // new hashtags get their own button
            for (const tg of x.tags ?? []) {
              if (tagBox && !tagBox.querySelector(`[data-tag="${CSS.escape(tg)}"]`)) {
                const b = document.createElement('button');
                b.type = 'button';
                b.className = 'tagchip';
                b.dataset.tag = tg;
                b.textContent = `#${tg}`;
                tagBox.append(b);
                tagBox.hidden = false;
              }
            }
          }
          const empty = document.querySelector<HTMLElement>('[data-music-empty]');
          if (empty) empty.hidden = !!list!.querySelector('[data-track]');
        })
        .catch((err) => console.warn('[music] the main site could not be reached', err))
    : Promise.resolve();

  void fromMain.then(async () => {
    startPlayer();
    let events = JSON.parse(document.querySelector('[data-pl-events]')?.textContent || '[]') as PlEvent[];
    if (liveSite)
      events = await fetch(`${liveSite}/calendar.json`, { cache: 'no-cache' })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((d: { events: PlEvent[] }) => d.events.filter((e) => e.music?.length))
        .catch(() => events);
    renderPlaylists(events);
    // ?playlist=<event id> (from the calendar): that playlist starts
    const want = new URLSearchParams(location.search).get('playlist');
    if (want) {
      const card = plBox?.querySelector<HTMLElement>(`[data-pl="${CSS.escape(want)}"]`);
      card?.scrollIntoView({ block: 'center' });
      card?.click();
    }
  });
  function startPlayer() {
  const audio = document.querySelector<HTMLAudioElement>('[data-music-audio]');
  const tracks = Array.from(document.querySelectorAll<HTMLElement>('[data-track]'));
  if (audio && tracks.length) {
    let current: HTMLElement | null = null;
    const clock = (s: number) => (Number.isFinite(s) ? `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}` : '0:00');
    const play = (tr: HTMLElement) => {
      if (current !== tr) {
        current?.classList.remove('is-playing');
        current = tr;
        audio.src = tr.dataset.src!;
      }
      // (a link that opens a playlist cannot start the sound by itself: the browser waits for a click)
      audio.play().catch(() => {});
    };
    tracks.forEach((tr) => {
      tr.querySelector('[data-track-play]')!.addEventListener('click', () => {
        if (current === tr && !audio.paused) audio.pause();
        else play(tr);
      });
      tr.querySelector<HTMLElement>('[data-track-bar]')!.addEventListener('click', (e) => {
        const bar = e.currentTarget as HTMLElement;
        const r = bar.getBoundingClientRect();
        const part = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        if (current !== tr) {
          play(tr);
          audio.addEventListener('loadedmetadata', () => (audio.currentTime = part * audio.duration), { once: true });
        } else if (Number.isFinite(audio.duration)) audio.currentTime = part * audio.duration;
      });
    });
    audio.addEventListener('play', () => current?.classList.add('is-playing'));
    audio.addEventListener('pause', () => current?.classList.remove('is-playing'));
    audio.addEventListener('timeupdate', () => {
      if (!current) return;
      const p = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
      current.querySelector<HTMLElement>('[data-track-fill]')!.style.width = `${p}%`;
      current.querySelector('[data-track-time]')!.textContent = `${clock(audio.currentTime)} / ${clock(audio.duration)}`;
    });
    // one after the other
    audio.addEventListener('ended', () => {
      // the next one that is shown (a hashtag or a playlist: only those), in the list's order
      const order = Array.from(document.querySelectorAll<HTMLElement>('[data-track]')).filter((x) => !x.hidden);
      const next = order[order.indexOf(current!) + 1];
      current?.classList.remove('is-playing');
      if (next) play(next);
    });

    // developer mode: delete a track (the audio file and its description), live after 🚀 Publish
    const tpl = (n: string) => document.querySelector<HTMLTemplateElement>(`[data-music-${n}]`)?.content.textContent ?? '';
    tracks.forEach((tr) =>
      tr.querySelector('[data-track-del]')!.addEventListener('click', async (e) => {
        e.stopPropagation();
        const title = tr.querySelector('.track__title')?.textContent ?? '';
        if (!window.confirm(tpl('confirm').replace('{title}', title))) return;
        let key = getToken();
        if (!key) key = (window.prompt(tpl('needkey')) ?? '').trim();
        if (!key) return;
        try {
          await commitFiles(
            key,
            [
              { path: `public${tr.dataset.src}`, delete: true },
              { path: `src/content/music/${tr.dataset.id}.yml`, delete: true },
            ],
            `Music deleted on the site: ${title}`,
            [`🗑 🎵 ${title}`],
          );
          if (current === tr) audio.pause();
          tr.style.opacity = '0.35';
          tr.querySelector('.track__title')!.textContent = `${title} – ${tpl('deleted')}`;
        } catch (err) {
          window.alert(err instanceof Error ? err.message : String(err));
        }
      }),
    );
  }
  }
</script>

<script>
  /*
   * Developer mode: ✎ on a track rewrites its title, artist, words, hashtags and place
   * (src/content/music/<id>.yml, saved to GitHub; 🚀 Publish puts it online).
   */
  import { commitFiles, getToken } from '../../lib/githubCommit';
  import { geocode } from '../../lib/geocode';

  const form = document.querySelector<HTMLFormElement>('[data-track-form]');
  if (form) {
    const tx = (n: string) => document.querySelector<HTMLTemplateElement>(`[data-music-${n}]`)?.content.textContent ?? '';
    const field = (n: string) => form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-tf="${n}"]`)!;
    const note = form.querySelector<HTMLElement>('[data-tf-note]')!;
    type Meta = { id: string; file: string; title: string; artist?: string; about?: string; tags?: string[]; place?: string; lat?: number; lng?: number; date?: string; post?: string };
    let tr: HTMLElement | null = null;
    let meta: Meta | null = null;
    document.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('[data-track-edit]');
      if (!b) return;
      tr = b.closest<HTMLElement>('[data-track]');
      if (!tr?.dataset.meta) return;
      meta = JSON.parse(tr.dataset.meta) as Meta;
      field('title').value = meta.title;
      field('artist').value = meta.artist ?? '';
      field('about').value = meta.about ?? '';
      field('tags').value = (meta.tags ?? []).map((x) => `#${x}`).join(' ');
      field('place').value = meta.place ?? '';
      note.textContent = '';
      form.hidden = false;
      field('about').focus();
    });
    form.querySelector('[data-tf-cancel]')!.addEventListener('click', () => (form.hidden = true));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!tr || !meta) return;
      const title = field('title').value.trim() || meta.title;
      const artist = field('artist').value.trim();
      const about = field('about').value.trim();
      const tags = field('tags').value.split(/[#,]/).map((x) => x.trim().toLowerCase()).filter(Boolean);
      const place = field('place').value.trim();
      let lat = meta.lat;
      let lng = meta.lng;
      if (place !== (meta.place ?? '')) {
        lat = lng = undefined;
        if (place) {
          const hit = (await geocode(place, document.documentElement.lang || 'en').catch(() => []))[0];
          if (!hit) return void (note.textContent = tx('nogeo'));
          lat = Math.round(hit.latitude * 1e5) / 1e5;
          lng = Math.round(hit.longitude * 1e5) / 1e5;
        }
      }
      const date = meta.date ? String(meta.date).slice(0, 10) : '';
      const yml = [
        `file: ${meta.file}`,
        `title: ${JSON.stringify(title)}`,
        artist && `artist: ${JSON.stringify(artist)}`,
        about && `about: ${JSON.stringify(about)}`,
        date && `date: ${date}`,
        meta.post && `post: ${meta.post}`,
        tags.length && `tags: ${JSON.stringify(tags)}`,
        place && `place: ${JSON.stringify(place)}`,
        lat !== undefined && lng !== undefined && `lat: ${lat}\nlng: ${lng}`,
      ]
        .filter(Boolean)
        .join('\n');
      let key = getToken();
      if (!key) key = (window.prompt(tx('needkey')) ?? '').trim();
      if (!key) return;
      try {
        await commitFiles(key, [{ path: `src/content/music/${meta.id}.yml`, text: `${yml}\n` }], `Music edited on the site: ${title}`, [`✎ 🎵 ${title}`]);
        // show it at once
        const set = (sel: string, text: string) => {
          const el = tr!.querySelector(sel);
          if (el) el.textContent = text;
        };
        set('.track__title', title);
        set('.track__artist', artist);
        set('.track__about', about);
        set('.track__place', place ? `📍 ${place}` : '');
        set('.track__tags', tags.map((x) => `#${x}`).join(' '));
        tr.dataset.meta = JSON.stringify({ ...meta, title, artist, about, tags, place, lat, lng });
        note.textContent = tx('saved');
        window.setTimeout(() => (form.hidden = true), 900);
      } catch (err) {
        note.textContent = err instanceof Error ? err.message : String(err);
      }
    });
  }
</script>

