---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    {
      Object.entries(SYMBOLS).map(([id, body]) => (
        <symbol id={`doodle-${id}`} viewBox={`0 0 ${DOODLE_SIZES[id][0]} ${DOODLE_SIZES[id][1]}`} set:html={body} />
      ))
    }
  </defs>
</svg>

<style is:global>
  /* doodle palette: site ink + theme colours, plus a few natural tones */
  .d-o { fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .d-ink { fill: var(--ink); }
  .d-v, .d-y, .d-w, .d-g, .d-b, .d-s, .d-grey { stroke: var(--ink); stroke-width: 1.3; stroke-linejoin: round; }
  .d-v { fill: var(--violet); }
  .d-y { fill: var(--yellow); }
  .d-w { fill: #ffffff; }
  .d-g { fill: #5fae5a; }
  .d-b { fill: #a9744f; }
  .d-s { fill: #e9c98f; }
  .d-grey { fill: #a3aec0; }
  .d-sea { fill: none; stroke: var(--violet); stroke-width: 1.2; stroke-linecap: round; opacity: 0.7; }
  .d-trunk { fill: none; stroke: #8a5a3b; stroke-width: 3; stroke-linecap: round; }
  .d-bamboo { fill: none; stroke: #5fae5a; stroke-width: 2.2; stroke-linecap: round; }
  .d-ice { fill: #ffffff; stroke: var(--ink); stroke-width: 1.3; stroke-linejoin: round; }
  .d-ice-shade { fill: #cfe8f7; }
  .d-ice-under { fill: #bfe3f7; opacity: 0.6; }
</style>
