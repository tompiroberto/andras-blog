    <path class="d-w" d="M6 20 C6 16 9 15 13 15 H19 L20 6 C20 3 22 2 24 3 L26 4 L25 6 L23 6 L23 16 C24 17 25 19 24 22 C24 24 22 25 20 25 H10 C7 25 6 23 6 20 Z"/>
    <path class="d-v" d="M11 15.2 H18.8 V21 H11 Z"/>
    <path class="d-o" d="M22 3 V0.6 M24.4 3.6 V1.2 M9 25 V36 M12 25 V36 M19 25 V36 M22 25 V36"/>
    <circle class="d-ink" cx="23" cy="4.6" r="0.8"/>`,
  windmill: `
    <path class="d-w" d="M11 42 L13 18 H19 L21 42 Z"/>
    <path class="d-v" d="M15 42 V36 a1 1 0 0 1 2 0 V42 Z"/>
    <path class="d-v" d="M12 18 L16 13 L20 18 Z"/>
    <g class="d-blades">
      <path class="d-y" d="M16 16 L14.5 2 H17.5 Z M16 16 L30 14.5 V17.5 Z M16 16 L17.5 30 H14.5 Z M16 16 L2 17.5 V14.5 Z"/>
