    <path class="d-ink" d="M11 21 H15 V26 H11 Z M25 21 H29 V26 H25 Z M20 11 C18 15 18 19 21 22 H25 C24 18 24 14 26 12 Z"/>
    <circle class="d-ink" cx="28" cy="11" r="1.7"/>
    <circle class="d-ink" cx="32" cy="11.6" r="1.5"/>
    <ellipse class="d-ink" cx="30.6" cy="15.4" rx="1.5" ry="1.1"/>
