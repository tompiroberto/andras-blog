---
/**
 * Little landscape drawings for the background map (see WorldLayer): one <symbol> per kind,
 * drawn in the site's style (ink outlines, theme colours). Each kind's viewBox is its display size in px.
 */
import { DOODLE_SIZES } from '../lib/doodles';

const waves = (w: number, y: number) =>
  `M1 ${y}` + Array.from({ length: Math.floor((w - 2) / 6) }, () => ' q3 -2 6 0').join('');

const camel = (dx: number) => `
  <g transform="translate(${dx} 0)">
    <path class="d-s" d="M7 21 C6 16 9 13 12 14 C14 8 21 8 23 14 C25 15 27 14 29 12 L32 6 C33 4 36 4 37 6 L38 8 L35 9 L33 13 L31 19 C30 21 28 22 25 22 L13 22 C10 22 8 22 7 21 Z"/>
    <path class="d-o" d="M10 22 V33 M14 22 V33 M24 22 V33 M28 21 V33 M7 19 q-3 2 -3 6"/>
    <circle class="d-ink" cx="35" cy="6.5" r="0.9"/>
  </g>`;

const bear = (cls: string) => `
  <path class="${cls}" d="M5 22 C5 14 11 10 20 10 C27 10 31 11 34 12 C35 9 39 9 40 12 C42 13 43 16 41 18 L37 19 C36 21 35 23 35 27 H31 V23 H21 V27 H17 V23 C12 24 9 27 7 27 H5 Z"/>
  <circle class="${cls}" cx="35.5" cy="10.5" r="1.8"/>
  <circle class="d-ink" cx="38" cy="14" r="0.9"/>
  <circle class="d-ink" cx="41.6" cy="16.6" r="1"/>`;

const SYMBOLS: Record<string, string> = {
