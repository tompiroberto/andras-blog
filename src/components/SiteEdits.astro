---
/**
 * Edits made on the page in developer mode (src/data/edits.json, saved by src/components/EditMode.astro):
 * moved / resized / hidden elements, rewritten texts and added subtitles or paragraphs. Applied for every
 * visitor right after the page is parsed, before it is painted.
 *
 * An element is addressed by a path from the nearest stable anchor: ["lay:about", "div:0", "p:1"]
 * (data-lay section, element id, an added element "ed:<id>", or the body), then tag:index steps that
 * ignore the developer-mode helpers (data-dev-ui) and added elements (data-ed-id).
 *   style: { "<page without language>": { "<path>": { x, y, w, h, hidden, color, bg, font, fs, fw, r } } }
 *          – position, size, colours, font, font size / weight, corner radius; same in every language
 *   text:  { "<full path>": { "<path>": "new text" } }                            – per language
 *   add:   { "<full path>": [{ id, after: <path>, tag: "h3" | "p", text } | { id, after, clone: <path> }] }
 *          – added subtitles / paragraphs, or a copy of an element (a new card, a new plan note); per language
 *   theme: { violet, yellow, bg, ink } – the site's colours (not in developer mode, not with a palette theme)
 * A replaced picture is style.src (a file in public/uploads/).
 */
import edits from '../data/edits.json';

/** fonts offered in developer mode (EditMode's font menu) */
const fonts = {"heading": "'Unbounded', system-ui, sans-serif", "body": "'DM Sans', system-ui, sans-serif", "serif": "Georgia, 'Times New Roman', serif", "mono": "ui-monospace, 'Cascadia Code', Consolas, monospace", "hand": "'Segoe Print', 'Comic Sans MS', 'Bradley Hand', cursive", "impact": "Impact, 'Arial Black', sans-serif"};
---

<script is:inline define:vars={{ edits, fonts }}>
  var SKIP = function (e) {
    return e.hasAttribute('data-dev-ui') || e.hasAttribute('data-ed-id') || e.hasAttribute('data-ed-mv');
  };
  function resolve(path) {
    if (!path || !path.length) return null;
    var first = path[0];
    var i = first.indexOf(':');
    var kind = first.slice(0, i);
    var val = first.slice(i + 1);
    var el = null;
    if (kind === 'lay') el = document.querySelector('[data-lay="' + val + '"]');
    else if (kind === 'id') el = document.getElementById(val);
    else if (kind === 'ed') el = document.querySelector('[data-ed-id="' + val + '"]');
    else if (kind === 'body') el = document.body;
    for (var k = 1; k < path.length && el; k++) {
      var p = path[k].split(':');
      var n = Number(p[1]);
      var c = 0;
      var next = null;
      for (var ch = el.firstElementChild; ch; ch = ch.nextElementSibling) {
        if (SKIP(ch) || ch.tagName.toLowerCase() !== p[0]) continue;
        if (c === n) {
          next = ch;
          // a moved element: a hidden stand-in keeps its old place (so the other paths stay the same)
          if (ch.hasAttribute('data-ed-ph')) next = document.querySelector('[data-ed-mv="' + ch.getAttribute('data-ed-ph') + '"]');
          break;
        }
        c++;
      }
      el = next;
    }
    return el;
  }
  function pathOf(el) {
    var steps = [];
    while (el && el !== document.body) {
      if (el.hasAttribute('data-ed-mv')) el = document.querySelector('[data-ed-ph="' + el.getAttribute('data-ed-mv') + '"]') || el;
      if (el.hasAttribute('data-ed-id')) return ['ed:' + el.getAttribute('data-ed-id')].concat(steps);
      if (el.hasAttribute('data-lay')) return ['lay:' + el.getAttribute('data-lay')].concat(steps);
      if (el.id && el.id !== 'main' && document.querySelectorAll('[id="' + el.id + '"]').length === 1) return ['id:' + el.id].concat(steps);
      var tag = el.tagName.toLowerCase();
      var c = 0;
      for (var s = el.previousElementSibling; s; s = s.previousElementSibling) if (!SKIP(s) && s.tagName.toLowerCase() === tag) c++;
      steps.unshift(tag + ':' + c);
      el = el.parentElement;
    }
    return ['body:'].concat(steps);
  }
  function styleEl(el, s) {
    el.style.translate = s.x || s.y ? (s.x || 0) + 'px ' + (s.y || 0) + 'px' : '';
    el.style.width = s.w ? s.w + 'px' : '';
    el.style.maxWidth = s.w ? 'none' : '';
    el.style.flexShrink = s.w ? '0' : '';
    // a set height is the real height (like a PowerPoint box), also inside stretched grid/flex rows
    el.style.height = s.h ? s.h + 'px' : '';
    el.style.minHeight = s.h ? '0' : '';
    el.style.alignSelf = s.h ? 'start' : '';
    el.style.objectFit = s.h && el.tagName === 'IMG' ? 'cover' : '';
    el.style.color = s.color || '';
    el.style.background = s.bg || '';
    el.style.fontFamily = (s.font && fonts[s.font]) || '';
    el.style.fontSize = s.fs ? s.fs + 'px' : '';
    el.style.fontWeight = s.fw || '';
    el.style.borderRadius = s.r !== undefined && s.r !== null ? s.r + 'px' : '';
    if (el.tagName === 'IMG') {
      if (s.src) {
        if (el.dataset.edOrigSrc === undefined) el.dataset.edOrigSrc = el.getAttribute('src') || '';
        el.setAttribute('src', s.src);
        el.removeAttribute('srcset');
        el.removeAttribute('sizes');
        var pic = el.closest('picture');
        if (pic) pic.querySelectorAll('source').forEach(function (x) { x.remove(); });
      } else if (el.dataset.edOrigSrc !== undefined) {
        el.setAttribute('src', el.dataset.edOrigSrc);
      }
    }
    if (s.hidden) el.setAttribute('data-ed-hidden', '');
    else el.removeAttribute('data-ed-hidden');
  }
  /* a copy's own longer story: opens in an info box (src/lib/infobox.ts) when the copy is clicked */
  function story(c, text) {
    var b = c.querySelector('button') || c;
    b.setAttribute('data-info-title', '');
    b.setAttribute('data-info-title-from', 'h3, h2, strong');
    b.setAttribute('data-info-text', text);
    b.removeAttribute('data-info-wired');
    return b;
  }
  function added(a) {
    if (a.clone) {
      var src = resolve(a.clone);
      if (!src) return null;
      var c = src.cloneNode(true);
      [c].concat(Array.from(c.querySelectorAll('*'))).forEach(function (x) {
        x.removeAttribute('id');
        x.removeAttribute('data-ed-id');
        x.removeAttribute('contenteditable');
        x.removeAttribute('data-ed-mv');
        // the original's longer story (info box) does not belong to the copy
        ['data-info-title', 'data-info-text', 'data-info-facts', 'data-info-wired', 'aria-expanded'].forEach(function (k) { x.removeAttribute(k); });
        x.classList.remove('ed-hover');
      });
      c.querySelectorAll('[data-dev-ui], .dev-plus, .lay-bar, [data-ed-ph], .plan-note__hint').forEach(function (x) { x.remove(); });
      c.setAttribute('data-ed-id', a.id);
      if (a.story) story(c, a.story);
      return c;
    }
    var n = document.createElement(a.tag === 'p' ? 'p' : 'h3');
    n.setAttribute('data-ed-id', a.id);
    n.className = 'ed-added ed-added--' + (a.tag === 'p' ? 'p' : 'h3');
    n.textContent = a.text;
    return n;
  }
  /* a new order: {id, path, after | before} – replayed in the order they were made */
  function move(m) {
    var el = resolve(m.path);
    var ref = resolve(m.after || m.before);
    if (!el || !ref || ref === el || el.contains(ref)) return;
    if (!el.hasAttribute('data-ed-id') && !el.hasAttribute('data-ed-mv')) {
      var ph = document.createElement(el.tagName);
      ph.setAttribute('data-ed-ph', m.id);
      ph.setAttribute('aria-hidden', 'true');
      ph.style.display = 'none';
      el.before(ph);
      el.setAttribute('data-ed-mv', m.id);
    }
    if (m.after) ref.after(el);
    else ref.before(el);
  }
  function unmoveAll() {
    document.querySelectorAll('[data-ed-ph]').forEach(function (ph) {
      var el = document.querySelector('[data-ed-mv="' + ph.getAttribute('data-ed-ph') + '"]');
      if (el) {
        ph.replaceWith(el);
        el.removeAttribute('data-ed-mv');
      } else ph.remove();
    });
  }
  var full = location.pathname;
  var page = full.replace(/^\/[a-z]{2}(?=\/)/, '') || '/';
  // the site's own colours (edits.theme): only when no palette theme is chosen and not in developer mode
  var themeStyle = null;
  function applyTheme(t) {
    t = t || {};
    var css = '';
    if (t.violet) css += '--violet:' + t.violet + ';--violet-dark:color-mix(in srgb,' + t.violet + ' 75%,#000);--violet-tint:color-mix(in srgb,' + t.violet + ' 13%,#fff);--globe-line-footer:' + t.violet + ';';
    if (t.yellow) css += '--yellow:' + t.yellow + ';--yellow-tint:color-mix(in srgb,' + t.yellow + ' 28%,#fff);';
    if (t.bg) css += '--bg:' + t.bg + ';';
    if (t.ink) css += '--ink:' + t.ink + ';--muted:color-mix(in srgb,' + t.ink + ' 72%,#fff);';
    if (!themeStyle) {
      themeStyle = document.createElement('style');
      themeStyle.setAttribute('data-ed-theme', '');
      document.head.append(themeStyle);
    }
    themeStyle.textContent = css ? ':root:not(.dev-mode):not([data-theme]){' + css + '}' : '';
  }
  function apply() {
    applyTheme(edits.theme);
    (edits.add[full] || []).forEach(function (a) {
      var ref = resolve(a.after);
      if (ref && !document.querySelector('[data-ed-id="' + a.id + '"]')) {
        var n = added(a);
        if (n) ref.after(n);
      }
    });
    ((edits.move || {})[full] || []).forEach(move);
    var texts = edits.text[full] || {};
    Object.keys(texts).forEach(function (k) {
      var el = resolve(JSON.parse(k));
      if (el) el.textContent = texts[k];
    });
    var styles = edits.style[page] || {};
    Object.keys(styles).forEach(function (k) {
      var el = resolve(JSON.parse(k));
      if (el) styleEl(el, styles[k]);
    });
  }
  window.__siteEdits = { data: edits, resolve: resolve, pathOf: pathOf, styleEl: styleEl, added: added, story: story, move: move, unmoveAll: unmoveAll, applyTheme: applyTheme, page: page, full: full };
  try {
    apply();
  } catch (e) {
    console.warn('[site edits]', e);
  }
</script>
