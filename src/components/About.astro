---
import Globe from './Globe.astro';
import Icon from './Icon.astro';
import IconCircle from './IconCircle.astro';
import SectionHeading from './SectionHeading.astro';
import StatRing from './StatRing.astro';
import { t, type Lang, type TKey } from '../i18n';
import site from '../data/site.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// "Work experience: …" -> bold lead-in before the first colon
const work = t(lang, 'about.work');
const colon = work.indexOf(':');
const workLead = colon > 0 ? work.slice(0, colon + 1) : '';
const workRest = colon > 0 ? work.slice(colon + 1) : work;
---

<section class="section about" id="about" data-lay="about" aria-labelledby="about-title">
  <div class="bg-layer">
    <Globe size="min(760px, 110vw)" left="-22%" top="8%" speed={85} direction="ccw" dots={false} />
  </div>
  <div class="container about__grid">
    <div class="about__text reveal">
      <SectionHeading icon="user" id="about-title">{t(lang, 'about.title')}</SectionHeading>
      <p>{t(lang, 'about.text')}</p>
      <p>{workLead && <strong>{workLead}</strong>}{workRest}</p>

      <div class="lang-stories">
        <ul class="chips" aria-label={t(lang, 'icon.languages')}>
          {
            site.languages.map((l) => (
              <li>
                <button
                  type="button"
                  class:list={['chip', 'chip--btn', l.level === 'solid' ? 'chip--solid' : 'chip--learning']}
                  data-info-title={t(lang, l.key as TKey)}
                  data-info-text={t(lang, `story.${l.key}` as TKey)}
                >
                  <Icon name={l.level === 'solid' ? 'check' : 'pencil'} size={16} />
                  {t(lang, l.key as TKey)}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="about__side reveal">
      <figure class="portrait">
        <div class="portrait__frame">
          <picture>
            <source srcset="/images/andras-520.webp 520w, /images/andras.webp 800w" sizes="260px" type="image/webp" />
            <img
              src="/images/andras.jpg"
              alt={t(lang, 'about.photoAlt')}
              width="260"
              height="260"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <span class="portrait__tri" aria-hidden="true"></span>
        </div>
        <figcaption>{t(lang, 'about.photoCaption')}</figcaption>
      </figure>

      <div class="rings">
        {
          site.personalBests.map((pb, i) => (
            <button
              type="button"
              class="ring-btn"
              data-info-title={`${pb.distance} · ${pb.time}`}
              data-info-text={t(lang, `pb.${pb.id}.text` as TKey)}
              data-info-facts={t(lang, `pb.${pb.id}.facts` as TKey)}
              data-info-icon=".stat-ring__content svg"
            >
              <StatRing distance={pb.distance} time={pb.time} fill={pb.ringFill} label={t(lang, 'stats.pb')} tone={i % 2 ? 'violet' : 'yellow'} />
            </button>
          ))
        }
      </div>

      <ul class="badges">
        {
          site.raceBadges.map((b) => (
            <li>
              <button
                type="button"
                class="pill badge badge--btn"
                data-info-title={t(lang, `race.${b.id}` as TKey)}
                data-info-text={t(lang, `race.${b.id}.text` as TKey)}
                data-info-facts={t(lang, `race.${b.id}.facts` as TKey)}
              >
                <IconCircle icon={b.icon} variant={b.icon === 'trophy' ? 'yellow' : 'violet'} size="nav" />
                {t(lang, `race.${b.id}` as TKey)}
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  .about__text p {
    max-width: 60ch;
  }
  .chips,
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: var(--fs-small);
    line-height: 1.3;
  }
  .chip--btn {
    font-family: inherit;
    color: inherit;
    cursor: pointer;
    transition: transform var(--t-fast), box-shadow var(--t-fast);
  }
  .chip--btn:hover,
  .chip--btn:focus-visible,
  .chip--btn[aria-expanded='true'] {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .lang-stories {
    position: relative;
  }
  .chip--solid {
    background: var(--yellow);
    border: var(--border);
  }
  .chip--learning {
    background: var(--violet-tint);
    border: 2px dashed var(--violet);
    color: var(--violet-dark);
  }

  .about__side {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .portrait {
    margin: 0 0 32px;
    text-align: center;
  }
  .portrait__frame {
    position: relative;
    width: 260px;
    height: 260px;
    max-width: 70vw;
    max-height: 70vw;
    margin-inline: auto;
    border-radius: 50%;
    /* ink outline, 6px yellow ring, ink outline */
    box-shadow:
      0 0 0 2px var(--ink),
      0 0 0 8px var(--yellow),
      0 0 0 10px var(--ink);
  }
  .portrait__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .portrait__tri {
    position: absolute;
    right: -2px;
    bottom: 6px;
    width: 46px;
    height: 42px;
    background: var(--ink);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    transform: rotate(18deg);
  }
  .portrait__tri::after {
    content: '';
    position: absolute;
    inset: 4px 4px 2px;
    background: var(--violet);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .portrait figcaption {
    margin-top: 22px;
    font-style: italic;
    color: var(--muted);
  }
  .rings {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    width: 100%;
  }
  .rings > :global(*) {
    /* the rings are counter-zoomed themselves, so this is already in their own (constant) px */
    flex: 0 1 250px;
  }
  @media (max-width: 599px) {
    .rings {
      gap: 16px;
    }
    .rings > :global(*) {
      flex-basis: calc(50% - 8px);
    }
  }
  .badges {
    justify-content: center;
    margin-top: 28px;
  }
  .badges {
    position: relative;
  }
  /* the record rings open their story */
  .ring-btn {
    display: block;
    flex: 0 1 250px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: transform var(--t-med) cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ring-btn:hover,
  .ring-btn:focus-visible,
  .ring-btn[aria-expanded='true'] {
    transform: scale(1.05) rotate(-2deg);
  }
  /* horizontal page: text and photo side by side, the three record rings in one row (less tall) */
  :global(:root.horizontal) .about__grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    align-items: center;
  }
  :global(:root.horizontal) .about__side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  /* a smaller photo, so the record rings get a full row of their own under it */
  :global(:root.horizontal) .portrait {
    margin: 0;
    max-width: 230px;
  }
  :global(:root.horizontal) .rings {
    flex-wrap: nowrap;
    justify-content: center;
    gap: 22px;
  }
  :global(:root.horizontal) .rings > :global(*) {
    /* the rings size themselves to their box (container query), so the box needs a real width */
    flex: 0 0 clamp(150px, 15vw, 200px);
  }
  :global(:root.horizontal) .badges {
    grid-column: 1 / -1;
    margin-top: 8px;
  }
  .badge {
    padding: 4px 16px 4px 4px;
    gap: 10px;
  }
  .badge--btn {
    font: inherit;
    font-weight: 700;
    color: inherit;
    cursor: pointer;
    transition: transform var(--t-fast), box-shadow var(--t-fast);
  }
  .badge--btn:hover,
  .badge--btn:focus-visible,
  .badge--btn[aria-expanded='true'] {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--ink);
  }
  @media (max-width: 899px) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { wireInfoBoxes } from '../lib/infobox';

  wireInfoBoxes(document.querySelector('.about') ?? document);
</script>
