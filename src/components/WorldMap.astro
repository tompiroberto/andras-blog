---
/**
 * "Where I've been" world map. The TopoJSON (public/data/countries-50m.json) and the d3 modules
 * are only loaded when the section approaches the viewport.
 */
import Icon from './Icon.astro';
import { t, type Lang, type TKey } from '../i18n';
import countriesData from '../data/countries.json';
import type { MapCountry, MapStatus as Status } from '../lib/map';

interface Props {
  lang: Lang;
  /** Slugs of published posts, so tooltip links never point at a missing page */
  publishedSlugs: string[];
  /** the page already has the title (the map page) */
  hideTitle?: boolean;
}

const { lang, publishedSlugs, hideTitle = false } = Astro.props;


const STATUSES: { status: Status; key: TKey; icon: string }[] = [
  { status: 'visited', key: 'legend.visited', icon: 'circle-check' },
  { status: 'transit', key: 'legend.transit', icon: 'train-front' },
  { status: 'now', key: 'legend.now', icon: 'map-pin' },
  { status: 'home', key: 'legend.home', icon: 'house' },
  { status: 'planned', key: 'legend.planned', icon: 'calendar-clock' },
];

const mapCountries: MapCountry[] = [];
for (const c of countriesData.countries) {
  if (!c.isoNumeric) {
    // TODO(content): list the actual countries visited in North-West Europe in summer 2017
    if (lang === 'en') console.warn(`[map] TODO: "${c.id}" has no isoNumeric yet – skipped on the map.`);
    continue;
  }
  const text = c.i18n[lang as keyof typeof c.i18n] ?? c.i18n.en;
  const rawLink = 'link' in c && c.link ? (c.link as { url: string }).url : undefined;
  const slug = rawLink?.match(/\/posts\/([^/]+)\//)?.[1];
  mapCountries.push({
    iso: c.isoNumeric,
    status: c.status as Status,
    name: text.name,
    text: text.text,
    link: rawLink && slug && publishedSlugs.includes(slug) ? rawLink.replace('{lang}', lang) : undefined,
  });
}

const labels = {
  zoomIn: t(lang, 'map.zoomIn'),
  zoomOut: t(lang, 'map.zoomOut'),
  reset: t(lang, 'map.reset'),
  readMore: t(lang, 'posts.readMore'),
};
---

<div class="map-section explore-map" id="map" aria-labelledby="map-title" data-map-wrap>
  <div>
    <h3 class:list={['explore-map__title', { 'visually-hidden': hideTitle }]} id="map-title"><Icon name="map-pin" size={26} />{t(lang, 'map.title')}</h3>
    <p class="map-hint">
      <span class="map-hint--hover">{t(lang, 'map.hint')}</span>
      <span class="map-hint--touch">{t(lang, 'map.hintTouch')}</span>
    </p>

    <ul class="map-legend">
      {
        STATUSES.map((s) => (
          <li>
            <span class:list={['swatch', `swatch--${s.status}`]} aria-hidden="true" />
            {t(lang, s.key)}
          </li>
        ))
      }
    </ul>

    <div class="map-panel reveal" data-map data-lang={lang}>
      <div class="map-canvas" data-map-canvas>
        <!-- The map only loads when the visitor asks for it -->
        <button type="button" class="map-reveal" data-map-reveal aria-label={t(lang, 'map.show')} title={t(lang, 'map.show')}>
          <span class="map-reveal__icon" aria-hidden="true"><Icon name="map" size={38} /></span>
        </button>
        <div class="map-loading" data-map-loading hidden>
          <span class="map-loading__dot" aria-hidden="true"></span>
        </div>
      </div>

      <div class="map-controls" hidden data-map-controls>
        <button type="button" class="map-btn" data-zoom="in" aria-label={labels.zoomIn} title={labels.zoomIn}>
          <Icon name="plus" size={20} />
        </button>
        <button type="button" class="map-btn" data-zoom="out" aria-label={labels.zoomOut} title={labels.zoomOut}>
          <Icon name="minus" size={20} />
        </button>
        <button type="button" class="map-btn" data-zoom="reset" aria-label={labels.reset} title={labels.reset}>
          <Icon name="rotate-ccw" size={20} />
        </button>
      </div>

      <div class="map-tip" data-map-tip hidden>
        <div class="map-tip__head">
          <span class="map-tip__icon" data-tip-icon></span>
          <strong class="map-tip__name" data-tip-name></strong>
        </div>
        <p class="map-tip__text" data-tip-text></p>
        <a class="map-tip__link link-arrow" data-tip-link hidden>{labels.readMore}</a>
      </div>

      {
        STATUSES.map((s) => (
          <template data-status-icon={s.status}>
            <Icon name={s.icon} size={18} />
          </template>
        ))
      }
      <template data-house-icon>
        <Icon name="house" size={14} />
      </template>
    </div>
  </div>
  <script type="application/json" data-map-countries set:html={JSON.stringify(mapCountries)} />
</div>

<style>
  .explore-map {
    margin-top: clamp(40px, 6vw, 72px);
    scroll-margin-top: calc((var(--header-h) + 16px) * var(--tz));
  }
  .explore-map__title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 12px;
    font-size: clamp(24px, 3vw, 34px);
  }
  .explore-map__title :global(svg) {
    color: var(--violet);
  }
  .map-hint {
    color: var(--muted);
    margin-bottom: 12px;
  }
  .map-hint--touch {
    display: none;
  }
  @media (hover: none) {
    .map-hint--hover {
      display: none;
    }
    .map-hint--touch {
      display: inline;
    }
  }
  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .map-legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .swatch {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid var(--ink);
    flex: none;
  }
  .swatch--visited {
    background: var(--yellow);
  }
  .swatch--transit {
    background: var(--surface);
    border: 2px dashed var(--violet);
  }
  .swatch--now {
    background: var(--violet);
    border-radius: 50%;
  }
  .swatch--home {
    background: var(--ink);
    border-color: var(--yellow);
    box-shadow: 0 0 0 1.5px var(--ink);
  }
  .swatch--planned {
    background: repeating-linear-gradient(45deg, var(--violet) 0 2px, var(--violet-tint) 2px 6px);
  }

  .map-panel {
    position: relative;
    background-color: var(--surface);
    background-image: radial-gradient(var(--globe-line) 1.2px, transparent 1.4px);
    background-size: 18px 18px;
    border: var(--border);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-violet);
    overflow: hidden;
  }
  .map-canvas {
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 280px;
  }
  .map-canvas :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }
  .map-canvas :global(svg:active) {
    cursor: grabbing;
  }
  @media (max-width: 599px) {
    .map-canvas {
      aspect-ratio: 1;
    }
  }
  .map-reveal {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    border: 0;
    /* just the map icon until the visitor asks for the map */
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .map-reveal__icon {
    display: grid;
    place-items: center;
    width: calc(var(--icon-lg) * 1.3);
    height: calc(var(--icon-lg) * 1.3);
    border-radius: 50%;
    background: var(--violet);
    color: #fff;
    border: var(--border);
    box-shadow: 4px 4px 0 var(--ink);
    transition: transform var(--t-med) var(--ease);
  }
  .map-reveal:hover .map-reveal__icon,
  .map-reveal:focus-visible .map-reveal__icon {
    transform: scale(1.1) rotate(-6deg);
  }
  .map-reveal:focus-visible {
    outline-offset: -6px;
  }
  .map-canvas.is-revealed :global(svg) {
    animation: map-reveal-in 600ms var(--ease) both;
  }
  @keyframes map-reveal-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  .map-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .map-loading__dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--violet);
    animation: pulse 1.2s ease-out infinite;
  }

  /* --- Countries --- */
  .map-canvas :global(.land) {
    fill: var(--land);
    stroke: #fff;
    stroke-width: 0.5;
    vector-effect: non-scaling-stroke;
  }
  .map-canvas :global(.c-visited) {
    fill: var(--yellow);
    stroke: var(--ink);
    stroke-width: 1;
  }
  .map-canvas :global(.c-transit) {
    fill: var(--surface);
    stroke: var(--violet);
    stroke-width: 1.4;
    stroke-dasharray: 3 2;
  }
  .map-canvas :global(.c-now) {
    fill: var(--violet);
    stroke: var(--ink);
    stroke-width: 1;
  }
  .map-canvas :global(.c-home) {
    fill: var(--ink);
    stroke: var(--yellow);
    stroke-width: 1.5;
  }
  .map-canvas :global(.c-planned) {
    fill: url(#map-hatch);
    stroke: var(--violet-dark);
    stroke-width: 1;
  }
  .map-canvas :global(.is-data) {
    cursor: pointer;
    outline: none;
  }
  .map-canvas :global(.is-data.is-hover),
  .map-canvas :global(.is-data:focus-visible) {
    stroke: var(--ink);
    stroke-width: 3;
    stroke-dasharray: none;
  }
  .map-canvas :global(.c-home.is-hover),
  .map-canvas :global(.c-home:focus-visible) {
    stroke: var(--violet);
  }
  .map-canvas :global(.marker) {
    pointer-events: none;
  }
  .map-canvas :global(.marker-pulse) {
    fill: var(--violet);
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse var(--pulse-duration) ease-out infinite;
  }
  .map-canvas :global(.marker-core) {
    fill: var(--violet);
    stroke: #fff;
    stroke-width: 2;
  }
  .map-canvas :global(.marker-home) {
    fill: var(--yellow);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .map-controls {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .map-btn {
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    border: var(--border);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 3px 3px 0 var(--ink);
    cursor: pointer;
  }
  .map-btn:hover {
    background: var(--yellow);
  }

  .map-tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: var(--z-tooltip);
    max-width: min(300px, calc(100% - 24px));
    padding: 14px 16px;
    background: var(--ink);
    color: #fff;
    border-radius: 16px;
    box-shadow: 5px 5px 0 var(--yellow);
    pointer-events: none;
    font-size: var(--fs-small);
    line-height: 1.4;
  }
  .map-tip.is-pinned {
    pointer-events: auto;
  }
  .map-tip__head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .map-tip__icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
  }
  .map-tip__name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--yellow);
    font-size: 17px;
    line-height: 1.2;
  }
  .map-tip__text {
    margin: 0;
  }
  .map-tip__link {
    color: var(--yellow);
    min-height: 32px;
    margin-top: 4px;
  }
  .map-tip__link:focus-visible {
    outline-color: var(--yellow);
  }
</style>

<script>
  import type { MapCountry } from '../lib/map';
  import { REDUCED_MOTION_QUERY } from '../lib/constants';
  import { pageZoom, textZoom } from '../lib/zoom';

  const panel = document.querySelector<HTMLElement>('[data-map]');
  const section = panel?.closest<HTMLElement>('[data-map-wrap]') ?? panel?.closest('section');
  if (panel && section) {
    // The map is only loaded (d3 + 750 KB of map data) when the visitor clicks "Show the map"
    const reveal = panel.querySelector<HTMLButtonElement>('[data-map-reveal]');
    const loading = panel.querySelector<HTMLElement>('[data-map-loading]');
    reveal?.addEventListener('click', () => {
      reveal.remove();
      if (loading) loading.hidden = false;
      initMap(panel, section)
        .then(() => {
          panel.querySelector<HTMLElement>('[data-map-canvas]')?.classList.add('is-revealed');
          panel.querySelector<HTMLElement>('[data-map-controls]')!.hidden = false;
          // keep keyboard users in place: continue on the map itself
          panel.querySelector<SVGSVGElement>('[data-map-canvas] svg')?.focus({ preventScroll: true });
        })
        .catch((err) => console.error('[map] failed to load', err));
    });
  }

  async function initMap(panel: HTMLElement, section: HTMLElement) {
    const [geo, z, sel, topo, world] = await Promise.all([
      import('d3-geo'),
      import('d3-zoom'),
      import('d3-selection'),
      import('topojson-client'),
      fetch('/data/countries-50m.json').then((r) => r.json()),
    ]);

    const SVG_NS = 'http://www.w3.org/2000/svg';
    const canvas = panel.querySelector<HTMLElement>('[data-map-canvas]')!;
    const tip = panel.querySelector<HTMLElement>('[data-map-tip]')!;
    const tipIcon = tip.querySelector<HTMLElement>('[data-tip-icon]')!;
    const tipName = tip.querySelector<HTMLElement>('[data-tip-name]')!;
    const tipText = tip.querySelector<HTMLElement>('[data-tip-text]')!;
    const tipLink = tip.querySelector<HTMLAnchorElement>('[data-tip-link]')!;
    const data: MapCountry[] = JSON.parse(section.querySelector('[data-map-countries]')!.textContent || '[]');
    const byIso = new Map(data.map((c) => [c.iso, c]));
    let hovered: SVGPathElement | null = null;
    const statusIcon = (s: string) =>
      panel.querySelector<HTMLTemplateElement>(`template[data-status-icon="${s}"]`)!.innerHTML;

    // Size the drawing to the panel's aspect ratio so it is never letter-boxed
    const W = 960;
    const H = Math.round((W * canvas.clientHeight) / Math.max(1, canvas.clientWidth));

    const countries = topo.feature(world, world.objects.countries) as unknown as GeoJSON.FeatureCollection<GeoJSON.Geometry, { name: string }>;
    const projection = geo.geoEqualEarth().fitExtent(
      [
        [8, 8],
        [W - 8, H - 8],
      ],
      { type: 'Sphere' },
    );
    const path = geo.geoPath(projection);

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('role', 'group');
    svg.setAttribute('tabindex', '-1');
    svg.setAttribute('aria-labelledby', 'map-title');
    svg.innerHTML = `
      <defs>
        <pattern id="map-hatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
          <rect width="6" height="6" style="fill:var(--violet-tint)"/>
          <line x1="0" y1="0" x2="0" y2="6" stroke-width="3" style="stroke:var(--violet)"/>
        </pattern>
      </defs>`;
    const g = document.createElementNS(SVG_NS, 'g');
    const markers = document.createElementNS(SVG_NS, 'g');
    svg.append(g, markers);

    const dataPaths: SVGPathElement[] = [];
    for (const f of countries.features) {
      const d = path(f);
      if (!d) continue;
      const el = document.createElementNS(SVG_NS, 'path');
      el.setAttribute('d', d);
      el.classList.add('land');
      const info = byIso.get(String(f.id));
      if (info) {
        el.classList.add('is-data', `c-${info.status}`);
        el.setAttribute('tabindex', '0');
        el.setAttribute('role', 'button');
        el.setAttribute('aria-label', `${info.name}: ${info.text}`);
        el.dataset.iso = info.iso;
        dataPaths.push(el);
      }
      g.append(el);
    }
    // Data countries on top, so their outlines are not covered by neighbours
    dataPaths.forEach((el) => g.append(el));

    // Markers keep a constant on-screen size while zooming
    const markerEls: { el: SVGGElement; x: number; y: number }[] = [];
    const addMarker = (iso: string, html: string) => {
      const f = countries.features.find((c) => String(c.id) === iso);
      if (!f) return;
      const [x, y] = path.centroid(f);
      const m = document.createElementNS(SVG_NS, 'g');
      m.classList.add('marker');
      m.innerHTML = html;
      markers.append(m);
      markerEls.push({ el: m, x, y });
    };
    const houseSvg = panel.querySelector<HTMLTemplateElement>('template[data-house-icon]')!.innerHTML;
    for (const c of data) {
      if (c.status === 'now') {
        addMarker(c.iso, '<circle r="7" class="marker-pulse"/><circle r="5" class="marker-core"/>');
      } else if (c.status === 'home') {
        addMarker(
          c.iso,
          `<circle r="10" class="marker-home"/><g transform="translate(-7 -7)" style="color:var(--ink)">${houseSvg}</g>`,
        );
      }
    }

    canvas.querySelector('[data-map-loading]')?.remove();
    canvas.append(svg);

    // ---- Zoom & pan ----
    const reduced = window.matchMedia(REDUCED_MOTION_QUERY);
    const zoom = z
      .zoom<SVGSVGElement, unknown>()
      .scaleExtent([1, 48])
      .translateExtent([
        [0, 0],
        [W, H],
      ])
      .on('zoom', (event: { transform: { k: number; x: number; y: number; toString(): string } }) => {
        const t = event.transform;
        g.setAttribute('transform', t.toString());
        for (const m of markerEls) {
          m.el.setAttribute('transform', `translate(${t.x + m.x * t.k} ${t.y + m.y * t.k})`);
        }
        hideTip();
      });
    const svgSel = sel.select(svg as SVGSVGElement);
    svgSel.call(zoom);

    // Initial view: Europe, so small countries such as Slovenia are easy to hit
    const europe = {
      type: 'Feature',
      properties: {},
      geometry: {
        type: 'Polygon',
        coordinates: [
          [
            [-11, 35],
            [-11, 60],
            [40, 60],
            [40, 35],
            [-11, 35],
          ],
        ],
      },
    } as GeoJSON.Feature;
    const [[x0, y0], [x1, y1]] = path.bounds(europe);
    const europeK = Math.min(W / (x1 - x0), H / (y1 - y0));
    const home = z.zoomIdentity
      .translate(W / 2, H / 2)
      .scale(europeK)
      .translate(-(x0 + x1) / 2, -(y0 + y1) / 2);

    const animateTo = (target: typeof home) => {
      if (reduced.matches) return zoom.transform(svgSel, target);
      const from = z.zoomTransform(svg);
      const t0 = performance.now();
      const D = 300;
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / D);
        const e = 1 - Math.pow(1 - p, 3);
        const kk = from.k + (target.k - from.k) * e;
        const tx = from.x + (target.x - from.x) * e;
        const ty = from.y + (target.y - from.y) * e;
        zoom.transform(svgSel, z.zoomIdentity.translate(tx, ty).scale(kk));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    zoom.transform(svgSel, home);

    panel.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const mode = btn.dataset.zoom;
        if (mode === 'reset') return animateTo(home);
        const factor = mode === 'in' ? 1.6 : 1 / 1.6;
        const cur = z.zoomTransform(svg);
        const nk = Math.min(48, Math.max(1, cur.k * factor));
        // zoom around the centre of the view
        const cx = (W / 2 - cur.x) / cur.k;
        const cy = (H / 2 - cur.y) / cur.k;
        const target = z.zoomIdentity.translate(W / 2 - cx * nk, H / 2 - cy * nk).scale(nk);
        animateTo(zoom.constrain()(target, [[0, 0], [W, H]], [[0, 0], [W, H]]));
      }),
    );

    // ---- Tooltip ----
    function fillTip(info: MapCountry) {
      tipIcon.innerHTML = statusIcon(info.status);
      tipName.textContent = info.name;
      tipText.textContent = info.text;
      if (info.link) {
        tipLink.href = info.link;
        tipLink.hidden = false;
      } else tipLink.hidden = true;
    }
    function placeTip(clientX: number, clientY: number) {
      // screen values are zoomed; the tooltip is positioned in CSS px (see src/lib/zoom.ts)
      const z = pageZoom();
      const b = panel.getBoundingClientRect();
      const r = { left: b.left / z, top: b.top / z, width: b.width / z, height: b.height / z };
      clientX /= z;
      clientY /= z;
      tip.hidden = false;
      // the tooltip is counter-zoomed: its own sizes are in its own (larger) CSS px
      const tz = textZoom();
      const w = tip.offsetWidth * tz;
      const h = tip.offsetHeight * tz;
      let x = clientX - r.left + 16;
      let y = clientY - r.top + 16;
      if (x + w > r.width - 8) x = clientX - r.left - w - 16;
      if (y + h > r.height - 8) y = clientY - r.top - h - 16;
      tip.style.transform = `translate(${Math.max(8, x) / tz}px, ${Math.max(8, y) / tz}px)`;
    }
    function highlight(el: SVGPathElement | null) {
      if (hovered && hovered !== el) hovered.classList.remove('is-hover');
      hovered = el;
      el?.classList.add('is-hover');
    }
    function hideTip() {
      tip.hidden = true;
      tip.classList.remove('is-pinned');
      highlight(null);
    }
    const infoFor = (el: Element | null) => {
      const p = el?.closest<SVGPathElement>('path.is-data');
      return p ? { el: p, info: byIso.get(p.dataset.iso!)! } : null;
    };

    svg.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || e.buttons) return;
      const hit = infoFor(e.target as Element);
      if (!hit) {
        if (!tip.classList.contains('is-pinned')) hideTip();
        return;
      }
      if (hovered !== hit.el) {
        fillTip(hit.info);
        highlight(hit.el);
      }
      tip.classList.remove('is-pinned');
      placeTip(e.clientX, e.clientY);
    });
    svg.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && !tip.classList.contains('is-pinned')) hideTip();
    });
    svg.addEventListener('click', (e) => {
      const hit = infoFor(e.target as Element);
      if (!hit) return hideTip();
      const isMouse = (e as PointerEvent).pointerType === 'mouse';
      if (isMouse && hit.info.link) {
        window.location.href = hit.info.link;
        return;
      }
      // touch / pen: tap shows a pinned tooltip (its link can then be tapped)
      fillTip(hit.info);
      highlight(hit.el);
      tip.classList.add('is-pinned');
      placeTip(e.clientX, e.clientY);
    });

    // Keyboard: focus shows the tooltip next to the country
    for (const el of dataPaths) {
      el.addEventListener('focus', () => {
        const info = byIso.get(el.dataset.iso!)!;
        fillTip(info);
        highlight(el);
        const b = el.getBoundingClientRect();
        const r = panel.getBoundingClientRect();
        const cx = Math.min(Math.max(b.left + b.width / 2, r.left + 8), r.right - 8);
        const cy = Math.min(Math.max(b.top + b.height / 2, r.top + 8), r.bottom - 8);
        placeTip(cx, cy);
      });
      el.addEventListener('blur', () => {
        if (!tip.contains(document.activeElement)) hideTip();
      });
      el.addEventListener('keydown', (e) => {
        const info = byIso.get(el.dataset.iso!)!;
        if ((e.key === 'Enter' || e.key === ' ') && info.link) {
          e.preventDefault();
          window.location.href = info.link;
        }
      });
    }
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideTip();
    });
  }
</script>
