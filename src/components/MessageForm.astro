---
import Globe from './Globe.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import site from '../data/site.json';
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const LIMITS = { name: 80, contact: 120, message: 1000 };
const TOPICS = [
  { id: 'idea', icon: 'lightbulb' },
  { id: 'join', icon: 'users' },
  { id: 'work', icon: 'briefcase' },
] as const;
---

<section class="section message" id="message" data-lay="message" aria-labelledby="message-title">
  <div class="bg-layer">
    <Globe size="min(720px, 110vw)" left="-20%" top="4%" speed={75} direction="ccw" />
  </div>
  <div class="container message__grid">
    <div class="message__art" aria-hidden="true">
      <div class="message__bulb">
        <Icon name="lightbulb" size={96} />
      </div>
      <svg class="shape float message__tri message__tri--1" viewBox="0 0 60 60"><path d="M8 52 L30 8 L52 52 Z" /></svg>
      <svg class="shape float float--slow message__tri message__tri--2" viewBox="0 0 60 60"><path d="M8 52 L30 8 L52 52 Z" /></svg>
      <span class="shape float float--fast message__spark"><Icon name="sparkles" size={34} /></span>
    </div>

    <div class="card message__card reveal">
      <SectionHeading icon="send" id="message-title">{t(lang, 'msg.title')}</SectionHeading>
      <p class="message__lead">{t(lang, 'msg.lead')}</p>

      <form
        name="message"
        method="POST"
        action={localePath(lang)}
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
        data-message-form
        data-email={site.email}
        data-subject={t(lang, 'msg.subject')}
        data-msg-mode={site.messageMode}
        data-provider={site.formProvider}
      >
        <input type="hidden" name="form-name" value="message" />
        <input type="hidden" name="lang" value={lang} />
        <p class="hp" aria-hidden="true">
          <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <p class="mail-hint">{t(lang, 'msg.pick')}</p>
        <fieldset class="topics">
          <legend class="visually-hidden">{t(lang, 'pm.topic')}</legend>
          {
            TOPICS.map((tp, i) => (
              <label class="topic">
                <input type="radio" name="topic" value={tp.id} checked={i === 0} data-label={t(lang, `msg.topic.${tp.id}`)} data-start={t(lang, `msg.start.${tp.id}`)} />
                <span>
                  <Icon name={tp.icon} size={18} />
                  {t(lang, `msg.topic.${tp.id}`)}
                </span>
              </label>
            ))
          }
        </fieldset>

        <div class="field">
          <label for="msg-name">{t(lang, 'msg.name')} <span aria-hidden="true">*</span></label>
          <input id="msg-name" name="name" type="text" required maxlength={LIMITS.name} autocomplete="name" />
        </div>

        <div class="field">
          <label for="msg-contact">{t(lang, 'msg.contact')}</label>
          <input id="msg-contact" name="contact" type="text" maxlength={LIMITS.contact} autocomplete="email" />
        </div>

        <div class="field">
          <label for="msg-message">{t(lang, 'msg.message')} <span aria-hidden="true">*</span></label>
          <textarea
            id="msg-message"
            name="message"
            required
            rows="6"
            maxlength={LIMITS.message}
            placeholder={t(lang, 'msg.placeholder')}
            aria-describedby="msg-counter"
          ></textarea>
          <span class="counter" id="msg-counter" data-counter data-max={LIMITS.message}>0 / {LIMITS.message}</span>
        </div>

        <div class="status" role="status" aria-live="polite" data-status></div>

        <button type="submit" class="btn btn--primary submit" data-submit>
          <span class="submit__idle"><Icon name="send" size={20} />{t(lang, 'msg.send')}</span>
          <span class="submit__busy"><Icon name="loader-circle" size={20} class="spin" />{t(lang, 'msg.sending')}</span>
        </button>

        <p class="direct">
          {t(lang, 'msg.direct')} <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="privacy-note">
          {t(lang, 'msg.privacy')}
          <a href={localePath(lang, 'privacy')}>{t(lang, 'footer.privacy')}</a>
        </p>
      </form>

      <div class="success" hidden data-success tabindex="-1">
        <span class="success__icon"><Icon name="circle-check" size={40} /></span>
        <p>{t(lang, 'msg.success')}</p>
      </div>

      <template data-msg-required>{t(lang, 'msg.required')}</template>
      <template data-msg-error>{t(lang, 'msg.error')}</template>
    </div>
  </div>
</section>

<style>
  .message__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .message__art {
    position: relative;
    aspect-ratio: 1;
    max-width: 400px;
    width: 100%;
    justify-self: center;
  }
  .message__bulb {
    position: absolute;
    inset: 12%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--yellow);
    border: 3px solid var(--ink);
    box-shadow: var(--shadow-hard);
    color: var(--ink);
  }
  .message__tri path {
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .message__tri--1 {
    --rot: -16deg;
    width: 64px;
    height: 64px;
    left: 0;
    top: 2%;
  }
  .message__tri--1 path {
    fill: var(--violet);
  }
  .message__tri--2 {
    --rot: 24deg;
    width: 48px;
    height: 48px;
    right: 0;
    bottom: 6%;
  }
  .message__tri--2 path {
    fill: var(--yellow);
  }
  .message__spark {
    right: 6%;
    top: 4%;
    color: var(--violet);
  }

  .message__card {
    --card-corner: var(--violet);
  }
  .message__lead {
    font-size: clamp(18px, 1.5vw, 21px);
    margin-bottom: 24px;
  }
  /* "e-mail" message mode (site.json → messageMode, switched in developer mode): the topics open the
     visitor's e-mail app, nothing is typed on the site */
  form[data-msg-mode='email'] .field,
  form[data-msg-mode='email'] [data-status],
  form[data-msg-mode='email'] [data-submit] {
    display: none;
  }
  .mail-hint {
    display: none;
    margin: 0 0 12px;
    font-weight: 700;
  }
  form[data-msg-mode='email'] .mail-hint {
    display: block;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 18px;
    padding: 0;
    border: 0;
  }
  .topic input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .topic span {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    transition: background-color var(--t-fast), box-shadow var(--t-fast);
  }
  .topic input:checked + span {
    background: var(--yellow);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .topic input:focus-visible + span {
    outline: 3px solid var(--violet);
    outline-offset: 2px;
  }
  .direct {
    margin: 14px 0 0;
    font-size: var(--fs-small);
  }
  .direct a {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
  }
  .field label {
    font-weight: 700;
    font-size: var(--fs-small);
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: var(--touch);
    padding: 12px 16px;
    border: var(--border);
    border-radius: 16px;
    background: var(--bg);
    font-size: 17px;
  }
  .field textarea {
    resize: vertical;
    min-height: 140px;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    background: #fff;
    outline-offset: 2px;
  }
  .field [aria-invalid='true'] {
    border-color: #C0142B;
    box-shadow: 0 0 0 2px #C0142B;
  }
  .field textarea::placeholder {
    color: var(--muted);
  }
  .counter {
    align-self: flex-end;
    font-size: var(--fs-tiny);
    color: var(--muted);
  }
  .counter.is-near {
    color: var(--violet-dark);
    font-weight: 700;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .status:not(:empty) {
    margin-bottom: 16px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--yellow-tint);
    border: 2px solid var(--ink);
    font-weight: 500;
  }
  .submit__busy {
    display: none;
  }
  .submit__idle,
  .submit__busy {
    align-items: center;
    gap: 10px;
  }
  .submit__idle {
    display: inline-flex;
  }
  .submit[aria-busy='true'] .submit__idle {
    display: none;
  }
  .submit[aria-busy='true'] .submit__busy {
    display: inline-flex;
  }
  .submit[aria-busy='true'] {
    cursor: progress;
  }
  .submit :global(.spin) {
    animation: spin 0.9s linear infinite;
  }
  .privacy-note {
    margin: 16px 0 0;
    font-size: var(--fs-tiny);
    color: var(--muted);
  }
  .privacy-note a {
    margin-left: 4px;
    font-weight: 700;
  }
  .success {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    border-radius: 20px;
    background: #E6F6EC;
    border: 2px solid var(--ink);
  }
  .success[hidden] {
    display: none;
  }
  .success p {
    margin: 0;
    font-weight: 700;
  }
  .success__icon {
    color: var(--success);
    flex: none;
  }
  @media (max-width: 899px) {
    .message__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .message__art {
      max-width: 220px;
    }
  }
</style>

<script>
  import { submitForm } from '../lib/formHandler';
  import { openMail, letterBody } from '../lib/mail';

  const form = document.querySelector<HTMLFormElement>('[data-message-form]');
  if (form) {
    const card = form.parentElement!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const counter = form.querySelector<HTMLElement>('[data-counter]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const success = card.querySelector<HTMLElement>('[data-success]')!;
    const msgRequired = card.querySelector<HTMLTemplateElement>('[data-msg-required]')!.content.textContent ?? '';
    const msgError = card.querySelector<HTMLTemplateElement>('[data-msg-error]')!.content.textContent ?? '';
    const nameInput = form.elements.namedItem('name') as HTMLInputElement;
    const messageInput = form.elements.namedItem('message') as HTMLTextAreaElement;
    const max = Number(counter.dataset.max);

    // e-mail mode: picking a topic opens the e-mail app with a started letter
    form.addEventListener('click', (e) => {
      const radio = (e.target as Element).closest<HTMLInputElement>('input[name="topic"]');
      if (!radio || form.dataset.msgMode !== 'email') return;
      openMail(form.dataset.email!, `${form.dataset.subject} – ${radio.dataset.label}`, radio.dataset.start!);
    });

    const updateCounter = () => {
      const n = messageInput.value.length;
      counter.textContent = `${n} / ${max}`;
      counter.classList.toggle('is-near', n > max * 0.9);
    };
    messageInput.addEventListener('input', updateCounter);
    updateCounter();

    [nameInput, messageInput].forEach((el) =>
      el.addEventListener('input', () => {
        if (el.value.trim()) el.removeAttribute('aria-invalid');
      }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      const missing = [nameInput, messageInput].filter((el) => !el.value.trim());
      missing.forEach((el) => el.setAttribute('aria-invalid', 'true'));
      if (missing.length) {
        status.textContent = msgRequired;
        missing[0].focus();
        return;
      }

      submit.setAttribute('aria-busy', 'true');
      submit.disabled = true;
      try {
        await submitForm(form);
        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (err) {
        console.error(err);
        // sending did not work: the visitor's e-mail app opens with the message already written
        status.textContent = msgError;
        const topic = form.querySelector<HTMLInputElement>('input[name="topic"]:checked');
        const data = new FormData(form);
        openMail(form.dataset.email!, `${form.dataset.subject} – ${topic?.dataset.label ?? ''}`, letterBody(data));
      } finally {
        submit.removeAttribute('aria-busy');
        submit.disabled = false;
      }
    });
  }
</script>
