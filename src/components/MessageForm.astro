---
import Globe from './Globe.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import site from '../data/site.json';
import { mailtoHref } from '../lib/mail';
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** "Message me": topics that open the visitor's e-mail app with a started letter (no form backend). */
const TOPICS = [
  { id: 'idea', icon: 'lightbulb' },
  { id: 'join', icon: 'users' },
  { id: 'work', icon: 'briefcase' },
] as const;
const subject = t(lang, 'msg.subject');
---

<section class="section message" id="message" aria-labelledby="message-title">
  <div class="bg-layer">
    <Globe size="min(720px, 110vw)" left="-20%" top="4%" speed={75} direction="ccw" />
  </div>
  <div class="container message__grid">
    <div class="message__art" aria-hidden="true">
      <div class="message__bulb">
        <Icon name="lightbulb" size={96} />
      </div>
      <svg class="shape float message__tri message__tri--1" viewBox="0 0 60 60"><path d="M8 52 L30 8 L52 52 Z" /></svg>
      <svg class="shape float float--slow message__tri message__tri--2" viewBox="0 0 60 60"><path d="M8 52 L30 8 L52 52 Z" /></svg>
      <span class="shape float float--fast message__spark"><Icon name="sparkles" size={34} /></span>
    </div>

    <div class="card message__card reveal">
      <SectionHeading icon="send" id="message-title">{t(lang, 'msg.title')}</SectionHeading>
      <p class="message__lead">{t(lang, 'msg.lead')}</p>

      <p class="message__pick">{t(lang, 'msg.pick')}</p>
      <div class="message__topics">
        {
          TOPICS.map((tp) => (
            <a class="message__topic" href={mailtoHref(site.email, `${subject} – ${t(lang, `msg.topic.${tp.id}`)}`, t(lang, `msg.start.${tp.id}`))}>
              <Icon name={tp.icon} size={20} />
              <span>{t(lang, `msg.topic.${tp.id}`)}</span>
              <Icon name="mail" size={18} />
            </a>
          ))
        }
      </div>

      <p class="message__fallback">
        {t(lang, 'msg.fallback')}
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" class="message__copy" data-copy={site.email} data-copied={t(lang, 'msg.copied')}>{t(lang, 'msg.copy')}</button>
      </p>
      <p class="privacy-note">
        {t(lang, 'msg.privacy')}
        <a href={localePath(lang, 'privacy')}>{t(lang, 'footer.privacy')}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .message__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .message__art {
    position: relative;
    aspect-ratio: 1;
    max-width: 400px;
    width: 100%;
    justify-self: center;
  }
  .message__bulb {
    position: absolute;
    inset: 12%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--yellow);
    border: 3px solid var(--ink);
    box-shadow: var(--shadow-hard);
    color: var(--ink);
  }
  .message__tri path {
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .message__tri--1 {
    --rot: -16deg;
    width: 64px;
    height: 64px;
    left: 0;
    top: 2%;
  }
  .message__tri--1 path {
    fill: var(--violet);
  }
  .message__tri--2 {
    --rot: 24deg;
    width: 48px;
    height: 48px;
    right: 0;
    bottom: 6%;
  }
  .message__tri--2 path {
    fill: var(--yellow);
  }
  .message__spark {
    right: 6%;
    top: 4%;
    color: var(--violet);
  }

  .message__card {
    --card-corner: var(--violet);
  }
  .message__lead {
    font-size: clamp(18px, 1.5vw, 21px);
    margin-bottom: 24px;
  }
  .message__pick {
    margin: 0 0 12px;
    font-weight: 700;
  }
  .message__topics {
    display: grid;
    gap: 10px;
    margin-bottom: 18px;
  }
  .message__topic {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--touch);
    padding: 12px 18px;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--ink);
    font-weight: 700;
    font-size: 17px;
    text-decoration: none;
    transition: background-color var(--t-fast), box-shadow var(--t-fast), transform var(--t-fast);
  }
  .message__topic span {
    flex: 1;
  }
  .message__topic:hover,
  .message__topic:focus-visible {
    background: var(--yellow);
    box-shadow: 3px 3px 0 var(--ink);
    transform: translate(-1px, -1px);
  }
  .message__fallback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
  }
  .message__fallback a {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .message__copy {
    padding: 4px 12px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--violet-tint);
    color: var(--ink);
    font-size: 14px;
    font-weight: 700;
  }
  .privacy-note {
    margin: 16px 0 0;
    font-size: var(--fs-tiny);
    color: var(--muted);
  }
  .privacy-note a {
    margin-left: 4px;
    font-weight: 700;
  }
  @media (max-width: 899px) {
    .message__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .message__art {
      max-width: 220px;
    }
  }
</style>

<script>
  import { wireCopyButtons } from '../lib/mail';

  const card = document.querySelector('.message__card');
  if (card) wireCopyButtons(card);
</script>
