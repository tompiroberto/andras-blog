---
/**
 * Developer mode: click the header title (the globe or "András") 5 times quickly, then type the access
 * code in the movie-style "hacking" screen (the code only keeps out the curious – publishing still needs
 * the GitHub key). The site turns neon green on black with falling code. Then a green "+" shows
 * on every section (photo or post; on Explore cards / category pages the post gets that category), and a
 * small panel opens. Photos (with descriptions, src/components/PhotoUpload.astro) and posts (with pictures,
 * src/components/PostEditor.astro) are published from the site straight to GitHub; Netlify rebuilds the
 * site in about a minute. Publishing needs the owner's GitHub key – the 5 clicks only reveal the door.
 */
import Icon from './Icon.astro';
import PhotoUpload from './PhotoUpload.astro';
import PostEditor from './PostEditor.astro';
import MusicUpload from './MusicUpload.astro';
import EditMode from './EditMode.astro';
import site from '../data/site.json';
import layout from '../data/layout.json';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const REPO = 'https://github.com/tompiroberto/andras-blog';
---

<aside class="dev-panel" hidden data-dev-panel aria-labelledby="dev-title">
  <div class="dev-panel__head">
    <span class="dev-panel__icon" aria-hidden="true"><Icon name="code" size={18} /></span>
    <h2 id="dev-title">{t(lang, 'dev.title')}</h2>
    <span class="dev-panel__grip" aria-hidden="true" title={t(lang, 'dev.panelMove')}>⠿</span>
    <button type="button" class="dev-panel__close" aria-label={t(lang, 'dev.panelReset')} title={t(lang, 'dev.panelReset')} data-dev-panel-reset>⤢</button>
    <button type="button" class="dev-panel__close" aria-label={t(lang, 'dev.off')} title={t(lang, 'dev.off')} data-dev-off><Icon name="x" size={16} /></button>
  </div>
  <p class="dev-panel__text">{t(lang, 'dev.text')}</p>
  <button type="button" class="dev-publish" data-dev-publish>
    🚀 <span>{t(lang, 'pub.button')}</span> <b class="dev-publish__n" data-dev-pending>0</b>
  </button>
  <p class="dev-publish__note">{t(lang, 'pub.note')}</p>
  <div class="dev-panel__actions">
    <button type="button" class="dev-panel__btn" data-dev-new-post><Icon name="file-plus" size={16} />{t(lang, 'dev.newPost')}</button>
    <button type="button" class="dev-panel__btn" data-dev-insert="h3" title={t(lang, 'ins.hint')}><Icon name="heading" size={16} />{t(lang, 'ins.subtitle')}</button>
    <button type="button" class="dev-panel__btn" data-dev-insert="p" title={t(lang, 'ins.hint')}><Icon name="pilcrow" size={16} />{t(lang, 'ins.paragraph')}</button>
    <button type="button" class="dev-panel__btn" data-dev-upload><Icon name="image-plus" size={16} />{t(lang, 'dev.newPhoto')}</button>
    <button type="button" class="dev-panel__btn" data-dev-music><Icon name="music" size={16} />{t(lang, 'music.upload')}</button>
    <button type="button" class="dev-panel__btn dev-panel__edit" aria-pressed="true" data-dev-edit><Icon name="move" size={16} /><span data-dev-edit-label>{t(lang, 'ed.on')}</span></button>
    <a class="dev-panel__btn" href={`${REPO}/tree/main/src/content/posts`} target="_blank" rel="noopener"><Icon name="layout-dashboard" size={16} />{t(lang, 'dev.admin')}</a>
  </div>
  <div class="dev-panel__post" hidden data-dev-post>
    <button type="button" class="dev-panel__btn" data-dev-post-edit><Icon name="file-pen" size={16} />{t(lang, 'dev.postEdit')}</button>
    <button type="button" class="dev-panel__btn" data-dev-post-photo><Icon name="image-plus" size={16} />{t(lang, 'dev.postPhoto')}</button>
    <button type="button" class="dev-panel__btn" data-dev-post-music><Icon name="music" size={16} />{t(lang, 'dev.postMusic')}</button>
    <button type="button" class="dev-panel__btn dev-panel__btn--danger" data-dev-post-delete><Icon name="trash-2" size={16} />{t(lang, 'dev.postDelete')}</button>
  </div>
  <details class="dev-log" data-dev-log>
    <summary>📋 {t(lang, 'log.title')} <b data-dev-log-n>0</b></summary>
    <p class="dev-log__h">{t(lang, 'log.unsaved')}</p>
    <ul data-dev-log-now></ul>
    <p class="dev-log__h">{t(lang, 'log.waiting')}</p>
    <ul data-dev-log-saved></ul>
    <p class="dev-log__empty" data-dev-log-empty>{t(lang, 'log.empty')}</p>
  </details>
  <template data-dev-loglabels>{JSON.stringify({ layout: t(lang, 'log.layout'), map: t(lang, 'log.map'), pictures: t(lang, 'log.pictures'), post: t(lang, 'log.post'), postDel: t(lang, 'log.postDel'), photos: t(lang, 'log.photos'), setting: t(lang, 'log.setting'), edits: t(lang, 'log.edits'), none: t(lang, 'log.none') })}</template>
  <button type="button" class="dev-panel__btn dev-panel__preview" data-dev-preview><Icon name="eye" size={16} />{t(lang, 'dev.preview')}</button>
  <fieldset class="dev-msg dev-theme" data-dev-theme>
    <legend>{t(lang, 'dev.theme')}</legend>
    <label><input type="color" data-theme-key="violet" /> {t(lang, 'dev.theme.violet')}</label>
    <label><input type="color" data-theme-key="yellow" /> {t(lang, 'dev.theme.yellow')}</label>
    <label><input type="color" data-theme-key="bg" /> {t(lang, 'dev.theme.bg')}</label>
    <label><input type="color" data-theme-key="ink" /> {t(lang, 'dev.theme.ink')}</label>
    <button type="button" class="dev-theme__reset" data-theme-reset>{t(lang, 'dev.theme.reset')}</button>
    <p class="dev-msg__status">{t(lang, 'dev.theme.hint')}</p>
  </fieldset>
  <fieldset class="dev-msg" data-dev-setting="formProvider" data-mode={site.formProvider}>
    <legend>{t(lang, 'dev.provider')}</legend>
    <label><input type="radio" name="dev-provider" value="formspree" checked={site.formProvider !== 'netlify'} /> Formspree</label>
    <label><input type="radio" name="dev-provider" value="netlify" checked={site.formProvider === 'netlify'} /> Netlify Forms</label>
    <p class="dev-msg__status" role="status" data-dev-msg-status></p>
  </fieldset>
  <fieldset class="dev-msg" data-dev-setting="messageMode" data-mode={site.messageMode}>
    <legend>{t(lang, 'dev.msgTitle')}</legend>
    <label><input type="radio" name="dev-msg-mode" value="form" checked={site.messageMode !== 'email'} /> {t(lang, 'dev.msgForm')}</label>
    <label><input type="radio" name="dev-msg-mode" value="email" checked={site.messageMode === 'email'} /> {t(lang, 'dev.msgEmail')}</label>
    <p class="dev-msg__status" role="status" data-dev-msg-status></p>
  </fieldset>
  <p class="dev-panel__note">{t(lang, 'dev.note')}</p>
  <template data-dev-msgsaving>{t(lang, 'dev.msgSaving')}</template>
  <template data-dev-msgsaved>{t(lang, 'dev.msgSaved')}</template>
  <template data-dev-msgkey>{t(lang, 'dev.msgKey')}</template>
  <template data-dev-msgerror>{t(lang, 'upload.error')}</template>
</aside>
<PhotoUpload lang={lang} />
<PostEditor lang={lang} />
<MusicUpload lang={lang} />
<EditMode lang={lang} />
<div class="dev-add-menu" hidden data-dev-add-menu>
  <button type="button" data-dev-add-pick="card" hidden><Icon name="copy-plus" size={18} /><span data-dev-card-label>{t(lang, 'ins.card')}</span></button>
  <button type="button" data-dev-add-pick="h3"><Icon name="heading" size={18} />{t(lang, 'ins.subtitleHere')}</button>
  <button type="button" data-dev-add-pick="p"><Icon name="pilcrow" size={18} />{t(lang, 'ins.paragraphHere')}</button>
  <button type="button" data-dev-add-pick="photo"><Icon name="image-plus" size={18} />{t(lang, 'dev.addPhoto')}</button>
  <button type="button" data-dev-add-pick="post"><Icon name="file-plus" size={18} />{t(lang, 'dev.addPost')}</button>
</div>
<div class="lay-save" hidden data-lay-save>
  <span>{t(lang, 'lay.changed')}</span>
  <button type="button" class="lay-save__pub" data-dev-publish>🚀 {t(lang, 'pub.button')} <b data-dev-pending>0</b></button>
  <button type="button" data-ed-undo title="Ctrl+Z">↶</button>
  <button type="button" data-ed-redo title="Ctrl+Y">↷</button>
  <button type="button" data-lay-undo>{t(lang, 'lay.undo')}</button>
  <span class="lay-save__status" data-lay-status></span>
</div>
<template data-dev-laytitles>{JSON.stringify({ up: t(lang, 'lay.up'), down: t(lang, 'lay.down'), hide: t(lang, 'lay.hide'), width: t(lang, 'lay.width'), smaller: t(lang, 'lay.smaller'), bigger: t(lang, 'lay.bigger'), saving: t(lang, 'dev.msgSaving'), saved: t(lang, 'lay.saved'), unsaved: t(lang, 'lay.unsaved'), needKey: t(lang, 'lay.needKey'), widths: { narrow: t(lang, 'lay.w.narrow'), normal: t(lang, 'lay.w.normal'), wide: t(lang, 'lay.w.wide'), full: t(lang, 'lay.w.full') } })}</template>
<template data-dev-layhidden>{JSON.stringify(layout.hidden)}</template>
<template data-dev-pubbusy>{t(lang, 'pub.busy')}</template>
<template data-dev-pubdone>{t(lang, 'pub.done')}</template>
<template data-dev-pubnone>{t(lang, 'pub.none')}</template>
<template data-dev-edon>{t(lang, 'ed.on')}</template>
<template data-dev-edoff>{t(lang, 'ed.off')}</template>
<template data-dev-plan>{t(lang, 'ins.plan')}</template>
<template data-dev-card>{t(lang, 'ins.card')}</template>
<template data-dev-placehint>{t(lang, 'ins.hint')}</template>
<template data-dev-addlabel>{t(lang, 'dev.add')}</template>
<canvas class="dev-rain" aria-hidden="true" data-dev-rain></canvas>
<div class="dev-scan" aria-hidden="true"></div>
<div class="dev-gate" hidden role="dialog" aria-modal="true" aria-label="Access code" data-dev-gate>
  <div class="dev-gate__box" data-dev-gate-box>
    <pre class="dev-gate__log" data-dev-gate-log></pre>
    <form class="dev-gate__form" hidden data-dev-gate-form>
      <label for="dev-code">&gt; ENTER ACCESS CODE:</label>
      <input id="dev-code" type="password" inputmode="numeric" autocomplete="off" maxlength="6" spellcheck="false" data-dev-code />
      <span class="dev-gate__cursor" aria-hidden="true">█</span>
    </form>
    <p class="dev-gate__verdict" role="status" data-dev-gate-verdict></p>
    <button type="button" class="dev-gate__abort" data-dev-gate-abort>[ESC] abort</button>
  </div>
</div>
<button type="button" class="dev-preview-exit" hidden data-dev-ui data-dev-preview-exit>◀ {t(lang, 'dev.previewExit')}</button>
<template data-dev-postconfirm>{t(lang, 'dev.postConfirm')}</template>
<template data-dev-postdeleted>{t(lang, 'dev.postDeleted')}</template>
<span class="dev-tip" hidden data-dev-tip></span>
<p class="dev-toast" hidden role="status" data-dev-toast></p>
<template data-dev-on>{t(lang, 'dev.on')}</template>
<template data-dev-offmsg>{t(lang, 'dev.offMsg')}</template>
<template data-dev-count>{t(lang, 'dev.count')}</template>

<style>
  .dev-panel {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 690;
    width: min(340px, calc(100vw - 32px));
    padding: 14px 16px;
    border: 2px solid #1b1b24;
    border-radius: 16px;
    background: #0d1117;
    color: #d6f5d6;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 13px;
    box-shadow: 5px 5px 0 #39d353;
    zoom: var(--inv-zoom, 1);
    animation: dev-in 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* the panel can be dragged by its title bar and resized from the corner */
  .dev-panel {
    resize: both;
    min-width: 240px;
    min-height: 160px;
  }
  .dev-panel__head {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .dev-panel.is-dragging .dev-panel__head {
    cursor: grabbing;
  }
  .dev-panel__grip {
    margin-left: auto;
    color: #39d353;
    font-size: 16px;
    opacity: 0.7;
  }
  .dev-log {
    margin-top: 10px;
    padding: 8px 10px;
    border: 1px solid #30363d;
    border-radius: 10px;
  }
  .dev-log summary {
    cursor: pointer;
    font-weight: 700;
    color: #39d353;
  }
  .dev-log summary b {
    display: inline-block;
    min-width: 20px;
    margin-left: 4px;
    padding: 0 6px;
    border-radius: 99px;
    background: #39d353;
    color: #000;
    text-align: center;
  }
  .dev-log__h {
    margin: 8px 0 2px;
    color: #8b949e;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .dev-log ul {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    line-height: 1.35;
  }
  .dev-log ul:empty::after {
    content: '–';
    color: #6e7681;
  }
  .dev-log__empty {
    margin: 6px 0 0;
    color: #6e7681;
    font-size: 12px;
  }
  .dev-log__empty[hidden] {
    display: none;
  }
  .dev-panel[hidden] {
    display: none;
  }
  .dev-panel__head {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dev-panel__icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #39d353;
    color: #0d1117;
  }
  .dev-panel h2 {
    flex: 1;
    margin: 0;
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    color: #39d353;
  }
  .dev-panel__close {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid #30363d;
    border-radius: 8px;
    background: transparent;
    color: #d6f5d6;
    cursor: pointer;
  }
  .dev-panel__text,
  .dev-panel__note {
    margin: 10px 0;
    line-height: 1.45;
  }
  .dev-panel__note {
    margin-bottom: 0;
    font-size: 11px;
    opacity: 0.7;
  }
  .dev-panel__actions {
    display: grid;
    gap: 6px;
  }
  .dev-panel__btn {
    width: 100%;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid #30363d;
    border-radius: 8px;
    color: #d6f5d6;
    text-decoration: none;
  }
  .dev-panel__btn:hover,
  .dev-panel__btn:focus-visible {
    border-color: #39d353;
    background: #161b22;
  }
  .dev-toast {
    position: fixed;
    left: 50%;
    top: 90px;
    z-index: 695;
    margin: 0;
    padding: 8px 14px;
    border-radius: 10px;
    background: #0d1117;
    color: #39d353;
    font: 700 13px ui-monospace, Consolas, monospace;
    transform: translateX(-50%);
    zoom: var(--inv-zoom, 1);
  }
  .dev-toast[hidden] {
    display: none;
  }
  .dev-panel__edit[aria-pressed='true'] {
    border-color: #39d353;
    background: #0f3d17;
  }
  .dev-panel {
    max-height: calc(100vh - 32px);
    overflow: auto;
  }
  .dev-publish {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    margin-top: 10px;
    padding: 9px 12px;
    border: 2px solid #39d353;
    border-radius: 10px;
    background: #39d353;
    color: #0d1117;
    font: 800 14px ui-monospace, Consolas, monospace;
    cursor: pointer;
  }
  .dev-publish:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .dev-publish__n,
  .lay-save__pub b {
    margin-left: auto;
    min-width: 22px;
    padding: 1px 7px;
    border-radius: 999px;
    background: #0d1117;
    color: #39d353;
    text-align: center;
  }
  .dev-publish__note {
    margin: 4px 0 0;
    font-size: 11px;
    color: #9be9a8;
  }
  .dev-panel__post {
    display: grid;
    gap: 6px;
    margin-top: 8px;
  }
  .dev-panel__post[hidden] {
    display: none;
  }
  .dev-panel__btn--danger {
    border-color: #6f1f1f !important;
    color: #ff8080 !important;
  }
  .dev-panel__preview {
    margin-top: 8px;
  }
  .dev-theme label {
    font-size: 12px;
  }
  .dev-theme input[type='color'] {
    width: 34px;
    height: 22px;
    padding: 0;
    border: 1px solid #39d353;
    background: none;
  }
  .dev-theme__reset {
    justify-self: start;
    margin-top: 4px;
    padding: 3px 8px;
    border: 1px solid #30363d;
    border-radius: 6px;
    background: none;
    color: #d6f5d6;
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .dev-tip {
    position: fixed;
    z-index: 2100;
    max-width: 260px;
    padding: 5px 10px;
    border: 1px solid #39ff14;
    border-radius: 8px;
    background: #000;
    color: #39ff14;
    font: 700 12px ui-monospace, Consolas, monospace;
    pointer-events: none;
    box-shadow: 0 0 12px rgba(57, 255, 20, 0.35);
  }
  .dev-tip[hidden] {
    display: none;
  }
  .dev-preview-exit {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 700;
    padding: 10px 16px;
    border: 2px solid #1b1b24;
    border-radius: 999px;
    background: #0d1117;
    color: #39d353;
    font: 700 13px ui-monospace, Consolas, monospace;
    box-shadow: 4px 4px 0 #39d353;
    cursor: pointer;
    zoom: var(--inv-zoom, 1);
  }
  .dev-preview-exit[hidden] {
    display: none;
  }
  .dev-msg {
    display: grid;
    gap: 4px;
    margin: 12px 0 0;
    padding: 8px 10px 10px;
    border: 1px solid #30363d;
    border-radius: 8px;
  }
  .dev-msg legend {
    padding: 0 4px;
    color: #39d353;
    font-weight: 700;
  }
  .dev-msg label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .dev-msg input {
    accent-color: #39d353;
  }
  .dev-msg__status {
    margin: 2px 0 0;
    font-size: 12px;
    color: #9be9a8;
  }
  .dev-msg__status:empty {
    display: none;
  }
  /* ---- layout editor: a toolbar on every home-page section, and the save bar ---- */
  :global(.lay-bar) {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 41;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid #39ff14;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.85);
    font: 700 12px ui-monospace, Consolas, monospace;
    zoom: calc(1 / var(--lay-zoom, 1));
  }
  :global(.lay-bar button) {
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    border: 1px solid #1f6f2a;
    border-radius: 7px;
    background: #031a08;
    color: #39ff14;
    font: inherit;
    cursor: pointer;
  }
  :global(.lay-bar button:hover),
  :global(.lay-bar button:focus-visible) {
    background: #39ff14;
    color: #000;
  }
  :global(.lay-bar .lay-bar__name) {
    padding: 0 6px;
    color: #9be9a8;
  }
  .lay-save {
    position: fixed;
    left: 50%;
    bottom: 18px;
    z-index: 695;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 10px 14px;
    border: 2px solid #39ff14;
    border-radius: 12px;
    background: #000;
    color: #39ff14;
    font: 700 13px ui-monospace, Consolas, monospace;
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.4);
    transform: translateX(-50%);
    zoom: var(--inv-zoom, 1);
  }
  .lay-save[hidden] {
    display: none;
  }
  .lay-save button {
    padding: 6px 12px;
    border: 1px solid #39ff14;
    border-radius: 8px;
    background: none;
    color: #39ff14;
    font: inherit;
    cursor: pointer;
  }
  .lay-save .lay-save__pub {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    border-color: #39ff14;
  }
  .lay-save .lay-save__ok {
    background: #39ff14;
    color: #000;
  }
  .lay-save__status:empty {
    display: none;
  }
  /* the "+" buttons are added by the script, so their styles are global */
  :global(.dev-plus-host) {
    position: relative;
  }
  :global(.dev-plus) {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 2px solid #1b1b24;
    border-radius: 50%;
    background: #39d353;
    color: #0d1117;
    font: 800 30px/1 ui-monospace, Consolas, monospace;
    box-shadow: 3px 3px 0 #1b1b24;
    cursor: pointer;
    animation: dev-in 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transition: transform 150ms;
  }
  :global(.dev-plus:hover),
  :global(.dev-plus:focus-visible) {
    transform: rotate(90deg) scale(1.08);
  }
  .dev-add-menu {
    position: fixed;
    z-index: 700;
    display: grid;
    gap: 6px;
    padding: 8px;
    border: 2px solid #1b1b24;
    border-radius: 14px;
    background: #0d1117;
    box-shadow: 4px 4px 0 #39d353;
  }
  .dev-add-menu[hidden] {
    display: none;
  }
  .dev-add-menu button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid #30363d;
    border-radius: 9px;
    background: none;
    color: #d6f5d6;
    font: 700 14px ui-monospace, Consolas, monospace;
    text-align: left;
    cursor: pointer;
  }
  .dev-add-menu button[hidden] {
    display: none;
  }
  .dev-add-menu button:hover,
  .dev-add-menu button:focus-visible {
    background: #39d353;
    color: #0d1117;
  }
  /* ---- the "hacking" screen ---- */
  .dev-gate {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: grid;
    place-items: center;
    padding: 16px;
    background: rgba(0, 0, 0, 0.92);
    color: #39ff14;
    font: 15px/1.55 ui-monospace, 'Cascadia Code', Consolas, monospace;
    zoom: var(--inv-zoom, 1);
  }
  .dev-gate[hidden] {
    display: none;
  }
  .dev-gate__box {
    width: min(620px, 100%);
    padding: 22px 24px;
    border: 1px solid #39ff14;
    border-radius: 6px;
    background: #000;
    box-shadow:
      0 0 24px rgba(57, 255, 20, 0.35),
      inset 0 0 40px rgba(57, 255, 20, 0.06);
    text-shadow: 0 0 6px rgba(57, 255, 20, 0.7);
  }
  .dev-gate__log {
    margin: 0 0 10px;
    min-height: 7.5em;
    white-space: pre-wrap;
    font: inherit;
  }
  .dev-gate__form {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .dev-gate__form[hidden] {
    display: none;
  }
  .dev-gate__form label {
    font-weight: 700;
  }
  .dev-gate__form input {
    width: 7ch;
    padding: 2px 6px;
    border: 0;
    border-bottom: 2px solid #39ff14;
    background: transparent;
    color: #39ff14;
    font: 700 22px ui-monospace, Consolas, monospace;
    letter-spacing: 0.4em;
    caret-color: transparent;
    outline: none;
  }
  .dev-gate__cursor {
    animation: dev-blink 1s steps(1) infinite;
  }
  .dev-gate__verdict {
    min-height: 1.6em;
    margin: 14px 0 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  .dev-gate__verdict.is-denied {
    color: #ff2a2a;
    text-shadow: 0 0 10px rgba(255, 42, 42, 0.8);
  }
  .dev-gate__verdict.is-granted {
    color: #39ff14;
    animation: dev-flash 0.18s steps(2) 4;
  }
  .dev-gate__box.is-shake {
    animation: dev-shake 0.4s;
    border-color: #ff2a2a;
  }
  .dev-gate__abort {
    margin-top: 14px;
    padding: 0;
    border: 0;
    background: none;
    color: #1f8f0f;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .dev-gate__abort:hover {
    color: #39ff14;
  }
  @keyframes dev-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes dev-flash {
    50% {
      color: #000;
      background: #39ff14;
    }
  }
  @keyframes dev-shake {
    20%,
    60% {
      transform: translateX(-10px);
    }
    40%,
    80% {
      transform: translateX(10px);
    }
  }

  /* ---- falling code and scan lines (only in developer mode) ---- */
  .dev-rain,
  .dev-scan {
    display: none;
    position: fixed;
    inset: 0;
    pointer-events: none;
    zoom: var(--inv-zoom, 1);
  }
  .dev-rain {
    z-index: -1;
    width: 100vw;
    height: 100vh;
    opacity: 0.38;
  }
  .dev-scan {
    z-index: 1500;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 3px);
    animation: dev-scan-flicker 6s infinite;
  }
  :global(html.dev-mode) .dev-rain,
  :global(html.dev-mode) .dev-scan {
    display: block;
  }
  @keyframes dev-scan-flicker {
    0%,
    96%,
    100% {
      opacity: 1;
    }
    97% {
      opacity: 0.4;
    }
    98% {
      opacity: 1;
    }
    99% {
      opacity: 0.6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dev-scan {
      animation: none;
    }
  }

  @keyframes dev-in {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
  }
</style>

<script>
  import { PENDING_EVENT, TOKEN_KEY, commitFiles, getToken, pendingCount, pendingLog, publishSite, readFile } from '../lib/githubCommit';

  const KEY = 'andras-dev-mode';

  // ---- the panel: drag it by the title bar, resize it from the corner; remembered in this browser ----
  {
    const panel = document.querySelector<HTMLElement>('[data-dev-panel]')!;
    const head = panel.querySelector<HTMLElement>('.dev-panel__head')!;
    const PKEY = 'andras-dev-panel';
    type Box = { x?: number; y?: number; w?: number; h?: number };
    const read = (): Box => {
      try {
        return JSON.parse(localStorage.getItem(PKEY) ?? '{}') as Box;
      } catch {
        return {};
      }
    };
    const write = (b: Box) => {
      try {
        localStorage.setItem(PKEY, JSON.stringify(b));
      } catch {
        /* storage unavailable */
      }
    };
    const zoom = () => Number(getComputedStyle(document.documentElement).zoom) || 1;
    const applyBox = (b: Box) => {
      const k = 1 / zoom();
      if (b.x !== undefined && b.y !== undefined) {
        // always (at least partly) on the screen
        const x = Math.max(0, Math.min(window.innerWidth * k - 120, b.x));
        const y = Math.max(0, Math.min(window.innerHeight * k - 40, b.y));
        panel.style.left = `${x}px`;
        panel.style.top = `${y}px`;
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
      } else {
        panel.style.left = panel.style.top = panel.style.right = panel.style.bottom = '';
      }
      panel.style.width = b.w ? `${b.w}px` : '';
      panel.style.height = b.h ? `${b.h}px` : '';
    };
    applyBox(read());
    addEventListener('resize', () => applyBox(read()));
    let start: { px: number; py: number; x: number; y: number } | null = null;
    head.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('button')) return;
      const k = 1 / zoom();
      const r = panel.getBoundingClientRect();
      start = { px: e.clientX, py: e.clientY, x: r.left * k, y: r.top * k };
      head.setPointerCapture(e.pointerId);
      panel.classList.add('is-dragging');
    });
    head.addEventListener('pointermove', (e) => {
      if (!start) return;
      const k = 1 / zoom();
      applyBox({ ...read(), x: start.x + (e.clientX - start.px) * k, y: start.y + (e.clientY - start.py) * k, w: panel.offsetWidth, h: panel.style.height ? panel.offsetHeight : undefined });
    });
    const end = () => {
      if (!start) return;
      start = null;
      panel.classList.remove('is-dragging');
      write({ ...read(), x: parseFloat(panel.style.left), y: parseFloat(panel.style.top) });
    };
    head.addEventListener('pointerup', end);
    head.addEventListener('pointercancel', end);
    // a size set with the corner handle
    let sized = false;
    new ResizeObserver(() => {
      if (panel.hidden || !sized) return;
      write({ ...read(), w: panel.offsetWidth, h: panel.offsetHeight });
    }).observe(panel);
    panel.addEventListener('pointerdown', (e) => {
      const r = panel.getBoundingClientRect();
      // the browser's resize corner (bottom right)
      if (e.clientX > r.right - 22 && e.clientY > r.bottom - 22) sized = true;
    });
    panel.querySelector('[data-dev-panel-reset]')!.addEventListener('click', () => {
      sized = false;
      write({});
      applyBox({});
    });
  }

  // ---- labels: in developer mode every tool button says what it does, at once ----
  const devTip = document.querySelector<HTMLElement>('[data-dev-tip]')!;
  const TIP_AREAS = '.dev-panel, .lay-bar, .lay-save, .ed-frame, .mm-ed, .dev-plus, .dev-add-menu, .site-header, .dyn-search, .mm-bar';
  let tipFor: HTMLElement | null = null;
  document.addEventListener('mouseover', (e) => {
    if (!document.documentElement.classList.contains('dev-mode')) return;
    const el = (e.target as Element).closest<HTMLElement>('[title], [data-tip], [aria-label]');
    if (!el || !el.closest(TIP_AREAS)) {
      devTip.hidden = true;
      tipFor = null;
      return;
    }
    // the browser's own (slow) tooltip would show the same text a second later
    if (el.title) {
      el.dataset.tip = el.title;
      el.removeAttribute('title');
    }
    const text = el.dataset.tip || el.getAttribute('aria-label') || '';
    if (!text || text === tipFor?.dataset.tip) return;
    tipFor = el;
    devTip.textContent = text;
    devTip.hidden = false;
    const z = Number(getComputedStyle(document.documentElement).zoom) || 1;
    const r = el.getBoundingClientRect();
    const k = 1 / z;
    const below = r.bottom * k + 8 + 30 < window.innerHeight * k;
    devTip.style.left = `${Math.max(6, Math.min(window.innerWidth * k - 270, (r.left + r.width / 2) * k - 60))}px`;
    devTip.style.top = `${below ? r.bottom * k + 8 : r.top * k - 34}px`;
  });
  document.addEventListener('mouseout', (e) => {
    if (tipFor && !(e.relatedTarget instanceof Node && tipFor.contains(e.relatedTarget))) {
      devTip.hidden = true;
      tipFor = null;
    }
  });

  // ---- 🚀 Publish: one deploy for everything saved (saves alone cost no Netlify credits) ----
  const pubButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-dev-publish]'));
  const showPending = () => document.querySelectorAll<HTMLElement>('[data-dev-pending]').forEach((b) => (b.textContent = String(pendingCount())));
  window.addEventListener(PENDING_EVENT, showPending);
  showPending();
  pubButtons.forEach((btn) =>
    btn.addEventListener('click', async () => {
      const t = (n: string) => document.querySelector<HTMLTemplateElement>(`[data-dev-${n}]`)?.content.textContent ?? '';
      const toast = document.querySelector<HTMLElement>('[data-dev-toast]');
      const tell = (msg: string) => {
        if (!toast) return;
        toast.textContent = msg;
        toast.hidden = false;
        window.setTimeout(() => (toast.hidden = true), 3200);
      };
      let key = getToken();
      if (!key) key = (window.prompt(t('msgkey')) ?? '').trim();
      if (!key) return;
      pubButtons.forEach((b) => (b.disabled = true));
      tell(t('pubbusy'));
      try {
        // first the unsaved page edits, then one deploy for everything
        const saved = await ((window as unknown as { __devSave?: (key: string) => Promise<boolean> }).__devSave?.(key) ?? Promise.resolve(true));
        if (!saved) throw new Error('save failed');
        if (!pendingCount() && !window.confirm(t('pubnone'))) return;
        await publishSite(key);
        tell(t('pubdone'));
      } catch (err) {
        tell(t('msgerror').replace('{msg}', err instanceof Error ? err.message : String(err)));
      } finally {
        pubButtons.forEach((b) => (b.disabled = false));
      }
    }),
  );
  const CLICKS = 5;
  const WINDOW_MS = 3000;
  const html = document.documentElement;
  const panel = document.querySelector<HTMLElement>('[data-dev-panel]');
  const toast = document.querySelector<HTMLElement>('[data-dev-toast]');
  const tpl = (n: string) => document.querySelector<HTMLTemplateElement>(`[data-dev-${n}]`)?.content.textContent ?? '';
  let toastTimer = 0;
  const say = (text: string) => {
    if (!toast) return;
    toast.textContent = text;
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toast.hidden = true), 1600);
  };
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));

  // ---- falling code behind the page ----
  const rain = document.querySelector<HTMLCanvasElement>('[data-dev-rain]')!;
  const GLYPHS = 'アイウエオカキクケコサシスセソタチツテトナニヌネノ0123456789ABCDEF<>/{}[]=;:+*#$%&ÁÉŐŰ';
  const WORDS = ['git push', 'sudo', '0xDEAD', 'root', 'npm run', 'chmod', 'ssh', 'Nutella', 'Chile'];
  let rainTimer = 0;
  let drops: number[] = [];
  const startRain = () => {
    if (rainTimer || reduced) return;
    const ctx = rain.getContext('2d')!;
    const FONT = 16;
    const resize = () => {
      rain.width = window.innerWidth;
      rain.height = window.innerHeight;
      drops = Array.from({ length: Math.ceil(rain.width / FONT) }, () => Math.random() * -60);
    };
    resize();
    window.addEventListener('resize', resize);
    rainTimer = window.setInterval(() => {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.09)';
      ctx.fillRect(0, 0, rain.width, rain.height);
      ctx.font = `${FONT}px ui-monospace, Consolas, monospace`;
      drops.forEach((y, i) => {
        const x = i * FONT;
        const head = Math.random() < 0.004 ? WORDS[(Math.random() * WORDS.length) | 0] : GLYPHS[(Math.random() * GLYPHS.length) | 0];
        ctx.fillStyle = Math.random() < 0.06 ? '#d8ffd0' : '#39ff14';
        ctx.fillText(head, x, y * FONT);
        drops[i] = y * FONT > rain.height && Math.random() > 0.975 ? 0 : y + 1;
      });
    }, 55);
  };
  const stopRain = () => {
    window.clearInterval(rainTimer);
    rainTimer = 0;
    rain.getContext('2d')?.clearRect(0, 0, rain.width, rain.height);
  };

  // ---- the "hacking" screen with the access code ----
  const CODE_HASH = '92c2ffc57ee144f2698e57b5ae2e1149428e2e76660d17da348d459cf708c3cb';
  const gate = document.querySelector<HTMLElement>('[data-dev-gate]')!;
  const gateBox = gate.querySelector<HTMLElement>('[data-dev-gate-box]')!;
  const gateLog = gate.querySelector<HTMLElement>('[data-dev-gate-log]')!;
  const gateForm = gate.querySelector<HTMLFormElement>('[data-dev-gate-form]')!;
  const gateInput = gate.querySelector<HTMLInputElement>('[data-dev-code]')!;
  const verdict = gate.querySelector<HTMLElement>('[data-dev-gate-verdict]')!;
  let gateRun = 0;
  let tries = 0;
  let checking = false;

  const type = async (line: string, run: number, speed = 14) => {
    for (const ch of line) {
      if (run !== gateRun) return;
      gateLog.textContent += ch;
      await sleep(speed);
    }
    gateLog.textContent += '\n';
  };
  const closeGate = () => {
    gateRun++;
    gate.hidden = true;
  };
  async function openGate() {
    const run = ++gateRun;
    tries = 0;
    gate.hidden = false;
    gateLog.textContent = '';
    verdict.textContent = '';
    verdict.className = 'dev-gate__verdict';
    gateForm.hidden = true;
    gateInput.value = '';
    const bar = (n: number) => `[${'#'.repeat(n)}${'.'.repeat(20 - n)}] ${n * 5}%`;
    await type(`> ssh root@${location.hostname}`, run);
    await type('> handshake ........... OK', run);
    if (run !== gateRun) return;
    gateLog.textContent += '> bypassing firewall  ';
    for (let n = 0; n <= 20; n += 4) {
      if (run !== gateRun) return;
      const lines = gateLog.textContent!.split('\n');
      lines[lines.length - 1] = `> bypassing firewall  ${bar(n)}`;
      gateLog.textContent = lines.join('\n');
      await sleep(90);
    }
    gateLog.textContent += '\n';
    await type('> AUTHENTICATION REQUIRED', run, 30);
    if (run !== gateRun) return;
    gateForm.hidden = false;
    gateInput.focus();
  }

  const sha256 = async (text: string) =>
    Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text))))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');

  async function check() {
    if (checking) return;
    checking = true;
    const run = gateRun;
    const ok = (await sha256(`andras-dev:${gateInput.value}`)) === CODE_HASH;
    if (run !== gateRun) return void (checking = false);
    if (!ok) {
      tries++;
      verdict.textContent = tries >= 3 ? 'INTRUSION DETECTED — CONNECTION TERMINATED' : 'ACCESS DENIED';
      verdict.className = 'dev-gate__verdict is-denied';
      gateBox.classList.remove('is-shake');
      void gateBox.offsetWidth;
      gateBox.classList.add('is-shake');
      gateInput.value = '';
      checking = false;
      if (tries >= 3) {
        gateForm.hidden = true;
        await sleep(1600);
        if (run === gateRun) closeGate();
      }
      return;
    }
    verdict.textContent = 'ACCESS GRANTED';
    verdict.className = 'dev-gate__verdict is-granted';
    gateForm.hidden = true;
    await type('> decrypting content store ... OK', run, 8);
    await type('> mounting /posts /photos .... OK', run, 8);
    await type('> welcome back, András.', run, 25);
    await sleep(500);
    checking = false;
    if (run !== gateRun) return;
    closeGate();
    setDev(true);
    say(tpl('on'));
  }

  gateInput.addEventListener('input', () => {
    gateInput.value = gateInput.value.replace(/\D/g, '');
    if (gateInput.value.length >= 3) void check();
  });
  gateForm.addEventListener('submit', (e) => {
    e.preventDefault();
    void check();
  });
  gate.querySelector('[data-dev-gate-abort]')!.addEventListener('click', closeGate);
  gate.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeGate();
  });
  // a click anywhere on the screen puts the cursor back into the code field
  gate.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('button') && !gateForm.hidden) gateInput.focus();
  });

  // ---- site settings in src/data/site.json, switched from the panel (saved like everything else) ----
  //   messageMode:  write on the site / open the e-mail app      → data-msg-mode on the forms
  //   formProvider: Formspree / Netlify Forms (the other is the backup) → data-provider on the forms
  const SETTING_ATTR: Record<string, string> = { messageMode: 'msgMode', formProvider: 'provider' };
  document.querySelectorAll<HTMLFieldSetElement>('[data-dev-setting]').forEach((box) => {
    const setting = box.dataset.devSetting!;
    const status = box.querySelector<HTMLElement>('[data-dev-msg-status]')!;
    const applyHere = (value: string) =>
      document.querySelectorAll<HTMLElement>(`[data-${setting === 'messageMode' ? 'msg-mode' : 'provider'}]`).forEach((f) => (f.dataset[SETTING_ATTR[setting]] = value));
    box.addEventListener('change', async (e) => {
      const value = (e.target as HTMLInputElement).value;
      const previous = box.dataset.mode!;
      const undo = () => (box.querySelector<HTMLInputElement>(`input[value="${previous}"]`)!.checked = true);
      let key = getToken();
      if (!key) key = (window.prompt(tpl('msgkey')) ?? '').trim();
      if (!key) return undo();
      box.disabled = true;
      status.textContent = tpl('msgsaving');
      try {
        const data = JSON.parse(await readFile(key, 'src/data/site.json'));
        data[setting] = value;
        await commitFiles(key, [{ path: 'src/data/site.json', text: `${JSON.stringify(data, null, 2)}\n` }], `Setting: ${setting} = ${value}`);
        try {
          localStorage.setItem(TOKEN_KEY, key);
        } catch {
          /* storage unavailable */
        }
        box.dataset.mode = value;
        applyHere(value);
        status.textContent = tpl('msgsaved');
      } catch (err) {
        undo();
        status.textContent = tpl('msgerror').replace('{msg}', err instanceof Error ? err.message : String(err));
      } finally {
        box.disabled = false;
      }
    });
  });

  // "+" on every section (and on the places marked data-dev-add="photo" | "post", with data-dev-category)
  const menu = document.querySelector<HTMLElement>('[data-dev-add-menu]')!;
  let menuCategory: string | undefined;
  let menuHost: HTMLElement | null = null;
  const openPhoto = () => window.dispatchEvent(new Event('andras:upload-photos'));
  const openPost = (category?: string) => window.dispatchEvent(new CustomEvent('andras:new-post', { detail: { category } }));
  const hideMenu = () => (menu.hidden = true);
  const addPluses = () => {
    document.querySelectorAll<HTMLElement>('main .section, [data-dev-add]').forEach((host) => {
      if (host.querySelector(':scope > .dev-plus')) return;
      const plus = document.createElement('button');
      plus.type = 'button';
      plus.className = 'dev-plus';
      plus.setAttribute('data-dev-ui', '');
      plus.textContent = '+';
      plus.title = tpl('addlabel');
      plus.setAttribute('aria-label', tpl('addlabel'));
      plus.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const kind = host.dataset.devAdd;
        if (kind === 'photo') return openPhoto();
        if (kind === 'music') return window.dispatchEvent(new Event('andras:upload-music'));
        if (kind === 'post') return openPost(host.dataset.devCategory);
        menuCategory = host.dataset.devCategory;
        menuHost = host;
        // sections made of cards / notes offer a new one (a copy of the first, then rewritten)
        const cards = cardsOf(host);
        const cardBtn = menu.querySelector<HTMLButtonElement>('[data-dev-add-pick="card"]')!;
        cardBtn.hidden = !cards;
        if (cards) menu.querySelector('[data-dev-card-label]')!.textContent = tpl(host.dataset.lay === 'plans' ? 'plan' : 'card');
        // the page may be zoomed (html zoom): the menu lives in the same zoomed space
        const z = Number(getComputedStyle(document.documentElement).zoom) || 1;
        const r = plus.getBoundingClientRect();
        menu.hidden = false;
        menu.style.top = `${r.bottom / z + 8}px`;
        menu.style.left = `${Math.max(8, r.right / z - menu.offsetWidth)}px`;
        menu.querySelector('button')!.focus();
      });
      host.classList.add('dev-plus-host');
      host.append(plus);
    });
  };
  const removePluses = () => {
    document.querySelectorAll('.dev-plus').forEach((b) => b.remove());
    document.querySelectorAll('.dev-plus-host').forEach((h) => h.classList.remove('dev-plus-host'));
    hideMenu();
  };
  menu.querySelectorAll<HTMLButtonElement>('[data-dev-add-pick]').forEach((b) =>
    b.addEventListener('click', () => {
      hideMenu();
      const pick = b.dataset.devAddPick;
      const insert = (detail: Record<string, unknown>) => window.dispatchEvent(new CustomEvent('andras:insert', { detail }));
      if (pick === 'photo') return openPhoto();
      if (pick === 'post') return openPost(menuCategory);
      if (!menuHost) return;
      if (pick === 'card') {
        const cards = cardsOf(menuHost);
        if (cards) insert({ clone: cards[0], after: cards[cards.length - 1] });
        return;
      }
      // a subtitle / paragraph right under the section's title
      const heading = menuHost.querySelector<HTMLElement>('.section-heading, h2, h1') ?? menuHost.querySelector<HTMLElement>('.container > *');
      if (heading) insert({ tag: pick, after: heading });
    }),
  );
  /** the cards / notes of a section (Explore cards, plan notes – without the "more coming soon" one) */
  function cardsOf(host: HTMLElement): HTMLElement[] | null {
    const list = Array.from(host.querySelectorAll<HTMLElement>('.plans-board > li:not(.plan-note--more):not([data-ed-ph]), .explore__grid > li:not([data-ed-ph]), .photos__grid > li:not([data-ed-ph])'));
    return list.length ? list : null;
  }
  // panel: "＋ New subtitle / paragraph" – then click where it should go
  document.querySelectorAll<HTMLButtonElement>('[data-dev-insert]').forEach((b) =>
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      say(tpl('placehint'));
      window.dispatchEvent(new CustomEvent('andras:insert', { detail: { tag: b.dataset.devInsert } }));
    }),
  );
  document.addEventListener('click', (e) => {
    if (!menu.hidden && !menu.contains(e.target as Node)) hideMenu();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hideMenu();
  });

  // ---- layout editor (home page): order, hide, width, size of each section → src/data/layout.json ----
  const WIDTH_STEPS = ['narrow', 'normal', 'wide', 'full'] as const;
  const WIDTH_CSS: Record<string, string> = { narrow: '860px', normal: 'var(--container)', wide: '1440px', full: '100%' };
  const layTitles = JSON.parse(tpl('laytitles') || '{}');
  /** sections hidden in the saved layout (src/data/layout.json) */
  const savedHidden: string[] = JSON.parse(tpl('layhidden') || '[]');
  const saveBar = document.querySelector<HTMLElement>('[data-lay-save]')!;
  const layStatus = saveBar.querySelector<HTMLElement>('[data-lay-status]')!;
  const sections = () => Array.from(document.querySelectorAll<HTMLElement>('main > [data-lay]'));
  let layChanged = false;
  // nothing is saved by itself: changes stay in this browser tab until 🚀 Publish saves them and puts
  // them online (one deploy)
  let unsaved = false;
  let saving = false;
  const showSave = () => {
    unsaved = true;
    saveBar.hidden = false;
    layStatus.textContent = layTitles.unsaved;
  };
  window.addEventListener('beforeunload', (e) => {
    if (unsaved) e.preventDefault();
  });
  const changed = () => {
    layChanged = true;
    showSave();
  };
  // edits on the page (EditMode) use the same save bar
  window.addEventListener('andras:dev-changed', showSave);
  const editsDraft = () => (window as unknown as { __editsDraft?: () => string | null }).__editsDraft?.() ?? null;
  const readLayout = () => {
    const order: string[] = [];
    const hidden: string[] = [];
    const width: Record<string, string> = {};
    const scale: Record<string, number> = {};
    for (const el of sections()) {
      const id = el.dataset.lay!;
      order.push(id);
      const cs = getComputedStyle(el);
      if (el.dataset.layState === 'hidden' || (el.dataset.layState !== 'shown' && savedHidden.includes(id))) hidden.push(id);
      if (el.dataset.layWidth && el.dataset.layWidth !== 'normal') width[id] = el.dataset.layWidth;
      const z = Number(el.style.getPropertyValue('--lay-zoom') || cs.getPropertyValue('--lay-zoom') || 1);
      if (z && Math.abs(z - 1) > 0.001) scale[id] = Math.round(z * 100) / 100;
    }
    return { order, hidden, width, scale };
  };
  const currentWidth = (el: HTMLElement) => {
    if (el.dataset.layWidth) return el.dataset.layWidth;
    const w = getComputedStyle(el).getPropertyValue('--lay-w').trim();
    return (Object.keys(WIDTH_CSS).find((k) => WIDTH_CSS[k] === w) ?? 'normal') as string;
  };
  const addLayBars = () => {
    for (const el of sections()) {
      if (el.querySelector(':scope > .lay-bar')) continue;
      el.dataset.layWidth = currentWidth(el);
      const bar = document.createElement('div');
      bar.className = 'lay-bar';
      bar.setAttribute('data-dev-ui', '');
      const btn = (label: string, title: string, fn: () => void) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.title = title;
        b.setAttribute('aria-label', title);
        b.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          fn();
        });
        bar.append(b);
        return b;
      };
      const name = document.createElement('span');
      name.className = 'lay-bar__name';
      name.textContent = el.dataset.lay!;
      bar.append(name);
      btn('↑', layTitles.up, () => {
        const prev = sections()[sections().indexOf(el) - 1];
        if (prev) {
          prev.before(el);
          changed();
        }
      });
      btn('↓', layTitles.down, () => {
        const next = sections()[sections().indexOf(el) + 1];
        if (next) {
          next.after(el);
          changed();
        }
      });
      btn('👁', layTitles.hide, () => {
        const isHidden = el.dataset.layState === 'hidden' || (el.dataset.layState !== 'shown' && savedHidden.includes(el.dataset.lay!));
        el.dataset.layState = isHidden ? 'shown' : 'hidden';
        changed();
      });
      const wBtn = btn(`⇔ ${layTitles.widths?.[el.dataset.layWidth] ?? ''}`, layTitles.width, () => {
        const next = WIDTH_STEPS[(WIDTH_STEPS.indexOf(el.dataset.layWidth as (typeof WIDTH_STEPS)[number]) + 1) % WIDTH_STEPS.length];
        el.dataset.layWidth = next;
        el.style.setProperty('--lay-w', WIDTH_CSS[next]);
        wBtn.textContent = `⇔ ${layTitles.widths?.[next] ?? next}`;
        changed();
      });
      const zoomBy = (d: number) => {
        const z = Number(el.style.getPropertyValue('--lay-zoom') || getComputedStyle(el).getPropertyValue('--lay-zoom') || 1);
        const nz = Math.min(1.6, Math.max(0.5, Math.round((z + d) * 10) / 10));
        el.style.setProperty('--lay-zoom', String(nz));
        changed();
      };
      btn('A−', layTitles.smaller, () => zoomBy(-0.1));
      btn('A+', layTitles.bigger, () => zoomBy(0.1));
      el.classList.add('dev-plus-host');
      el.prepend(bar);
    }
  };
  const removeLayBars = () => document.querySelectorAll('.lay-bar').forEach((b) => b.remove());
  saveBar.querySelector('[data-lay-undo]')!.addEventListener('click', () => location.reload());
  /** Commit the page edits (no deploy); true when everything is saved. Called by 🚀 Publish. */
  async function saveNow(key: string): Promise<boolean> {
    if (saving) return false;
    saving = true;
    layStatus.textContent = layTitles.saving;
    try {
      const files = [];
      if (layChanged) files.push({ path: 'src/data/layout.json', text: `${JSON.stringify(readLayout(), null, 2)}\n` });
      const edits = editsDraft();
      if (edits) files.push({ path: 'src/data/edits.json', text: edits });
      const pictures = (window as unknown as { __editsFiles?: () => { path: string; base64: string }[] }).__editsFiles?.() ?? [];
      files.push(...pictures);
      // the world-map editor (MapMode.astro): countries, pins and their photos
      const mapFiles = (window as unknown as { __mapFiles?: () => ({ path: string; text: string } | { path: string; base64: string })[] }).__mapFiles?.() ?? [];
      files.push(...mapFiles);
      if (!files.length) {
        unsaved = false;
        return true;
      }
      await commitFiles(key, files, 'Page edits: changed in developer mode', logNow());
      try {
        localStorage.setItem(TOKEN_KEY, key);
      } catch {
        /* storage unavailable */
      }
      layChanged = false;
      unsaved = false;
      (window as unknown as { __editsSaved?: () => void }).__editsSaved?.();
      (window as unknown as { __mapSaved?: () => void }).__mapSaved?.();
      layStatus.textContent = layTitles.saved;
      return true;
    } catch (err) {
      layStatus.textContent = tpl('msgerror').replace('{msg}', err instanceof Error ? err.message : String(err));
      return false;
    } finally {
      saving = false;
    }
  }
  (window as unknown as { __devSave?: (key: string) => Promise<boolean> }).__devSave = async (key) => (unsaved ? saveNow(key) : true);

  // ---- the change log: not saved yet (this page) + saved and waiting for 🚀 Publish ----
  const logBox = document.querySelector<HTMLElement>('[data-dev-log]')!;
  const LL = JSON.parse(document.querySelector<HTMLTemplateElement>('[data-dev-loglabels]')!.content.textContent ?? '{}') as Record<string, string>;
  function logNow(): string[] {
    const out = [...((window as unknown as { __editsLog?: () => string[] }).__editsLog?.() ?? [])];
    if (layChanged) out.push(LL.layout);
    const pics = (window as unknown as { __editsFiles?: () => unknown[] }).__editsFiles?.() ?? [];
    if (pics.length) out.push(LL.pictures.replace('{n}', String(pics.length)));
    const map = (window as unknown as { __mapFiles?: () => unknown[] }).__mapFiles?.() ?? [];
    if (map.length) out.push(LL.map.replace('{n}', String(map.length)));
    return out;
  }
  /** a saved change in words: its own lines, or what its files were */
  const describe = (e: { message: string; files: string[]; lines?: string[] }): string[] => {
    if (e.lines?.length) return e.lines;
    const f = e.files;
    if (f.some((p) => p.startsWith('src/content/posts/'))) {
      const slug = f.find((p) => p.startsWith('src/content/posts/'))!.replace(/^.*\/|\.md$/g, '');
      return [(e.message.startsWith('Post deleted') ? LL.postDel : LL.post).replace('{name}', slug)];
    }
    if (f.some((p) => p.startsWith('src/content/music/'))) return [`🎵 ${e.message}`];
    if (f.some((p) => p.startsWith('src/content/photos/'))) return [LL.photos.replace('{n}', String(f.filter((p) => p.endsWith('.yml')).length))];
    if (f.includes('src/data/site.json')) return [LL.setting.replace('{name}', e.message.replace(/^Setting: /, ''))];
    return [LL.edits];
  };
  const fill = (ul: HTMLElement, lines: string[]) => {
    ul.replaceChildren(
      ...lines.map((l) => {
        const li = document.createElement('li');
        li.textContent = l;
        return li;
      }),
    );
  };
  const renderLog = () => {
    if (panel?.hidden) return;
    const now = unsaved ? logNow() : [];
    const saved = pendingLog().flatMap(describe);
    fill(logBox.querySelector('[data-dev-log-now]')!, now);
    fill(logBox.querySelector('[data-dev-log-saved]')!, saved);
    logBox.querySelector('[data-dev-log-n]')!.textContent = String(now.length + saved.length);
    logBox.querySelector<HTMLElement>('[data-dev-log-empty]')!.hidden = now.length + saved.length > 0;
  };
  window.addEventListener('andras:dev-changed', () => window.setTimeout(renderLog, 400));
  window.addEventListener(PENDING_EVENT, renderLog);
  logBox.addEventListener('toggle', renderLog);
  window.setInterval(renderLog, 2000);
  renderLog();
  saveBar.querySelector('[data-ed-undo]')!.addEventListener('click', () => window.dispatchEvent(new Event('andras:undo')));
  saveBar.querySelector('[data-ed-redo]')!.addEventListener('click', () => window.dispatchEvent(new Event('andras:redo')));

  // ---- theme colours (saved in src/data/edits.json, shown in the visitor preview) ----
  const themeBox = document.querySelector<HTMLElement>('[data-dev-theme]');
  if (themeBox) {
    const fill = () => {
      const theme = (window as unknown as { __editsTheme?: () => Record<string, string> }).__editsTheme?.() ?? {};
      const probe = getComputedStyle(document.documentElement);
      const defaults: Record<string, string> = { violet: '#7b2ff7', yellow: '#ffd60a', bg: '#f5f7ff', ink: '#141a33' };
      themeBox.querySelectorAll<HTMLInputElement>('[data-theme-key]').forEach((i) => {
        i.value = theme[i.dataset.themeKey!] ?? defaults[i.dataset.themeKey!] ?? probe.getPropertyValue(`--${i.dataset.themeKey}`).trim();
      });
    };
    setTimeout(fill);
    themeBox.querySelectorAll<HTMLInputElement>('[data-theme-key]').forEach((i) =>
      i.addEventListener('input', () => window.dispatchEvent(new CustomEvent('andras:theme', { detail: { key: i.dataset.themeKey, value: i.value } }))),
    );
    themeBox.querySelector('[data-theme-reset]')!.addEventListener('click', () => {
      for (const k of ['violet', 'yellow', 'bg', 'ink']) window.dispatchEvent(new CustomEvent('andras:theme', { detail: { key: k, value: null } }));
      fill();
    });
  }

  // ---- edit / delete the post on a post page ----
  const postSlug = location.pathname.match(/^\/[a-z]{2}\/posts\/([^/]+)\/?$/)?.[1];
  const postBox = document.querySelector<HTMLElement>('[data-dev-post]');
  if (postSlug && postBox) {
    postBox.hidden = false;
    postBox.querySelector('[data-dev-post-edit]')!.addEventListener('click', () => window.dispatchEvent(new CustomEvent('andras:edit-post', { detail: { slug: postSlug } })));
    // photos / videos / music that belong to this post (they show at its end)
    postBox.querySelector('[data-dev-post-photo]')!.addEventListener('click', () => window.dispatchEvent(new CustomEvent('andras:upload-photos', { detail: { post: postSlug } })));
    postBox.querySelector('[data-dev-post-music]')!.addEventListener('click', () => window.dispatchEvent(new CustomEvent('andras:upload-music', { detail: { post: postSlug } })));
    postBox.querySelector('[data-dev-post-delete]')!.addEventListener('click', async () => {
      if (!window.confirm(tpl('postconfirm'))) return;
      let key = getToken();
      if (!key) key = (window.prompt(tpl('msgkey')) ?? '').trim();
      if (!key) return;
      try {
        await commitFiles(key, [{ path: `src/content/posts/${postSlug}.md`, delete: true }], `Post deleted on the site: ${postSlug}`);
        say(tpl('postdeleted'));
        setTimeout(() => (location.href = `/${location.pathname.split('/')[1]}/`), 1600);
      } catch (err) {
        say(tpl('msgerror').replace('{msg}', err instanceof Error ? err.message : String(err)));
      }
    });
  }

  // ---- preview as a visitor: developer look and tools off until "back" ----
  const previewExit = document.querySelector<HTMLButtonElement>('[data-dev-preview-exit]')!;
  document.querySelector('[data-dev-preview]')?.addEventListener('click', () => {
    setDev(false);
    try {
      localStorage.setItem(KEY, '1');
    } catch {
      /* storage unavailable */
    }
    previewExit.hidden = false;
  });
  previewExit.addEventListener('click', () => {
    previewExit.hidden = true;
    setDev(true);
  });

  // ---- edit mode (select / move / resize / rewrite on the page, src/components/EditMode.astro) ----
  const editBtn = document.querySelector<HTMLButtonElement>('[data-dev-edit]');
  const setEdit = (on: boolean) => {
    window.dispatchEvent(new CustomEvent('andras:edit-toggle', { detail: on }));
    if (editBtn) {
      editBtn.setAttribute('aria-pressed', String(on));
      editBtn.querySelector('[data-dev-edit-label]')!.textContent = tpl(on ? 'edon' : 'edoff');
    }
  };
  editBtn?.addEventListener('click', () => setEdit(editBtn.getAttribute('aria-pressed') !== 'true'));

  const setDev = (on: boolean) => {
    html.classList.toggle('dev-mode', on);
    if (panel) panel.hidden = !on;
    if (on) {
      addPluses();
      addLayBars();
      setEdit(true);
      startRain();
    } else {
      removePluses();
      removeLayBars();
      saveBar.hidden = true;
      stopRain();
    }
    try {
      if (on) localStorage.setItem(KEY, '1');
      else localStorage.removeItem(KEY);
    } catch {
      /* storage unavailable */
    }
  };
  document.querySelector('[data-dev-upload]')?.addEventListener('click', openPhoto);
  document.querySelector('[data-dev-music]')?.addEventListener('click', () => window.dispatchEvent(new Event('andras:upload-music')));
  document.querySelector('[data-dev-new-post]')?.addEventListener('click', () => openPost());
  try {
    if (localStorage.getItem(KEY) === '1') setDev(true);
  } catch {
    /* storage unavailable */
  }

  // 5 quick clicks on the header title (or its planet, which never leaves the page); counted across a page load too
  document.querySelectorAll<HTMLAnchorElement>('.site-header .brand').forEach((brand) =>
    brand.addEventListener('click', (e) => {
      const now = Date.now();
      let clicks: number[] = [];
      try {
        clicks = JSON.parse(sessionStorage.getItem('andras-dev-clicks') ?? '[]');
      } catch {
        /* storage unavailable */
      }
      clicks = [...clicks.filter((c) => now - c < WINDOW_MS), now];
      // the planet itself does not lead home: it is the door to developer mode (it spins a little)
      const planet = (e.target as Element).closest<HTMLElement>('.icon-circle');
      if (planet) {
        e.preventDefault();
        planet.animate([{ transform: 'rotate(0)' }, { transform: 'rotate(360deg)' }], { duration: 500, easing: 'ease-out' });
      }
      // already on this page: no reload, so the clicks can follow each other quickly
      else if (new URL(brand.href).pathname === location.pathname) {
        e.preventDefault();
        window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
      }
      if (clicks.length >= CLICKS) {
        clicks = [];
        if (html.classList.contains('dev-mode')) {
          setDev(false);
          say(tpl('offmsg'));
        } else openGate();
      } else if (clicks.length >= 2) {
        say(tpl('count').replace('{n}', String(CLICKS - clicks.length)));
      }
      try {
        sessionStorage.setItem('andras-dev-clicks', JSON.stringify(clicks));
      } catch {
        /* storage unavailable */
      }
    }),
  );
  document.querySelector('[data-dev-off]')?.addEventListener('click', () => {
    setDev(false);
    say(tpl('offmsg'));
  });
</script>
