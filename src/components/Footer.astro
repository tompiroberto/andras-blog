---
import Globe from './Globe.astro';
import Icon from './Icon.astro';
import PowerLines from './PowerLines.astro';
import SupporterLogos from './SupporterLogos.astro';
import Landscape from './Landscape.astro';
import { localePath, t, type Lang } from '../i18n';
import site from '../data/site.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();

const contacts = [
  { href: `mailto:${site.email}`, icon: 'mail', label: 'E-mail', external: false },
  { href: site.strava, icon: 'strava', label: 'Strava', external: true },
  { href: site.instagram.url, icon: 'instagram', label: `Instagram ${site.instagram.handle}`, external: true },
  { href: site.facebook, icon: 'facebook', label: 'Facebook', external: true },
];
---

<PowerLines />
<footer class="site-footer" id="contact" aria-labelledby="contact-title">
  <div class="bg-layer">
    <Globe size="min(90vw, 760px)" right="-18%" top="-120px" tone="footer" speed={90} direction="ccw" opacity={0.7} />
  </div>
  <div class="container site-footer__inner">
    <h2 id="contact-title" class="site-footer__title">{t(lang, 'contact.title')}</h2>
    <ul class="contact-buttons">
      {
        contacts.map((c) => (
          <li>
            <a
              class="contact-btn"
              href={c.href}
              {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <span class="contact-btn__icon" aria-hidden="true">
                <Icon name={c.icon} size={22} />
              </span>
              <span>{c.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <SupporterLogos lang={lang} />

    <div class="site-footer__bottom">
      <span>© {year} {site.owner} · <span class="pum-credit">{t(lang, 'footer.pum').split('{pum}')[0]}<strong>PUM PUM PRODUCTION</strong>{t(lang, 'footer.pum').split('{pum}')[1]}</span></span>
      <button type="button" class="legend" data-legend-egg data-egg-circles={t(lang, 'egg.circles')} data-egg-tris={t(lang, 'egg.tris')} title="?">
        <span class="legend__circle" aria-hidden="true"></span>
        {t(lang, 'footer.legend')}
        <span class="legend__tri" aria-hidden="true"></span>
      </button>
      <a href={localePath(lang, 'privacy')}>{t(lang, 'footer.privacy')}</a>
    </div>
    <!-- how many slices of bread have wiped the Nutella stains off so far (NutellaRain.astro) -->
    <p class="bread-count" data-bread-count data-template={t(lang, 'bread.count')}>
      <span class="bread-count__icons" data-bread-icons aria-hidden="true"></span>
      <span data-bread-text>{t(lang, 'bread.count').replace('{n}', '0')}</span>
    </p>
  </div>
  <Landscape />
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    background: var(--violet);
    color: #fff;
    padding-block: clamp(56px, 8vw, 96px) 0;
  }
  .site-footer__inner {
    position: relative;
    z-index: var(--z-content);
  }
  .site-footer__title {
    color: #fff;
  }
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 0 0 clamp(40px, 6vw, 64px);
    padding: 0;
    list-style: none;
  }
  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 8px 26px 8px 8px;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--ink);
    border: var(--border);
    box-shadow: 5px 5px 0 var(--ink);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 20px);
    text-decoration: none;
    transition: transform var(--t-fast) var(--ease);
  }
  .contact-btn:hover {
    transform: translate(-2px, -3px);
  }
  .contact-btn:focus-visible {
    outline-color: var(--yellow);
  }
  .contact-btn__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--yellow);
    border: var(--border);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 32px;
    font-size: var(--fs-small);
  }
  .pum-credit strong {
    font-family: 'Unbounded', var(--font-heading);
    font-weight: 900;
    letter-spacing: 0.04em;
  }
  .site-footer__bottom a {
    color: #fff;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .site-footer__bottom a:focus-visible {
    outline-color: var(--yellow);
  }
  .bread-count {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 12px;
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px dashed rgb(255 255 255 / 0.35);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .bread-count__icons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
  }
  .bread-count__icons:empty {
    display: none;
  }
  .bread-count__icons :global(svg) {
    width: 20px;
    height: 22px;
  }
  .bread-count__icons :global(.bread-more) {
    align-self: center;
    margin-left: 4px;
  }
  .bread-count.is-bump .bread-count__icons :global(svg:last-of-type) {
    animation: bread-bump 500ms cubic-bezier(0.3, 1.8, 0.5, 1);
  }
  @keyframes bread-bump {
    from {
      transform: scale(0) rotate(-40deg);
    }
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .legend:hover .legend__circle,
  .legend:focus-visible .legend__circle {
    transform: scale(1.6);
  }
  .legend:hover .legend__tri,
  .legend:focus-visible .legend__tri {
    transform: rotate(-90deg);
  }
  .legend__circle,
  .legend__tri {
    transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .legend__circle {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    flex: none;
  }
  .legend__tri {
    width: 12px;
    height: 11px;
    background: var(--yellow);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    flex: none;
  }
</style>

<script>
  /*
   * Easter egg: "circles = places · triangles = direction" taken literally. A click sends circles
   * flying over the page – each lands and becomes a place – and triangles that all turn to point at
   * the mouse (or your finger). After a while they fly home.
   */
  const PLACES = ['Valparaíso', 'Tbilisi', 'Cusco', 'Ushuaia', 'Reykjavík', 'Lisboa', 'Kyoto', 'La Paz', 'Split', 'Vilnius', 'Naxos', 'Hévíz', 'Atacama', 'Uyuni', 'Tromsø', 'Sopron', 'Patagonia', 'Balaton', 'Kraków', 'Rapa Nui'];
  document.querySelectorAll<HTMLButtonElement>('[data-legend-egg]').forEach((btn) => {
    let running = false;
    btn.addEventListener('click', () => {
      if (running) return;
      running = true;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const layer = document.createElement('div');
      layer.className = 'egg-layer';
      layer.setAttribute('aria-hidden', 'true');
      document.body.append(layer);
      const from = btn.getBoundingClientRect();
      const fx = from.left + from.width / 2;
      const fy = from.top + from.height / 2;
      const W = window.innerWidth;
      const H = window.innerHeight;
      const places = [...PLACES].sort(() => Math.random() - 0.5);
      const tris: { el: HTMLElement; x: number; y: number }[] = [];
      const fly = (el: HTMLElement, x: number, y: number, delay: number) => {
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
        layer.append(el);
        if (!reduced)
          el.animate([{ transform: `translate(${fx - x}px, ${fy - y}px) scale(0.2)`, opacity: 0 }, { transform: 'translate(0, 0) scale(1)', opacity: 1 }], {
            duration: 900,
            delay,
            easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)',
            fill: 'backwards',
          });
      };
      for (let i = 0; i < 9; i++) {
        const c = document.createElement('span');
        c.className = 'egg-place';
        c.innerHTML = `<i></i><b>${places[i]}</b>`;
        fly(c, 40 + Math.random() * (W - 180), 90 + Math.random() * (H - 220), i * 90);
      }
      for (let i = 0; i < 9; i++) {
        const tr = document.createElement('span');
        tr.className = 'egg-tri';
        const x = 30 + Math.random() * (W - 60);
        const y = 90 + Math.random() * (H - 160);
        fly(tr, x, y, 200 + i * 90);
        tris.push({ el: tr, x, y });
      }
      // triangles = direction: they all point at you
      const aim = (px: number, py: number) => tris.forEach((t) => (t.el.style.rotate = `${Math.atan2(py - t.y, px - t.x)}rad`));
      const onMove = (e: PointerEvent) => aim(e.clientX, e.clientY);
      aim(fx, fy);
      window.addEventListener('pointermove', onMove);
      // the two halves of the legend, said out loud
      const say = (text: string, x: number, y: number, delay: number) => {
        const b = document.createElement('span');
        b.className = 'egg-say';
        b.textContent = text;
        fly(b, x, y, delay);
      };
      say(btn.dataset.eggCircles ?? '', W * 0.22, H * 0.18, 600);
      say(btn.dataset.eggTris ?? '', W * 0.58, H * 0.3, 900);
      window.setTimeout(() => {
        layer.classList.add('is-leaving');
        window.removeEventListener('pointermove', onMove);
        window.setTimeout(() => {
          layer.remove();
          running = false;
        }, 700);
      }, 12000);
    });
  });
</script>
