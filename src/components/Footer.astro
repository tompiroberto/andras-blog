---
import { MAIN_SITE as MAIN_SITE_URL } from '../lib/mainSite.mjs';
import Globe from './Globe.astro';
import Icon from './Icon.astro';
import PowerLines from './PowerLines.astro';
import SupporterLogos from './SupporterLogos.astro';
import Landscape from './Landscape.astro';
import StarChart from './StarChart.astro';
import { localePath, t, type Lang } from '../i18n';
import site from '../data/site.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
// the visitor counter: the main site's /api/visits (netlify/functions/visits.mjs); a copy on another host asks the main site
const visitsApi = `${import.meta.env.PUBLIC_STATIC_EXPORT === '1' ? import.meta.env.PUBLIC_MAIN_SITE || MAIN_SITE_URL : ''}/api/visits`;

const contacts = [
  { href: `mailto:${site.email}`, icon: 'mail', label: 'E-mail', external: false },
  { href: site.strava, icon: 'strava', label: 'Strava', external: true },
  { href: site.instagram.url, icon: 'instagram', label: `Instagram ${site.instagram.handle}`, external: true },
  { href: site.facebook, icon: 'facebook', label: 'Facebook', external: true },
];
---

<PowerLines />
<footer class="site-footer" id="contact" aria-labelledby="contact-title">
  <div class="bg-layer">
    <Globe size="min(90vw, 760px)" right="-18%" top="-120px" tone="footer" speed={90} direction="ccw" opacity={0.7} />
  </div>
  <div class="container site-footer__inner">
    <h2 id="contact-title" class="site-footer__title">{t(lang, 'contact.title')}</h2>
    <ul class="contact-buttons">
      {
        contacts.map((c) => (
          <li>
            <a
              class="contact-btn"
              href={c.href}
              {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <span class="contact-btn__icon" aria-hidden="true">
                <Icon name={c.icon} size={22} />
              </span>
              <span>{c.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <SupporterLogos lang={lang} />

    <div class="site-footer__bottom">
      <span>© {year} {site.owner} · <span class="pum-credit">{t(lang, 'footer.pum').split('{pum}')[0]}<strong>PUM PUM PRODUCTION</strong>{t(lang, 'footer.pum').split('{pum}')[1]}</span></span>
      <button type="button" class="legend" data-legend-egg title={t(lang, 'egg.open')}>
        <span class="legend__circle" aria-hidden="true"></span>
        {t(lang, 'footer.legend')}
        <span class="legend__tri" aria-hidden="true"></span>
      </button>
      <a href={localePath(lang, 'music')}>♪ {t(lang, 'music.title')}</a>
      <a href={localePath(lang, 'privacy')}>{t(lang, 'footer.privacy')}</a>
    </div>
    <!-- how many slices of bread have wiped the Nutella stains off so far (NutellaRain.astro) -->
    <p class="bread-count" data-bread-count data-template={t(lang, 'bread.count')}>
      <span class="bread-count__icons" data-bread-icons aria-hidden="true"></span>
      <span data-bread-text>{t(lang, 'bread.count').replace('{n}', '0')}</span>
    </p>
    <!-- the visitor counter (numbers only, nothing personal); hidden when the counter cannot be reached -->
    <p class="visit-count" hidden data-visits={visitsApi}>
      <span class="visit-count__eye" aria-hidden="true">👀</span>
      <span class="visit-count__num" data-visits-total>0</span>
      <span>{t(lang, 'visits.visitors')}</span>
      <span class="visit-count__dot" aria-hidden="true">·</span>
      <span>{t(lang, 'visits.today')}</span>
      <span class="visit-count__num visit-count__num--small" data-visits-today>0</span>
    </p>
  </div>
  <Landscape lang={lang} />
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    background: var(--violet);
    color: #fff;
    padding-block: clamp(56px, 8vw, 96px) 0;
  }
  .site-footer__inner {
    position: relative;
    z-index: var(--z-content);
  }
  .site-footer__title {
    color: #fff;
  }
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 0 0 clamp(40px, 6vw, 64px);
    padding: 0;
    list-style: none;
  }
  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 8px 26px 8px 8px;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--ink);
    border: var(--border);
    box-shadow: 5px 5px 0 var(--ink);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 20px);
    text-decoration: none;
    transition: transform var(--t-fast) var(--ease);
  }
  .contact-btn:hover {
    transform: translate(-2px, -3px);
  }
  .contact-btn:focus-visible {
    outline-color: var(--yellow);
  }
  .contact-btn__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--yellow);
    border: var(--border);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 32px;
    font-size: var(--fs-small);
  }
  .pum-credit strong {
    font-family: 'Unbounded', var(--font-heading);
    font-weight: 900;
    letter-spacing: 0.04em;
  }
  .site-footer__bottom a {
    color: #fff;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .site-footer__bottom a:focus-visible {
    outline-color: var(--yellow);
  }
  .bread-count {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 12px;
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px dashed rgb(255 255 255 / 0.35);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .bread-count__icons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
  }
  .bread-count__icons:empty {
    display: none;
  }
  .bread-count__icons :global(svg) {
    width: 20px;
    height: 22px;
  }
  .bread-count__icons :global(.bread-more) {
    align-self: center;
    margin-left: 4px;
  }
  .bread-count.is-bump .bread-count__icons :global(svg:last-of-type) {
    animation: bread-bump 500ms cubic-bezier(0.3, 1.8, 0.5, 1);
  }
  @keyframes bread-bump {
    from {
      transform: scale(0) rotate(-40deg);
    }
  }
  .visit-count {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 8px;
    margin: 12px 0 0;
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .visit-count[hidden] {
    display: none;
  }
  .visit-count__eye {
    font-size: 20px;
    animation: visit-look 4s ease-in-out infinite;
  }
  .visit-count__num {
    min-width: 2ch;
    padding: 2px 10px;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--yellow);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--font-heading);
    font-size: 18px;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  .visit-count__num--small {
    background: #fff;
    font-size: 15px;
  }
  .visit-count__dot {
    opacity: 0.6;
  }
  @keyframes visit-look {
    0%, 40%, 100% {
      transform: none;
    }
    50%, 70% {
      transform: translateX(3px);
    }
    80%, 90% {
      transform: translateX(-3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .visit-count__eye {
      animation: none;
    }
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .legend:hover .legend__circle,
  .legend:focus-visible .legend__circle {
    transform: scale(1.6);
  }
  .legend:hover .legend__tri,
  .legend:focus-visible .legend__tri {
    transform: rotate(-90deg);
  }
  .legend__circle,
  .legend__tri {
    transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .legend__circle {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    flex: none;
  }
  .legend__tri {
    width: 12px;
    height: 11px;
    background: var(--yellow);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    flex: none;
  }
</style>

<StarChart lang={lang} />

<script>
  import { TOKEN_KEY } from '../lib/githubCommit';

  // a visit is counted once a day per browser (not András's own: developer mode on, or his GitHub key saved here)
  const box = document.querySelector<HTMLElement>('[data-visits]');
  if (box) {
    const api = box.dataset.visits!;
    const store = {
      get: (k: string) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      },
      set: (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {
          /* private window: counted again next time, that is fine */
        }
      },
    };
    const today = new Date().toISOString().slice(0, 10);
    const me = store.get('andras-dev-mode') === '1' || !!store.get(TOKEN_KEY);
    const count = !me && store.get('andras-visit-day') !== today;
    const fresh = !store.get('andras-visitor');
    const fmt = new Intl.NumberFormat(document.documentElement.lang || 'hu');
    /** the numbers roll up to their value */
    const roll = (el: HTMLElement, to: number) => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return void (el.textContent = fmt.format(to));
      const t0 = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / 1400);
        el.textContent = fmt.format(Math.round(to * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    fetch(api, count ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ new: fresh }) } : { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((d: { visitors: number; today: number }) => {
        if (typeof d.visitors !== 'number') return;
        if (count) {
          store.set('andras-visit-day', today);
          store.set('andras-visitor', '1');
        }
        box.hidden = false;
        // rolls when it comes into view
        const total = box.querySelector<HTMLElement>('[data-visits-total]')!;
        const day = box.querySelector<HTMLElement>('[data-visits-today]')!;
        new IntersectionObserver((entries, io) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          roll(total, Math.max(d.visitors, 1));
          roll(day, Math.max(d.today, 1));
        }).observe(box);
      })
      .catch(() => {
        /* no counter here (e.g. the local preview): it stays hidden */
      });
  }
</script>
