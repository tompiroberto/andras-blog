---
/**
 * A themed background drawing behind a card or a page header (absolute, under the content):
 *   eu        – the European flag's ring of stars on blue (Erasmus+)
 *   map       – the world's continents (Where I've been)
 *   random    – random things: a Nutella jar, a utility pole, a light bulb, a plum dumpling, a cow
 *   adventure – big mountains, a tent and a car
 * The categories have one each (src/lib/categories.ts → backdrop); a post can set its own in its front
 * matter (background: eu | map | random | adventure | none).
 */
interface Props {
  theme?: string;
  /** stronger on a page header, softer on a small card */
  strength?: 'soft' | 'strong' | 'card';
}
const { theme, strength = 'soft' } = Astro.props;
const stars = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  return [100 + Math.cos(a) * 62, 100 + Math.sin(a) * 62];
});
const star = (x: number, y: number, r = 9) =>
  Array.from({ length: 10 }, (_, i) => {
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    const rr = i % 2 ? r * 0.4 : r;
    return `${(x + Math.cos(a) * rr).toFixed(1)},${(y + Math.sin(a) * rr).toFixed(1)}`;
  }).join(' ');
---

{
  theme && theme !== 'none' && (
    <span class:list={['backdrop', `backdrop--${theme}`, `is-${strength}`]} aria-hidden="true">
      {theme === 'eu' && (
        <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMid meet">
          <circle cx="100" cy="100" r="96" fill="#003399" />
          {stars.map(([x, y]) => (
            <polygon points={star(x, y)} fill="#ffcc00" />
          ))}
        </svg>
      )}
      {theme === 'map' && <img src="/world-land.svg" alt="" />}
      {theme === 'random' && (
        <svg viewBox="0 0 300 160" preserveAspectRatio="xMaxYMax meet">
          <g stroke="#1b1b24" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
            {/* a Nutella jar */}
            <rect x="22" y="70" width="44" height="12" rx="3" fill="#fff" />
            <path d="M20 84h48q6 0 6 7v44q0 10-10 10H24q-10 0-10-10V91q0-7 6-7Z" fill="#5a3217" />
            <rect x="18" y="100" width="52" height="22" rx="4" fill="#fff" />
            <path d="M40 106h22M40 114h14" stroke="#d7263d" />
            {/* a utility pole with wires */}
            <path d="M120 150V30M98 44h44M104 60h32" fill="none" />
            <path d="M98 44q-40 10-90 4M142 44q60 14 160 2M136 60q60 10 160 0" fill="none" stroke-width="1.6" />
            <circle cx="98" cy="44" r="3" fill="#ffd60a" />
            <circle cx="142" cy="44" r="3" fill="#ffd60a" />
            {/* a light bulb */}
            <path d="M190 70a24 24 0 1 1 30 0q-6 6-6 14h-18q0-8-6-14Z" fill="#ffd60a" />
            <path d="M196 90h18M198 98h14" fill="none" />
            {/* a plum dumpling */}
            <circle cx="260" cy="128" r="22" fill="#f3e6c8" />
            <path d="M246 116q14-8 28 0" fill="none" stroke="#c9a46a" />
            <circle cx="268" cy="110" r="3" fill="#7b2ff7" />
          </g>
        </svg>
      )}
      {theme === 'adventure' && (
        <svg viewBox="0 0 320 160" preserveAspectRatio="xMaxYMax meet">
          <g stroke="#1b1b24" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
            {/* big mountains with snow */}
            <path d="M0 150 70 40l40 52 50-72 80 130Z" fill="#a3aec0" />
            <path d="M70 40l14 18-14-4-10 10Zm90-20 18 28-18-6-12 12Z" fill="#fff" />
            {/* a tent */}
            <path d="M190 150l40-56 40 56Z" fill="#ffd60a" />
            <path d="M230 94v56M218 150l12-24 12 24" fill="none" />
            {/* a car */}
            <path d="M250 136q0-14 12-16l10-14h28l12 14q8 2 8 16Z" fill="#7b2ff7" />
            <circle cx="268" cy="140" r="8" fill="#fff" />
            <circle cx="302" cy="140" r="8" fill="#fff" />
          </g>
        </svg>
      )}
    </span>
  )
}

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    border-radius: inherit;
  }
  .backdrop svg,
  .backdrop img {
    position: absolute;
    right: -4%;
    bottom: -6%;
    height: 78%;
    max-width: 70%;
    opacity: 0.16;
  }
  .backdrop.is-strong svg,
  .backdrop.is-strong img {
    height: 105%;
    max-width: 44%;
    top: 0;
    bottom: auto;
    opacity: 0.38;
  }
  /* a big card (the home page's topics): a smaller drawing in its bottom corner */
  .backdrop.is-card svg {
    height: 42%;
    max-width: 60%;
    opacity: 0.2;
  }
  .backdrop--eu.is-card svg {
    height: 32%;
    right: 4%;
    bottom: 4%;
  }
  /* the world map: across the whole card */
  .backdrop--map img {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0.2;
  }
  .backdrop--map.is-strong img {
    top: 0;
    height: 100%;
    max-width: none;
    opacity: 0.18;
  }
  /* the EU: a blue tint over the whole card, the ring of stars on the right */
  .backdrop--eu {
    background: linear-gradient(120deg, transparent 40%, color-mix(in srgb, #003399 10%, transparent));
  }
  .backdrop--eu svg {
    opacity: 0.22;
  }
</style>
