---
import IconCircle from './IconCircle.astro';
import { t, type Lang, type TKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** a click on an icon opens its story (story.<name>) in a box under the strip */
const ITEMS: { key: TKey; icon: string }[] = [
  { key: 'icon.running', icon: 'timer' },
  { key: 'icon.spontaneous', icon: 'zap' },
  { key: 'icon.maps', icon: 'map' },
  { key: 'icon.budget', icon: 'backpack' },
  { key: 'icon.languages', icon: 'message-square' },
  { key: 'icon.eating', icon: 'utensils' },
];
---

<div class="container icon-strip-wrap" data-lay="icons">
  <ul class="icon-strip reveal">
    {
      ITEMS.map((item, i) => (
        <li>
          <button type="button" class="icon-strip__btn" data-info-title={t(lang, item.key)} data-info-text={t(lang, `story.${item.key.slice(5)}` as TKey)}>
            <IconCircle icon={item.icon} variant={i % 2 ? 'yellow' : 'violet'} size="md" />
            <span>{t(lang, item.key)}</span>
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .icon-strip-wrap {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * clamp(80px, 10vw, 120px));
  }
  .icon-strip {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 24px 12px;
    margin: 0;
    padding: clamp(24px, 3vw, 36px) clamp(16px, 2vw, 28px);
    list-style: none;
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-hard);
  }
  .icon-strip__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 6px 4px;
    border: 0;
    border-radius: 18px;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: transform var(--t-fast), background-color var(--t-fast);
  }
  .icon-strip__btn:hover,
  .icon-strip__btn:focus-visible {
    transform: translateY(-3px);
  }
  .icon-strip__btn[aria-expanded='true'] span {
    text-decoration: underline 3px var(--yellow);
    text-underline-offset: 4px;
  }
  .icon-strip__btn[aria-expanded='true'] :global(.icon-circle) {
    animation: icon-pop 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes icon-pop {
    40% {
      transform: scale(1.18) rotate(-8deg);
    }
  }
  .icon-strip li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    font-weight: 700;
    font-size: var(--fs-small);
    line-height: 1.3;
    min-width: 0;
    overflow-wrap: break-word;
  }
  @media (max-width: 899px) {
    .icon-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 479px) {
    .icon-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { wireInfoBoxes } from '../lib/infobox';

  wireInfoBoxes(document.querySelector('.icon-strip-wrap') ?? document);
</script>
