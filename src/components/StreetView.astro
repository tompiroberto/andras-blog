---
/**
 * Street View theme (opened from map mode's toolbar, html.street-mode): the site as a walk along a road, drawn in the
 * site's style – look around 360° by dragging, walk forward / back with the arrows (or ↑ ↓, ← → turns).
 * Seventeen regions with their GeoGuessr-famous looks – own utility poles (with wires), road markings,
 * roadside things and animals that move (the drawing is in src/lib/streetScene.ts). Drag up and down
 * to look at the sky or the road. The site's content stands by the road: billboards, road signs, a
 * signpost and a mailbox – click them. "Real street view" opens Google Maps at a similar place.
 */
import Icon from './Icon.astro';
import site from '../data/site.json';
import { localePath, t, type Lang, type TKey } from '../i18n';
import { CATEGORY_META } from '../lib/categories';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = localePath(lang);
const REGIONS = [
  { id: 'japan', group: 'asia', flag: 'jp', real: [35.3326, 138.7962] },
  { id: 'thailand', group: 'asia', flag: 'th', real: [18.79, 98.99] },
  { id: 'indonesia', group: 'asia', flag: 'id', real: [-8.43, 115.28] },
  { id: 'usa', group: 'northAmerica', flag: 'us', real: [38.3601, -98.7648] },
  { id: 'mexico', group: 'northAmerica', flag: 'mx', real: [20.6, -100.39] },
  { id: 'chile', group: 'southAmerica', flag: 'cl', real: [-24.2698, -69.0726] },
  { id: 'brazil', group: 'southAmerica', flag: 'br', real: [-21.2, -47.8] },
  { id: 'argentina', group: 'southAmerica', flag: 'ar', real: [-36.6, -60.0] },
  { id: 'namibia', group: 'africa', flag: 'na', real: [-24.4717, 15.7968] },
  { id: 'kenya', group: 'africa', flag: 'ke', real: [-0.72, 36.43] },
  { id: 'southafrica', group: 'africa', flag: 'za', real: [-33.6, 19.4] },
  { id: 'hungary', group: 'europe', flag: 'hu', real: [46.95, 19.95] },
  { id: 'norway', group: 'europe', flag: 'no', real: [61.2, 7.1] },
  { id: 'iceland', group: 'europe', flag: 'is', real: [63.83, -20.4] },
  { id: 'australia', group: 'oceania', flag: 'au', real: [-25.2, 133.2] },
  { id: 'mongolia', group: 'asia', flag: 'mn', real: [47.6, 106.2] },
  { id: 'peru', group: 'southAmerica', flag: 'pe', real: [-13.3, -72.1] },
] as const;
const GROUPS = ['asia', 'northAmerica', 'southAmerica', 'africa', 'europe', 'oceania'] as const;
// the site's content, standing by the road
const INFO = [
  { id: 'hello', kind: 'billboard', title: t(lang, 'hero.title'), text: t(lang, 'hero.tagline'), links: [{ href: `${home}#about`, label: t(lang, 'nav.about') }] },
  { id: 'about', kind: 'billboard', title: t(lang, 'about.title'), text: t(lang, 'about.text'), links: [{ href: `${home}#about`, label: t(lang, 'posts.readMore') }] },
  {
    id: 'pbs',
    kind: 'roadsign',
    title: t(lang, 'mapmode.pbs'),
    text: site.personalBests.map((p) => `${p.distance} · ${p.time}`).join('\n'),
    links: [{ href: site.strava, label: 'Strava', external: true }],
  },
  {
    id: 'explore',
    kind: 'signpost',
    title: t(lang, 'explore.title'),
    text: CATEGORY_META.map((c) => t(lang, c.titleKey)).join(' · '),
    links: CATEGORY_META.map((c) => ({ href: localePath(lang, c.slug), label: t(lang, c.titleKey) })),
  },
  {
    id: 'plans',
    kind: 'billboard',
    title: t(lang, 'plans.title'),
    text: [1, 2, 3, 4, 5].map((n) => `• ${t(lang, `plan${n}.title` as TKey)}`).join('\n'),
    links: [{ href: `${home}#plans`, label: t(lang, 'plans.title') }],
  },
  {
    id: 'contact',
    kind: 'mailbox',
    title: t(lang, 'contact.title'),
    text: t(lang, 'msg.lead'),
    links: [
      { href: `${home}#message`, label: t(lang, 'msg.title') },
      { href: `mailto:${site.email}`, label: 'E-mail' },
      { href: site.instagram.url, label: 'Instagram', external: true },
      { href: site.facebook, label: 'Facebook', external: true },
    ],
  },
];
---

<div class="street-view" hidden data-street-view role="region" aria-label={t(lang, 'street.toggle')}>
  <svg class="sv-scene" data-sv-scene aria-hidden="true"></svg>
  <svg class="sv-hood" data-sv-hood viewBox="0 0 1000 160" preserveAspectRatio="none" aria-hidden="true"></svg>

  <div class="sv-bar">
    <button type="button" class="sv-btn sv-btn--exit" data-sv-exit><Icon name="arrow-left" size={18} /><span>{t(lang, 'street.toMap')}</span></button>
    <label class="sv-regions">
      <span class="visually-hidden">{t(lang, 'street.region')}</span>
      <img src="/flags/jp.svg" alt="" width="24" height="18" data-sv-flag />
      <select data-sv-region>
        {
          GROUPS.map((gr) => (
            <optgroup label={t(lang, `continent.${gr}` as TKey)}>
              {REGIONS.filter((r) => r.group === gr).map((r) => (
                <option value={r.id} data-real={r.real.join(',')} data-flag={r.flag}>
                  {t(lang, `street.${r.id}` as TKey)}
                </option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </label>
    <a class="sv-btn sv-btn--real" href="#" target="_blank" rel="noopener" data-sv-real><Icon name="external-link" size={16} /><span>{t(lang, 'street.real')}</span></a>
  </div>

  <div class="sv-moves">
    <button type="button" class="sv-arrow sv-arrow--back" aria-label={t(lang, 'street.back')} title={t(lang, 'street.back')} data-sv-move="-1"><Icon name="chevron-down" size={30} /></button>
    <button type="button" class="sv-arrow" aria-label={t(lang, 'street.forward')} title={t(lang, 'street.forward')} data-sv-move="1"><Icon name="chevron-up" size={30} /></button>
  </div>
  <div class="sv-compass" aria-hidden="true"><span data-sv-needle>N</span></div>
  <p class="sv-hint">{t(lang, 'street.hint')}</p>

  <aside class="sv-card" hidden data-sv-card aria-live="polite">
    <button type="button" class="sv-card__close" aria-label={t(lang, 'facts.close')} data-sv-card-close><Icon name="x" size={16} /></button>
    <h2 data-sv-card-title></h2>
    <p data-sv-card-text></p>
    <p class="sv-card__links" data-sv-card-links></p>
  </aside>
  <script type="application/json" data-sv-info set:html={JSON.stringify(INFO)} />
</div>

<style>
  .street-view {
    position: fixed;
    inset: 0;
    z-index: 552;
    overflow: hidden;
    background: #9fd3ff;
    font-family: 'DM Sans', system-ui, sans-serif;
    color: var(--ink);
    zoom: var(--inv-zoom, 1);
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .street-view[hidden] {
    display: none;
  }
  .street-view.is-dragging {
    cursor: grabbing;
  }
  :global(html.street-mode) {
    overflow: hidden;
  }
  .sv-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .sv-scene :global(.sv-obj) {
    cursor: default;
  }
  .sv-scene :global(.sv-info) {
    cursor: pointer;
  }
  .sv-scene :global(.sv-info:hover) {
    filter: brightness(1.08) drop-shadow(0 0 6px #fff);
  }
  .sv-hood {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 16vh;
    pointer-events: none;
  }
  .sv-bar {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    cursor: default;
  }
  .sv-btn,
  .sv-regions button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 2px 2px 0 var(--ink);
  }
  .sv-btn--exit {
    background: var(--violet);
    color: #fff;
  }
  .sv-btn--real {
    margin-left: auto;
  }
  .sv-regions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 6px 4px 12px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--yellow);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .sv-regions select {
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
  }
  .sv-regions button[aria-checked='true'] {
    background: var(--yellow);
  }
  .sv-regions img {
    border: 1px solid var(--ink);
    border-radius: 3px;
  }
  .sv-moves {
    position: absolute;
    left: 50%;
    bottom: calc(16vh + 10px);
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    transform: translateX(-50%);
  }
  .sv-arrow {
    display: grid;
    place-items: center;
    width: 56px;
    height: 44px;
    border: 3px solid #fff;
    border-radius: 14px;
    background: rgb(27 27 36 / 0.55);
    color: #fff;
    cursor: pointer;
    transform: perspective(200px) rotateX(35deg);
  }
  .sv-arrow:hover,
  .sv-arrow:focus-visible {
    background: rgb(123 47 247 / 0.85);
  }
  .sv-compass {
    position: absolute;
    left: 18px;
    bottom: calc(16vh + 14px);
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: rgb(27 27 36 / 0.6);
    color: #fff;
    font-weight: 800;
  }
  .sv-compass span {
    display: grid;
    place-items: start center;
    width: 100%;
    height: 100%;
    padding-top: 4px;
    font-size: 12px;
    color: var(--yellow);
    transform: rotate(var(--rot, 0deg));
  }
  .sv-hint {
    position: absolute;
    right: 14px;
    bottom: calc(16vh + 14px);
    max-width: min(340px, calc(100% - 160px));
    margin: 0;
    padding: 6px 12px;
    border-radius: 12px;
    background: rgb(27 27 36 / 0.75);
    color: #fff;
    font-size: 13px;
  }
  .sv-card {
    position: absolute;
    left: 50%;
    top: 90px;
    width: min(460px, calc(100% - 24px));
    max-height: calc(100% - 200px);
    overflow: auto;
    padding: 16px 18px;
    border: 3px solid var(--ink);
    border-radius: 18px;
    background: #fff;
    box-shadow: 6px 6px 0 var(--yellow);
    transform: translateX(-50%);
    cursor: default;
    animation: sv-card 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sv-card[hidden] {
    display: none;
  }
  .sv-card h2 {
    margin: 0 36px 8px 0;
    font-size: 22px;
  }
  .sv-card p {
    margin: 0;
    white-space: pre-line;
    line-height: 1.5;
  }
  .sv-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 12px !important;
  }
  .sv-card__links :global(a) {
    color: var(--violet-dark);
    font-weight: 700;
  }
  .sv-card__close {
    position: absolute;
    right: 10px;
    top: 10px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: #fff;
    cursor: pointer;
  }
  @keyframes sv-card {
    from {
      opacity: 0;
      transform: translate(-50%, 20px) scale(0.95);
    }
  }
  @media (max-width: 700px) {
    .sv-regions button {
      padding: 6px 9px;
      font-size: 12px;
    }
    .sv-btn--real span,
    .sv-btn--exit span {
      display: none;
    }
    .sv-hint {
      display: none;
    }
  }
</style>

<script>
  import { STREET_EVENT, STREET_STORAGE_KEY, REDUCED_MOTION_QUERY } from '../lib/constants';
  import { FOV, LOOK, drawScene, wrapAngle, type Region } from '../lib/streetScene';

  type Info = { id: string; kind: 'billboard' | 'roadsign' | 'signpost' | 'mailbox'; title: string; text: string; links: { href: string; label: string; external?: boolean }[] };

  const view = document.querySelector<HTMLElement>('[data-street-view]');
  if (view) setup(view);

  function setup(view: HTMLElement) {
    const html = document.documentElement;
    const scene = view.querySelector<SVGSVGElement>('[data-sv-scene]')!;
    const hood = view.querySelector<SVGSVGElement>('[data-sv-hood]')!;
    const needle = view.querySelector<HTMLElement>('[data-sv-needle]')!;
    const card = view.querySelector<HTMLElement>('[data-sv-card]')!;
    const realLink = view.querySelector<HTMLAnchorElement>('[data-sv-real]')!;
    const select = view.querySelector<HTMLSelectElement>('[data-sv-region]')!;
    const flag = view.querySelector<HTMLImageElement>('[data-sv-flag]')!;
    const info: Info[] = JSON.parse(view.querySelector('[data-sv-info]')!.textContent || '[]');
    const reduced = window.matchMedia(REDUCED_MOTION_QUERY);

    let region: Region = 'japan';
    let z0 = 0; // position along the road (m)
    let heading = 0; // look left / right (0 = along the road)
    let pitch = 0; // look up (+) / down (−)
    const focal = () => view.clientWidth / 2 / Math.tan(FOV / 2);

    function drawHood() {
      const L = LOOK[region];
      if (!L.hood) return void (hood.innerHTML = '');
      // the camera car's bonnet – with a snorkel in Kenya and the double antenna in Namibia
      hood.innerHTML =
        `<path d="M0 160 L0 70 Q500 10 1000 70 L1000 160Z" fill="${L.hood}" stroke="#1b1b24" stroke-width="3"/>` +
        `<path d="M120 60 Q500 20 880 60" fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="6"/>` +
        (L.hoodExtra === 'antenna' ? '<path d="M70 120 L40 0 M930 120 L960 0" stroke="#1b1b24" stroke-width="6" stroke-linecap="round"/>' : '') +
        (L.hoodExtra === 'snorkel' ? '<path d="M880 150 L880 40 Q880 18 905 18 L940 18" fill="none" stroke="#1b1b24" stroke-width="22" stroke-linecap="round"/>' : '');
    }
    function render(t = performance.now() / 1000) {
      const W = view.clientWidth;
      const H = view.clientHeight;
      if (!W || !H) return; // hidden: nothing to draw yet
      scene.setAttribute('viewBox', `0 0 ${W} ${H}`);
      scene.innerHTML = drawScene({ region, z0, heading, pitch, W, H, t, info });
      needle.style.setProperty('--rot', `${(-heading * 180) / Math.PI}deg`);
      // the bonnet stays with the car: looking up it slides away, looking down it fills more of the view
      hood.style.transform = `translateY(${Math.max(-H * 0.3, focal() * Math.tan(pitch) * 0.6)}px)`;
    }

    // animals and clouds keep moving while the street view is open (about 30 frames a second)
    let loop = 0;
    let last = 0;
    const tick = (now: number) => {
      if (view.hidden) return;
      if (now - last > 33) {
        last = now;
        render(now / 1000);
      }
      loop = requestAnimationFrame(tick);
    };
    const startLoop = () => {
      cancelAnimationFrame(loop);
      if (reduced.matches) render();
      else loop = requestAnimationFrame(tick);
    };

    // ---- moving around ----
    let anim = 0;
    const move = (dir: number) => {
      cancelAnimationFrame(anim);
      const from = z0;
      const to = z0 + dir * 14 * Math.max(0.2, Math.cos(heading));
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 450);
        z0 = from + (to - from) * (1 - Math.pow(1 - p, 3));
        if (reduced.matches) render();
        if (p < 1) anim = requestAnimationFrame(step);
      };
      anim = requestAnimationFrame(step);
    };
    const look = (dh: number, dp: number) => {
      heading = wrapAngle(heading + dh);
      pitch = Math.max(-1.15, Math.min(1.15, pitch + dp));
      if (reduced.matches) render();
    };
    view.querySelectorAll<HTMLButtonElement>('[data-sv-move]').forEach((b) => b.addEventListener('click', () => move(Number(b.dataset.svMove))));
    // drag: left / right turns all the way round, up / down looks at the sky or down at the road
    let drag: { x: number; y: number; h: number; p: number } | null = null;
    scene.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('.sv-info')) return;
      drag = { x: e.clientX, y: e.clientY, h: heading, p: pitch };
      view.classList.add('is-dragging');
      scene.setPointerCapture(e.pointerId);
    });
    scene.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const f = focal();
      heading = wrapAngle(drag.h - (e.clientX - drag.x) / f);
      pitch = Math.max(-1.15, Math.min(1.15, drag.p + (e.clientY - drag.y) / f));
      if (reduced.matches) render();
    });
    const endDrag = () => {
      drag = null;
      view.classList.remove('is-dragging');
    };
    scene.addEventListener('pointerup', endDrag);
    scene.addEventListener('pointercancel', endDrag);
    scene.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        move(e.deltaY < 0 ? 1 : -1);
      },
      { passive: false },
    );
    document.addEventListener('keydown', (e) => {
      if (view.hidden || (e.target as Element).closest('input, textarea, select')) return;
      if (e.key === 'ArrowUp') move(1);
      else if (e.key === 'ArrowDown') move(-1);
      else if (e.key === 'ArrowLeft') look(-0.25, 0);
      else if (e.key === 'ArrowRight') look(0.25, 0);
      else if (e.key === 'PageUp') look(0, 0.2);
      else if (e.key === 'PageDown') look(0, -0.2);
      else if (e.key === 'Escape' && !card.hidden) card.hidden = true;
      else return;
      e.preventDefault();
    });

    // ---- the content by the road ----
    const openInfo = (i: number) => {
      const it = info[i];
      if (!it) return;
      card.querySelector('[data-sv-card-title]')!.textContent = it.title;
      card.querySelector('[data-sv-card-text]')!.textContent = it.text;
      const links = card.querySelector<HTMLElement>('[data-sv-card-links]')!;
      links.replaceChildren(
        ...it.links.map((l) => {
          const a = document.createElement('a');
          a.href = l.href;
          a.textContent = l.label;
          if (l.external) {
            a.target = '_blank';
            a.rel = 'noopener';
          } else a.addEventListener('click', () => setOn(false));
          return a;
        }),
      );
      card.hidden = false;
    };
    scene.addEventListener('click', (e) => {
      const g = (e.target as Element).closest<SVGGElement>('.sv-info');
      if (g) openInfo(Number(g.dataset.info));
    });
    scene.addEventListener('keydown', (e) => {
      const g = (e.target as Element).closest<SVGGElement>('.sv-info');
      if (g && (e.key === 'Enter' || e.key === ' ')) openInfo(Number(g.dataset.info));
    });
    card.querySelector('[data-sv-card-close]')!.addEventListener('click', () => (card.hidden = true));

    // ---- regions ----
    const setRegion = (r: Region) => {
      region = r;
      heading = 0;
      pitch = 0;
      select.value = r;
      const opt = select.selectedOptions[0];
      const [lat, lon] = (opt?.dataset.real ?? '0,0').split(',');
      realLink.href = `https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${lat},${lon}`;
      flag.src = `/flags/${opt?.dataset.flag ?? 'jp'}.svg`;
      drawHood();
      render();
      try {
        localStorage.setItem('andras-street-region', r);
      } catch {
        /* storage unavailable */
      }
    };
    select.addEventListener('change', () => setRegion(select.value as Region));

    // ---- on / off (header switch; the exit button turns it off) ----
    function setOn(on: boolean) {
      html.classList.toggle('street-mode', on);
      view!.hidden = !on;
      try {
        localStorage.setItem(STREET_STORAGE_KEY, on ? '1' : '0');
      } catch {
        /* storage unavailable */
      }
      document.querySelectorAll<HTMLButtonElement>('[data-html-toggle="street-mode"]').forEach((b) => b.setAttribute('aria-pressed', String(on)));
      if (on) startLoop();
    }
    window.addEventListener('andras:street', (e) => setOn((e as CustomEvent<boolean>).detail));
    // leaving goes back to the world map when the walk started there
    view.querySelector('[data-sv-exit]')!.addEventListener('click', () => {
      setOn(false);
      if (html.dataset.streetFrom === 'map' || !html.dataset.streetFrom) {
        delete html.dataset.streetFrom;
        if (!html.classList.contains('map-mode')) document.querySelector<HTMLButtonElement>('[data-html-toggle="map-mode"]')?.click();
      }
    });
    const sync = () => {
      const on = html.classList.contains('street-mode');
      view.hidden = !on;
      if (on) startLoop();
    };
    window.addEventListener(STREET_EVENT, sync);
    window.addEventListener('resize', () => !view.hidden && render());
    let saved: Region = 'japan';
    try {
      saved = (localStorage.getItem('andras-street-region') as Region) || 'japan';
    } catch {
      /* storage unavailable */
    }
    setRegion(LOOK[saved] ? saved : 'japan');
    sync();
  }
</script>
