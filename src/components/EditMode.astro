    function trash(el: HTMLElement) {
      const item = addedItem(el);
      if (item) {
        draft.add[api.full] = draft.add[api.full].filter((x) => x !== item);
        // its texts and its place in a new order go with it
        const pre = JSON.stringify([`ed:${item.id}`]).slice(0, -1);
        for (const k of Object.keys(draft.text[api.full])) if (k.startsWith(pre)) delete draft.text[api.full][k];
        draft.move![api.full] = draft.move![api.full].filter((m) => !JSON.stringify(m.path).startsWith(pre));
