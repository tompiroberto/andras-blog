      }
      changed();
    });

    // ---- the change log (DevMode's panel shows it): what is changed on this page and not saved yet ----
    const original: Edits = JSON.parse(JSON.stringify(api.data));
    // a copy on another host: the main site's newer edits arrived – nothing changed here yet, so they
    // become the starting point (saving later must not overwrite them with the copy's older ones)
    window.addEventListener('andras:edits-live', (e) => {
      if (dirty) return;
      const next: Edits = JSON.parse(JSON.stringify((e as CustomEvent<Edits>).detail));
      for (const target of [draft, original]) {
        target.style = JSON.parse(JSON.stringify(next.style ?? {}));
        target.text = JSON.parse(JSON.stringify(next.text ?? {}));
        target.add = JSON.parse(JSON.stringify(next.add ?? {}));
        target.move = JSON.parse(JSON.stringify(next.move ?? {}));
        target.theme = JSON.parse(JSON.stringify(next.theme ?? {}));
