---
/**
 * Developer mode → editing on the page, PowerPoint-style: click anything to select it (a frame with
 * eight handles), drag to move, drag a handle to resize (corners of pictures keep the proportions),
 * double-click a text to rewrite it, add a subtitle or a paragraph after the selected element, hide it,
 * or reset it. The edits live in a draft of src/data/edits.json (applied by src/components/SiteEdits.astro);
 * DevMode's save bar commits it. Arrow keys nudge (Shift: 10 px), Delete hides, Esc deselects.
 */
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = {
  dup: t(lang, 'ed.dup'),
  img: t(lang, 'ed.img'),
  noImg: t(lang, 'ed.noImg'),
  style: t(lang, 'ed.style'),
  color: t(lang, 'ed.color'),
  bg: t(lang, 'ed.bg'),
  none: t(lang, 'ed.none'),
  font: t(lang, 'ed.font'),
  fontDefault: t(lang, 'ed.fontDefault'),
  fontHand: t(lang, 'ed.fontHand'),
  size: t(lang, 'ed.size'),
  weight: t(lang, 'ed.weight'),
  radius: t(lang, 'ed.radius'),
  styleReset: t(lang, 'ed.styleReset'),
  parent: t(lang, 'ed.parent'),
  text: t(lang, 'ed.text'),
  subtitle: t(lang, 'ed.subtitle'),
  paragraph: t(lang, 'ed.paragraph'),
  hide: t(lang, 'ed.hide'),
  reset: t(lang, 'ed.reset'),
  close: t(lang, 'facts.close'),
  newSubtitle: t(lang, 'ed.newSubtitle'),
  newParagraph: t(lang, 'ed.newParagraph'),
  up: t(lang, 'ed.up'),
  down: t(lang, 'ed.down'),
  addHere: t(lang, 'ed.addHere'),
  trash: t(lang, 'ed.trash'),
  story: t(lang, 'ed.story'),
  storyHint: t(lang, 'ed.storyHint'),
  save: t(lang, 'ed.storySave'),
  grip: t(lang, 'ed.grip'),
  logAdd: t(lang, 'log.add'),
  logCopy: t(lang, 'log.copy'),
  logDel: t(lang, 'log.del'),
  logText: t(lang, 'log.text'),
  logHide: t(lang, 'log.hide'),
  logImg: t(lang, 'log.img'),
  logPos: t(lang, 'log.pos'),
  logStyle: t(lang, 'log.style'),
  logOrder: t(lang, 'log.order'),
  logTheme: t(lang, 'log.theme'),
  logStory: t(lang, 'log.story'),
  more: t(lang, 'ed.more'),
};
/** the toolbar: [select the parent] [text, subtitle, paragraph] [style, picture] [order, copy] [hide, reset] [close] */
const TOOLS: { act: string; icon: string; label: string; key?: string }[][] = [
  [{ act: 'parent', icon: 'corner-left-up', label: L.parent }],
  [
    { act: 'text', icon: 'pencil', label: L.text, key: 'Enter' },
    { act: 'h3', icon: 'heading', label: L.subtitle },
    { act: 'p', icon: 'pilcrow', label: L.paragraph },
  ],
  [
    { act: 'style', icon: 'palette', label: L.style },
    { act: 'img', icon: 'image', label: L.img },
  ],
  [
    { act: 'up', icon: 'arrow-up', label: L.up, key: 'Alt+↑' },
    { act: 'down', icon: 'arrow-down', label: L.down, key: 'Alt+↓' },
    { act: 'dup', icon: 'copy', label: L.dup, key: 'Ctrl+D' },
  ],
  [
    { act: 'hide', icon: 'eye-off', label: L.hide, key: 'Del' },
    { act: 'reset', icon: 'rotate-ccw', label: L.reset },
  ],
  [{ act: 'close', icon: 'x', label: L.close, key: 'Esc' }],
];
---

<div class="ed-frame" hidden data-dev-ui data-ed-frame>
  {['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'].map((h) => <span class={`ed-h ed-h--${h}`} data-h={h} />)}
  <!-- the tools of the selected element, in groups; each says its name and its key -->
  <div class="ed-tools" data-ed-tools>
    <span class="ed-tools__name" data-ed-name></span>
    {
      TOOLS.map((group) => (
        <span class="ed-tools__group">
          {group.map((b) => (
            <button type="button" data-ed-act={b.act} data-label={b.label} data-key={b.key} aria-label={b.key ? `${b.label} (${b.key})` : b.label}>
              <Icon name={b.icon} size={16} />
            </button>
          ))}
        </span>
      ))
    }
  </div>
  <span class="ed-size" data-ed-size></span>
  <input type="file" accept="image/*" class="ed-imgfile" tabindex="-1" aria-hidden="true" data-ed-imgfile />
  <div class="ed-style" hidden data-ed-style>
    <label>{L.color} <input type="color" data-st="color" /></label>
    <label>{L.bg} <input type="color" data-st="bg" /><button type="button" data-st-clear="bg" title={L.none}>∅</button></label>
    <label
      >{L.font}
      <select data-st="font">
        <option value="">{L.fontDefault}</option>
        <option value="heading" style="font-family:Unbounded">Unbounded</option>
        <option value="body" style="font-family:'DM Sans'">DM Sans</option>
        <option value="serif" style="font-family:Georgia">Serif</option>
        <option value="mono" style="font-family:monospace">Mono</option>
        <option value="hand" style="font-family:'Segoe Print','Comic Sans MS',cursive">{L.fontHand}</option>
        <option value="impact" style="font-family:Impact">Impact</option>
      </select>
    </label>
    <label>{L.size} <input type="range" min="10" max="120" step="1" data-st="fs" /><output data-st-out="fs"></output></label>
    <label>{L.weight} <select data-st="fw"><option value="">–</option><option value="400">400</option><option value="700">700</option><option value="900">900</option></select></label>
    <label>{L.radius} <input type="range" min="0" max="80" step="1" data-st="r" /><output data-st-out="r"></output></label>
    <button type="button" class="ed-style__reset" data-st-reset>{L.styleReset}</button>
  </div>
</div>
<!-- the "+" under the element the mouse is over: put something new right there -->
<button type="button" class="ed-addhere" hidden data-dev-ui data-ed-addhere title={L.addHere} aria-label={L.addHere}>＋</button>
<div class="ed-addmenu" hidden data-dev-ui data-ed-addmenu>
  <button type="button" data-ed-addpick="more"><Icon name="copy-plus" size={16} /> {L.more}</button>
  <button type="button" data-ed-addpick="h3"><Icon name="heading" size={16} /> {L.subtitle}</button>
  <button type="button" data-ed-addpick="p"><Icon name="pilcrow" size={16} /> {L.paragraph}</button>
  <button type="button" data-ed-addpick="up"><Icon name="arrow-up" size={16} /> {L.up}</button>
  <button type="button" data-ed-addpick="down"><Icon name="arrow-down" size={16} /> {L.down}</button>
  <button type="button" data-ed-addpick="story" hidden><Icon name="book-open" size={16} /> {L.story}</button>
  <button type="button" data-ed-addpick="trash" class="ed-addmenu__danger"><Icon name="trash-2" size={16} /> {L.trash}</button>
</div>
<!-- drag this to put the element somewhere else among its neighbours -->
<button type="button" class="ed-grip" hidden data-dev-ui data-ed-grip title={L.grip} aria-label={L.grip}>⠿</button>
<span class="ed-dropline" hidden data-dev-ui data-ed-dropline></span>
<dialog class="ed-storybox" data-dev-ui data-ed-storybox>
  <form method="dialog">
    <strong>📖 {L.story}</strong>
    <small>{L.storyHint}</small>
    <textarea rows="8" maxlength="3000" data-ed-storytext></textarea>
    <div><button value="cancel" formnovalidate>✕</button> <button value="ok" class="ed-storybox__ok">{L.save}</button></div>
  </form>
</dialog>
<template data-ed-texts>{JSON.stringify(L)}</template>

<style is:global>
  /* added subtitles and paragraphs (visible for everyone) */
  .ed-added--h3 {
    margin: 0.8em 0 0.4em;
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: 1.2;
  }
  .ed-added--p {
    margin: 0 0 1em;
  }
  :root:not(.dev-mode) [data-ed-hidden] {
    display: none !important;
  }
  :root.dev-mode [data-ed-hidden] {
    opacity: 0.3;
    outline: 2px dashed #ff4d4d;
  }
  :root.ed-placing,
  :root.ed-placing * {
    cursor: copy !important;
  }
  :root.ed-placing .ed-hover {
    outline: none !important;
    box-shadow: 0 6px 0 -2px #39ff14 !important;
  }
  :root.ed-on .ed-hover {
    outline: 2px dashed #39ff14 !important;
    outline-offset: 2px;
    cursor: pointer;
  }
  :root.ed-on [contenteditable='true'] {
    outline: 2px solid #ffd60a !important;
    outline-offset: 3px;
    cursor: text;
  }
  .ed-addmenu__danger {
    color: #ff7b7b !important;
  }
  .ed-grip {
    position: fixed;
    z-index: 679;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 2px solid #39ff14;
    border-radius: 8px;
    background: #000;
    color: #39ff14;
    font: 900 15px/1 ui-monospace, Consolas, monospace;
    cursor: grab;
    touch-action: none;
  }
  .ed-grip[hidden],
  .ed-dropline[hidden] {
    display: none;
  }
  :root.ed-dnd,
  :root.ed-dnd * {
    cursor: grabbing !important;
    user-select: none;
  }
  .ed-dragging {
    opacity: 0.45;
    outline: 3px dashed #39ff14 !important;
  }
  .ed-dropline {
    position: fixed;
    z-index: 2040;
    border-radius: 4px;
    background: #39ff14;
    box-shadow: 0 0 12px #39ff14;
    pointer-events: none;
  }
  .ed-storybox {
    width: min(520px, calc(100vw - 32px));
    padding: 18px;
    border: 2px solid #39ff14;
    border-radius: 16px;
    background: #0d1117;
    color: #d6f5d6;
    font: 14px ui-monospace, Consolas, monospace;
  }
  .ed-storybox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .ed-storybox form {
    display: grid;
    gap: 10px;
  }
  .ed-storybox small {
    color: #8b949e;
  }
  .ed-storybox textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #30363d;
    border-radius: 10px;
    background: #010409;
    color: #e6edf3;
    font: 14px/1.5 'DM Sans', system-ui, sans-serif;
    resize: vertical;
  }
  .ed-storybox div {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .ed-storybox button {
    padding: 8px 14px;
    border: 1px solid #30363d;
    border-radius: 9px;
    background: #161b22;
    color: #d6f5d6;
    font: 700 13px ui-monospace, Consolas, monospace;
    cursor: pointer;
  }
  .ed-storybox .ed-storybox__ok {
    border-color: #39d353;
    background: #39d353;
    color: #000;
  }
  .ed-addhere {
    position: fixed;
    z-index: 679;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 2px solid #000;
    border-radius: 50%;
    background: #39ff14;
    color: #000;
    font: 900 17px/1 ui-monospace, Consolas, monospace;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(57, 255, 20, 0.6);
    transition: transform 120ms ease;
  }
  .ed-addhere:hover {
    transform: scale(1.2);
  }
  .ed-addhere[hidden],
  .ed-addmenu[hidden] {
    display: none;
  }
  .ed-addmenu {
    position: fixed;
    z-index: 2050;
    display: grid;
    gap: 2px;
    min-width: 200px;
    padding: 6px;
    border: 2px solid #39ff14;
    border-radius: 12px;
    background: #0d1117;
    box-shadow: 0 0 18px rgba(57, 255, 20, 0.35);
  }
  .ed-addmenu button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: #d6f5d6;
    font: 700 13px ui-monospace, Consolas, monospace;
    text-align: left;
    cursor: pointer;
  }
  .ed-addmenu button:hover {
    background: rgba(57, 255, 20, 0.16);
    color: #39ff14;
  }
  .ed-frame {
    position: fixed;
    z-index: 680;
    border: 2px solid #39ff14;
    box-shadow: 0 0 0 1px #000, 0 0 14px rgba(57, 255, 20, 0.5);
    cursor: move;
    touch-action: none;
  }
  .ed-frame[hidden] {
    display: none;
  }
  .ed-frame.is-text {
    pointer-events: none;
  }
  .ed-frame.is-text .ed-tools,
  .ed-frame.is-text .ed-h {
    pointer-events: auto;
  }
  .ed-h {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 2px solid #000;
    border-radius: 3px;
    background: #39ff14;
  }
  .ed-h--nw { left: -7px; top: -7px; cursor: nwse-resize; }
  .ed-h--n { left: calc(50% - 6px); top: -7px; cursor: ns-resize; }
  .ed-h--ne { right: -7px; top: -7px; cursor: nesw-resize; }
  .ed-h--e { right: -7px; top: calc(50% - 6px); cursor: ew-resize; }
  .ed-h--se { right: -7px; bottom: -7px; cursor: nwse-resize; }
  .ed-h--s { left: calc(50% - 6px); bottom: -7px; cursor: ns-resize; }
  .ed-h--sw { left: -7px; bottom: -7px; cursor: nesw-resize; }
  .ed-h--w { left: -7px; top: calc(50% - 6px); cursor: ew-resize; }
  .ed-tools {
    position: absolute;
    left: -2px;
    bottom: calc(100% + 8px);
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 3px;
    border: 1px solid #39ff14;
    border-radius: 9px;
    background: #000;
    font: 700 12px ui-monospace, Consolas, monospace;
    white-space: nowrap;
    cursor: default;
  }
  .ed-frame.is-low .ed-tools {
    bottom: auto;
    top: calc(100% + 8px);
  }
  .ed-tools__name {
    padding: 0 6px;
    color: #9be9a8;
  }
  /* the groups, split by thin lines */
  .ed-tools__group {
    display: flex;
    gap: 2px;
    padding: 0 3px;
    border-left: 1px solid #1f6f2a;
  }
  .ed-tools button {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #d6f5d6;
    font: inherit;
    cursor: pointer;
  }
  .ed-tools button:hover,
  .ed-tools button:focus-visible {
    background: #39ff14;
    color: #000;
  }
  .ed-tools [data-ed-act='hide']:hover,
  .ed-tools [data-ed-act='reset']:hover {
    background: #ff6b5e;
  }
  /* invisible but not display:none – some browsers refuse to open a hidden file picker */
  .ed-imgfile {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .ed-style {
    position: absolute;
    left: -2px;
    top: calc(100% + 30px);
    display: grid;
    gap: 6px;
    width: 250px;
    padding: 10px;
    border: 1px solid #39ff14;
    border-radius: 10px;
    background: #000;
    color: #39ff14;
    font: 700 12px ui-monospace, Consolas, monospace;
    cursor: default;
    z-index: 2;
  }
  .ed-frame.is-low .ed-style {
    top: auto;
    bottom: calc(100% + 46px);
  }
  .ed-style[hidden] {
    display: none;
  }
  .ed-style label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .ed-style input[type='color'] {
    width: 44px;
    height: 26px;
    padding: 0;
    border: 1px solid #39ff14;
    background: none;
  }
  .ed-style input[type='range'] {
    flex: 1;
    accent-color: #39ff14;
  }
  .ed-style select,
  .ed-style button {
    padding: 3px 6px;
    border: 1px solid #1f6f2a;
    border-radius: 6px;
    background: #031a08;
    color: #39ff14;
    font: inherit;
  }
  .ed-style output {
    min-width: 28px;
    text-align: right;
  }
  .ed-size {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    padding: 1px 6px;
    border-radius: 6px;
    background: #000;
    color: #39ff14;
    font: 700 11px ui-monospace, Consolas, monospace;
  }
  .ed-frame.is-low .ed-size {
    top: auto;
    bottom: calc(100% + 6px);
  }
</style>

<script>
  import { shrinkToJpeg } from '../lib/githubCommit';

  type Theme = { violet?: string; yellow?: string; bg?: string; ink?: string };
  type Style = { src?: string; x?: number; y?: number; w?: number; h?: number; hidden?: boolean; color?: string; bg?: string; font?: string; fs?: number; fw?: string; r?: number };
  type Added = { id: string; after: string[]; tag?: 'h3' | 'p'; text?: string; clone?: string[]; story?: string };
  type Move = { id: string; path: string[]; after?: string[]; before?: string[] };
  interface Edits {
    style: Record<string, Record<string, Style>>;
    text: Record<string, Record<string, string>>;
    add: Record<string, Added[]>;
    move?: Record<string, Move[]>;
    theme?: Theme;
  }
  interface SiteEdits {
    data: Edits;
    resolve: (p: string[]) => HTMLElement | null;
    pathOf: (el: Element) => string[];
    styleEl: (el: HTMLElement, s: Style) => void;
    added: (a: Added) => HTMLElement | null;
    story: (c: HTMLElement, text: string) => HTMLElement;
    move: (m: Move) => void;
    unmoveAll: () => void;
    applyTheme: (t: Theme) => void;
    page: string;
    full: string;
  }

  const siteEdits = (window as unknown as { __siteEdits?: SiteEdits }).__siteEdits;
  const frameEl = document.querySelector<HTMLElement>('[data-ed-frame]');
  if (siteEdits && frameEl) {
    const api = siteEdits;
    const frame = frameEl;
    const html = document.documentElement;
    const L = JSON.parse(document.querySelector<HTMLTemplateElement>('[data-ed-texts]')!.content.textContent ?? '{}');
    const nameEl = frame.querySelector<HTMLElement>('[data-ed-name]')!;
    const sizeEl = frame.querySelector<HTMLElement>('[data-ed-size]')!;
    const stylePanel = frame.querySelector<HTMLElement>('[data-ed-style]')!;
    const draft: Edits = JSON.parse(JSON.stringify(api.data));
    draft.style[api.page] ??= {};
    draft.text[api.full] ??= {};
    draft.add[api.full] ??= [];
    draft.move ??= {};
    draft.move[api.full] ??= [];
    let dirty = false;
    let sel: HTMLElement | null = null;
    let hover: HTMLElement | null = null;

    const key = (el: Element) => JSON.stringify(api.pathOf(el));
    const styleOf = (el: Element): Style => (draft.style[api.page][key(el)] ??= {});
    draft.theme ??= {};
    // ---- undo / redo: snapshots of the draft ----
    let history = [JSON.stringify(draft)];
    let pos = 0;
    let recordTimer = 0;
    const record = () => {
      window.clearTimeout(recordTimer);
      const snap = JSON.stringify(draft);
      if (snap === history[pos]) return;
      history = history.slice(0, pos + 1);
      history.push(snap);
      if (history.length > 200) history.shift();
      pos = history.length - 1;
    };
    const changed = () => {
      dirty = true;
      window.dispatchEvent(new Event('andras:dev-changed'));
      window.clearTimeout(recordTimer);
      recordTimer = window.setTimeout(record, 350);
    };
    /** show a draft on the page: added elements, texts, styles and colours */
    const show = (prev: Edits, next: Edits) => {
      api.unmoveAll();
      document.querySelectorAll('[data-ed-id]').forEach((n) => n.remove());
      for (const a of next.add[api.full] ?? []) {
        const ref = api.resolve(a.after);
        const n = api.added(a);
        if (ref && n) ref.after(n);
      }
      for (const m of next.move?.[api.full] ?? []) api.move(m);
      const texts = new Set([...Object.keys(prev.text[api.full] ?? {}), ...Object.keys(next.text[api.full] ?? {})]);
      for (const k of texts) {
        const el = api.resolve(JSON.parse(k));
        if (!el) continue;
        const t = next.text[api.full]?.[k];
        if (t !== undefined) {
          el.dataset.edOrig ??= el.textContent ?? '';
          el.textContent = t;
        } else if (el.dataset.edOrig !== undefined) el.textContent = el.dataset.edOrig;
      }
      const styles = new Set([...Object.keys(prev.style[api.page] ?? {}), ...Object.keys(next.style[api.page] ?? {})]);
      for (const k of styles) {
        const el = api.resolve(JSON.parse(k));
        if (!el) continue;
        const st = next.style[api.page]?.[k] ?? {};
        // a replaced picture not yet on the server is shown from memory
        api.styleEl(el, st.src && previews.has(st.src) ? { ...st, src: previews.get(st.src) } : st);
      }
      api.applyTheme(next.theme ?? {});
    };
    const step = (dir: -1 | 1) => {
      stopText();
      record();
      const to = pos + dir;
      if (to < 0 || to >= history.length) return;
      const prev: Edits = JSON.parse(history[pos]);
      const next: Edits = JSON.parse(history[to]);
      pos = to;
      draft.style = next.style;
      draft.text = next.text;
      draft.add = next.add;
      draft.move = next.move ?? {};
      draft.theme = next.theme ?? {};
      draft.style[api.page] ??= {};
      draft.text[api.full] ??= {};
      draft.add[api.full] ??= [];
      draft.move[api.full] ??= [];
      show(prev, next);
      dirty = true;
      window.dispatchEvent(new Event('andras:dev-changed'));
      if (sel && !sel.isConnected) deselect();
      else if (sel) place();
    };
    window.addEventListener('andras:undo', () => step(-1));
    window.addEventListener('andras:redo', () => step(1));
    document.addEventListener('keydown', (e) => {
      if (!html.classList.contains('dev-mode') || editing || !(e.ctrlKey || e.metaKey)) return;
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, select, [contenteditable="true"]')) return;
      const k = e.key.toLowerCase();
      if (k === 'z' && !e.shiftKey) {
        e.preventDefault();
        step(-1);
      } else if (k === 'y' || (k === 'z' && e.shiftKey)) {
        e.preventDefault();
        step(1);
      }
    });

    // ---- the site's colours (developer panel → "Theme colours") ----
    window.addEventListener('andras:theme', (e) => {
      const { key: k, value } = (e as CustomEvent<{ key: keyof Theme; value: string | null }>).detail;
      if (value) draft.theme![k] = value;
      else delete draft.theme![k];
      api.applyTheme(draft.theme!);
      changed();
    });
    (window as unknown as { __editsTheme?: () => Theme }).__editsTheme = () => draft.theme ?? {};

    // ---- pictures put on the page (replaced images): files to commit with the next save ----
    const pendingFiles = new Map<string, string>();
    const previews = new Map<string, string>();
    (window as unknown as { __editsFiles?: () => { path: string; base64: string }[] }).__editsFiles = () =>
      [...pendingFiles].map(([path, base64]) => ({ path, base64 }));
    (window as unknown as { __editsSaved?: () => void }).__editsSaved = () => pendingFiles.clear();
    // DevMode's save bar asks for the file
    (window as unknown as { __editsDraft?: () => string | null }).__editsDraft = () => {
      if (!dirty) return null;
      // drop empty entries
      for (const [k, s] of Object.entries(draft.style[api.page])) if (Object.values(s).every((v) => v === undefined || v === '' || v === 0 || v === false)) delete draft.style[api.page][k];
      return `${JSON.stringify(draft, null, 2)}\n`;
    };

    // developer UI, and the full-screen views that have their own editing (the world map) or none
    const isDevUi = (el: Element) =>
      !!el.closest('[data-dev-ui], .dev-panel, .lay-bar, .dev-plus, .lay-save, .dev-gate, .dev-add-menu, .dev-toast, dialog, .site-header .brand, .map-mode-view, .chaos-view, .country-view, .route-view, .street-view, .cal-view, .site-header .header-tools, .site-header .menu-toggle, .mobile-menu, .hero__status, .gal-folders, .gallery__dev, .gal-place, .music__sort, .music__tags, .music__playlists, .track__edit, .track__del, .track-form, .cal-devbar, .ctr, .ctr-new, .post-media-album, .whiteboard, .nshelf, .races');
    const pickable = (t: EventTarget | null): HTMLElement | null => {
      let el = t instanceof Element ? t : null;
      while (el && !(el instanceof HTMLElement)) el = el.parentElement;
      if (!el || isDevUi(el) || el === document.body || el === html || el.id === 'main') return null;
      return el;
    };
    const textLike = (el: HTMLElement) => /^(H1|H2|H3|H4|H5|H6|P|LI|SPAN|A|FIGCAPTION|BLOCKQUOTE|LABEL|TIME|STRONG|EM|SMALL|BUTTON|DT|DD)$/.test(el.tagName) && !el.querySelector('img, svg, picture, ul, ol, div, p');

    // ---- the frame follows the selected element ----
    const place = () => {
      if (!sel || !sel.isConnected) return deselect();
      const r = sel.getBoundingClientRect();
      const z = Number(getComputedStyle(html).zoom) || 1;
      frame.style.left = `${r.left / z - 3}px`;
      frame.style.top = `${r.top / z - 3}px`;
      frame.style.width = `${r.width / z + 6}px`;
      frame.style.height = `${r.height / z + 6}px`;
      frame.classList.toggle('is-low', r.top / z < 110);
      sizeEl.textContent = `${Math.round(sel.offsetWidth)} × ${Math.round(sel.offsetHeight)}`;
    };
    const select = (el: HTMLElement) => {
      stopText();
      if (el !== sel) stylePanel.hidden = true;
      sel = el;
      frame.hidden = false;
      // what is selected, in a word anyone gets: ¶ a paragraph, H a title, 🖼 a picture, ▭ a box …
      const KIND: Record<string, string> = { P: '¶', H1: 'H1', H2: 'H2', H3: 'H3', H4: 'H4', IMG: '🖼', PICTURE: '🖼', VIDEO: '▶', A: '🔗', BUTTON: '⏺', LI: '•', UL: '☰', OL: '☰', SECTION: '▭', FIGURE: '🖼' };
      nameEl.textContent = el.dataset.lay ?? (el.id ? `#${el.id}` : (KIND[el.tagName] ?? '▭'));
      place();
    };
    function deselect() {
      stylePanel.hidden = true;
      stopText();
      sel = null;
      frame.hidden = true;
    }
    addEventListener('scroll', () => sel && place(), true);
    addEventListener('resize', () => sel && place());

    // ---- edit mode on/off (follows developer mode; the panel button switches it) ----
    const setOn = (on: boolean) => {
      html.classList.toggle('ed-on', on);
      if (!on) {
        deselect();
        hover?.classList.remove('ed-hover');
        addBtn.hidden = true;
        gripBtn.hidden = true;
        addMenu.hidden = true;
      }
    };
    new MutationObserver(() => {
      const dev = html.classList.contains('dev-mode');
      if (!dev && html.classList.contains('ed-on')) setOn(false);
    }).observe(html, { attributes: true, attributeFilter: ['class'] });
    window.addEventListener('andras:edit-toggle', (e) => setOn((e as CustomEvent<boolean>).detail));
    // developer mode may already be on when this script runs (saved in this browser)
    if (html.classList.contains('dev-mode')) setOn(true);

    const addBtn = document.querySelector<HTMLButtonElement>('[data-ed-addhere]')!;
    const addMenu = document.querySelector<HTMLElement>('[data-ed-addmenu]')!;
    const gripBtn = document.querySelector<HTMLButtonElement>('[data-ed-grip]')!;
    const dropLine = document.querySelector<HTMLElement>('[data-ed-dropline]')!;
    let addFor: HTMLElement | null = null;
    // an item of a list (a card, a plan note …) first – then a paragraph / heading
    const ITEMS = 'li, article, figure, .card';
    const BLOCKS = 'p, h1, h2, h3, h4, blockquote, dt, dd, .ed-added';
    const showAdd = (el: HTMLElement | null) => {
      const block = el?.closest<HTMLElement>(ITEMS) ?? el?.closest<HTMLElement>(BLOCKS) ?? el;
      if (!block || !pickable(block) || editing) {
        addBtn.hidden = true;
        gripBtn.hidden = true;
        return;
      }
      addFor = block;
      const z = Number(getComputedStyle(html).zoom) || 1;
      const r = block.getBoundingClientRect();
      addBtn.style.left = `${(r.left + r.width / 2) / z - 13}px`;
      addBtn.style.top = `${r.bottom / z - 13}px`;
      addBtn.hidden = false;
      gripBtn.style.left = `${(r.left + r.width / 2) / z - 45}px`;
      gripBtn.style.top = `${r.bottom / z - 13}px`;
      gripBtn.hidden = !neighbour(block, -1) && !neighbour(block, 1);
    };
    addBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      // a copy (a new plan / card) can get its own longer story
      addMenu.querySelector<HTMLButtonElement>('[data-ed-addpick="story"]')!.hidden = !addedItem(addFor)?.clone;
      const r = addBtn.getBoundingClientRect();
      const z = Number(getComputedStyle(html).zoom) || 1;
      addMenu.hidden = false;
      addMenu.style.left = `${Math.min(window.innerWidth / z - 230, r.left / z)}px`;
      addMenu.style.top = `${Math.min(window.innerHeight / z - 220, r.bottom / z + 4)}px`;
    });
    addMenu.querySelectorAll<HTMLButtonElement>('[data-ed-addpick]').forEach((b) =>
      b.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        addMenu.hidden = true;
        addBtn.hidden = true;
        const el = addFor;
        if (!el?.isConnected) return;
        const pick = b.dataset.edAddpick;
        if (pick === 'more') cloneAfter(el, el);
        else if (pick === 'h3' || pick === 'p') insertAfter(pick, el);
        else if (pick === 'trash') trash(el);
        else if (pick === 'story') editStory(el);
        else moveEl(el, pick === 'up' ? -1 : 1);
      }),
    );
    document.addEventListener('pointerdown', (e) => {
      if (!(e.target instanceof Element) || !e.target.closest('[data-ed-addmenu], [data-ed-addhere]')) addMenu.hidden = true;
    });
    addEventListener('scroll', () => {
      if (dnd) return;
      addBtn.hidden = true;
      gripBtn.hidden = true;
      addMenu.hidden = true;
    }, true);

    // ---- drag and drop: ⠿ takes the element to another place among its neighbours ----
    let dnd: { el: HTMLElement; target: Element | null; side: 'before' | 'after' } | null = null;
    const siblingsOf = (el: HTMLElement) =>
      Array.from(el.parentElement?.children ?? []).filter(
        (s) => s !== el && !s.hasAttribute('data-ed-ph') && !isDevUi(s) && !/^(SCRIPT|STYLE|TEMPLATE)$/.test(s.tagName) && !s.classList.contains('dev-plus') && !s.classList.contains('lay-bar') && (s as HTMLElement).offsetParent !== null,
      );
    gripBtn.addEventListener('pointerdown', (e) => {
      if (!addFor) return;
      e.preventDefault();
      e.stopPropagation();
      gripBtn.setPointerCapture(e.pointerId);
      dnd = { el: addFor, target: null, side: 'after' };
      addFor.classList.add('ed-dragging');
      addBtn.hidden = true;
      addMenu.hidden = true;
      html.classList.add('ed-dnd');
    });
    gripBtn.addEventListener('pointermove', (e) => {
      if (!dnd) return;
      const z = Number(getComputedStyle(html).zoom) || 1;
      gripBtn.style.left = `${e.clientX / z - 16}px`;
      gripBtn.style.top = `${e.clientY / z - 16}px`;
      const sibs = siblingsOf(dnd.el);
      if (!sibs.length) return;
      // the nearest neighbour; side by the layout (a row of cards: left / right, a column: above / below)
      let best: Element = sibs[0];
      let bd = Infinity;
      for (const s of sibs) {
        const r = s.getBoundingClientRect();
        const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right);
        const dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
        const d = Math.hypot(dx, dy);
        if (d < bd) {
          bd = d;
          best = s;
        }
      }
      const r = best.getBoundingClientRect();
      const row = sibs.some((s) => s !== best && Math.abs(s.getBoundingClientRect().top - r.top) < 12);
      const side = row ? (e.clientX < r.left + r.width / 2 ? 'before' : 'after') : e.clientY < r.top + r.height / 2 ? 'before' : 'after';
      dnd.target = best;
      dnd.side = side;
      dropLine.hidden = false;
      dropLine.classList.toggle('is-v', row);
      if (row) {
        dropLine.style.left = `${(side === 'before' ? r.left - 6 : r.right + 2) / z}px`;
        dropLine.style.top = `${r.top / z}px`;
        dropLine.style.width = '4px';
        dropLine.style.height = `${r.height / z}px`;
      } else {
        dropLine.style.left = `${r.left / z}px`;
        dropLine.style.top = `${(side === 'before' ? r.top - 6 : r.bottom + 2) / z}px`;
        dropLine.style.width = `${r.width / z}px`;
        dropLine.style.height = '4px';
      }
    });
    const endDnd = () => {
      if (!dnd) return;
      const { el, target, side } = dnd;
      dnd = null;
      el.classList.remove('ed-dragging');
      html.classList.remove('ed-dnd');
