      gripBtn.hidden = true;
      if (target) moveTo(el, target as HTMLElement, side);
    };
    gripBtn.addEventListener('pointerup', endDnd);
    gripBtn.addEventListener('pointercancel', endDnd);

    document.addEventListener('mouseover', (e) => {
      if (!html.classList.contains('ed-on') || drag || dnd) return;
      // the "+" (and its menu) keep the element they belong to
      if (e.target instanceof Element && e.target.closest('[data-ed-addhere], [data-ed-addmenu], [data-ed-grip]')) return;
      if (addMenu.hidden) showAdd(pickable(e.target));
