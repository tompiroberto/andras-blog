      draft.text[api.full] ??= {};
      draft.add[api.full] ??= [];
      draft.move![api.full] ??= [];
      history = [JSON.stringify(draft)];
      pos = 0;
    });
    const short = (s: string | null | undefined) => {
      const t = (s ?? '').replace(/\s+/g, ' ').trim();
      return t.length > 42 ? `${t.slice(0, 40)}…` : t;
    };
    const nameOf = (path: string[] | string) => {
      const el = api.resolve(typeof path === 'string' ? JSON.parse(path) : path);
      return el ? `„${short(el.querySelector('h3, h2, strong')?.textContent || el.textContent) || el.tagName.toLowerCase()}”` : '';
    };
    (window as unknown as { __editsLog?: () => string[] }).__editsLog = () => {
      if (!dirty) return [];
      const out: string[] = [];
      const was = original.add[api.full] ?? [];
      for (const a of draft.add[api.full]) {
        const o = was.find((x) => x.id === a.id);
        if (!o) out.push(a.clone ? `${L.logCopy} ${nameOf([`ed:${a.id}`])}` : `${L.logAdd} „${short(a.text)}”`);
        else if (o.text !== a.text && a.text) out.push(`${L.logText} „${short(a.text)}”`);
        if ((o?.story ?? '') !== (a.story ?? '')) out.push(`${L.logStory} ${nameOf([`ed:${a.id}`])}`);
      }
      for (const o of was) if (!draft.add[api.full].some((x) => x.id === o.id)) out.push(`${L.logDel} „${short(o.text) || '…'}”`);
      const t0 = original.text[api.full] ?? {};
      for (const [k, v] of Object.entries(draft.text[api.full])) if (t0[k] !== v) out.push(`${L.logText} „${short(v)}”`);
      const s0 = original.style[api.page] ?? {};
      for (const [k, s] of Object.entries(draft.style[api.page])) {
        const o = s0[k] ?? {};
        if (JSON.stringify(o) === JSON.stringify(s)) continue;
        const n = nameOf(k);
        if (!!o.hidden !== !!s.hidden) out.push(`${L.logHide} ${n}`);
        if ((o.src ?? '') !== (s.src ?? '')) out.push(`${L.logImg} ${n}`);
        if (o.x !== s.x || o.y !== s.y || o.w !== s.w || o.h !== s.h) out.push(`${L.logPos} ${n}`);
        if (o.color !== s.color || o.bg !== s.bg || o.font !== s.font || o.fs !== s.fs || o.fw !== s.fw || o.r !== s.r) out.push(`${L.logStyle} ${n}`);
      }
      const m0 = original.move?.[api.full]?.length ?? 0;
      const moved = new Set(draft.move![api.full].slice(m0).map((m) => JSON.stringify(m.path)));
      for (const p of moved) out.push(`${L.logOrder} ${nameOf(p)}`);
      if (JSON.stringify(original.theme ?? {}) !== JSON.stringify(draft.theme ?? {})) out.push(L.logTheme);
      return out;
    };

    function insertAfter(tag: 'h3' | 'p', after: HTMLElement) {
      const item: Added = { id: Date.now().toString(36), after: api.pathOf(after), tag, text: tag === 'h3' ? L.newSubtitle : L.newParagraph };
      const n = api.added(item);
      if (!n) return;
      draft.add[api.full].push(item);
      after.after(n);
      changed();
      select(n);
      startText();
    }
    function cloneAfter(source: HTMLElement, after: HTMLElement) {
      const item: Added = { id: Date.now().toString(36), after: api.pathOf(after), clone: api.pathOf(source) };
      const n = api.added(item);
      if (!n) return;
      draft.add[api.full].push(item);
      after.after(n);
      changed();
      // straight into its title, so the new card / plan gets its own text
      const title = n.querySelector<HTMLElement>('h3, h2, strong') ?? n;
      select(title);
      startText();
    }
    window.addEventListener('andras:insert', (e) => {
      const d = (e as CustomEvent<{ tag?: 'h3' | 'p'; after?: HTMLElement; clone?: HTMLElement }>).detail;
      setOn(true);
      if (d.clone && d.after) return cloneAfter(d.clone, d.after);
      if (d.tag && d.after) return insertAfter(d.tag, d.after);
      if (d.tag) {
        placing = d.tag;
        html.classList.add('ed-placing');
      }
    });
    document.addEventListener(
      'click',
      (e) => {
        if (!placing) return;
        const el = pickable(e.target);
        if (!el) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        const tag = placing;
        placing = null;
        html.classList.remove('ed-placing');
        insertAfter(tag, el);
      },
      true,
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && placing) {
        placing = null;
        html.classList.remove('ed-placing');
      }
    });

    // double-click on the selected element (the frame lies over it) rewrites its text
    frame.addEventListener('dblclick', (e) => {
      if ((e.target as Element).closest('[data-ed-tools]')) return;
      startText();
    });
    frame.querySelectorAll<HTMLButtonElement>('[data-ed-act]').forEach((b) => {
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        act(b.dataset.edAct!);
      });
    });

    // ---- replace a picture: the 🖼 button, or drop a file onto any picture ----
    const imgFile = frame.querySelector<HTMLInputElement>('[data-ed-imgfile]')!;
    const replaceImage = async (img: HTMLElement, file: File) => {
      const base64 = await shrinkToJpeg(file, 2000).catch(() => null);
      if (!base64) return;
      const path = `public/uploads/${Date.now().toString(36)}.jpg`;
      pendingFiles.set(path, base64);
      const s = styleOf(img);
      s.src = path.replace(/^public/, '');
      // until the site is rebuilt the new file only exists here: show it from memory
      previews.set(s.src, `data:image/jpeg;base64,${base64}`);
      api.styleEl(img, { ...s, src: previews.get(s.src) });
      changed();
      if (sel === img) place();
    };
    imgFile.addEventListener('change', () => {
      const f = imgFile.files?.[0];
      if (f && sel) void replaceImage(sel, f);
      imgFile.value = '';
    });
    document.addEventListener('dragover', (e) => {
      if (html.classList.contains('ed-on') && (e.target as Element).closest?.('img')) e.preventDefault();
    });
    document.addEventListener('drop', (e) => {
      const img = (e.target as Element).closest?.('img') as HTMLElement | null;
      const f = e.dataTransfer?.files?.[0];
      if (!html.classList.contains('ed-on') || !img || !f || !f.type.startsWith('image/')) return;
      e.preventDefault();
      select(img);
      void replaceImage(img, f);
    });

    // ---- colours, font, size, weight, corners ----
    const toHex = (c: string) => {
      const m = c.match(/\d+(\.\d+)?/g);
      if (!m || m.length < 3 || (m.length > 3 && Number(m[3]) === 0)) return '#ffffff';
      return `#${m.slice(0, 3).map((n) => Math.round(Number(n)).toString(16).padStart(2, '0')).join('')}`;
    };
    function fillStylePanel() {
      if (!sel) return;
      const s = styleOf(sel);
      const cs = getComputedStyle(sel);
      const set = (k: string, v: string) => {
        const input = stylePanel.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-st="${k}"]`)!;
        input.value = v;
        const out = stylePanel.querySelector(`[data-st-out="${k}"]`);
        if (out) out.textContent = v;
      };
      set('color', s.color ?? toHex(cs.color));
      set('bg', s.bg ?? toHex(cs.backgroundColor));
      set('font', s.font ?? '');
      set('fs', String(s.fs ?? Math.round(parseFloat(cs.fontSize))));
      set('fw', s.fw ?? '');
      set('r', String(s.r ?? Math.round(parseFloat(cs.borderTopLeftRadius) || 0)));
    }
    stylePanel.addEventListener('pointerdown', (e) => e.stopPropagation());
    stylePanel.addEventListener('click', (e) => e.stopPropagation());
    stylePanel.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-st]').forEach((input) =>
      input.addEventListener('input', () => {
        if (!sel) return;
        const s = styleOf(sel) as Record<string, unknown>;
        const k = input.dataset.st!;
        s[k] = input.type === 'range' ? Number(input.value) : input.value || undefined;
        const out = stylePanel.querySelector(`[data-st-out="${k}"]`);
        if (out) out.textContent = input.value;
        api.styleEl(sel, s as Style);
        changed();
        place();
      }),
    );
    stylePanel.querySelector('[data-st-clear="bg"]')!.addEventListener('click', () => {
      if (!sel) return;
      delete styleOf(sel).bg;
      api.styleEl(sel, styleOf(sel));
      changed();
      fillStylePanel();
    });
    stylePanel.querySelector('[data-st-reset]')!.addEventListener('click', () => {
      if (!sel) return;
      const s = styleOf(sel);
      for (const k of ['color', 'bg', 'font', 'fs', 'fw', 'r'] as const) delete s[k];
      api.styleEl(sel, s);
      changed();
      fillStylePanel();
      place();
    });

    // ---- move (drag the frame) and resize (drag a handle) ----
    let drag: { mode: string; px: number; py: number; s0: Style; w0: number; h0: number; k: number; ratio: number; moved?: boolean } | null = null;
    frame.addEventListener('pointerdown', (e) => {
      if (!sel || (e.target as Element).closest('[data-ed-tools]')) return;
      e.preventDefault();
      const handle = (e.target as HTMLElement).dataset.h;
      const r = sel.getBoundingClientRect();
      const w0 = sel.offsetWidth || r.width;
      const h0 = sel.offsetHeight || r.height;
      drag = { mode: handle ?? 'move', px: e.clientX, py: e.clientY, s0: { ...styleOf(sel) }, w0, h0, k: r.width / (w0 || 1) || 1, ratio: w0 / (h0 || 1) };
      frame.setPointerCapture(e.pointerId);
    });
    frame.addEventListener('pointermove', (e) => {
      if (!drag || !sel) return;
      const dx = (e.clientX - drag.px) / drag.k;
      const dy = (e.clientY - drag.py) / drag.k;
      if (!drag.moved && Math.abs(dx) + Math.abs(dy) < 3) return;
      drag.moved = true;
      const s = styleOf(sel);
      const m = drag.mode;
      if (m === 'move') {
        s.x = Math.round((drag.s0.x ?? 0) + dx);
        s.y = Math.round((drag.s0.y ?? 0) + dy);
      } else {
        let w = drag.w0 + (m.includes('e') ? dx : m.includes('w') ? -dx : 0);
        let h = drag.h0 + (m.includes('s') ? dy : m.includes('n') ? -dy : 0);
        w = Math.max(24, w);
        h = Math.max(16, h);
        // corners of pictures keep the proportions (like PowerPoint); hold Shift to stretch freely
        const media = /^(IMG|PICTURE|VIDEO|FIGURE)$/.test(sel.tagName);
        if (media && m.length === 2 && !e.shiftKey) h = w / drag.ratio;
        if (m.includes('e') || m.includes('w')) s.w = Math.round(w);
        if (m.includes('n') || m.includes('s') || (media && m.length === 2)) s.h = Math.round(h);
        if (m.includes('w')) s.x = Math.round((drag.s0.x ?? 0) + (drag.w0 - w));
        if (m.includes('n')) s.y = Math.round((drag.s0.y ?? 0) + (drag.h0 - h));
      }
      api.styleEl(sel, s);
      place();
    });
    frame.addEventListener('pointerup', () => {
      if (drag?.moved) changed();
      drag = null;
    });
  }
</script>
