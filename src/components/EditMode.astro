        }
        e.preventDefault();
        e.stopPropagation();
        select(el);
      },
      true,
    );
    document.addEventListener(
      'dblclick',
      (e) => {
        if (!html.classList.contains('ed-on')) return;
        const el = pickable(e.target);
        if (!el) return;
        e.preventDefault();
        e.stopPropagation();
        select(el);
        startText();
      },
      true,
    );

    // ---- text editing ----
    let editing: HTMLElement | null = null;
    function startText() {
      if (!sel) return;
      if (!textLike(sel)) {
        const inner = Array.from(sel.querySelectorAll<HTMLElement>('h1,h2,h3,h4,p,li,span,a,figcaption')).find(textLike);
        if (!inner) return;
        select(inner);
      }
      editing = sel!;
      editing.dataset.edOrig ??= editing.textContent ?? '';
      editing.contentEditable = 'true';
      frame.classList.add('is-text');
      editing.focus();
      const range = document.createRange();
      range.selectNodeContents(editing);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
    }
    function stopText() {
      if (!editing) return;
      const el = editing;
      editing = null;
      el.contentEditable = 'false';
      el.removeAttribute('contenteditable');
      frame.classList.remove('is-text');
      const txt = (el.textContent ?? '').replace(/\s+/g, ' ').trim();
      el.textContent = txt;
      if (el.dataset.edId) {
        const a = draft.add[api.full].find((x) => x.id === el.dataset.edId);
        if (a && a.text !== txt) {
          a.text = txt;
          changed();
        }
      } else if (txt !== (el.dataset.edOrig ?? '').replace(/\s+/g, ' ').trim()) {
        draft.text[api.full][key(el)] = txt;
        changed();
      }
    }
    document.addEventListener('keydown', (e) => {
      if (editing) {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          stopText();
          place();
        }
        if (e.key === 'Escape') stopText();
        // inside a button (a plan note, a card) the space key would press the button instead of typing
        if (e.key === ' ' && editing?.closest('button')) {
          e.preventDefault();
          document.execCommand('insertText', false, ' ');
        }
        return;
      }
      if (!sel || !html.classList.contains('ed-on')) return;
      // the usual keys keep working in fields (copy, paste, select all, delete a letter …)
      if ((e.target as HTMLElement).closest?.('input, textarea, select, [contenteditable="true"]')) return;
      const mod = e.ctrlKey || e.metaKey;
      const k = e.key.toLowerCase();
      // Ctrl+D: a copy · Enter / F2: rewrite the text · Alt+↑ / Alt+↓: order · Del / Backspace: hide
      if (mod && k === 'd') {
        e.preventDefault();
        return act('dup');
      }
      if ((e.key === 'Enter' || e.key === 'F2') && !mod) {
        e.preventDefault();
        return act('text');
      }
      if (e.altKey && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
        e.preventDefault();
        return act(e.key === 'ArrowUp' ? 'up' : 'down');
      }
      if (e.key === 'Backspace' && !mod) {
        e.preventDefault();
        return act('hide');
      }
      if (mod) return;
      const step = e.shiftKey ? 10 : 1;
      const moves: Record<string, [number, number]> = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
      if (moves[e.key]) {
        e.preventDefault();
        const s = styleOf(sel);
        s.x = (s.x ?? 0) + moves[e.key][0];
        s.y = (s.y ?? 0) + moves[e.key][1];
        api.styleEl(sel, s);
        changed();
        place();
      } else if (e.key === 'Delete') {
        act('hide');
      } else if (e.key === 'Escape') {
        deselect();
      }
    });

    // ---- toolbar ----
    function act(a: string) {
      if (!sel) return;
      if (a === 'close') return deselect();
      if (a === 'parent') {
        const p = pickable(sel.parentElement);
        if (p) select(p);
        return;
      }
      if (a === 'text') return startText();
      if (a === 'dup') {
        // a copy right after it: a new card, a new plan note … (texts can be rewritten, the copy moved)
        const item: Added = { id: Date.now().toString(36), after: api.pathOf(sel), clone: api.pathOf(sel) };
        const n = api.added(item);
        if (!n) return;
        draft.add[api.full].push(item);
        sel.after(n);
        changed();
        return select(n);
      }
      if (a === 'up' || a === 'down') return moveEl(sel, a === 'up' ? -1 : 1);
      if (a === 'img') {
        const img = sel.tagName === 'IMG' ? sel : sel.querySelector<HTMLElement>('img');
        if (!img) return void (sizeEl.textContent = L.noImg);
        select(img);
        imgFile.click();
        return;
      }
      if (a === 'style') {
        stylePanel.hidden = !stylePanel.hidden;
        if (!stylePanel.hidden) fillStylePanel();
        return;
      }
      if (a === 'hide') {
        const s = styleOf(sel);
        s.hidden = !s.hidden;
        api.styleEl(sel, s);
        changed();
        return place();
      }
      if (a === 'reset') {
        if (sel.dataset.edId) {
          draft.add[api.full] = draft.add[api.full].filter((x) => x.id !== sel!.dataset.edId);
          sel.remove();
          changed();
          return deselect();
        }
        const k = key(sel);
        delete draft.style[api.page][k];
        api.styleEl(sel, {});
        if (draft.text[api.full][k] !== undefined) {
          delete draft.text[api.full][k];
          if (sel.dataset.edOrig !== undefined) sel.textContent = sel.dataset.edOrig;
        }
        changed();
        return place();
      }
      if (a === 'h3' || a === 'p') {
        const item: Added = { id: Date.now().toString(36), after: api.pathOf(sel), tag: a, text: a === 'h3' ? L.newSubtitle : L.newParagraph };
        const n = api.added(item);
        if (!n) return;
        draft.add[api.full].push(item);
        sel.after(n);
        changed();
        select(n);
        startText();
      }
    }
    /**
     * Insert a subtitle / paragraph after an element, or a copy of a card (a new plan note, a new Explore
     * card) – asked for by DevMode (the panel buttons, the "+" menus):
     *   andras:insert { tag: 'h3' | 'p', after?: Element }  – without "after": click where it should go
     *   andras:insert { clone: Element, after: Element }
     */
    let placing: 'h3' | 'p' | null = null;
    /** the neighbour that counts (no stand-ins, scripts or developer buttons) */
    const neighbour = (el: Element, dir: -1 | 1) => {
      let s = dir < 0 ? el.previousElementSibling : el.nextElementSibling;
      while (s && (s.hasAttribute('data-ed-ph') || isDevUi(s) || /^(SCRIPT|STYLE|TEMPLATE)$/.test(s.tagName) || s.classList.contains('dev-plus') || s.classList.contains('lay-bar')))
        s = dir < 0 ? s.previousElementSibling : s.nextElementSibling;
      return s;
    };
    /** ▲ / ▼: swap with the neighbour (a new order for cards, plans, paragraphs …) */
    function moveEl(el: HTMLElement, dir: -1 | 1) {
