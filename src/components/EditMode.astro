      if (to) moveTo(el, to as HTMLElement, dir > 0 ? 'after' : 'before');
    }
    function moveTo(el: HTMLElement, to: HTMLElement, side: 'before' | 'after') {
      if (to === el || (side === 'after' && neighbour(el, -1) === to) || (side === 'before' && neighbour(el, 1) === to)) return;
      const m: Move = { id: el.dataset.edMv ?? Date.now().toString(36), path: api.pathOf(el), ...(side === 'after' ? { after: api.pathOf(to) } : { before: api.pathOf(to) }) };
      draft.move![api.full].push(m);
      api.move(m);
      changed();
      select(el);
    }
    /** the draft entry of an element added on the page (a subtitle, a paragraph, a copy) */
    function addedItem(el: HTMLElement | null) {
      const id = el?.dataset.edId;
      return id ? draft.add[api.full].find((x) => x.id === id) : undefined;
    }
