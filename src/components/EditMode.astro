---
/**
 * Developer mode → editing on the page, PowerPoint-style: click anything to select it (a frame with
 * eight handles), drag to move, drag a handle to resize (corners of pictures keep the proportions),
 * double-click a text to rewrite it, add a subtitle or a paragraph after the selected element, hide it,
 * or reset it. The edits live in a draft of src/data/edits.json (applied by src/components/SiteEdits.astro);
 * DevMode's save bar commits it. Arrow keys nudge (Shift: 10 px), Delete hides, Esc deselects.
 */
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = {
  dup: t(lang, 'ed.dup'),
  img: t(lang, 'ed.img'),
  noImg: t(lang, 'ed.noImg'),
  style: t(lang, 'ed.style'),
  color: t(lang, 'ed.color'),
  bg: t(lang, 'ed.bg'),
  none: t(lang, 'ed.none'),
  font: t(lang, 'ed.font'),
  fontDefault: t(lang, 'ed.fontDefault'),
  fontHand: t(lang, 'ed.fontHand'),
  size: t(lang, 'ed.size'),
  weight: t(lang, 'ed.weight'),
  radius: t(lang, 'ed.radius'),
  styleReset: t(lang, 'ed.styleReset'),
  parent: t(lang, 'ed.parent'),
  text: t(lang, 'ed.text'),
  subtitle: t(lang, 'ed.subtitle'),
  paragraph: t(lang, 'ed.paragraph'),
  hide: t(lang, 'ed.hide'),
  reset: t(lang, 'ed.reset'),
  close: t(lang, 'facts.close'),
  newSubtitle: t(lang, 'ed.newSubtitle'),
  newParagraph: t(lang, 'ed.newParagraph'),
};
---

<div class="ed-frame" hidden data-dev-ui data-ed-frame>
  {['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'].map((h) => <span class={`ed-h ed-h--${h}`} data-h={h} />)}
  <div class="ed-tools" data-ed-tools>
    <span class="ed-tools__name" data-ed-name></span>
    <button type="button" data-ed-act="parent" title={L.parent}>⬑</button>
    <button type="button" data-ed-act="text" title={L.text}>✎</button>
    <button type="button" data-ed-act="h3" title={L.subtitle}>＋H</button>
    <button type="button" data-ed-act="p" title={L.paragraph}>＋¶</button>
    <button type="button" data-ed-act="style" title={L.style}>🎨</button>
    <button type="button" data-ed-act="dup" title={L.dup}>⧉</button>
    <button type="button" data-ed-act="img" title={L.img}>🖼</button>
    <button type="button" data-ed-act="hide" title={L.hide}>👁</button>
    <button type="button" data-ed-act="reset" title={L.reset}>↺</button>
    <button type="button" data-ed-act="close" title={L.close}>✕</button>
  </div>
  <span class="ed-size" data-ed-size></span>
  <input type="file" accept="image/*" class="ed-imgfile" tabindex="-1" aria-hidden="true" data-ed-imgfile />
  <div class="ed-style" hidden data-ed-style>
    <label>{L.color} <input type="color" data-st="color" /></label>
    <label>{L.bg} <input type="color" data-st="bg" /><button type="button" data-st-clear="bg" title={L.none}>∅</button></label>
    <label
      >{L.font}
      <select data-st="font">
        <option value="">{L.fontDefault}</option>
        <option value="heading" style="font-family:Unbounded">Unbounded</option>
        <option value="body" style="font-family:'DM Sans'">DM Sans</option>
        <option value="serif" style="font-family:Georgia">Serif</option>
        <option value="mono" style="font-family:monospace">Mono</option>
        <option value="hand" style="font-family:'Segoe Print','Comic Sans MS',cursive">{L.fontHand}</option>
        <option value="impact" style="font-family:Impact">Impact</option>
      </select>
    </label>
    <label>{L.size} <input type="range" min="10" max="120" step="1" data-st="fs" /><output data-st-out="fs"></output></label>
    <label>{L.weight} <select data-st="fw"><option value="">–</option><option value="400">400</option><option value="700">700</option><option value="900">900</option></select></label>
    <label>{L.radius} <input type="range" min="0" max="80" step="1" data-st="r" /><output data-st-out="r"></output></label>
    <button type="button" class="ed-style__reset" data-st-reset>{L.styleReset}</button>
  </div>
</div>
<template data-ed-texts>{JSON.stringify(L)}</template>

<style is:global>
  /* added subtitles and paragraphs (visible for everyone) */
  .ed-added--h3 {
    margin: 0.8em 0 0.4em;
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: 1.2;
  }
  .ed-added--p {
    margin: 0 0 1em;
  }
  :root:not(.dev-mode) [data-ed-hidden] {
    display: none !important;
  }
  :root.dev-mode [data-ed-hidden] {
    opacity: 0.3;
    outline: 2px dashed #ff4d4d;
  }
  :root.ed-on .ed-hover {
    outline: 2px dashed #39ff14 !important;
    outline-offset: 2px;
    cursor: pointer;
  }
  :root.ed-on [contenteditable='true'] {
    outline: 2px solid #ffd60a !important;
    outline-offset: 3px;
    cursor: text;
  }
  .ed-frame {
    position: fixed;
    z-index: 680;
    border: 2px solid #39ff14;
    box-shadow: 0 0 0 1px #000, 0 0 14px rgba(57, 255, 20, 0.5);
    cursor: move;
    touch-action: none;
  }
  .ed-frame[hidden] {
    display: none;
  }
  .ed-frame.is-text {
    pointer-events: none;
  }
  .ed-frame.is-text .ed-tools,
  .ed-frame.is-text .ed-h {
    pointer-events: auto;
  }
  .ed-h {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 2px solid #000;
    border-radius: 3px;
    background: #39ff14;
  }
  .ed-h--nw { left: -7px; top: -7px; cursor: nwse-resize; }
  .ed-h--n { left: calc(50% - 6px); top: -7px; cursor: ns-resize; }
  .ed-h--ne { right: -7px; top: -7px; cursor: nesw-resize; }
  .ed-h--e { right: -7px; top: calc(50% - 6px); cursor: ew-resize; }
  .ed-h--se { right: -7px; bottom: -7px; cursor: nwse-resize; }
  .ed-h--s { left: calc(50% - 6px); bottom: -7px; cursor: ns-resize; }
  .ed-h--sw { left: -7px; bottom: -7px; cursor: nesw-resize; }
  .ed-h--w { left: -7px; top: calc(50% - 6px); cursor: ew-resize; }
  .ed-tools {
    position: absolute;
    left: -2px;
    bottom: calc(100% + 8px);
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 3px;
    border: 1px solid #39ff14;
    border-radius: 9px;
    background: #000;
    font: 700 12px ui-monospace, Consolas, monospace;
    white-space: nowrap;
    cursor: default;
  }
  .ed-frame.is-low .ed-tools {
    bottom: auto;
    top: calc(100% + 8px);
  }
  .ed-tools__name {
    padding: 0 6px;
    color: #9be9a8;
  }
  .ed-tools button {
    min-width: 28px;
    height: 28px;
    padding: 0 6px;
    border: 1px solid #1f6f2a;
    border-radius: 6px;
    background: #031a08;
    color: #39ff14;
    font: inherit;
    cursor: pointer;
  }
  .ed-tools button:hover,
  .ed-tools button:focus-visible {
    background: #39ff14;
    color: #000;
  }
  /* invisible but not display:none – some browsers refuse to open a hidden file picker */
  .ed-imgfile {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .ed-style {
    position: absolute;
    left: -2px;
    top: calc(100% + 30px);
    display: grid;
    gap: 6px;
    width: 250px;
    padding: 10px;
    border: 1px solid #39ff14;
    border-radius: 10px;
    background: #000;
    color: #39ff14;
    font: 700 12px ui-monospace, Consolas, monospace;
    cursor: default;
    z-index: 2;
  }
  .ed-frame.is-low .ed-style {
    top: auto;
    bottom: calc(100% + 46px);
  }
  .ed-style[hidden] {
    display: none;
  }
  .ed-style label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .ed-style input[type='color'] {
    width: 44px;
    height: 26px;
    padding: 0;
    border: 1px solid #39ff14;
    background: none;
  }
  .ed-style input[type='range'] {
    flex: 1;
    accent-color: #39ff14;
  }
  .ed-style select,
  .ed-style button {
    padding: 3px 6px;
    border: 1px solid #1f6f2a;
    border-radius: 6px;
    background: #031a08;
    color: #39ff14;
    font: inherit;
  }
  .ed-style output {
    min-width: 28px;
    text-align: right;
  }
  .ed-size {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    padding: 1px 6px;
    border-radius: 6px;
    background: #000;
    color: #39ff14;
    font: 700 11px ui-monospace, Consolas, monospace;
  }
  .ed-frame.is-low .ed-size {
    top: auto;
    bottom: calc(100% + 6px);
  }
</style>

<script>
  import { shrinkToJpeg } from '../lib/githubCommit';

  type Theme = { violet?: string; yellow?: string; bg?: string; ink?: string };
  type Style = { src?: string; x?: number; y?: number; w?: number; h?: number; hidden?: boolean; color?: string; bg?: string; font?: string; fs?: number; fw?: string; r?: number };
  type Added = { id: string; after: string[]; tag?: 'h3' | 'p'; text?: string; clone?: string[] };
  interface Edits {
    style: Record<string, Record<string, Style>>;
    text: Record<string, Record<string, string>>;
    add: Record<string, Added[]>;
    theme?: Theme;
  }
  interface SiteEdits {
    data: Edits;
    resolve: (p: string[]) => HTMLElement | null;
    pathOf: (el: Element) => string[];
    styleEl: (el: HTMLElement, s: Style) => void;
    added: (a: Added) => HTMLElement | null;
    applyTheme: (t: Theme) => void;
    page: string;
    full: string;
  }

  const siteEdits = (window as unknown as { __siteEdits?: SiteEdits }).__siteEdits;
  const frameEl = document.querySelector<HTMLElement>('[data-ed-frame]');
  if (siteEdits && frameEl) {
    const api = siteEdits;
    const frame = frameEl;
    const html = document.documentElement;
    const L = JSON.parse(document.querySelector<HTMLTemplateElement>('[data-ed-texts]')!.content.textContent ?? '{}');
    const nameEl = frame.querySelector<HTMLElement>('[data-ed-name]')!;
    const sizeEl = frame.querySelector<HTMLElement>('[data-ed-size]')!;
    const stylePanel = frame.querySelector<HTMLElement>('[data-ed-style]')!;
    const draft: Edits = JSON.parse(JSON.stringify(api.data));
    draft.style[api.page] ??= {};
    draft.text[api.full] ??= {};
    draft.add[api.full] ??= [];
    let dirty = false;
    let sel: HTMLElement | null = null;
    let hover: HTMLElement | null = null;

    const key = (el: Element) => JSON.stringify(api.pathOf(el));
    const styleOf = (el: Element): Style => (draft.style[api.page][key(el)] ??= {});
    draft.theme ??= {};
    // ---- undo / redo: snapshots of the draft ----
    let history = [JSON.stringify(draft)];
    let pos = 0;
    let recordTimer = 0;
    const record = () => {
      window.clearTimeout(recordTimer);
      const snap = JSON.stringify(draft);
      if (snap === history[pos]) return;
      history = history.slice(0, pos + 1);
      history.push(snap);
      if (history.length > 200) history.shift();
      pos = history.length - 1;
    };
    const changed = () => {
      dirty = true;
      window.dispatchEvent(new Event('andras:dev-changed'));
      window.clearTimeout(recordTimer);
      recordTimer = window.setTimeout(record, 350);
    };
    /** show a draft on the page: added elements, texts, styles and colours */
    const show = (prev: Edits, next: Edits) => {
      document.querySelectorAll('[data-ed-id]').forEach((n) => n.remove());
      for (const a of next.add[api.full] ?? []) {
        const ref = api.resolve(a.after);
        const n = api.added(a);
        if (ref && n) ref.after(n);
      }
      const texts = new Set([...Object.keys(prev.text[api.full] ?? {}), ...Object.keys(next.text[api.full] ?? {})]);
      for (const k of texts) {
        const el = api.resolve(JSON.parse(k));
        if (!el) continue;
        const t = next.text[api.full]?.[k];
        if (t !== undefined) {
          el.dataset.edOrig ??= el.textContent ?? '';
          el.textContent = t;
        } else if (el.dataset.edOrig !== undefined) el.textContent = el.dataset.edOrig;
      }
      const styles = new Set([...Object.keys(prev.style[api.page] ?? {}), ...Object.keys(next.style[api.page] ?? {})]);
      for (const k of styles) {
        const el = api.resolve(JSON.parse(k));
        if (!el) continue;
        const st = next.style[api.page]?.[k] ?? {};
        // a replaced picture not yet on the server is shown from memory
        api.styleEl(el, st.src && previews.has(st.src) ? { ...st, src: previews.get(st.src) } : st);
      }
      api.applyTheme(next.theme ?? {});
    };
    const step = (dir: -1 | 1) => {
      stopText();
      record();
      const to = pos + dir;
      if (to < 0 || to >= history.length) return;
      const prev: Edits = JSON.parse(history[pos]);
      const next: Edits = JSON.parse(history[to]);
      pos = to;
      draft.style = next.style;
      draft.text = next.text;
      draft.add = next.add;
      draft.theme = next.theme ?? {};
      draft.style[api.page] ??= {};
      draft.text[api.full] ??= {};
      draft.add[api.full] ??= [];
      show(prev, next);
      dirty = true;
      window.dispatchEvent(new Event('andras:dev-changed'));
      if (sel && !sel.isConnected) deselect();
      else if (sel) place();
    };
    window.addEventListener('andras:undo', () => step(-1));
    window.addEventListener('andras:redo', () => step(1));
    document.addEventListener('keydown', (e) => {
      if (!html.classList.contains('dev-mode') || editing || !(e.ctrlKey || e.metaKey)) return;
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, select, [contenteditable="true"]')) return;
      const k = e.key.toLowerCase();
      if (k === 'z' && !e.shiftKey) {
        e.preventDefault();
        step(-1);
      } else if (k === 'y' || (k === 'z' && e.shiftKey)) {
        e.preventDefault();
        step(1);
      }
    });

    // ---- the site's colours (developer panel → "Theme colours") ----
    window.addEventListener('andras:theme', (e) => {
      const { key: k, value } = (e as CustomEvent<{ key: keyof Theme; value: string | null }>).detail;
      if (value) draft.theme![k] = value;
      else delete draft.theme![k];
      api.applyTheme(draft.theme!);
      changed();
    });
    (window as unknown as { __editsTheme?: () => Theme }).__editsTheme = () => draft.theme ?? {};

    // ---- pictures put on the page (replaced images): files to commit with the next save ----
    const pendingFiles = new Map<string, string>();
    const previews = new Map<string, string>();
    (window as unknown as { __editsFiles?: () => { path: string; base64: string }[] }).__editsFiles = () =>
      [...pendingFiles].map(([path, base64]) => ({ path, base64 }));
    (window as unknown as { __editsSaved?: () => void }).__editsSaved = () => pendingFiles.clear();
    // DevMode's save bar asks for the file
    (window as unknown as { __editsDraft?: () => string | null }).__editsDraft = () => {
      if (!dirty) return null;
      // drop empty entries
      for (const [k, s] of Object.entries(draft.style[api.page])) if (Object.values(s).every((v) => v === undefined || v === '' || v === 0 || v === false)) delete draft.style[api.page][k];
      return `${JSON.stringify(draft, null, 2)}\n`;
    };

    // developer UI, and the full-screen views that have their own editing (the world map) or none
    const isDevUi = (el: Element) =>
      !!el.closest('[data-dev-ui], .dev-panel, .lay-bar, .dev-plus, .lay-save, .dev-gate, .dev-add-menu, .dev-toast, dialog, .site-header .brand, .map-mode-view, .chaos-view, .country-view, .route-view, .street-view');
    const pickable = (t: EventTarget | null): HTMLElement | null => {
      let el = t instanceof Element ? t : null;
      while (el && !(el instanceof HTMLElement)) el = el.parentElement;
      if (!el || isDevUi(el) || el === document.body || el === html || el.id === 'main') return null;
      return el;
    };
    const textLike = (el: HTMLElement) => /^(H1|H2|H3|H4|H5|H6|P|LI|SPAN|A|FIGCAPTION|BLOCKQUOTE|LABEL|TIME|STRONG|EM|SMALL|BUTTON|DT|DD)$/.test(el.tagName) && !el.querySelector('img, svg, picture, ul, ol, div, p');

    // ---- the frame follows the selected element ----
    const place = () => {
      if (!sel || !sel.isConnected) return deselect();
      const r = sel.getBoundingClientRect();
      const z = Number(getComputedStyle(html).zoom) || 1;
      frame.style.left = `${r.left / z - 3}px`;
      frame.style.top = `${r.top / z - 3}px`;
      frame.style.width = `${r.width / z + 6}px`;
      frame.style.height = `${r.height / z + 6}px`;
      frame.classList.toggle('is-low', r.top / z < 110);
      sizeEl.textContent = `${Math.round(sel.offsetWidth)} × ${Math.round(sel.offsetHeight)}`;
    };
    const select = (el: HTMLElement) => {
      stopText();
      if (el !== sel) stylePanel.hidden = true;
      sel = el;
      frame.hidden = false;
      nameEl.textContent = el.dataset.lay ?? (el.id ? `#${el.id}` : el.tagName.toLowerCase());
      place();
    };
    function deselect() {
      stylePanel.hidden = true;
      stopText();
      sel = null;
      frame.hidden = true;
    }
    addEventListener('scroll', () => sel && place(), true);
    addEventListener('resize', () => sel && place());

    // ---- edit mode on/off (follows developer mode; the panel button switches it) ----
    const setOn = (on: boolean) => {
      html.classList.toggle('ed-on', on);
      if (!on) {
        deselect();
        hover?.classList.remove('ed-hover');
      }
    };
    new MutationObserver(() => {
      const dev = html.classList.contains('dev-mode');
      if (!dev && html.classList.contains('ed-on')) setOn(false);
    }).observe(html, { attributes: true, attributeFilter: ['class'] });
    window.addEventListener('andras:edit-toggle', (e) => setOn((e as CustomEvent<boolean>).detail));
    // developer mode may already be on when this script runs (saved in this browser)
    if (html.classList.contains('dev-mode')) setOn(true);

    document.addEventListener('mouseover', (e) => {
      if (!html.classList.contains('ed-on') || drag) return;
      const el = pickable(e.target);
      if (el === hover) return;
      hover?.classList.remove('ed-hover');
      hover = el;
      el?.classList.add('ed-hover');
    });
    // clicks select instead of following links / pressing buttons
    document.addEventListener(
      'click',
      (e) => {
        if (!html.classList.contains('ed-on')) return;
        const el = pickable(e.target);
        if (!el) return;
        if (el.isContentEditable) return;
        e.preventDefault();
        e.stopPropagation();
        select(el);
      },
      true,
    );
    document.addEventListener(
      'dblclick',
      (e) => {
        if (!html.classList.contains('ed-on')) return;
        const el = pickable(e.target);
        if (!el) return;
        e.preventDefault();
        e.stopPropagation();
        select(el);
        startText();
      },
      true,
    );

    // ---- text editing ----
    let editing: HTMLElement | null = null;
    function startText() {
      if (!sel) return;
      if (!textLike(sel)) {
        const inner = Array.from(sel.querySelectorAll<HTMLElement>('h1,h2,h3,h4,p,li,span,a,figcaption')).find(textLike);
        if (!inner) return;
        select(inner);
      }
      editing = sel!;
      editing.dataset.edOrig ??= editing.textContent ?? '';
      editing.contentEditable = 'true';
      frame.classList.add('is-text');
      editing.focus();
      const range = document.createRange();
      range.selectNodeContents(editing);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
    }
    function stopText() {
      if (!editing) return;
      const el = editing;
      editing = null;
      el.contentEditable = 'false';
      el.removeAttribute('contenteditable');
      frame.classList.remove('is-text');
      const txt = (el.textContent ?? '').replace(/\s+/g, ' ').trim();
      el.textContent = txt;
      if (el.dataset.edId) {
        const a = draft.add[api.full].find((x) => x.id === el.dataset.edId);
        if (a && a.text !== txt) {
          a.text = txt;
          changed();
        }
      } else if (txt !== (el.dataset.edOrig ?? '').replace(/\s+/g, ' ').trim()) {
        draft.text[api.full][key(el)] = txt;
        changed();
      }
    }
    document.addEventListener('keydown', (e) => {
      if (editing) {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          stopText();
          place();
        }
        if (e.key === 'Escape') stopText();
        return;
      }
      if (!sel || !html.classList.contains('ed-on')) return;
      const step = e.shiftKey ? 10 : 1;
      const moves: Record<string, [number, number]> = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
      if (moves[e.key]) {
        e.preventDefault();
        const s = styleOf(sel);
        s.x = (s.x ?? 0) + moves[e.key][0];
        s.y = (s.y ?? 0) + moves[e.key][1];
        api.styleEl(sel, s);
        changed();
        place();
      } else if (e.key === 'Delete') {
        act('hide');
      } else if (e.key === 'Escape') {
        deselect();
      }
    });

    // ---- toolbar ----
    function act(a: string) {
      if (!sel) return;
      if (a === 'close') return deselect();
      if (a === 'parent') {
        const p = pickable(sel.parentElement);
        if (p) select(p);
        return;
      }
      if (a === 'text') return startText();
      if (a === 'dup') {
        // a copy right after it: a new card, a new plan note … (texts can be rewritten, the copy moved)
        const item: Added = { id: Date.now().toString(36), after: api.pathOf(sel), clone: api.pathOf(sel) };
        const n = api.added(item);
        if (!n) return;
        draft.add[api.full].push(item);
        sel.after(n);
        changed();
        return select(n);
      }
      if (a === 'img') {
        const img = sel.tagName === 'IMG' ? sel : sel.querySelector<HTMLElement>('img');
        if (!img) return void (sizeEl.textContent = L.noImg);
        select(img);
        imgFile.click();
        return;
      }
      if (a === 'style') {
        stylePanel.hidden = !stylePanel.hidden;
        if (!stylePanel.hidden) fillStylePanel();
        return;
      }
      if (a === 'hide') {
        const s = styleOf(sel);
        s.hidden = !s.hidden;
        api.styleEl(sel, s);
        changed();
        return place();
      }
      if (a === 'reset') {
        if (sel.dataset.edId) {
          draft.add[api.full] = draft.add[api.full].filter((x) => x.id !== sel!.dataset.edId);
          sel.remove();
          changed();
          return deselect();
        }
        const k = key(sel);
        delete draft.style[api.page][k];
        api.styleEl(sel, {});
        if (draft.text[api.full][k] !== undefined) {
          delete draft.text[api.full][k];
          if (sel.dataset.edOrig !== undefined) sel.textContent = sel.dataset.edOrig;
        }
        changed();
        return place();
      }
      if (a === 'h3' || a === 'p') {
        const item: Added = { id: Date.now().toString(36), after: api.pathOf(sel), tag: a, text: a === 'h3' ? L.newSubtitle : L.newParagraph };
        const n = api.added(item);
        if (!n) return;
        draft.add[api.full].push(item);
        sel.after(n);
        changed();
        select(n);
        startText();
      }
    }
    // double-click on the selected element (the frame lies over it) rewrites its text
    frame.addEventListener('dblclick', (e) => {
      if ((e.target as Element).closest('[data-ed-tools]')) return;
      startText();
    });
    frame.querySelectorAll<HTMLButtonElement>('[data-ed-act]').forEach((b) =>
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        act(b.dataset.edAct!);
      }),
    );

    // ---- replace a picture: the 🖼 button, or drop a file onto any picture ----
    const imgFile = frame.querySelector<HTMLInputElement>('[data-ed-imgfile]')!;
    const replaceImage = async (img: HTMLElement, file: File) => {
      const base64 = await shrinkToJpeg(file, 2000).catch(() => null);
      if (!base64) return;
      const path = `public/uploads/${Date.now().toString(36)}.jpg`;
      pendingFiles.set(path, base64);
      const s = styleOf(img);
      s.src = path.replace(/^public/, '');
      // until the site is rebuilt the new file only exists here: show it from memory
      previews.set(s.src, `data:image/jpeg;base64,${base64}`);
      api.styleEl(img, { ...s, src: previews.get(s.src) });
      changed();
      if (sel === img) place();
    };
    imgFile.addEventListener('change', () => {
      const f = imgFile.files?.[0];
      if (f && sel) void replaceImage(sel, f);
      imgFile.value = '';
    });
    document.addEventListener('dragover', (e) => {
      if (html.classList.contains('ed-on') && (e.target as Element).closest?.('img')) e.preventDefault();
    });
    document.addEventListener('drop', (e) => {
      const img = (e.target as Element).closest?.('img') as HTMLElement | null;
      const f = e.dataTransfer?.files?.[0];
      if (!html.classList.contains('ed-on') || !img || !f || !f.type.startsWith('image/')) return;
      e.preventDefault();
      select(img);
      void replaceImage(img, f);
    });

    // ---- colours, font, size, weight, corners ----
    const toHex = (c: string) => {
      const m = c.match(/\d+(\.\d+)?/g);
      if (!m || m.length < 3 || (m.length > 3 && Number(m[3]) === 0)) return '#ffffff';
      return `#${m.slice(0, 3).map((n) => Math.round(Number(n)).toString(16).padStart(2, '0')).join('')}`;
    };
    function fillStylePanel() {
      if (!sel) return;
      const s = styleOf(sel);
      const cs = getComputedStyle(sel);
      const set = (k: string, v: string) => {
        const input = stylePanel.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-st="${k}"]`)!;
        input.value = v;
        const out = stylePanel.querySelector(`[data-st-out="${k}"]`);
        if (out) out.textContent = v;
      };
      set('color', s.color ?? toHex(cs.color));
      set('bg', s.bg ?? toHex(cs.backgroundColor));
      set('font', s.font ?? '');
      set('fs', String(s.fs ?? Math.round(parseFloat(cs.fontSize))));
      set('fw', s.fw ?? '');
      set('r', String(s.r ?? Math.round(parseFloat(cs.borderTopLeftRadius) || 0)));
    }
    stylePanel.addEventListener('pointerdown', (e) => e.stopPropagation());
    stylePanel.addEventListener('click', (e) => e.stopPropagation());
    stylePanel.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-st]').forEach((input) =>
      input.addEventListener('input', () => {
        if (!sel) return;
        const s = styleOf(sel) as Record<string, unknown>;
        const k = input.dataset.st!;
        s[k] = input.type === 'range' ? Number(input.value) : input.value || undefined;
        const out = stylePanel.querySelector(`[data-st-out="${k}"]`);
        if (out) out.textContent = input.value;
        api.styleEl(sel, s as Style);
        changed();
        place();
      }),
    );
    stylePanel.querySelector('[data-st-clear="bg"]')!.addEventListener('click', () => {
      if (!sel) return;
      delete styleOf(sel).bg;
      api.styleEl(sel, styleOf(sel));
      changed();
      fillStylePanel();
    });
    stylePanel.querySelector('[data-st-reset]')!.addEventListener('click', () => {
      if (!sel) return;
      const s = styleOf(sel);
      for (const k of ['color', 'bg', 'font', 'fs', 'fw', 'r'] as const) delete s[k];
      api.styleEl(sel, s);
      changed();
      fillStylePanel();
      place();
    });

    // ---- move (drag the frame) and resize (drag a handle) ----
    let drag: { mode: string; px: number; py: number; s0: Style; w0: number; h0: number; k: number; ratio: number; moved?: boolean } | null = null;
    frame.addEventListener('pointerdown', (e) => {
      if (!sel || (e.target as Element).closest('[data-ed-tools]')) return;
      e.preventDefault();
      const handle = (e.target as HTMLElement).dataset.h;
      const r = sel.getBoundingClientRect();
      const w0 = sel.offsetWidth || r.width;
      const h0 = sel.offsetHeight || r.height;
      drag = { mode: handle ?? 'move', px: e.clientX, py: e.clientY, s0: { ...styleOf(sel) }, w0, h0, k: r.width / (w0 || 1) || 1, ratio: w0 / (h0 || 1) };
      frame.setPointerCapture(e.pointerId);
    });
    frame.addEventListener('pointermove', (e) => {
      if (!drag || !sel) return;
      const dx = (e.clientX - drag.px) / drag.k;
      const dy = (e.clientY - drag.py) / drag.k;
      if (!drag.moved && Math.abs(dx) + Math.abs(dy) < 3) return;
      drag.moved = true;
      const s = styleOf(sel);
      const m = drag.mode;
      if (m === 'move') {
        s.x = Math.round((drag.s0.x ?? 0) + dx);
        s.y = Math.round((drag.s0.y ?? 0) + dy);
      } else {
        let w = drag.w0 + (m.includes('e') ? dx : m.includes('w') ? -dx : 0);
        let h = drag.h0 + (m.includes('s') ? dy : m.includes('n') ? -dy : 0);
        w = Math.max(24, w);
        h = Math.max(16, h);
        // corners of pictures keep the proportions (like PowerPoint); hold Shift to stretch freely
        const media = /^(IMG|PICTURE|VIDEO|FIGURE)$/.test(sel.tagName);
        if (media && m.length === 2 && !e.shiftKey) h = w / drag.ratio;
        if (m.includes('e') || m.includes('w')) s.w = Math.round(w);
        if (m.includes('n') || m.includes('s') || (media && m.length === 2)) s.h = Math.round(h);
        if (m.includes('w')) s.x = Math.round((drag.s0.x ?? 0) + (drag.w0 - w));
        if (m.includes('n')) s.y = Math.round((drag.s0.y ?? 0) + (drag.h0 - h));
      }
      api.styleEl(sel, s);
      place();
    });
    frame.addEventListener('pointerup', () => {
      if (drag?.moved) changed();
      drag = null;
    });
  }
</script>
