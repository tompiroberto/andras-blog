    }
    /** 📖: the longer story of a copy, shown in an info box when it is clicked */
    const storyBox = document.querySelector<HTMLDialogElement>('[data-ed-storybox]')!;
    const storyText = storyBox.querySelector<HTMLTextAreaElement>('[data-ed-storytext]')!;
    let storyFor: HTMLElement | null = null;
    function editStory(el: HTMLElement) {
      const item = addedItem(el);
      if (!item) return;
