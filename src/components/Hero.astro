---
import { MAIN_SITE as MAIN_SITE_URL } from '../lib/mainSite.mjs';
import Globe from './Globe.astro';
import { STEPS, stepAt, stepText } from '../lib/whereabouts';
import Icon from './Icon.astro';
import { HTML_LANG, type TKey, t, type Lang } from '../i18n';
import translations from '../i18n/hu.json';
import site from '../data/site.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Put the name on a yellow highlight wherever it appears in the translated title
const title = t(lang, 'hero.title');
const nameAt = title.indexOf(site.owner);
const before = nameAt >= 0 ? title.slice(0, nameAt) : title;
const after = nameAt >= 0 ? title.slice(nameAt + site.owner.length) : '';

// Only the lead-in is translated; the nicknames are always shown exactly as in site.json
const nickLead = t(lang, 'hero.nicknames').split(':')[0].trim();
// where he is: chosen when the page is built, and again in the visitor's browser (it moves on by itself)
// a step's text: its own (written in developer mode: Hungarian on the Hungarian page, English elsewhere) or a translated one
// for the browser too: the translated texts (a copy reads the main site's steps and calendar)
const whereWords = Object.fromEntries(Object.keys(translations).filter((k) => k.startsWith('where.')).map((k) => [k.slice(6), t(lang, k as TKey)]));
const whereSteps = STEPS.map((st) => ({ from: st.from, text: stepText(st, lang, whereWords) }));
const whereNow = stepAt() ? stepText(stepAt()!, lang, whereWords) : t(lang, 'hero.status');
const whereLive = import.meta.env.PUBLIC_STATIC_EXPORT === '1' ? import.meta.env.PUBLIC_MAIN_SITE || MAIN_SITE_URL : '';
---

<section class="hero section" data-lay="hero" aria-labelledby="hero-title">
  <div class="bg-layer hero__bg">
    <Globe
      class="hero__globe"
      size="min(700px, 92vw)"
      right="max(-140px, -12vw)"
      top="50%"
      speed={80}
      animatedMeridians
      orbit
    />
    <svg class="shape float hero__tri hero__tri--yellow" viewBox="0 0 60 60" aria-hidden="true">
      <path d="M8 52 L30 8 L52 52 Z" />
    </svg>
    <svg class="shape float float--slow hero__tri hero__tri--violet" viewBox="0 0 60 60" aria-hidden="true">
      <path d="M8 52 L30 8 L52 52 Z" />
    </svg>
    <span class="shape float float--fast hero__dot" aria-hidden="true"></span>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="pill hero__status" data-where={JSON.stringify(whereSteps)} data-where-words={JSON.stringify(whereWords)} data-where-lang={lang} data-where-live={whereLive || undefined}>
        <span class="hero__pin" aria-hidden="true">
          <Icon name="map-pin" size={14} />
        </span>
        <span data-where-text>{whereNow}</span>
        <span class="hero__where-edit" aria-hidden="true">✎</span>
      </p>
      <!-- developer mode: a click on the pill – where am I now (from now, or from a given time) -->
      <!-- developer mode: the internet connection says another country – update? -->
      <p class="where-guess" hidden data-where-guess data-dev-ui>
        <span data-where-guess-text></span>
        <button type="button" data-where-guess-yes>✓ {t(lang, 'whereEd.yes')}</button>
        <button type="button" data-where-guess-no>✕</button>
      </p>
      <template data-where-guess-t>{t(lang, 'whereEd.guess')}</template>
      <form class="where-ed" hidden data-where-form data-dev-ui data-locale={HTML_LANG[lang]}>
        <strong>📍 {t(lang, 'whereEd.title')}</strong>
        <label>{t(lang, 'whereEd.country')}
          <span class="where-ed__country"><img alt="" hidden data-where-flag /><select required data-where-country><option value="">—</option></select></span>
        </label>
        <label>🇭🇺 {t(lang, 'whereEd.text')}<input type="text" maxlength="80" required data-where-hu /></label>
        <label>🇬🇧 English<input type="text" maxlength="80" data-where-en /></label>
        <label>{t(lang, 'whereEd.from')}<input type="datetime-local" required data-where-from /></label>
        <small data-where-note></small>
        <div class="where-ed__actions">
          <button type="button" data-where-cancel>✕</button>
          <button type="submit">✓ {t(lang, 'whereEd.save')}</button>
        </div>
      </form>

      <div class="hero__title-wrap" data-nick>
        <h1 id="hero-title">
          {before}
          {
            nameAt >= 0 && (
              <button type="button" class="hero__name" aria-describedby="nick-tip" aria-expanded="false" data-nick-trigger>
                {site.owner}
              </button>
            )
          }
          {after}
        </h1>
        <!-- pointing at the name: round photos of András pop out around it and fill the space beside the title -->
        <span class="hero-faces" aria-hidden="true" data-hero-faces data-count="23"></span>
        <div class="nick-tip" id="nick-tip" role="tooltip" data-nick-tip>
          {nickLead}:{' '}
          {
            site.nicknames.map((n, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <strong lang={/[Ⴀ-ჿ]/.test(n) ? 'ka' : n === 'Später' ? 'de' : 'hu'}>{n}</strong>
              </>
            ))
          }
        </div>
      </div>

      <p class="hero__tagline">{t(lang, 'hero.tagline')}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#explore">
          <Icon name="arrow-down" size={20} />
          {t(lang, 'hero.btnScroll')}
        </a>
        <a class="btn btn--secondary" href={site.strava} target="_blank" rel="noopener">
          <Icon name="strava" size={20} />
          {t(lang, 'hero.btnStrava')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(40px, 8vw, 96px);
    padding-bottom: clamp(120px, 14vw, 180px);
    min-height: min(88vh, 860px);
    display: flex;
    align-items: center;
  }
  .hero__bg :global(.hero__globe) {
    transform: translateY(-50%);
  }
  .hero__inner {
    width: 100%;
  }
  .hero__copy {
    max-width: calc(700px * var(--tz));
  }
  .hero__status {
    margin: 0 0 24px;
    padding: 6px 16px 6px 6px;
  }
  /* developer mode: the pill can be rewritten (a click) */
  .hero__where-edit {
    display: none;
    margin-left: 6px;
    color: #1f8a3a;
  }
  :global(html.dev-mode:not(.dev-preview)) .hero__status {
    outline: 2px dashed #39d353;
    outline-offset: 3px;
    cursor: pointer;
  }
  :global(html.dev-mode:not(.dev-preview)) .hero__where-edit {
    display: inline;
  }
  .where-guess {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 560px;
    margin: -12px 0 18px;
    padding: 10px 12px;
    border: 2px solid #39d353;
    border-radius: 12px;
    background: #0d1117;
    color: #d6f5d6;
    font: 13px ui-monospace, Consolas, monospace;
  }
  .where-guess[hidden] {
    display: none;
  }
  .where-guess button {
    padding: 5px 12px;
    border: 1px solid #39d353;
    border-radius: 8px;
    background: #0d1117;
    color: #39d353;
    font: inherit;
    cursor: pointer;
  }
  .where-guess [data-where-guess-yes] {
    background: #39d353;
    color: #0d1117;
    font-weight: 800;
  }
  .where-ed {
    position: absolute;
    z-index: 50;
    display: grid;
    gap: 10px;
    width: min(340px, calc(100vw - 24px));
    margin-top: -12px;
    padding: 14px;
    border: 2px solid #39d353;
    border-radius: 14px;
    background: #0d1117;
    color: #d6f5d6;
    box-shadow: 0 0 0 4px rgb(57 211 83 / 0.2);
    font: 13px ui-monospace, Consolas, monospace;
  }
  .where-ed[hidden] {
    display: none;
  }
  .where-ed label {
    display: grid;
    gap: 4px;
  }
  .where-ed input,
  .where-ed select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #30363d;
    border-radius: 8px;
    background: #010409;
    color: #e6edf3;
    font: inherit;
    color-scheme: dark;
  }
  .where-ed__country {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .where-ed__country img {
    width: 30px;
    height: 20px;
    border-radius: 3px;
    object-fit: cover;
  }
  .where-ed__actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .where-ed button {
    padding: 7px 14px;
    border: 1px solid #39d353;
    border-radius: 8px;
    background: #0d1117;
    color: #39d353;
    font: inherit;
    cursor: pointer;
  }
  .where-ed button[type='submit'] {
    background: #39d353;
    color: #0d1117;
    font-weight: 800;
  }
  .hero__pin {
    position: relative;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--violet);
    color: #fff;
    flex: none;
  }
  .hero__pin::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--violet);
    z-index: -1;
    animation: pulse var(--pulse-duration) ease-out infinite;
  }
  .hero__title-wrap {
    position: relative;
  }
  .hero__title-wrap h1 {
    margin-bottom: 0.35em;
  }
  .hero__name {
    all: unset;
    position: relative;
    display: inline-block;
    padding: 0 0.14em;
    margin: 0 0.02em;
    cursor: help;
    font-family: 'Unbounded', var(--font-heading);
    z-index: 0;
    text-decoration: underline dashed var(--ink);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.16em;
  }
  .hero__name::before {
    content: '';
    position: absolute;
    inset: 0.1em -0.02em 0.02em;
    background: var(--yellow);
    border: 2px solid var(--ink);
    border-radius: 0.28em;
    z-index: -1;
    transform: rotate(-1.5deg);
  }
  .hero__name:focus-visible {
    outline: 3px solid var(--violet);
    outline-offset: 4px;
    border-radius: 0.28em;
  }
  /* the photos: they start on the name and pop out to their places (--face-x, --face-y in the wrap;
     own names: --r is a registered <length> elsewhere) */
  .hero-faces {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .hero-faces :global(img) {
    position: absolute;
    left: -50px;
    top: -50px;
    width: 100px;
    max-width: none;
    height: 100px;
    border: 4px solid #fff;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 2px var(--ink),
      4px 5px 0 2px var(--violet);
    transform: translate(var(--from-x), var(--from-y)) scale(0.2) rotate(-30deg);
    opacity: 0;
    transition:
      transform 480ms cubic-bezier(0.3, 1.5, 0.5, 1),
      opacity 220ms ease;
    transition-delay: calc(var(--face-i, 0) * 55ms);
  }
  .hero-faces :global(img:nth-child(even)) {
    box-shadow:
      0 0 0 2px var(--ink),
      4px 5px 0 2px var(--yellow);
  }
  .hero-faces :global(img.is-out) {
    transform: translate(var(--face-x), var(--face-y)) scale(1) rotate(var(--face-r, 0deg));
    opacity: 1;
  }
  /* the Hungarian flag that comes out with them: it stays in its place (no flying in, no waving) –
     it only fades in, straight */
  .hero-faces :global(img.hero-faces__flag) {
    left: -36px;
    top: -26px;
    width: 72px;
    height: 52px;
    border: 3px solid #fff;
    border-radius: 8px;
    transform: translate(var(--face-x), var(--face-y)) scale(0.92);
    transition:
      opacity 250ms ease,
      transform 250ms ease;
    transition-delay: 0ms;
  }
  .hero-faces :global(img.hero-faces__flag.is-out) {
    transform: translate(var(--face-x), var(--face-y)) scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-faces :global(img) {
      transition: opacity 150ms ease;
    }
  }

  .nick-tip {
    position: absolute;
    /* set by JS in the title's CSS px; the bubble itself is counter-zoomed (--tz) */
    left: calc(var(--tip-x, 0px) / var(--tz));
    top: calc(var(--tip-y, 0px) / var(--tz) + 14px);
    z-index: var(--z-tooltip);
    max-width: min(340px, calc(100vw - 32px));
    padding: 12px 16px;
    background: var(--yellow);
    border: var(--border);
    border-radius: 18px;
    box-shadow: 4px 4px 0 var(--ink);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.4;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity var(--t-fast),
      transform var(--t-fast),
      visibility var(--t-fast);
  }
  .nick-tip strong {
    font-weight: 700;
  }
  .nick-tip strong:lang(ka) {
    font-family: 'Noto Sans Georgian', sans-serif;
  }
  .nick-tip::before,
  .nick-tip::after {
    /* speech-bubble pointer */
    content: '';
    position: absolute;
    left: calc(var(--arrow-x, 32px) / var(--tz));
    border: 10px solid transparent;
    border-top: 0;
  }
  .nick-tip::before {
    top: -12px;
    border-bottom: 12px solid var(--ink);
    margin-left: -10px;
  }
  .nick-tip::after {
    top: -8px;
    border-width: 0 8px 10px;
    border-bottom-color: var(--yellow);
    margin-left: -8px;
  }
  .nick-tip.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .hero__tagline {
    font-size: var(--fs-tagline);
    line-height: 1.45;
    color: var(--muted);
    max-width: 36ch;
    margin-bottom: 32px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hero__tri {
    width: 64px;
    height: 64px;
  }
  .hero__tri path {
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .hero__tri--yellow {
    --rot: 14deg;
    right: 38%;
    top: 14%;
  }
  .hero__tri--yellow path {
    fill: var(--yellow);
  }
  .hero__tri--violet {
    --rot: -22deg;
    width: 44px;
    height: 44px;
    right: 6%;
    bottom: 16%;
  }
  .hero__tri--violet path {
    fill: var(--violet);
  }
  .hero__dot {
    right: 30%;
    bottom: 22%;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--yellow);
    border: 2px solid var(--ink);
  }

  @media (max-width: 899px) {
    .hero {
      min-height: 0;
    }
    .hero__bg :global(.hero__globe) {
      opacity: 0.55 !important;
      right: -45vw !important;
    }
    .hero__bg :global(.globe__cities) {
      display: none;
    }
    .hero__tri--yellow {
      right: 8%;
      top: 4%;
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  import { pageZoom } from '../lib/zoom';

  const wrap = document.querySelector<HTMLElement>('[data-nick]');
  const trigger = wrap?.querySelector<HTMLButtonElement>('[data-nick-trigger]');
  const tip = wrap?.querySelector<HTMLElement>('[data-nick-tip]');

  if (wrap && trigger && tip) {
    let hideTimer = 0;
    let pinned = false; // opened by click/tap: stays until dismissed

    const place = () => {
      // screen rects are zoomed; convert to CSS px (see src/lib/zoom.ts)
      const z = pageZoom();
      const scale = (r: DOMRect) => ({ left: r.left / z, top: r.top / z, bottom: r.bottom / z, width: r.width / z });
      const w = scale(wrap.getBoundingClientRect());
      const n = scale(trigger.getBoundingClientRect());
      const maxX = Math.max(0, w.width - tip.offsetWidth);
      const x = Math.min(Math.max(0, n.left - w.left), maxX);
      tip.style.setProperty('--tip-x', `${x}px`);
      tip.style.setProperty('--tip-y', `${n.bottom - w.top}px`);
      tip.style.setProperty('--arrow-x', `${Math.min(Math.max(20, n.left - w.left + n.width / 2 - x), tip.offsetWidth - 20)}px`);
    };
    const show = () => {
      window.clearTimeout(hideTimer);
      place();
      tip.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
    };
    const hide = () => {
      pinned = false;
      tip.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    };
    const hideSoon = () => {
      if (pinned) return;
      hideTimer = window.setTimeout(hide, 200);
    };

    trigger.addEventListener('mouseenter', show);
    trigger.addEventListener('mouseleave', hideSoon);
    tip.addEventListener('mouseenter', () => window.clearTimeout(hideTimer));
    tip.addEventListener('mouseleave', hideSoon);
    trigger.addEventListener('focus', show);
    trigger.addEventListener('blur', () => {
      pinned = false;
      hideSoon();
    });
    trigger.addEventListener('click', () => {
      if (pinned) hide();
      else {
        pinned = true;
        show();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && tip.classList.contains('is-open')) hide();
    });
    document.addEventListener('pointerdown', (e) => {
      if (!wrap.contains(e.target as Node)) hide();
    });
    window.addEventListener('resize', () => tip.classList.contains('is-open') && place());
  }

  // ---- the name in the title: round photos of András pop out beside it – up to six, in a symmetric
  // wedge pointing right (3 + 2 + 1, as many columns as fit) – and a Hungarian flag at the end of the
  // line above; each new visit swaps one or two of the photos for others ----
  const faces = wrap?.querySelector<HTMLElement>('[data-hero-faces]');
  const title = wrap?.querySelector<HTMLElement>('h1');
  if (wrap && trigger && faces && title) {
    const all = Array.from({ length: Number(faces.dataset.count ?? 0) }, (_, i) => `/images/faces/andras-${i + 1}.jpg`);
    const shuffled = <T,>(a: T[]) => [...a].sort(() => Math.random() - 0.5);
    const SIZE = 100;
    const GAP = 10;
    let shown: string[] = [];
    let hideTimer = 0;

    /** the places, in the wrap's own (zoom-free) pixels */
    const spots = () => {
      const z = pageZoom();
      const w = wrap.getBoundingClientRect();
      const n = trigger.getBoundingClientRect();
      const ny = (n.top + n.height / 2 - w.top) / z;
      // the text lines of the title (the ones above and below the name are not to be covered)
      const range = document.createRange();
      range.selectNodeContents(title);
      const rects = Array.from(range.getClientRects());
      const lineEnd = Math.max(...rects.filter((r) => r.bottom > n.top && r.top < n.bottom).map((r) => r.right));
      const ox = (lineEnd - w.left) / z + 18;
      // how far right they may go: the window, or the country ribbon on the right
      const ribbon = document.querySelector<HTMLElement>('.chile')?.getBoundingClientRect();
      const right = ((ribbon && ribbon.width > 0 ? Math.min(window.innerWidth, ribbon.left) : window.innerWidth) - w.left) / z - 12;
      // the wedge: columns of 3, 2 and 1, packed like a honeycomb
      const step = SIZE + GAP;
      const colX = (c: number) => ox + SIZE / 2 + c * step * 0.87;
      const columns = [
        [-step, 0, step],
        [-step / 2, step / 2],
        [0],
      ];
      const out: { x: number; y: number }[] = [];
      for (let c = 0; c < columns.length && colX(c) + SIZE / 2 <= right; c++) columns[c].forEach((dy) => out.push({ x: colX(c), y: ny + dy }));
      // the flag: at the end of the line above the name, or above the wedge if there is none
      // (line boxes overlap a little: a line is above the name when its middle is)
      const above = rects.filter((r) => r.top + r.height / 2 < n.top);
      const lastAbove = above.length ? above.reduce((a, b) => (b.bottom > a.bottom || (b.bottom === a.bottom && b.right > a.right) ? b : a)) : null;
      const flag = lastAbove
        ? { x: (lastAbove.right - w.left) / z + 70, y: (lastAbove.top + lastAbove.height / 2 - w.top) / z }
        : { x: colX(0), y: ny - step * 1.55 };
      return { out, flag, from: { x: ox, y: ny } };
    };
    const pop = (src: string, p: { x: number; y: number }, from: { x: number; y: number }, i: number, cls = '') => {
      const img = Object.assign(document.createElement('img'), { src, alt: '', decoding: 'async', className: cls });
      img.style.cssText = `--from-x:${from.x}px;--from-y:${from.y}px;--face-x:${p.x}px;--face-y:${p.y}px;--face-r:${Math.round((Math.random() - 0.5) * 20)}deg;--face-i:${i}`;
      faces.append(img);
      requestAnimationFrame(() => requestAnimationFrame(() => img.classList.add('is-out')));
    };
    const show = () => {
      window.clearTimeout(hideTimer);
      // back before they were gone: the same ones come out again
      if (faces.childElementCount) return faces.querySelectorAll('img').forEach((img) => img.classList.add('is-out'));
      const { out, flag, from } = spots();
      const count = Math.min(out.length, all.length);
      if (!shown.length) shown = shuffled(all).slice(0, count);
      else {
        // keep some, swap one or two for pictures not shown last time
        const fresh = shuffled(all.filter((s) => !shown.includes(s)));
        const keep = shuffled(shown).slice(0, Math.max(1, Math.min(shown.length, count) - 1 - Math.round(Math.random())));
        shown = shuffled([...keep, ...fresh, ...shuffled(all)].filter((s, i, a) => a.indexOf(s) === i).slice(0, count));
      }
      out.slice(0, count).forEach((p, i) => pop(shown[i], p, from, i));
      pop('/flags/hu.svg', flag, from, count, 'hero-faces__flag');
    };
    const hide = () => {
      faces.querySelectorAll('img').forEach((img) => img.classList.remove('is-out'));
      hideTimer = window.setTimeout(() => faces.replaceChildren(), 500);
    };
    trigger.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && show());
    trigger.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && hide());
    // the pictures load in the background, so they pop out at once
    window.addEventListener('load', () => all.forEach((src) => (new Image().src = src)), { once: true });
  }
</script>

<script>
  import { commitFiles, getToken, keyCanWrite } from '../lib/githubCommit';
  import { MANUAL, STEPS, stepNow, stepText, timeline, type Step, type Trip } from '../lib/whereabouts';

  // the pill moves on by itself: the last step that has started (set by hand, or a trip of the calendar)
  document.querySelectorAll<HTMLElement>('[data-where]').forEach((pill) => {
    const words = JSON.parse(pill.dataset.whereWords ?? '{}') as Record<string, string>;
    const lang = pill.dataset.whereLang ?? 'hu';
    let list: Step[] = STEPS;
    const show = () => {
      const step = stepNow(list);
      if (step) pill.querySelector('[data-where-text]')!.textContent = stepText(step, lang, words);
    };
    show();
    // the steps set by hand (the editor adds to them); a copy on another host: the main site's, and its calendar
    let raw: { _comment?: string; steps: Step[] } | null = { steps: MANUAL };
    const site = pill.dataset.whereLive ?? '';
    const getJson = <T,>(path: string) => fetch(site + path, { cache: 'no-cache' }).then((r) => (r.ok ? (r.json() as Promise<T>) : Promise.reject(new Error(String(r.status)))));
    const loaded = Promise.all([getJson<{ _comment?: string; steps: Step[] }>('/whereabouts.json'), getJson<{ events: Trip[] }>('/calendar.json')])
      .then(([w, c]) => {
        raw = w;
        list = timeline(w.steps, c.events);
        show();
      })
      .catch(() => {});
    const textOf = (st: Step) => stepText(st, lang, words);

    // ---- developer mode: a click on the pill rewrites it ----
    const form = document.querySelector<HTMLFormElement>('[data-where-form]');
    if (!form) return;
    // developer mode with the GitHub key checked by GitHub in this tab (DevMode.astro) – nothing less
    const verified = () => {
      try {
        return sessionStorage.getItem('andras-dev-verified') === '1';
      } catch {
        return false;
      }
    };
    const isDev = () => verified() && document.documentElement.classList.contains('dev-mode') && !document.documentElement.classList.contains('dev-preview');
    const sel = form.querySelector<HTMLSelectElement>('[data-where-country]')!;
    const flag = form.querySelector<HTMLImageElement>('[data-where-flag]')!;
    const inHu = form.querySelector<HTMLInputElement>('[data-where-hu]')!;
    const inEn = form.querySelector<HTMLInputElement>('[data-where-en]')!;
    const inFrom = form.querySelector<HTMLInputElement>('[data-where-from]')!;
    const note = form.querySelector<HTMLElement>('[data-where-note]')!;
    const huNames = new Intl.DisplayNames(['hu'], { type: 'region' });
    const enNames = new Intl.DisplayNames(['en'], { type: 'region' });
    const pageNames = new Intl.DisplayNames([form.dataset.locale || 'hu'], { type: 'region' });
    const name = (n: Intl.DisplayNames, c: string) => {
      try {
        return n.of(c) ?? c;
      } catch {
        return c;
      }
    };
    let filled = false;
    const fill = () => {
      if (filled) return;
      filled = true;
      const codes: string[] = [];
      for (let a = 65; a <= 90; a++) for (let b = 65; b <= 90; b++) codes.push(String.fromCharCode(a, b));
      codes
        .map((c) => [c, name(pageNames, c)] as const)
        .filter(([c, n]) => n !== c && !/^(Unknown|ismeretlen)/i.test(n) && !['EU', 'EZ', 'UN', 'QO', 'XA', 'XB', 'ZZ'].includes(c))
        .sort((a, b) => a[1].localeCompare(b[1], form.dataset.locale))
        .forEach(([c, n]) => sel.add(new Option(n, c)));
    };
    // the schema: choosing a country writes the texts (they can be changed)
    sel.addEventListener('change', () => {
      const c = sel.value;
      flag.hidden = !c;
      if (c) flag.src = `/flags/${c.toLowerCase()}.svg`;
      if (!c) return;
      inHu.value = c === 'HU' ? 'Jelenleg itthon, Magyarországon' : `Jelenleg itt: ${name(huNames, c)}`;
      inEn.value = c === 'HU' ? 'Back home in Hungary' : `Currently in ${name(enNames, c)}`;
    });
    const localNow = () => {
      const d = new Date();
      d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
      return d.toISOString().slice(0, 16);
    };
    pill.addEventListener('click', (e) => {
      if (!isDev()) return;
      e.preventDefault();
      fill();
      const cur = stepNow(list);
      sel.value = cur?.country ?? '';
      flag.hidden = !sel.value;
      if (sel.value) flag.src = `/flags/${sel.value.toLowerCase()}.svg`;
      inHu.value = cur?.text ?? pill.querySelector('[data-where-text]')!.textContent ?? '';
      inEn.value = cur?.text_en ?? '';
      inFrom.value = localNow();
      note.textContent = '';
      form.hidden = false;
      sel.focus();
    });
    form.querySelector('[data-where-cancel]')!.addEventListener('click', () => (form.hidden = true));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      await loaded;
      if (!raw) return void (note.textContent = '⚠ whereabouts.json');
      let key = getToken();
      if (!key) key = (window.prompt('GitHub key') ?? '').trim();
      if (!key) return;
      // only a real key to the site may change it (asked from GitHub, not trusted from the browser)
      note.textContent = '…';
      if (!(await keyCanWrite(key))) return void (note.textContent = '⛔ GitHub key');
      // the time with its own offset (e.g. +02:00), like the other steps
      const at = new Date(inFrom.value);
      const off = -at.getTimezoneOffset();
      const pad = (n: number) => String(Math.floor(Math.abs(n))).padStart(2, '0');
      const from = `${inFrom.value}:00${off >= 0 ? '+' : '-'}${pad(off / 60)}:${pad(off % 60)}`;
      const step: Step = { from, country: sel.value, text: inHu.value.trim(), ...(inEn.value.trim() ? { text_en: inEn.value.trim() } : {}) };
      // a new step from that moment; a later one that was planned stays
      const steps = [...raw.steps.filter((st) => Date.parse(st.from) !== Date.parse(from)), step].sort((a, b) => Date.parse(a.from) - Date.parse(b.from));
      const next = { ...raw, steps };
      try {
        note.textContent = '…';
        await commitFiles(key, [{ path: 'src/data/whereabouts.json', text: `${JSON.stringify(next, null, 2)}\n` }], 'Where am I now: changed on the site', [`📍 ${step.text}`]);
        raw = next;
        list = timeline(steps, (await getJson<{ events: Trip[] }>('/calendar.json').catch(() => ({ events: [] as Trip[] }))).events);
        show();
        note.textContent = '✓';
        window.setTimeout(() => (form.hidden = true), 800);
      } catch (err) {
        note.textContent = err instanceof Error ? err.message : String(err);
      }
    });

    // ---- developer mode switched on: the internet connection's country (an e-mail address says nothing
    // about where one is); when it differs from the pill, one click updates it. Asked once a day per country.
    const guess = document.querySelector<HTMLElement>('[data-where-guess]');
    const guessT = document.querySelector<HTMLTemplateElement>('[data-where-guess-t]')?.content.textContent ?? '';
    let found = '';
    const askedKey = () => `andras-where-asked-${new Date().toISOString().slice(0, 10)}-${found}`;
    async function check() {
      if (!guess || !isDev()) return;
      try {
        const d = (await (await fetch('https://get.geojs.io/v1/ip/geo.json')).json()) as { country_code?: string; city?: string };
        found = (d.country_code ?? '').toUpperCase();
        const cur = stepNow(list);
        if (!found || !cur || cur.country === found) return;
        try {
          if (localStorage.getItem(askedKey())) return;
        } catch {
          /* storage unavailable */
        }
        guess.querySelector('[data-where-guess-text]')!.textContent = `📍 ${guessT.replace('{country}', `${name(pageNames, found)}${d.city ? ` (${d.city})` : ''}`)}`;
        guess.hidden = false;
      } catch {
        /* no answer: nothing to ask */
      }
    }
    const remember = () => {
      try {
        localStorage.setItem(askedKey(), '1');
      } catch {
        /* storage unavailable */
      }
      guess!.hidden = true;
    };
    guess?.querySelector('[data-where-guess-no]')!.addEventListener('click', remember);
    guess?.querySelector('[data-where-guess-yes]')!.addEventListener('click', () => {
      remember();
      // the editor, filled in: one more click saves it
      pill.click();
      sel.value = found;
      sel.dispatchEvent(new Event('change'));
    });
    if (new URLSearchParams(location.search).get('where') === 'edit' && isDev()) window.setTimeout(() => pill.click(), 400);
    let wasDev = isDev();
    if (wasDev) void loaded.then(check);
    new MutationObserver(() => {
      if (isDev() && !wasDev) void loaded.then(check);
      wasDev = isDev();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  });
</script>
