        <button type="button" role="radio" aria-checked="false" data-mm-mode="train"><Icon name="train-front" size={15} />{t(lang, 'route.train')}</button>
        <button type="button" role="radio" aria-checked="false" data-mm-mode="bus"><Icon name="bus" size={15} />{t(lang, 'route.bus')}</button>
        <button type="button" role="radio" aria-checked="false" data-mm-mode="walk"><Icon name="footprints" size={15} />{t(lang, 'route.walk')}</button>
      </div>
      <ol class="mm-route__legs" data-mm-route-legs></ol>
      <p class="mm-route__total" data-mm-route-total></p>
      <small class="mm-route__note">{t(lang, 'route.note')}</small>
    </div>
    <form class="mm-geo-panel__own" data-mm-own>
      <label for="mm-own-input">{t(lang, 'mapmode.distOwn')}</label>
      <div>
        <input id="mm-own-input" type="text" autocomplete="off" maxlength="80" placeholder={t(lang, 'mapmode.distPlaceholder')} />
        <button type="submit">{t(lang, 'mapmode.distSet')}</button>
      </div>
    </form>
    <small class="mm-geo-panel__note">{t(lang, 'mapmode.distNote')}</small>
    <button type="button" class="mm-tip__route" data-mm-geo-route><Icon name="route" size={16} />{t(lang, 'route.here')}</button>
    <button type="button" class="mm-tip__write" data-mm-geo-write><Icon name="message-circle" size={16} />{text.write}</button>
  </aside>
  <template data-mm-msg-searching>{t(lang, 'search.searching')}</template>
  <template data-mm-msg-none>{t(lang, 'search.none')}</template>
  <template data-mm-msg-error>{t(lang, 'search.error')}</template>
  <script type="application/json" data-mm-countries set:html={JSON.stringify(countryInfo)} />
  <!-- developer mode: the data files as they are, so edits can be saved back -->
  <script type="application/json" data-mm-countries-raw set:html={JSON.stringify(countriesData)} />
  <script type="application/json" data-mm-pins-raw set:html={JSON.stringify(mapPins)} />
  <!-- icons for the pins that come from the main site (a copy on another host) -->
  <template data-mm-icon="camera"><Icon name="camera" size={16} /></template>
  <template data-mm-icon="video"><Icon name="video" size={16} /></template>
  <template data-mm-icon="music"><Icon name="music" size={16} /></template>
  <template data-mm-gallery-link>{JSON.stringify({ gallery: [localePath(lang, 'gallery'), t(lang, 'gallery.title')], music: [localePath(lang, 'music'), t(lang, 'music.title')] })}</template>
  <script type="application/json" data-mm-friends-data set:html={JSON.stringify({ friends, a2: A2, words: frWords })} />
  <script type="application/json" data-mm-ed-words set:html={JSON.stringify(edWords)} />
  <aside class="mm-ed" hidden data-mm-ed data-dev-ui aria-label="Edit">
    <div class="mm-ed__head">
      <span class="mm-ed__kind" data-mm-ed-kind></span>
      <strong class="mm-ed__title" data-mm-ed-title></strong>
      <button type="button" class="mm-ed__x" data-mm-ed-close aria-label="×">✕</button>
    </div>
    <div class="mm-ed__statuses" data-mm-ed-statuses></div>
    <label class="mm-ed__field" data-mm-ed-row="name"><span>{edWords.name}</span><input data-mm-ed-in="name" /></label>
    <label class="mm-ed__field" data-mm-ed-row="title"><span>{edWords.title}</span><input data-mm-ed-in="title" /></label>
    <label class="mm-ed__field" data-mm-ed-row="when"><span>{edWords.when}</span><input data-mm-ed-in="when" placeholder="2026. augusztus" /></label>
    <label class="mm-ed__field" data-mm-ed-row="text"><span data-mm-ed-textlabel>{edWords.why}</span><textarea rows="2" data-mm-ed-in="text"></textarea></label>
    <label class="mm-ed__field" data-mm-ed-row="details"><span>{edWords.details}</span><textarea rows="3" data-mm-ed-in="details"></textarea></label>
    <div class="mm-ed__photo">
      <img alt="" hidden data-mm-ed-img />
      <label class="mm-ed__pick">📷 {edWords.photo}<input type="file" accept="image/*" data-mm-ed-file /></label>
      <button type="button" class="mm-ed__link" hidden data-mm-ed-unphoto>{edWords.removePhoto}</button>
    </div>
    <div class="mm-ed__actions">
      <button type="button" class="mm-ed__done" data-mm-ed-done>✓ {edWords.done}</button>
      <button type="button" class="mm-ed__link" hidden data-mm-ed-delete>🗑 {edWords.remove}</button>
    </div>
    <p class="mm-ed__note">{edWords.note}</p>
  </aside>
  <button type="button" class="mm-ed-addpin" hidden data-mm-ed-addpin data-dev-ui>📍 {edWords.addPin}</button>
  <!-- developer mode, after clicking a city or searching a place: put something there -->
  <div class="mm-offer" hidden data-mm-offer data-dev-ui>
    <span class="mm-offer__name">{edWords.here} <b data-mm-offer-name></b></span>
    <button type="button" data-mm-offer-do="pin">📍 {edWords.addPin}</button>
    <button type="button" data-mm-offer-do="photo">📷 {edWords.photo2}</button>
    <button type="button" data-mm-offer-do="post">📝 {edWords.post}</button>
    <button type="button" data-mm-offer-do="music">🎵 {edWords.music}</button>
    <button type="button" class="mm-offer__x" data-mm-offer-do="close" aria-label="✕">✕</button>
  </div>
  <!-- a photo at its real size -->
  <div class="mm-lightbox" hidden data-mm-lightbox>
    <img alt="" data-mm-lightbox-img />
    <button type="button" class="mm-lightbox__x" aria-label={text.close} data-mm-lightbox-close>✕</button>
  </div>
  <script type="application/json" data-mm-metas set:html={JSON.stringify(metas)} />
  <script type="application/json" data-mm-city-data set:html={JSON.stringify(cities)} />
  <script type="application/json" data-mm-text set:html={JSON.stringify(text)} />
  <script type="application/json" data-mm-factories set:html={JSON.stringify(factories)} />
</div>

<style>
  .map-mode-view {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 550;
    overflow: hidden;
    /* the globe hangs in space */
    background:
      radial-gradient(circle at 20% 30%, #fff 1px, transparent 1.4px) 0 0 / 97px 97px,
      radial-gradient(circle at 70% 60%, rgb(255 255 255 / 0.7) 1px, transparent 1.4px) 0 0 / 143px 143px,
      radial-gradient(circle at 40% 80%, rgb(255 255 255 / 0.5) 0.8px, transparent 1.2px) 0 0 / 61px 61px,
      linear-gradient(160deg, #1a1446, #07051a);
    font-family: var(--font-body);
    color: var(--ink);
    /* the page zoom slider does not affect map mode */
    zoom: var(--inv-zoom, 1);
  }
  :global(html.map-mode) .map-mode-view {
    display: block;
  }
  .mm-canvas,
  .mm-canvas :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }
  .mm-canvas :global(svg:active) {
    cursor: grabbing;
  }
  .mm-canvas :global(.mm-land) {
    fill: var(--land);
    stroke: #fff;
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
  }
  .mm-canvas :global(.c-unexplored) {
    fill: url(#mm-stripes);
    cursor: pointer;
  }
  .mm-canvas :global(.mm-land.is-data) {
    cursor: pointer;
  }
  .mm-canvas :global(.c-visited) {
    fill: var(--yellow);
    stroke: var(--ink);
    stroke-width: 1;
  }
  .mm-canvas :global(.c-transit) {
    fill: var(--surface);
    stroke: var(--violet);
    stroke-width: 1.4;
    stroke-dasharray: 3 2;
  }
  .mm-canvas :global(.c-now) {
    fill: var(--violet);
    stroke: var(--ink);
    stroke-width: 1;
  }
  .mm-canvas :global(.c-home) {
    fill: var(--ink);
    stroke: var(--yellow);
    stroke-width: 1.5;
  }
  .mm-canvas :global(.c-planned) {
    fill: url(#mm-hatch);
    stroke: var(--violet-dark);
    stroke-width: 1;
  }
  .mm-canvas :global(.mm-land.is-data:hover) {
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .mm-canvas :global(.mm-search-pin) {
    fill: var(--violet);
    stroke: var(--ink);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  /* ---- pinned content: pin → title → full card, depending on the zoom ---- */
  .mm-items {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .mm-item {
    position: absolute;
    left: 0;
    top: 0;
    display: none;
    transform: translate(var(--x), var(--y));
  }
  .mm-item.is-dot,
  .mm-item.is-label,
  .mm-item.is-card {
    display: block;
  }
  .mm-pin {
    position: absolute;
    left: -15px;
    top: -15px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--violet);
    color: #fff;
    box-shadow: 2px 2px 0 var(--ink);
    pointer-events: auto;
    transition: transform var(--t-fast);
  }
  .mm-item--yellow .mm-pin {
    background: var(--yellow);
    color: var(--ink);
  }
  .mm-pin:hover {
    transform: scale(1.15);
  }
  .mm-label {
    display: none;
    position: absolute;
    left: 20px;
    top: -12px;
    max-width: 220px;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 2px solid var(--ink);
    font-weight: 700;
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: auto;
    cursor: pointer;
  }
  .mm-item.is-flip .mm-label {
    left: auto;
    right: 20px;
  }
  .mm-item.is-flip .mm-card {
    left: auto;
    right: 22px;
  }
  .mm-item.is-label .mm-label {
    display: block;
  }
  .mm-card {
    display: none;
    position: absolute;
    left: 22px;
    top: -20px;
    width: 260px;
    padding: 12px 14px;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 18px;
    box-shadow: 4px 4px 0 var(--yellow);
    pointer-events: auto;
  }
  .mm-item--violet .mm-card {
    box-shadow: 4px 4px 0 var(--violet);
  }
  .mm-item.is-card .mm-card {
    display: block;
  }
  .mm-item.is-card {
    z-index: 2;
  }
  .mm-card__tag {
    display: inline-block;
    margin-bottom: 4px;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--yellow-tint);
    font-size: 11px;
    font-weight: 700;
  }
  .mm-card__title {
    margin: 0 0 4px;
    font-size: 16px;
    line-height: 1.2;
  }
  .mm-card__text {
    margin: 0 0 8px;
    font-size: 14px;
    line-height: 1.45;
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .mm-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }

  /* ---- controls ---- */
  .mm-bar {
    position: absolute;
    top: 14px;
    z-index: 3;
    display: flex;
    gap: 8px;
  }
  .mm-bar--left {
    left: 14px;
    flex-wrap: wrap;
    max-width: calc(100% - 90px);
  }
  .mm-bar--right {
    right: 14px;
    flex-direction: column;
  }
  .mm-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--touch);
    padding: 0 16px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font-weight: 700;
    font-size: 15px;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .mm-btn:hover {
    background: var(--yellow-tint);
  }
  .mm-btn--icon {
    justify-content: center;
    width: var(--touch);
    padding: 0;
  }
  .mm-btn--exit {
    background: var(--violet);
    color: #fff;
  }
  .mm-btn--exit:hover {
    background: var(--violet-dark);
  }
  .mm-search {
    display: flex;
    gap: 6px;
  }
  .mm-search input {
    width: min(280px, 60vw);
    min-height: var(--touch);
    padding: 8px 16px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-size: 15px;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .mm-legend {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    max-width: calc(100% - 28px);
    margin: 0;
    padding: 8px 14px;
    list-style: none;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 16px;
    font-size: 13px;
    font-weight: 500;
  }
  .mm-legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .mm-swatch {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border: 2px solid var(--ink);
  }
  .mm-swatch--visited {
    background: var(--yellow);
  }
  .mm-swatch--transit {
    background: var(--surface);
    border-style: dashed;
    border-color: var(--violet);
  }
  .mm-swatch--now {
    background: var(--violet);
    border-radius: 50%;
  }
  .mm-swatch--home {
    background: var(--ink);
    border-color: var(--yellow);
  }
  .mm-swatch--unexplored {
    background: repeating-linear-gradient(45deg, #c9cfe4 0 2px, var(--land) 2px 6px);
    border-color: #9aa3c4;
  }
  .mm-swatch--planned {
    background: repeating-linear-gradient(45deg, var(--violet) 0 2px, var(--violet-tint) 2px 6px);
  }
  .mm-hint {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 3;
    max-width: min(360px, calc(100% - 28px));
    margin: 0;
    padding: 6px 12px;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    font-size: 13px;
    font-weight: 500;
  }
  /* photos keep their shape (nothing cut off); a click opens them at their real size */
  .mm-card :global(.mm-card__img),
  .mm-card__img {
    display: block;
    width: 100%;
    max-height: 220px;
    object-fit: contain;
    margin: -2px 0 8px;
    border-radius: 10px;
    background: rgb(0 0 0 / 0.06);
  }
  .mm-card__img[data-mm-zoomable] {
    cursor: zoom-in;
  }
  .mm-card__audio {
    width: 100%;
    margin: 4px 0 8px;
  }
  /* "Music & photos": only those pins; otherwise they are not shown */
  .map-mode-view:not(.is-media) .mm-item--media,
  .map-mode-view.is-media .mm-item:not(.mm-item--media),
  .map-mode-view.is-media .mm-cities,
  .map-mode-view.is-media .mm-jars,
  .map-mode-view.is-media .mm-intro,
  .map-mode-view.is-media .mm-geo-labels,
  .map-mode-view.is-media .mm-route-stops {
    display: none !important;
  }
  .mm-dev-globe {
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .mm-dev-globe:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 2px;
  }
  .mm-media-switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--surface, #fff);
    color: var(--ink);
    font-weight: 700;
    font-size: 14px;
    box-shadow: 3px 3px 0 var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  /* friends on: only the friends' countries and their markers */
  .mm-fr-marks,
  .mm-fr-list,
  .mm-fr-list__dev {
    display: none;
  }
  .map-mode-view.is-friends .mm-items,
  .map-mode-view.is-friends .mm-cities,
  .map-mode-view.is-friends .mm-jars,
  .map-mode-view.is-friends .mm-intro,
  .map-mode-view.is-friends .mm-geo-labels,
  .map-mode-view.is-friends .mm-route-stops,
  .map-mode-view.is-friends .mm-space,
  .map-mode-view.is-friends .mm-legend--travel {
    display: none !important;
  }
  .map-mode-view.is-friends .mm-canvas :global(.mm-land) {
    fill: var(--land, #e9ecf5);
  }
  .map-mode-view.is-friends .mm-canvas :global(.mm-land.is-friend) {
    fill: #ff5fa2;
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .map-mode-view.is-friends .mm-canvas :global(.mm-land.is-friend:hover) {
    fill: #ff8cc0;
  }
  /* "Events": only the places he has been to and his races – everything else hides */
