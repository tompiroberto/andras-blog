</style>

<script>
  import { FACTS_EVENT, MAP_MODE_EVENT, MAP_MODE_STORAGE_KEY, PLACE_MESSAGE_EVENT, ROUTE_EVENT } from '../lib/constants';
  import { applySeen, markSeen } from '../lib/seen';
  import { jarSvg } from '../lib/jar';
  import { distanceKm, findMyLocation, loadMyLocation, saveMyLocation } from '../lib/myLocation';
  import { plan, type Mode, type Plan } from '../lib/routePlanner';
  import { geocode } from '../lib/geocode';

  /** Zoom levels where more detail appears */
  const LABEL_AT = 2.2;
  const CARD_AT = 4.5;
  const CARD_W = 290;
  const CARD_H = 190;

  const LAND_SVG = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100' preserveAspectRatio='none'><g fill='%2339d353' stroke='%23141a33' stroke-width='1.2'><path d='M18 22c10-8 30-9 40-2 6 5 2 14-6 17-6 2-8 8-14 10-8 2-12-4-14-10-3-6-12-8-6-15Z'/><path d='M44 52c6-2 12 2 13 9 1 9-4 20-9 28-3 3-6 0-6-4 0-8-5-13-4-21 0-6 2-10 6-12Z'/><path d='M92 20c6-5 16-4 20 1 3 4-2 8-7 8-5 1-6 5-11 4-5-2-6-9-2-13Z'/><path d='M96 40c8-3 18 0 20 8 2 9-3 16-6 24-2 6-8 8-11 2-4-7-2-14-6-20-2-6-1-12 3-14Z'/><path d='M118 18c14-6 40-6 52 2 8 6 4 14-4 16-8 2-10 10-20 10-10 0-14-6-22-8-8-3-14-14-6-20Z'/><path d='M160 64c6-3 16-2 18 4 2 6-4 10-10 10s-12-2-12-7c0-3 1-6 4-7Z'/><path d='M70 90c20-4 50-4 70 0' fill='none' stroke='%23fff' stroke-width='3'/></g></svg>";
  const view = document.querySelector<HTMLElement>('[data-map-mode-view]');
  if (view) setup(view);

  function setup(view: HTMLElement) {
    const html = document.documentElement;
    const isOn = () => html.classList.contains('map-mode');
    let started = false;

    // links into the normal page (and the exit button) leave map mode first
    const leave = () => {
      html.classList.remove('map-mode');
      try {
        localStorage.setItem(MAP_MODE_STORAGE_KEY, '0');
      } catch {
        /* storage unavailable */
      }
      window.dispatchEvent(new Event(MAP_MODE_EVENT));
    };
    view.querySelectorAll('[data-mm-exit]').forEach((a) => a.addEventListener('click', leave));
    view.querySelector('[data-mm-exit-mode]')!.addEventListener('click', leave);
    // the planet: counted like the header's (DevMode.astro), it spins a little
    view.querySelector('[data-mm-dev-globe]')?.addEventListener('click', (e) => {
      const me = (e.currentTarget as HTMLElement).querySelector('.icon-circle');
      me?.animate([{ transform: 'rotate(0)' }, { transform: 'rotate(360deg)' }], { duration: 500, easing: 'ease-out' });
      document.querySelector<HTMLElement>('.site-header .brand .icon-circle')?.click();
    });

    const start = () => {
      if (!isOn() || started) return;
      started = true;
      initMap(view).catch((err) => console.error('[map mode]', err));
    };
    window.addEventListener(MAP_MODE_EVENT, start);
    start();

    // switching to the world map: a spinning Earth first (not on a page load that starts in map mode)
    window.addEventListener(MAP_MODE_EVENT, () => {
      if (!isOn() || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelector('.mm-spin')?.remove();
      const spin = document.createElement('div');
      spin.className = 'mm-spin';
      spin.setAttribute('aria-hidden', 'true');
      spin.style.setProperty('--mm-land', `url("data:image/svg+xml,${LAND_SVG}")`);
      spin.innerHTML = '<span class="mm-spin__ring"></span><span class="mm-spin__earth"><span class="mm-spin__land"></span><span class="mm-spin__glow"></span></span>';
      document.body.append(spin);
      window.setTimeout(() => spin.remove(), 2000);
    });
  }

  async function initMap(view: HTMLElement) {
    const [geo, z, sel, topo, world] = await Promise.all([
      import('d3-geo'),
      import('d3-zoom'),
      import('d3-selection'),
      import('topojson-client'),
      fetch('/data/countries-110m.json').then((r) => r.json()),
    ]);
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const canvas = view.querySelector<HTMLElement>('[data-mm-canvas]')!;
    const status = view.querySelector<HTMLElement>('[data-mm-status]')!;
    const tip = view.querySelector<HTMLElement>('[data-mm-tip]')!;
    const msg = (n: string) => view.querySelector<HTMLTemplateElement>(`[data-mm-msg-${n}]`)!.content.textContent ?? '';
    const info: Record<string, { status: string; name: string; text: string; when?: string; details?: string; image?: string }> = JSON.parse(
      view.querySelector('[data-mm-countries]')!.textContent || '{}',
    );
    const metas: Record<string, { name: string; plonk: string; clues: { art: string; text: string }[] }> = JSON.parse(
      view.querySelector('[data-mm-metas]')!.textContent || '{}',
    );
    const words: {
      unexplored: string;
      meta: string;
      plonk: string;
      write: string;
      nutellaKicker: string;
      opened: string;
      uncertain: string;
      distResult: string;
      distIp: string;
      distLooking: string;
      distError: string;
      route: Record<string, string>;
      kinds: Record<string, string>;
    } = JSON.parse(view.querySelector('[data-mm-text]')!.textContent || '{}');
    type Factory = { city: string; country: string; countryName: string; lat: number; lon: number; opened: number | null; note: string; uncertain?: boolean };
    const factories: Factory[] = JSON.parse(view.querySelector('[data-mm-factories]')!.textContent || '[]');
    const writeAbout = (place: string) => window.dispatchEvent(new CustomEvent(PLACE_MESSAGE_EVENT, { detail: { place } }));
    const cityData: [string, number, number, number][] = JSON.parse(view.querySelector('[data-mm-city-data]')!.textContent || '[]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let W = canvas.clientWidth;
    let H = canvas.clientHeight;
    // The map is a globe: drag to spin it, wheel / buttons to zoom (orthographic projection)
    const view3d = { k: 1, lon: 15, lat: 30 };
    let base = Math.min(W, H) * 0.46;
    const projection = geo.geoOrthographic().clipAngle(90).precision(0.5);
    const fit = () => {
      base = Math.min(W, H) * 0.46;
      projection.scale(base * view3d.k).translate([W / 2, H / 2]).rotate([-view3d.lon, -view3d.lat]);
    };
    fit();
    const path = geo.geoPath(projection);
    /** Screen position of a place – far off-screen when it is on the back of the globe */
    const OFF: [number, number] = [-99999, -99999];
    const screenP = (p: [number, number]): [number, number] =>
      geo.geoDistance(p, [view3d.lon, view3d.lat]) > Math.PI / 2 - 0.03 ? OFF : ((projection(p) as [number, number] | null) ?? OFF);
    const graticule = geo.geoGraticule10();
    const countries = topo.feature(world, world.objects.countries) as unknown as GeoJSON.FeatureCollection;

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.innerHTML = `<defs><pattern id="mm-hatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
      <rect width="6" height="6" style="fill:var(--violet-tint)"/><line x1="0" y1="0" x2="0" y2="6" stroke-width="3" style="stroke:var(--violet)"/></pattern>
      <pattern id="mm-stripes" patternUnits="userSpaceOnUse" width="7" height="7" patternTransform="rotate(45)">
      <rect width="7" height="7" style="fill:var(--land)"/><line x1="0" y1="0" x2="0" y2="7" stroke-width="2" stroke="#c9cfe4"/></pattern></defs>`;
    const g = document.createElementNS(SVG_NS, 'g');
    svg.append(g);
    canvas.append(svg);

    const paths: { el: SVGPathElement; f: GeoJSON.Feature }[] = [];
    let searchPin: SVGCircleElement | null = null;
    // terrain layer (loaded the first time the terrain view is switched on)
    type TerrainData = {
      areas: { k: string; c: number[][][][] }[];
      rivers: number[][][];
      labels: { k: string; p: [number, number]; n: Record<string, string>; z: number }[];
    };
    let terrain: TerrainData | null = null;
    let terrainOn = false;
    // terrain shapes on the sphere
    const terrainEls: { el: SVGPathElement; geo: GeoJSON.Geometry }[] = [];
    function drawTerrain() {
      if (!terrain) return;
      const tg = document.createElementNS(SVG_NS, 'g');
      tg.setAttribute('class', 'mm-terrain');
      const byKind: Record<string, number[][][][]> = {};
      // ring direction differs between the source files: a shape "bigger than half the globe" is inside out
      const rightWay = (poly: number[][][]) =>
        geo.geoArea({ type: 'Polygon', coordinates: poly } as GeoJSON.Polygon) > 2 * Math.PI ? poly.map((ring) => [...ring].reverse()) : poly;
      for (const a of terrain.areas) (byKind[a.k] ??= []).push(...a.c.map(rightWay));
      for (const k of ['tundra', 'desert', 'range', 'lake']) {
        if (!byKind[k]) continue;
        const el = document.createElementNS(SVG_NS, 'path');
        el.setAttribute('class', `t-${k}`);
        const gm = { type: 'MultiPolygon', coordinates: byKind[k] } as GeoJSON.MultiPolygon;
        el.setAttribute('d', path(gm) ?? '');
        terrainEls.push({ el, geo: gm });
        tg.append(el);
      }
      const rv = document.createElementNS(SVG_NS, 'path');
      rv.setAttribute('class', 't-rivers');
      const rg = { type: 'MultiLineString', coordinates: terrain.rivers } as GeoJSON.MultiLineString;
      rv.setAttribute('d', path(rg) ?? '');
      terrainEls.push({ el: rv, geo: rg });
      tg.append(rv);
      g.append(tg);
    }
    const sphereEl = document.createElementNS(SVG_NS, 'path');
    sphereEl.setAttribute('class', 'mm-sphere');
    const gratEl = document.createElementNS(SVG_NS, 'path');
    gratEl.setAttribute('class', 'mm-graticule');
    function drawCountries() {
      g.replaceChildren(sphereEl, gratEl);
      sphereEl.setAttribute('d', path({ type: 'Sphere' }) ?? '');
      gratEl.setAttribute('d', path(graticule) ?? '');
      paths.length = 0;
      for (const f of countries.features) {
        const d = path(f) ?? '';
        const el = document.createElementNS(SVG_NS, 'path');
        el.setAttribute('d', d);
        el.classList.add('mm-land');
        el.dataset.iso = String(f.id);
        el.dataset.name = (f.properties as { name?: string } | null)?.name ?? '';
        const c = info[String(f.id)];
        if (c) el.classList.add('is-data', `c-${c.status}`);
        else el.classList.add('c-unexplored'); // not visited yet: "waiting to be explored" stripes
        g.append(el);
        paths.push({ el, f });
      }
      // data countries on top so their outlines show
      paths.filter((p) => p.el.classList.contains('is-data')).forEach((p) => g.append(p.el));
      drawTerrain();
    }
    /** Everything follows the globe: land, terrain (at most every 120 ms while moving), route, pin, labels */
    let lastTerrain = 0;
    let pinAt: [number, number] | null = null;
    function redraw(final = false) {
      projection.scale(base * view3d.k).translate([W / 2, H / 2]).rotate([-view3d.lon, -view3d.lat]);
      sphereEl.setAttribute('d', path({ type: 'Sphere' }) ?? '');
      gratEl.setAttribute('d', path(graticule) ?? '');
      for (const q of paths) q.el.setAttribute('d', path(q.f) ?? '');
      const now = performance.now();
      if (terrainOn && terrainEls.length && (final || now - lastTerrain > 120)) {
        lastTerrain = now;
        for (const te of terrainEls) te.el.setAttribute('d', path(te.geo) ?? '');
      }
      routeLayer?.querySelectorAll<SVGPathElement>('path[data-geo]').forEach((el) => el.setAttribute('d', path(JSON.parse(el.dataset.geo!)) ?? ''));
      if (searchPin && pinAt) {
        const [x, y] = screenP(pinAt);
        searchPin.setAttribute('cx', String(x));
        searchPin.setAttribute('cy', String(y));
      }
      renderItems();
      renderSpace();
      friendsMarks();
      eventMarks();
    }
    let eventMarks = () => {};
    let friendsMarks = () => {};
    let friendsClick: (e: MouseEvent, iso: string) => void = () => {};
    drawCountries();
    window.setTimeout(applySeen, 0);

    // ---- content items ----
    const items = Array.from(view.querySelectorAll<HTMLElement>('[data-mm-item]')).map((el) => ({
      el,
      media: !!el.dataset.media,
      lat: Number(el.dataset.lat),
      lon: Number(el.dataset.lon),
      priority: Number(el.dataset.priority),
    }));
    const t = view3d; // the zoom level (t.k) decides how much detail shows
    const intro = view.querySelector<HTMLElement>('[data-mm-intro]')!;
    const cityBox = view.querySelector<HTMLElement>('[data-mm-cities]')!;
    /** zoom level from which cities of each rank appear */
    const CITY_AT: Record<number, number> = { 1: 1.6, 2: 3.2, 3: 6 };
    type MapCity = { name: string; lat: number; lon: number; at: number; el?: HTMLButtonElement };
    const cityEls: MapCity[] = cityData.map(([name, lat, lon, rank]) => ({ name, lat, lon, at: CITY_AT[rank] ?? 99 }));
    const cityEl = (c: MapCity) => {
      if (c.el) return c.el;
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'mm-city';
      b.textContent = c.name;
      b.addEventListener('click', () => {
        markSeen(c.name);
        if (document.documentElement.classList.contains('dev-mode')) offerPin(c.name, c.lat, c.lon);
        window.dispatchEvent(new CustomEvent(FACTS_EVENT, { detail: { name: c.name, lat: c.lat, lon: c.lon } }));
      });
      cityBox.append(b);
      c.el = b;
      return b;
    };
    // zooming in: thousands more towns (Natural Earth populated places, loaded once)
    let placesLoaded = false;
    async function loadPlaces() {
      placesLoaded = true;
      try {
        const rows: [string, number, number, number][] = await (await fetch('/data/places.json')).json();
        const known = new Set(cityEls.map((c) => c.name));
        for (const [name, lat, lon, rank] of rows) {
          if (known.has(name)) continue;
          known.add(name);
          cityEls.push({ name, lat, lon, at: 2.2 + rank * 1.15 });
        }
        cityEls.sort((a, b) => a.at - b.at);
        renderItems();
        applySeen();
      } catch (err) {
        console.error('[map mode] places', err);
      }
    }

    function renderItems() {
      const [ix, iy] = screenP([Number(intro.dataset.lon), Number(intro.dataset.lat)]);
      intro.style.setProperty('--x', `${ix.toFixed(1)}px`);
      intro.style.setProperty('--y', `${iy.toFixed(1)}px`);
      const introBox = intro.getBoundingClientRect();
      const viewBox = view.getBoundingClientRect();
      const level = t.k >= CARD_AT ? 'card' : t.k >= LABEL_AT ? 'label' : 'dot';
      // highest priority first; cards/labels that would overlap a more important one fall back
      const taken: { l: number; r: number; t: number; b: number }[] = [];
      const order = [...items].sort((a, b) => b.priority - a.priority);
      const mediaOn = view.classList.contains('is-media');
      for (const it of order) {
        // the "Music & photos" switch: only those pins – otherwise everything but them
        if (!!(it as { media?: boolean }).media !== mediaOn) {
          it.el.classList.remove('is-dot', 'is-label', 'is-card');
          continue;
        }
        const [px, py] = screenP([it.lon, it.lat]);
        const x = px;
        const y = py;
        it.el.classList.remove('is-dot', 'is-label', 'is-card');
        // near the right edge the card / title opens to the left of its pin
        const flip = x + (level === 'card' ? CARD_W : 200) > W - 70;
        it.el.classList.toggle('is-flip', flip);
        if (x < -300 || x > W + 40 || y < -220 || y > H + 40) continue;
        it.el.style.setProperty('--x', `${x.toFixed(1)}px`);
        it.el.style.setProperty('--y', `${y.toFixed(1)}px`);
        let shown = level;
        if (shown !== 'dot') {
          const w = shown === 'card' ? CARD_W : 190;
          const h = shown === 'card' ? CARD_H : 28;
          const box = flip ? { l: x - w, r: x + 16, t: y - 22, b: y - 22 + h } : { l: x - 16, r: x + w, t: y - 22, b: y - 22 + h };
          const hit = taken.some((o) => box.l < o.r && box.r > o.l && box.t < o.b && box.b > o.t);
          if (hit && shown === 'card') {
            const small = flip ? { l: x - 190, r: x + 16, t: y - 14, b: y + 14 } : { l: x - 16, r: x + 190, t: y - 14, b: y + 14 };
            shown = taken.some((o) => small.l < o.r && small.r > o.l && small.t < o.b && small.b > o.t) ? 'dot' : 'label';
            if (shown === 'label') taken.push(small);
          } else if (hit) shown = 'dot';
          else taken.push(box);
        }
        it.el.classList.add(`is-${shown}`);
      }
      // cities: only where they do not cover the content cards, titles or the intro
      const blocked = [...taken, { l: introBox.left - viewBox.left, r: introBox.right - viewBox.left, t: introBox.top - viewBox.top, b: introBox.bottom - viewBox.top }];
      if (!placesLoaded && t.k > 2) loadPlaces();
      let shown = 0;
      for (const c of cityEls) {
        c.el?.classList.remove('is-on');
        if (terrainOn || t.k < c.at || shown > 160) continue;
        const [x, y] = screenP([c.lon, c.lat]);
        if (x < 0 || x > W - 60 || y < 60 || y > H - 20) continue;
        const box = { l: x - 6, r: x + 8 + c.name.length * 7, t: y - 9, b: y + 9 };
        if (blocked.some((o) => box.l < o.r && box.r > o.l && box.t < o.b && box.b > o.t)) continue;
        blocked.push(box);
        const el = cityEl(c);
        el.style.setProperty('--x', `${x.toFixed(1)}px`);
        el.style.setProperty('--y', `${y.toFixed(1)}px`);
        el.classList.add('is-on');
        shown++;
      }
      renderGeoLabels(blocked);
      renderJars();
      renderStops();
    }

    // ---- Nutella factories: big jars popping up one after the other ----
    const jarBox = view.querySelector<HTMLElement>('[data-mm-jars]')!;
    const nutellaBtn = view.querySelector<HTMLButtonElement>('[data-mm-nutella]')!;
    let nutellaOn = false;
    const jarEls = factories.map((f, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = `mm-jar${f.uncertain ? ' is-uncertain' : ''}`;
      b.setAttribute('aria-label', `${words.nutellaKicker}: ${f.city}`);
      b.style.setProperty('--pop-delay', `${i * 90}ms`);
      b.innerHTML = jarSvg();
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        const opened = f.opened ? words.opened.replace('{year}', String(f.opened)) : '';
        showTip(e, `${f.city} · ${f.countryName}`, [f.note, opened, f.uncertain ? words.uncertain : ''].filter(Boolean).join('\n'), `${f.city}, ${f.countryName}`, words.nutellaKicker, [f.lat, f.lon]);
      });
      jarBox.append(b);
      return { el: b, lat: f.lat, lon: f.lon };
    });
    function renderJars() {
      for (const j of jarEls) {
        if (!nutellaOn || terrainOn) {
          j.el.classList.remove('is-on');
          continue;
        }
        const [px, py] = screenP([j.lon, j.lat]);
        j.el.style.setProperty('--x', `${px.toFixed(1)}px`);
        j.el.style.setProperty('--y', `${py.toFixed(1)}px`);
        j.el.classList.add('is-on');
      }
    }
    nutellaBtn.addEventListener('click', () => {
      nutellaOn = !nutellaOn;
      nutellaBtn.setAttribute('aria-pressed', String(nutellaOn));
      // show the whole world so every factory can be seen popping up
      if (nutellaOn && t.k > 2) flyTo({ k: 1, lon: 10, lat: 25 });
      renderItems();
    });

    // ---- terrain labels: oceans, seas, mountain ranges, deserts, lakes, peaks (more as you zoom in) ----
    const geoBox = view.querySelector<HTMLElement>('[data-mm-geo-labels]')!;
    const lang = view.dataset.lang ?? 'en';
    const KIND_ORDER: Record<string, number> = { ocean: 0, range: 1, desert: 2, sea: 3, lake: 4, tundra: 5, plateau: 6, peak: 7, island: 8, cape: 9, waterfall: 10, pole: 11 };
    let geoEls: { el: HTMLElement; lon: number; lat: number; z: number; w: number; order: number }[] = [];
    function buildGeoLabels() {
      if (!terrain) return;
      geoBox.replaceChildren();
      geoEls = terrain.labels
        .map((l) => {
          const el = document.createElement('button');
          el.type = 'button';
          el.className = `mm-geo mm-geo--${l.k}`;
          el.textContent = l.n[lang] ?? l.n.en;
          el.addEventListener('click', (e) => openGeoPanel(e, el.textContent!, l.k, l.p[1], l.p[0]));
          geoBox.append(el);
          const size = l.k === 'ocean' ? 13 : 7.2;
          return { el, lon: l.p[0], lat: l.p[1], z: l.z, w: el.textContent.length * size + 10, order: KIND_ORDER[l.k] ?? 9 };
        })
        .sort((a, b) => a.z - b.z || a.order - b.order);
    }
    function renderGeoLabels(blocked: { l: number; r: number; t: number; b: number }[]) {
      if (!terrainOn) return;
      const used = [...blocked];
      for (const g0 of geoEls) {
        g0.el.classList.remove('is-on');
        if (t.k < g0.z) continue;
        const [px, py] = screenP([g0.lon, g0.lat]);
        const x = px;
        const y = py;
        if (x < 20 || x > W - 20 || y < 70 || y > H - 50) continue;
        const box = { l: x - g0.w / 2, r: x + g0.w / 2, t: y - 10, b: y + 10 };
        if (used.some((o) => box.l < o.r && box.r > o.l && box.t < o.b && box.b > o.t)) continue;
        used.push(box);
        g0.el.style.setProperty('--x', `${x.toFixed(1)}px`);
        g0.el.style.setProperty('--y', `${y.toFixed(1)}px`);
        g0.el.classList.add('is-on');
      }
    }
    // ---- a clicked geographic name: its kind, "distance from me" (by IP address or a place typed in), a message ----
    const geoPanel = view.querySelector<HTMLElement>('[data-mm-geo-panel]')!;
    const distResult = geoPanel.querySelector<HTMLElement>('[data-mm-dist-result]')!;
    let geoTarget: { name: string; lat: number; lon: number } | null = null;
    const place = (el: HTMLElement, e: MouseEvent) => {
      const r = view.getBoundingClientRect();
      el.hidden = false;
      const x = Math.min(e.clientX - r.left + 12, W - el.offsetWidth - 14);
      const y = Math.max(70, Math.min(e.clientY - r.top + 12, H - el.offsetHeight - 14));
      el.style.transform = `translate(${x}px, ${y}px)`;
    };
    // ---- journey planner: route + time estimate, drawn on the map ----
    const routeBox = geoPanel.querySelector<HTMLElement>('[data-mm-route]')!;
    const routeLegs = geoPanel.querySelector<HTMLElement>('[data-mm-route-legs]')!;
    const routeTotal = geoPanel.querySelector<HTMLElement>('[data-mm-route-total]')!;
    const stopBox = view.querySelector<HTMLElement>('[data-mm-route-stops]')!;
    let me: { name: string; lat: number; lon: number } | null = null;
    let routeMode: Mode = 'plane';
    let routeLayer: SVGGElement | null = null;
    let stops: { el: HTMLElement; lat: number; lon: number }[] = [];
    const countryAt = (lon: number, lat: number) => countries.features.find((f) => geo.geoContains(f, [lon, lat]))?.id?.toString() ?? null;
    const fmtTime = (h: number, days = false) => {
      if (days || h >= 48) return words.route.days.replace('{n}', String(Math.max(1, Math.round(h / 24))));
      return words.route.hours.replace('{n}', String(h < 10 ? Math.max(0.5, Math.round(h * 2) / 2) : Math.round(h)));
    };
    function clearRoute() {
      routeLayer?.remove();
      routeLayer = null;
      stops = [];
      stopBox.replaceChildren();
    }
    function drawRoute(p: Plan) {
      clearRoute();
      if (!p.legs.length) return;
      routeLayer = document.createElementNS(SVG_NS, 'g') as SVGGElement;
      const line = (cls: string, leg: (typeof p.legs)[number]) => {
        const el = document.createElementNS(SVG_NS, 'path');
        el.setAttribute('class', `mm-route-line ${cls}`);
        const gm = { type: 'LineString', coordinates: [[leg.from.lon, leg.from.lat], [leg.to.lon, leg.to.lat]] } as GeoJSON.LineString;
        el.setAttribute('d', path(gm) ?? '');
        el.dataset.geo = JSON.stringify(gm);
        routeLayer!.append(el);
      };
      p.legs.forEach((l) => line('mm-route-line--case', l));
      p.legs.forEach((l) => line(l.kind === 'air' ? 'mm-route-line--air' : 'mm-route-line--ground', l));
      g.append(routeLayer);
      const points = [p.legs[0].from, ...p.legs.map((l) => l.to)];
      stops = points.map((pt, i) => {
        const el = document.createElement('span');
        el.className = 'mm-stop';
        el.textContent = pt.name;
        el.style.setProperty('--d', `${i * 120}ms`);
        stopBox.append(el);
        return { el, lat: pt.lat, lon: pt.lon };
      });
      // show the whole journey
      const lons = points.map((q) => q.lon);
      const lats = points.map((q) => q.lat);
      const w = Math.min(...lons);
      const e = Math.max(...lons);
      if (e - w > 200) flyTo(WORLD);
      else flyTo(boxTransform(w - 4, Math.max(-60, Math.min(...lats) - 4), e + 4, Math.min(80, Math.max(...lats) + 4), 0.7));
      renderItems();
    }
    function renderStops() {
      for (const s0 of stops) {
        const [px, py] = screenP([s0.lon, s0.lat]);
        s0.el.style.setProperty('--x', `${px.toFixed(1)}px`);
        s0.el.style.setProperty('--y', `${py.toFixed(1)}px`);
      }
    }
    function showRoute() {
      if (!me || !geoTarget) return;
      routeBox.hidden = false;
      routeBox.querySelectorAll<HTMLButtonElement>('[data-mm-mode]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.mmMode === routeMode)));
      const p = plan(
        routeMode,
        { ...me, country: countryAt(me.lon, me.lat) },
        { ...geoTarget, country: countryAt(geoTarget.lon, geoTarget.lat) },
      );
      routeLegs.replaceChildren(
        ...p.legs.map((l) => {
          const li = document.createElement('li');
          const what = document.createElement('span');
          what.textContent = `${l.kind === 'air' ? '✈' : routeMode === 'train' ? '🚆' : routeMode === 'walk' ? '🚶' : '🚌'} ${l.from.name} → ${l.to.name}`;
          const time = document.createElement('span');
          time.className = 'mm-leg__time';
          time.textContent = fmtTime(l.hours, routeMode === 'walk');
          li.append(what, time);
          return li;
        }),
      );
      if (p.joke) routeTotal.textContent = words.route[`joke.${p.joke}`];
      else {
        routeTotal.textContent = words.route.total.replace('{t}', fmtTime(p.hours, p.mode === 'walk')) + (p.mode === 'walk' ? ` – ${words.route.walkNote}` : '');
      }
      drawRoute(p);
    }
    routeBox.querySelectorAll<HTMLButtonElement>('[data-mm-mode]').forEach((b) =>
      b.addEventListener('click', () => {
        routeMode = b.dataset.mmMode as Mode;
        showRoute();
      }),
    );

    const showDistance = (from: { name: string; lat: number; lon: number }, byIp: boolean) => {
      if (!geoTarget) return;
      me = from;
      const d = distanceKm(from.lat, from.lon, geoTarget.lat, geoTarget.lon);
      const km = Math.round(d).toLocaleString(view.dataset.lang);
      const label = byIp ? `${from.name} – ${words.distIp}` : from.name;
      distResult.textContent = words.distResult.replace('{km}', km).replace('{from}', label);
      routeMode = d > 900 ? 'plane' : d > 60 ? 'train' : 'walk';
      showRoute();
    };
    function openGeoPanel(e: MouseEvent, name: string, kind: string, lat: number, lon: number) {
      e.stopPropagation();
      tip.hidden = true;
      geoTarget = { name, lat, lon };
      markSeen(name);
      geoPanel.querySelector('[data-mm-geo-name]')!.textContent = name;
      geoPanel.querySelector('[data-mm-geo-kind]')!.textContent = words.kinds[kind] ?? '';
      distResult.textContent = '';
      routeBox.hidden = true;
      clearRoute();
      const saved = loadMyLocation();
      if (saved) showDistance(saved, false);
      place(geoPanel, e);
    }
    geoPanel.querySelector('[data-mm-geo-close]')!.addEventListener('click', () => {
      geoPanel.hidden = true;
      clearRoute();
    });
    geoPanel.querySelector('[data-mm-geo-write]')!.addEventListener('click', () => geoTarget && writeAbout(geoTarget.name));
    geoPanel.querySelector('[data-mm-geo-route]')!.addEventListener('click', () => geoTarget && routeTo(geoTarget.name, geoTarget.lat, geoTarget.lon));
    geoPanel.querySelector('[data-mm-dist]')!.addEventListener('click', async () => {
      distResult.textContent = words.distLooking;
      try {
        const me = await findMyLocation();
        showDistance(me, true);
      } catch (err) {
        console.error('[map mode] location', err);
        distResult.textContent = words.distError;
        geoPanel.querySelector<HTMLInputElement>('#mm-own-input')?.focus();
      }
    });
    const ownForm = geoPanel.querySelector<HTMLFormElement>('[data-mm-own]')!;
    ownForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = ownForm.querySelector('input')!.value.trim();
      if (!q) return;
      distResult.textContent = words.distLooking;
      try {
        const list = await geocode(q, view.dataset.lang ?? 'en');
        if (!list.length) return void (distResult.textContent = msg('none'));
        const r = list[0];
        const me = { name: [r.name, r.country].filter(Boolean).join(', '), lat: r.latitude, lon: r.longitude };
        saveMyLocation(me);
        showDistance(me, false);
      } catch (err) {
        console.error('[map mode] own location', err);
        distResult.textContent = msg('error');
      }
    });

    const terrainBtn = view.querySelector<HTMLButtonElement>('[data-mm-terrain]')!;
    // Street View lives in the world-map theme: leave the map and walk; its exit button brings the map back
    view.querySelector('[data-mm-street]')?.addEventListener('click', () => {
      document.documentElement.dataset.streetFrom = 'map';
      document.querySelector<HTMLButtonElement>('[data-html-toggle="map-mode"]')?.click();
      window.dispatchEvent(new CustomEvent('andras:street', { detail: true }));
    });
    terrainBtn.addEventListener('click', async () => {
      terrainOn = !terrainOn;
      terrainBtn.setAttribute('aria-pressed', String(terrainOn));
      view.classList.toggle('is-terrain', terrainOn);
      if (terrainOn && !terrain) {
        try {
          terrain = (await (await fetch('/data/terrain.json')).json()) as TerrainData;
          // more names that appear as you zoom in: islands, capes, waterfalls, peaks
          try {
            const extra = (await (await fetch('/data/terrain-extra.json')).json()) as { labels: TerrainData['labels'] };
            terrain.labels.push(...extra.labels);
          } catch {
            /* the basic names are enough */
          }
          drawTerrain();
          buildGeoLabels();
        } catch (err) {
          console.error('[map mode] terrain', err);
        }
      }
      if (!terrainOn) geoEls.forEach((g0) => g0.el.classList.remove('is-on'));
      tip.hidden = true;
      geoPanel.hidden = true;
      clearRoute();
      redraw(true);
    });

    // ---- spin & zoom the globe ----
    type View = { k: number; lon: number; lat: number };
    const WORLD: View = { k: 1, lon: 15, lat: 25 };
    let prevT = { x: 0, y: 0, k: 1 };
    let idle = 0;
    const zoom = z
      .zoom<SVGSVGElement, unknown>()
      .scaleExtent([0.8, 60])
      .on('zoom', (e: { transform: { x: number; y: number; k: number }; sourceEvent: Event | null }) => {
        const tr = e.transform;
        const se = e.sourceEvent;
        if (se) {
          // dragging spins the globe; the wheel / a pinch only zooms
          if (se.type !== 'wheel') {
            const S = base * view3d.k;
            view3d.lon -= ((tr.x - prevT.x) / S) * (180 / Math.PI);
            view3d.lat = Math.max(-85, Math.min(85, view3d.lat + ((tr.y - prevT.y) / S) * (180 / Math.PI)));
          }
          view3d.k = tr.k;
        }
        prevT = tr;
        redraw();
        window.clearTimeout(idle);
        idle = window.setTimeout(() => redraw(true), 160);
        // only the visitor's own dragging / zooming closes the panels (not the globe turning by itself)
        if (!se) return;
        tip.hidden = true;
        if (!stops.length) geoPanel.hidden = true;
      });
    const svgSel = sel.select(svg as SVGSVGElement);
    svgSel.call(zoom).on('dblclick.zoom', null);
    const setView = (v: View) => {
      view3d.k = v.k;
      view3d.lon = v.lon;
      view3d.lat = v.lat;
      zoom.transform(svgSel, z.zoomIdentity.scale(v.k));
    };
    // like a map app: the wheel zooms the map even when the pointer is over a card or pin
    view.querySelector<HTMLElement>('[data-mm-items]')!.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        svg.dispatchEvent(new WheelEvent('wheel', e));
      },
      { passive: false },
    );

    /** Centre and zoom that show a box of the world */
    const boxTransform = (w: number, s0: number, e: number, n: number, pad = 0.9): View => {
      const lat = (s0 + n) / 2;
      const lon = (w + e) / 2;
      const span = (Math.max((e - w) * Math.cos((lat * Math.PI) / 180), n - s0) * Math.PI) / 180;
      const k = (pad * Math.min(W, H)) / (2 * base * Math.sin(Math.min(Math.PI / 2, span / 2)));
      return { k: Math.min(60, Math.max(1, k)), lon, lat };
    };
    const europe = () => boxTransform(-12, 34, 44, 62);
    const flyTo = (target: View) => {
      if (reduced.matches) return setView(target);
      const from = { ...view3d };
      const along = geo.geoInterpolate([from.lon, from.lat], [target.lon, target.lat]);
      const t0 = performance.now();
      const D = 1000;
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / D);
        const q = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
        const [lon, lat] = along(q);
        // zoom out a little on long flights, like a plane climbing
        const dip = Math.sin(Math.PI * q) * Math.min(0.5, geo.geoDistance([from.lon, from.lat], [target.lon, target.lat]) / 3);
        const k = Math.exp(Math.log(from.k) + (Math.log(target.k) - Math.log(from.k)) * q) * (1 - dip);
        setView({ k: Math.max(0.8, k), lon, lat });
        if (p < 1) requestAnimationFrame(step);
        else redraw(true);
      };
      requestAnimationFrame(step);
    };
    const flyToPoint = (lat: number, lon: number, k = 7) => flyTo({ k, lon, lat });

    view.querySelectorAll<HTMLButtonElement>('[data-mm-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        const mode = b.dataset.mmZoom;
        if (mode === 'europe') return flyTo(europe());
        if (mode === 'world') return flyTo(WORLD);
        const factor = mode === 'in' ? 1.7 : 1 / 1.7;
        flyTo({ ...view3d, k: Math.min(60, Math.max(0.8, view3d.k * factor)) });
      }),
    );
    // a pin or title zooms in on its place and opens the card
    items.forEach((it) => {
      const go = () => flyToPoint(it.lat, it.lon, Math.max(CARD_AT + 1.5, t.k));
      it.el.querySelector('[data-mm-pin]')!.addEventListener('click', go);
      it.el.querySelector('[data-mm-label]')!.addEventListener('click', go);
    });

    // ---- developer mode: edit countries (colour, when, why, details, photo) and pins ----
    type RawCountry = { id: string; isoNumeric?: string; status: string; when?: string; image?: string; i18n: Record<string, { name: string; text: string; details?: string }> };
    type RawPin = { id: string; lat: number; lon: number; title: string; text: string; image?: string };
    const raw: { _comment?: string; countries: RawCountry[] } = JSON.parse(view.querySelector('[data-mm-countries-raw]')!.textContent || '{"countries":[]}');
    const pinsRaw: RawPin[] = JSON.parse(view.querySelector('[data-mm-pins-raw]')!.textContent || '[]');
    const edWords: Record<string, string> & { statuses: [string, string][] } = JSON.parse(view.querySelector('[data-mm-ed-words]')!.textContent || '{}');
    const ed = view.querySelector<HTMLElement>('[data-mm-ed]')!;
    const edIn = (k: string) => ed.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-mm-ed-in="${k}"]`)!;
    const edRow = (k: string) => ed.querySelector<HTMLElement>(`[data-mm-ed-row="${k}"]`)!;
    const edImg = ed.querySelector<HTMLImageElement>('[data-mm-ed-img]')!;
    const edFile = ed.querySelector<HTMLInputElement>('[data-mm-ed-file]')!;
    const edUnphoto = ed.querySelector<HTMLButtonElement>('[data-mm-ed-unphoto]')!;
    const edDelete = ed.querySelector<HTMLButtonElement>('[data-mm-ed-delete]')!;
    const statusBox = ed.querySelector<HTMLElement>('[data-mm-ed-statuses]')!;
    const addPinBtn = view.querySelector<HTMLButtonElement>('[data-mm-ed-addpin]')!;
    const SWATCH: Record<string, string> = { visited: 'var(--yellow)', transit: '#fff', planned: 'repeating-linear-gradient(45deg,#7b2ff7 0 2px,#fff 2px 5px)', now: 'var(--violet)', home: 'var(--ink)', none: 'transparent' };
    let mapDirty = false;
    const pendingPics = new Map<string, string>(); // repo path → base64
    const previewPics = new Map<string, string>(); // public path → data URL (until the site is rebuilt)
    const shownSrc = (src?: string) => (src && previewPics.get(src)) || src || '';
    const dirty = () => {
      mapDirty = true;
      window.dispatchEvent(new Event('andras:dev-changed'));
    };
    // DevMode's 🚀 Publish collects these files (and calls __mapSaved afterwards)
    const w = window as unknown as { __mapFiles?: () => { path: string; text?: string; base64?: string }[]; __mapSaved?: () => void };
    w.__mapFiles = () =>
      mapDirty
        ? [
            { path: 'src/data/countries.json', text: `${JSON.stringify(raw, null, 2)}\n` },
            { path: 'src/data/map-pins.json', text: `${JSON.stringify(pinsRaw, null, 2)}\n` },
            { path: 'src/data/friends.json', text: `${JSON.stringify(fr, null, 2)}\n` },
            ...[...pendingPics].map(([path, base64]) => ({ path, base64 })),
          ]
        : [];
    w.__mapSaved = () => {
      mapDirty = false;
      pendingPics.clear();
    };

    let edTarget: { kind: 'country'; iso: string } | { kind: 'pin'; id: string; isNew: boolean; lat: number; lon: number } | null = null;
    let edStatus = 'none';
    let edPhoto: string | undefined;
    const setStatus = (st: string) => {
      edStatus = st;
      statusBox.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.st === st)));
    };
    statusBox.replaceChildren(
      ...edWords.statuses.map(([st, label]) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.st = st;
        b.innerHTML = `<i style="background:${SWATCH[st]}"></i>`;
        b.append(label);
        b.addEventListener('click', () => setStatus(st));
        return b;
      }),
    );
    const showPhoto = (src?: string) => {
      edPhoto = src;
      edImg.hidden = !src;
      edUnphoto.hidden = !src;
      if (src) edImg.src = shownSrc(src);
    };
    const openEd = (kind: string, title: string) => {
      ed.querySelector('[data-mm-ed-kind]')!.textContent = kind;
      ed.querySelector('[data-mm-ed-title]')!.textContent = title;
      ed.hidden = false;
      addPinBtn.hidden = true;
    };
    function openCountryEditor(iso: string, fallbackName: string) {
      const entry = raw.countries.find((c) => c.isoNumeric === iso);
      const tr = entry ? entry.i18n[lang] ?? entry.i18n.en : undefined;
      edTarget = { kind: 'country', iso };
      statusBox.hidden = false;
      edRow('name').hidden = false;
      edRow('title').hidden = true;
      edRow('when').hidden = false;
      edRow('details').hidden = false;
      ed.querySelector('[data-mm-ed-textlabel]')!.textContent = edWords.why;
      edIn('name').value = tr?.name ?? fallbackName;
      edIn('when').value = entry?.when ?? '';
      edIn('text').value = tr?.text ?? '';
      edIn('details').value = tr?.details ?? '';
      setStatus(entry?.status ?? 'none');
      showPhoto(entry?.image);
      edDelete.hidden = true;
      openEd(edWords.country, tr?.name ?? fallbackName);
    }
    function openPinEditor(pin: RawPin, isNew: boolean) {
      edTarget = { kind: 'pin', id: pin.id, isNew, lat: pin.lat, lon: pin.lon };
      statusBox.hidden = true;
      edRow('name').hidden = true;
      edRow('title').hidden = false;
      edRow('when').hidden = true;
      edRow('details').hidden = true;
      ed.querySelector('[data-mm-ed-textlabel]')!.textContent = edWords.text;
      edIn('title').value = pin.title;
      edIn('text').value = pin.text;
      showPhoto(pin.image);
      edDelete.hidden = isNew;
      openEd(edWords.pin, pin.title);
    }
    const shrink = async (file: File, max = 1600) => {
      const bmp = await createImageBitmap(file);
      const k = Math.min(1, max / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas');
      c.width = Math.round(bmp.width * k);
      c.height = Math.round(bmp.height * k);
      c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
      return c.toDataURL('image/jpeg', 0.85);
    };
    edFile.addEventListener('change', async () => {
      const f = edFile.files?.[0];
      edFile.value = '';
      if (!f || !edTarget) return;
      const dataUrl = await shrink(f).catch(() => '');
      if (!dataUrl) return;
      const name = `${edTarget.kind === 'country' ? edTarget.iso : `pin-${edTarget.id}`}-${Date.now().toString(36)}.jpg`;
      const pub = `/uploads/map/${name}`;
      pendingPics.set(`public${pub}`, dataUrl.split(',')[1]);
      previewPics.set(pub, dataUrl);
      showPhoto(pub);
    });
    edUnphoto.addEventListener('click', () => showPhoto(undefined));
    ed.querySelector('[data-mm-ed-close]')!.addEventListener('click', () => (ed.hidden = true));

    /** recolour one country on the globe */
    const paint = (iso: string, st: string) => {
      for (const p of paths) {
        if (p.el.dataset.iso !== iso) continue;
        p.el.classList.remove('is-data', 'c-visited', 'c-transit', 'c-planned', 'c-now', 'c-home', 'c-unexplored');
        if (st === 'none') p.el.classList.add('c-unexplored');
        else p.el.classList.add('is-data', `c-${st}`);
      }
    };
    /** elements made here get the component's style scope (Astro's data-astro-cid-… attribute), like the built ones */
    const scopeName = Array.from(view.attributes).find((a) => a.name.startsWith('data-astro-cid'))?.name;
    const scoped = (el: Element) => {
      if (!scopeName) return;
      [el, ...Array.from(el.querySelectorAll('*'))].forEach((x) => x.setAttribute(scopeName, ''));
    };
    /** put a pin's card on the map (new) or refresh it */
    const pinItem = (pin: RawPin) => {
      let el = view.querySelector<HTMLElement>(`[data-pin-id="${CSS.escape(pin.id)}"]`);
      if (!el) {
        el = document.createElement('article');
        el.className = 'mm-item mm-item--yellow';
        el.dataset.mmItem = '';
        el.dataset.pinId = pin.id;
        el.dataset.lat = String(pin.lat);
        el.dataset.lon = String(pin.lon);
        el.dataset.priority = '6';
        el.innerHTML = '<button type="button" class="mm-pin" data-mm-pin>📍</button><span class="mm-label" data-mm-label></span><div class="mm-card"><h2 class="mm-card__title"></h2><p class="mm-card__text"></p></div>';
        scoped(el);
        view.querySelector('[data-mm-items]')!.append(el);
        const it = { el, media: false, lat: pin.lat, lon: pin.lon, priority: 6 };
        items.push(it);
        const go = () => flyToPoint(it.lat, it.lon, Math.max(CARD_AT + 1.5, t.k));
        el.querySelector('[data-mm-pin]')!.addEventListener('click', go);
        el.querySelector('[data-mm-label]')!.addEventListener('click', go);
      }
      el.querySelector('[data-mm-label]')!.textContent = pin.title;
      el.querySelector('.mm-card__title')!.textContent = pin.title;
      let text = el.querySelector<HTMLElement>('.mm-card__text');
      if (!text) {
        text = document.createElement('p');
        text.className = 'mm-card__text';
        if (scopeName) text.setAttribute(scopeName, '');
        el.querySelector('.mm-card')!.append(text);
      }
      text.textContent = pin.text;
      let img = el.querySelector<HTMLImageElement>('.mm-card__img');
      if (pin.image) {
        if (!img) {
          img = document.createElement('img');
          img.className = 'mm-card__img';
          if (scopeName) img.setAttribute(scopeName, '');
          el.querySelector('.mm-card')!.prepend(img);
        }
        img.src = shownSrc(pin.image);
      } else img?.remove();
      renderItems();
    };
    // in developer mode a click on a pin's card opens its editor
    view.querySelector('[data-mm-items]')!.addEventListener(
      'click',
      (e) => {
        if (!document.documentElement.classList.contains('dev-mode')) return;
        const el = (e.target as Element).closest<HTMLElement>('[data-pin-id]');
        if (!el || !(e.target as Element).closest('.mm-card')) return;
        const pin = pinsRaw.find((p) => p.id === el.dataset.pinId);
        if (pin) openPinEditor(pin, false);
      },
      true,
    );

    ed.querySelector('[data-mm-ed-done]')!.addEventListener('click', () => {
      if (!edTarget) return;
      if (edTarget.kind === 'country') {
        const iso = edTarget.iso;
        let entry = raw.countries.find((c) => c.isoNumeric === iso);
        const name = edIn('name').value.trim() || ed.querySelector('[data-mm-ed-title]')!.textContent || iso;
        if (edStatus === 'none') {
          if (entry) raw.countries = raw.countries.filter((c) => c !== entry);
          delete info[iso];
        } else {
          if (!entry) {
            // its id is the 2-letter code (e.g. MN), as the posts and the calendar use it
            const a2 = (JSON.parse(view.querySelector('[data-mm-friends-data]')?.textContent || '{}') as { a2?: Record<string, string> }).a2?.[iso];
            entry = { id: a2 ?? `c${iso}`, isoNumeric: iso, status: edStatus, i18n: {} };
            raw.countries.push(entry);
          }
          entry.status = edStatus;
          const when = edIn('when').value.trim();
          if (when) entry.when = when;
          else delete entry.when;
          if (edPhoto) entry.image = edPhoto;
          else delete entry.image;
          const details = edIn('details').value.trim();
          entry.i18n[lang] = { name, text: edIn('text').value.trim(), ...(details ? { details } : {}) };
          // every country needs an English entry (the other languages fall back to it)
          if (!entry.i18n.en) entry.i18n.en = { ...entry.i18n[lang] };
          info[iso] = { status: edStatus, name, text: entry.i18n[lang].text, when, details, image: shownSrc(edPhoto) };
        }
        paint(iso, edStatus);
      } else {
        const tgt = edTarget;
        let pin = pinsRaw.find((p) => p.id === tgt.id);
        if (!pin) {
          pin = { id: tgt.id, lat: tgt.lat, lon: tgt.lon, title: '', text: '' };
          pinsRaw.push(pin);
        }
        pin.title = edIn('title').value.trim() || pin.title || '📍';
        pin.text = edIn('text').value.trim();
        if (edPhoto) pin.image = edPhoto;
        else delete pin.image;
        pinItem(pin);
      }
      dirty();
      ed.hidden = true;
    });
    edDelete.addEventListener('click', () => {
      if (!edTarget || edTarget.kind !== 'pin') return;
      const id = edTarget.id;
      const i = pinsRaw.findIndex((p) => p.id === id);
      if (i >= 0) pinsRaw.splice(i, 1);
      const el = view.querySelector<HTMLElement>(`[data-pin-id="${CSS.escape(id)}"]`);
      const k = items.findIndex((it) => it.el === el);
      if (k >= 0) items.splice(k, 1);
      el?.remove();
      dirty();
      ed.hidden = true;
    });
    /** after a search in developer mode: offer a pin at the found place */
    let offered: { name: string; lat: number; lon: number } | null = null;
    function offerPin(name: string, lat: number, lon: number) {
      offered = { name, lat, lon };
      // a pin, a photo / video, a post or music for this place
      offerBar.hidden = !document.documentElement.classList.contains('dev-mode');
      offerBar.querySelector('[data-mm-offer-name]')!.textContent = name;
    }
    const offerBar = view.querySelector<HTMLElement>('[data-mm-offer]')!;
    offerBar.querySelectorAll<HTMLButtonElement>('[data-mm-offer-do]').forEach((b) =>
      b.addEventListener('click', () => {
        const what = b.dataset.mmOfferDo;
        if (what === 'close' || !offered) return void (offerBar.hidden = true);
        const detail = { place: offered.name, lat: offered.lat, lng: offered.lon };
        if (what === 'pin') addPinBtn.click();
        else if (what === 'photo') window.dispatchEvent(new CustomEvent('andras:upload-photos', { detail }));
        else if (what === 'post') window.dispatchEvent(new CustomEvent('andras:new-post', { detail }));
        else if (what === 'music') window.dispatchEvent(new CustomEvent('andras:upload-music', { detail }));
        offerBar.hidden = true;
      }),
    );

    // ---- a copy on another host: the main site's countries, pins, and the photos / music with a place ----
    if (view.dataset.live) {
      const site = view.dataset.live;
      const abs = (u?: string) => (u && u.startsWith('/') ? site + u : u);
      const getJson = <T,>(path: string) => fetch(site + path, { cache: 'no-cache' }).then((r) => (r.ok ? (r.json() as Promise<T>) : Promise.reject(new Error(String(r.status)))));
      getJson<{ countries: { countries: RawCountry[] }; pins: RawPin[] }>('/map.json')
        .then((d) => {
          // countries: colours and texts as on the main site
          const seen = new Set<string>();
          for (const c of d.countries.countries) {
            if (!c.isoNumeric) continue;
            seen.add(c.isoNumeric);
            const tr = c.i18n[lang] ?? c.i18n.en;
            info[c.isoNumeric] = { status: c.status, name: tr?.name ?? '', text: tr?.text ?? '', when: c.when ?? '', details: tr?.details ?? '', image: abs(c.image) ?? '' };
            paint(c.isoNumeric, c.status);
          }
          for (const iso of Object.keys(info)) if (!seen.has(iso) && iso !== '643') {
            delete info[iso];
            paint(iso, 'none');
          }
          raw.countries = d.countries.countries;
          // pins: new / changed ones, and the removed ones go
          const pinIds = new Set(d.pins.map((p) => p.id));
          view.querySelectorAll<HTMLElement>('[data-pin-id]').forEach((el) => {
            if (pinIds.has(el.dataset.pinId!)) return;
            const k = items.findIndex((it) => it.el === el);
            if (k >= 0) items.splice(k, 1);
            el.remove();
          });
          pinsRaw.splice(0, pinsRaw.length, ...d.pins);
          for (const p of d.pins) pinItem({ ...p, image: abs(p.image) });
        })
        .catch((err) => console.warn('[map mode] the main site could not be reached', err));
      // photos / videos and music with a place
      const iconTpl = (n: string) => view.querySelector<HTMLTemplateElement>(`[data-mm-icon="${n}"]`)?.innerHTML ?? '';
      const links = JSON.parse(view.querySelector<HTMLTemplateElement>('[data-mm-gallery-link]')?.content.textContent || '{}') as Record<string, [string, string]>;
      type Media = { key: string; lat: number; lon: number; title: string; text?: string; img?: string; video?: string; audio?: string; kind: 'photo' | 'video' | 'music' };
      const mediaItem = (m: Media) => {
        const el = document.createElement('article');
        el.className = `mm-item mm-item--${m.kind === 'music' ? 'violet' : 'yellow'} mm-item--media`;
        el.dataset.mmItem = '';
        el.dataset.media = m.kind;
        el.dataset.key = m.key;
        el.dataset.lat = String(m.lat);
        el.dataset.lon = String(m.lon);
        el.dataset.priority = '4';
        const pin = document.createElement('button');
        pin.type = 'button';
        pin.className = 'mm-pin';
        pin.dataset.mmPin = '';
        pin.innerHTML = iconTpl(m.kind === 'music' ? 'music' : m.kind === 'video' ? 'video' : 'camera');
        pin.setAttribute('aria-label', m.title);
        const label = document.createElement('span');
        label.className = 'mm-label';
        label.dataset.mmLabel = '';
        label.textContent = m.title;
        const card = document.createElement('div');
        card.className = 'mm-card';
        if (m.img) card.append(Object.assign(document.createElement('img'), { className: 'mm-card__img', src: m.img, alt: m.title, loading: 'lazy' }));
        if (m.video) card.append(Object.assign(document.createElement('video'), { className: 'mm-card__img', src: m.video, controls: true, preload: 'metadata', playsInline: true }));
        if (m.audio) card.append(Object.assign(document.createElement('audio'), { className: 'mm-card__audio', src: m.audio, controls: true, preload: 'none' }));
        card.append(Object.assign(document.createElement('h2'), { className: 'mm-card__title', textContent: m.title }));
        if (m.text) card.append(Object.assign(document.createElement('p'), { className: 'mm-card__text', textContent: m.text }));
        const [href, text] = links[m.kind === 'music' ? 'music' : 'gallery'] ?? [];
        if (href) {
          const p = document.createElement('p');
          p.className = 'mm-card__links';
          p.append(Object.assign(document.createElement('a'), { href: site + href, textContent: text }));
          card.append(p);
        }
        el.append(pin, label, card);
        scoped(el);
        view.querySelector('[data-mm-items]')!.append(el);
        const it = { el, media: true, lat: m.lat, lon: m.lon, priority: 4 };
        items.push(it);
        const go = () => flyToPoint(it.lat, it.lon, Math.max(CARD_AT + 1.5, t.k));
        pin.addEventListener('click', go);
        label.addEventListener('click', go);
      };
      /** the main site's list of one kind (photo / music) replaces this copy's */
      const syncMedia = (prefix: string, list: Media[]) => {
        const keys = new Set(list.map((m) => m.key));
        view.querySelectorAll<HTMLElement>(`[data-key^="${prefix}"]`).forEach((el) => {
          if (keys.has(el.dataset.key!)) return;
          const k = items.findIndex((it) => it.el === el);
          if (k >= 0) items.splice(k, 1);
          el.remove();
        });
        for (const m of list) if (!view.querySelector(`[data-key="${CSS.escape(m.key)}"]`)) mediaItem(m);
        renderItems();
      };
      getJson<{ items: { key: string; caption: string; place?: string; video?: string; large?: string; thumb?: string; lat?: number; lng?: number }[] }>('/gallery.json')
        .then((d) =>
          syncMedia(
            'photo:',
            d.items
              .filter((x) => x.lat !== undefined && x.lng !== undefined)
              .map((x) => ({ key: `photo:${x.key}`, lat: x.lat!, lon: x.lng!, title: x.caption, text: x.place, img: x.video ? undefined : abs(x.thumb || x.large), video: abs(x.video || undefined), kind: x.video ? 'video' : 'photo' })),
          ),
        )
        .catch(() => {});
      getJson<{ items: { id: string; file: string; title: string; artist?: string; about?: string; place?: string; tags?: string[]; lat?: number; lng?: number }[] }>('/music.json')
        .then((d) =>
          syncMedia(
            'music:',
            d.items
              .filter((x) => x.lat !== undefined && x.lng !== undefined)
              .map((x) => ({
                key: `music:${x.id}`,
                lat: x.lat!,
                lon: x.lng!,
                title: x.artist ? `${x.artist} – ${x.title}` : x.title,
                text: [x.place, x.about, (x.tags ?? []).map((tg) => `#${tg}`).join(' ')].filter(Boolean).join(' · '),
                audio: abs(x.file),
                kind: 'music' as const,
              })),
          ),
        )
        .catch(() => {});
    }

    // ---- "Music & photos" switch ----
    const mediaBox = view.querySelector<HTMLInputElement>('[data-mm-media]')!;
    const friendsBox = view.querySelector<HTMLInputElement>('[data-mm-friends]')!;
    mediaBox.addEventListener('change', () => {
      view.classList.toggle('is-media', mediaBox.checked);
      if (mediaBox.checked && friendsBox.checked) {
        friendsBox.checked = false;
        setFriends(false);
      }
      renderItems();
    });

    // ---- friends: the countries where András has friends (👥 switch; everything else hides) ----
    type Friend = { iso: string; a2?: string; name?: string; note: string; note_en?: string };
    // the Hungarian page shows the Hungarian note, every other language the English one
    const isHu = (document.documentElement.lang || '').startsWith('hu');
    const noteOf = (f: Friend) => (isHu ? f.note : f.note_en || f.note);
    const frData = JSON.parse(view.querySelector('[data-mm-friends-data]')!.textContent || '{}') as {
      friends: { _comment?: string; countries: Friend[] };
      a2: Record<string, string>;
      words: Record<string, string>;
    };
    const fr = frData.friends;
    const FW = frData.words;
    const frNames = new Intl.DisplayNames([document.documentElement.lang || 'en'], { type: 'region' });
    const frName = (f: Friend) => {
      const a2 = f.a2 ?? frData.a2[f.iso];
      try {
        if (a2) return frNames.of(a2) ?? f.name ?? f.iso;
      } catch {
        /* an unknown code: the stored name */
      }
      return f.name ?? paths.find((p) => p.el.dataset.iso === f.iso)?.el.dataset.name ?? f.iso;
    };
    const frMarks = view.querySelector<HTMLElement>('[data-mm-fr-marks]')!;
    const frList = view.querySelector<HTMLElement>('[data-mm-fr-items]')!;
    let marks: { el: HTMLButtonElement; lat: number; lon: number }[] = [];
    const centroid = (iso: string): [number, number] | null => {
      const f = paths.find((p) => p.el.dataset.iso === iso)?.f;
      if (!f) return null;
      // the biggest piece of the country (the USA: not between Alaska and Hawaii)
      const g = f.geometry as GeoJSON.Polygon | GeoJSON.MultiPolygon;
      const polys = g.type === 'MultiPolygon' ? g.coordinates.map((c) => ({ type: 'Polygon', coordinates: c }) as GeoJSON.Polygon) : [g];
      const big = polys.reduce((a, b) => (geo.geoArea(b) > geo.geoArea(a) ? b : a));
      const [lon, lat] = geo.geoCentroid(big);
      return [lat, lon];
    };
    const frTip = (e: MouseEvent, f: Friend) => {
      const at = centroid(f.iso);
      showTip(e, `👥 ${frName(f)}`, noteOf(f) || FW.noNote, frName(f), FW.kicker, at ?? undefined);
    };
    function renderFriends() {
      const on = view.classList.contains('is-friends');
      for (const p of paths) p.el.classList.toggle('is-friend', fr.countries.some((f) => f.iso === p.el.dataset.iso));
      frMarks.replaceChildren();
      marks = [];
      fr.countries.forEach((f, i) => {
        const at = centroid(f.iso);
        if (!at) return;
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'mm-fr-mark';
        b.textContent = '👥';
        b.title = frName(f);
        b.setAttribute('aria-label', frName(f));
        b.style.setProperty('--d', `${i * 40}ms`);
        b.addEventListener('click', (e) => {
          e.stopPropagation();
          if (isDev()) openFriendEditor(f.iso);
          else frTip(e, f);
        });
        frMarks.append(b);
        marks.push({ el: b, lat: at[0], lon: at[1] });
      });
      // the list: every country, a click flies there
      frList.replaceChildren(
        ...[...fr.countries]
          .sort((a, b) => frName(a).localeCompare(frName(b)))
          .map((f) => {
            const li = document.createElement('li');
            const go = document.createElement('button');
            go.type = 'button';
            go.textContent = frName(f);
            if (noteOf(f)) go.title = noteOf(f);
            go.addEventListener('click', () => {
              const at = centroid(f.iso);
              if (at) flyToPoint(at[0], at[1], Math.max(t.k, 2.2));
              if (isDev()) openFriendEditor(f.iso);
            });
            const x = document.createElement('button');
            x.type = 'button';
            x.className = 'mm-fr-x';
            x.textContent = '✕';
            x.title = FW.remove;
            x.addEventListener('click', () => {
              fr.countries = fr.countries.filter((o) => o !== f);
              dirty();
              renderFriends();
            });
            li.append(go, x);
            return li;
          }),
      );
      view.querySelector('[data-mm-fr-count]')!.textContent = `👥 ${FW.count.replace('{n}', String(fr.countries.length))}`;
      if (on) placeMarks();
    }
    function placeMarks() {
      for (const m of marks) {
        const [x, y] = screenP([m.lon, m.lat]);
        m.el.hidden = x < -50 || x > W + 50 || y < -50 || y > H + 50;
        m.el.style.setProperty('--x', `${x.toFixed(1)}px`);
        m.el.style.setProperty('--y', `${y.toFixed(1)}px`);
      }
    }
    friendsMarks = placeMarks;
    function setFriends(on: boolean) {
      view.classList.toggle('is-friends', on);
      tip.hidden = true;
      if (!on) frEd.hidden = true;
      if (on) renderFriends();
    }
    friendsBox.addEventListener('change', () => {
      if (friendsBox.checked && mediaBox.checked) {
        mediaBox.checked = false;
        view.classList.remove('is-media');
      }
      setFriends(friendsBox.checked);
      renderItems();
    });

    // ---- events: every place András has been to (📍, the calendar's trips) and every race (🏃) ----
    {
      const evBox = view.querySelector<HTMLInputElement>('[data-mm-events]')!;
      const evLayer = view.querySelector<HTMLElement>('[data-mm-ev-marks]')!;
      type Ev = { kind: 'trip' | 'race'; title: string; place?: string; from: string; to: string; time?: string; result?: string; lat: number; lng: number };
      const today = new Date().toISOString().slice(0, 10);
      // only what has happened (a planned trip is not a place he has been to)
      const evs = (JSON.parse(evLayer.dataset.events || '[]') as Ev[]).filter((e) => e.from <= today);
      const fmtD = new Intl.DateTimeFormat(evLayer.dataset.locale || 'hu', { year: 'numeric', month: 'short', day: 'numeric' });
      const day = (d: string) => fmtD.format(new Date(`${d}T12:00:00`));
      const marks: { el: HTMLButtonElement; lat: number; lon: number }[] = [];
      evs.forEach((e, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `mm-ev-mark${e.kind === 'race' ? ' is-race' : ''}`;
        b.textContent = e.kind === 'race' ? '🏃' : '📍';
        b.title = e.title;
        b.setAttribute('aria-label', e.title);
        b.style.setProperty('--d', `${i * 40}ms`);
        const when = e.from === e.to ? day(e.from) : `${day(e.from)} – ${day(e.to)}`;
        const body = [when, e.time && `⏱ ${e.time}`, e.result && `🏅 ${e.result}`].filter(Boolean).join(' · ');
        b.addEventListener('click', (ev) => {
          ev.stopPropagation();
          showTip(ev, `${e.kind === 'race' ? '🏃' : '📍'} ${e.title}`, body, e.place ?? e.title, undefined, [e.lat, e.lng]);
        });
        evLayer.append(b);
        marks.push({ el: b, lat: e.lat, lon: e.lng });
      });
      eventMarks = () => {
        if (!view.classList.contains('is-events')) return;
        for (const m of marks) {
          const [x, y] = screenP([m.lon, m.lat]);
          m.el.hidden = x < -50 || x > W + 50 || y < -50 || y > H + 50;
          m.el.style.setProperty('--x', `${x.toFixed(1)}px`);
          m.el.style.setProperty('--y', `${y.toFixed(1)}px`);
        }
      };
      evBox.addEventListener('change', () => {
        // one view at a time: the other switches go off
        if (evBox.checked) {
          if (mediaBox.checked) {
            mediaBox.checked = false;
            view.classList.remove('is-media');
          }
          if (friendsBox.checked) {
            friendsBox.checked = false;
            setFriends(false);
          }
        }
        view.classList.toggle('is-events', evBox.checked);
        tip.hidden = true;
        renderItems();
        eventMarks();
      });
      for (const other of [mediaBox, friendsBox])
        other.addEventListener('change', () => {
          if (other.checked && evBox.checked) {
            evBox.checked = false;
            view.classList.remove('is-events');
          }
        });
    }
    // developer mode: a click on a country (with the 👥 switch on) ticks it and asks where he met them
    const isDev = () => document.documentElement.classList.contains('dev-mode') && !document.documentElement.classList.contains('dev-preview');
    const frEd = view.querySelector<HTMLElement>('[data-mm-fr-ed]')!;
    const frHas = frEd.querySelector<HTMLInputElement>('[data-mm-fr-ed-has]')!;
    const frNote = frEd.querySelector<HTMLTextAreaElement>('[data-mm-fr-ed-note]')!;
    const frNoteEn = frEd.querySelector<HTMLTextAreaElement>('[data-mm-fr-ed-note-en]')!;
    let frIso = '';
    function openFriendEditor(iso: string) {
      frIso = iso;
      const f = fr.countries.find((o) => o.iso === iso);
      const name = paths.find((p) => p.el.dataset.iso === iso)?.el.dataset.name ?? iso;
      frEd.querySelector('[data-mm-fr-ed-title]')!.textContent = f ? frName(f) : frName({ iso, name, note: '' });
      frHas.checked = true;
      frNote.value = f?.note ?? '';
      frNoteEn.value = f?.note_en ?? '';
      tip.hidden = true;
      ed.hidden = true;
      frEd.hidden = false;
      frNote.focus();
    }
    frEd.querySelector('[data-mm-fr-ed-close]')!.addEventListener('click', () => (frEd.hidden = true));
    frEd.querySelector('[data-mm-fr-ed-done]')!.addEventListener('click', () => {
      const i = fr.countries.findIndex((o) => o.iso === frIso);
      if (!frHas.checked) {
        if (i >= 0) fr.countries.splice(i, 1);
      } else {
        const a2 = frData.a2[frIso];
        const name = paths.find((p) => p.el.dataset.iso === frIso)?.el.dataset.name;
        const item: Friend = { iso: frIso, ...(a2 ? { a2 } : name ? { name } : {}), note: frNote.value.trim(), note_en: frNoteEn.value.trim() };
        if (i >= 0) fr.countries[i] = { ...fr.countries[i], note: item.note, note_en: item.note_en };
        else fr.countries.push(item);
      }
      dirty();
      frEd.hidden = true;
      renderFriends();
    });
    const hover = view.querySelector<HTMLElement>('[data-mm-fr-hover]')!;
    svg.addEventListener('pointermove', (e) => {
      if (!view.classList.contains('is-friends') || e.pointerType === 'touch') return void (hover.hidden = true);
      const p = (e.target as Element).closest<SVGPathElement>('path.mm-land.is-friend');
      const f = p && fr.countries.find((o) => o.iso === p.dataset.iso);
      if (!f) return void (hover.hidden = true);
      hover.querySelector('strong')!.textContent = `👥 ${frName(f)}`;
      hover.querySelector('span')!.textContent = noteOf(f) || FW.noNote;
      hover.hidden = false;
      const r = view.getBoundingClientRect();
      const x = Math.min(e.clientX - r.left + 16, W - hover.offsetWidth - 10);
      const y = Math.min(e.clientY - r.top + 16, H - hover.offsetHeight - 10);
      hover.style.setProperty('--hx', `${x}px`);
      hover.style.setProperty('--hy', `${y}px`);
    });
    svg.addEventListener('pointerleave', () => (hover.hidden = true));
    friendsClick = (e: MouseEvent, iso: string) => {
      if (isDev()) return openFriendEditor(iso);
      const f = fr.countries.find((o) => o.iso === iso);
      if (f) frTip(e, f);
      else tip.hidden = true;
    };
    // a copy on another host: the main site's list
    if (view.dataset.live) {
      fetch(`${view.dataset.live}/friends.json`, { cache: 'no-cache' })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((d: { countries: Friend[] }) => {
          fr.countries = d.countries;
          renderFriends();
        })
        .catch((err) => console.warn('[map mode] friends: the main site could not be reached', err));
    }
    renderFriends();

    // ---- a photo at its real size (pins' and countries' photos) ----
    const lightbox = view.querySelector<HTMLElement>('[data-mm-lightbox]')!;
    const lightImg = lightbox.querySelector<HTMLImageElement>('[data-mm-lightbox-img]')!;
    view.addEventListener('click', (e) => {
      const img = (e.target as Element).closest<HTMLImageElement>('img.mm-tip__img, img[data-mm-zoomable]');
      if (!img) return;
      e.stopPropagation();
      lightImg.src = img.src;
      lightImg.alt = img.alt;
      lightbox.hidden = false;
    });
    lightbox.addEventListener('click', () => (lightbox.hidden = true));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') lightbox.hidden = true;
    });
    addPinBtn.addEventListener('click', () => {
      if (!offered) return;
      const id = `${Date.now().toString(36)}`;
      openPinEditor({ id, lat: offered.lat, lon: offered.lon, title: offered.name, text: '' }, true);
    });

    // ---- country tooltip ----
    const tipMetas = tip.querySelector<HTMLElement>('[data-mm-tip-metas]')!;
    tip.querySelector('[data-mm-tip-close]')!.addEventListener('click', () => (tip.hidden = true));
    const tipName = tip.querySelector<HTMLElement>('[data-mm-tip-name]')!;
    const tipText = tip.querySelector<HTMLElement>('[data-mm-tip-text]')!;
    let tipPlace = '';
    let tipAt: [number, number] | null = null; // lat, lon
    tip.querySelector('[data-mm-tip-write]')!.addEventListener('click', () => tipPlace && writeAbout(tipPlace));
    const routeTo = (name: string, lat: number, lon: number) => window.dispatchEvent(new CustomEvent(ROUTE_EVENT, { detail: { name, lat, lon } }));
    tip.querySelector('[data-mm-tip-route]')!.addEventListener('click', () => tipPlace && tipAt && routeTo(tipPlace, tipAt[0], tipAt[1]));
    const placeTip = (e: MouseEvent) => {
      const r = view.getBoundingClientRect();
      tip.hidden = false;
      const x = Math.min(e.clientX - r.left + 12, W - tip.offsetWidth - 14);
      const y = Math.max(70, Math.min(e.clientY - r.top + 12, H - tip.offsetHeight - 14));
      tip.style.transform = `translate(${x}px, ${y}px)`;
    };
    function showTip(e: MouseEvent, name: string, body: string, placeName: string, kicker?: string, at?: [number, number]) {
      tipAt = at ?? null;
      geoPanel.hidden = true;
      tipName.textContent = name;
      tipText.textContent = body;
      tipMetas.replaceChildren();
      if (kicker) {
        const k = document.createElement('span');
        k.className = 'mm-meta__kicker';
        k.textContent = kicker;
        tipMetas.append(k);
      }
      tipPlace = placeName;
      placeTip(e);
    }
    svg.addEventListener('click', (e) => {
      // terrain view: the countries say nothing, only the geographic names are clickable
      if (terrainOn) return void (tip.hidden = true);
      const p = (e.target as Element).closest<SVGPathElement>('path.mm-land');
      if (!p) return (tip.hidden = true);
      geoPanel.hidden = true;
      if (view.classList.contains('is-friends')) return friendsClick(e, p.dataset.iso!);
      const id = p.dataset.iso!;
      const c = info[id];
      const m = metas[id];
      tipName.textContent = c?.name ?? m?.name ?? p.dataset.name ?? '';
      tipText.textContent = c?.text ?? words.unexplored;
      tipPlace = tipName.textContent;
      // in developer mode a click opens the editor instead
      if (document.documentElement.classList.contains('dev-mode')) {
        tip.hidden = true;
        openCountryEditor(id, tipName.textContent);
        return;
      }
      const feat = paths.find((q) => q.el === p)?.f;
      const cen = feat ? geo.geoCentroid(feat) : null;
      tipAt = cen ? [cen[1], cen[0]] : null;
      markSeen(tipPlace);
      tipMetas.replaceChildren();
      if (c?.when) {
        const w = document.createElement('span');
        w.className = 'mm-tip__when';
        w.textContent = `🗓 ${c.when}`;
        tipMetas.append(w);
      }
      if (c?.details) {
        const d = document.createElement('p');
        d.className = 'mm-tip__details';
        d.textContent = c.details;
        tipMetas.append(d);
      }
      if (c?.image) {
        const img = document.createElement('img');
        img.className = 'mm-tip__img';
        img.src = c.image;
        img.alt = c.name;
        img.loading = 'lazy';
        tipMetas.append(img);
      }
      if (m) {
        const kicker = document.createElement('span');
        kicker.className = 'mm-meta__kicker';
        kicker.textContent = words.meta;
        tipMetas.append(kicker);
        for (const clue of m.clues) {
          const row = document.createElement('div');
          row.className = 'mm-meta';
          row.innerHTML = clue.art; // own static drawing from the build
          const span = document.createElement('span');
          span.textContent = clue.text;
          row.append(span);
          tipMetas.append(row);
        }
        const a = document.createElement('a');
        a.href = m.plonk;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = `${words.plonk} ↗`;
        tipMetas.append(a);
      }
      placeTip(e);
    });

    // ---- search ----
    const form = view.querySelector<HTMLFormElement>('[data-mm-search]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = (form.querySelector('input') as HTMLInputElement).value.trim();
      if (!q) return;
      status.textContent = msg('searching');
      try {
        const list = await geocode(q, view.dataset.lang ?? 'en');
        if (!list.length) return void (status.textContent = msg('none'));
        const r = list[0];
        status.textContent = [r.name, r.admin1, r.country].filter(Boolean).join(', ');
        offerPin(r.name, r.latitude, r.longitude);
        searchPin?.remove();
        searchPin = document.createElementNS(SVG_NS, 'circle');
        searchPin.setAttribute('class', 'mm-search-pin');
        searchPin.setAttribute('r', '7');
        pinAt = [r.longitude, r.latitude];
        g.append(searchPin);
        flyToPoint(r.latitude, r.longitude, 9);
        window.dispatchEvent(new CustomEvent(FACTS_EVENT, { detail: { name: r.name, lat: r.latitude, lon: r.longitude } }));
      } catch (err) {
        console.error('[map mode] search', err);
        status.textContent = msg('error');
      }
    });

    // ---- resize: refit the map, keep the view centre ----
    new ResizeObserver(() => {
      if (!canvas.clientWidth) return;
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      fit();
      buildSpace();
      redraw(true);
    }).observe(canvas);

    // ---- outer space: floaters around the globe (hidden behind it), each says something when clicked ----
    const spaceBox = view.querySelector<HTMLElement>('[data-mm-space]')!;
    const spaceKinds = Array.from(spaceBox.querySelectorAll<HTMLTemplateElement>('[data-mm-space-kind]'));
    // each floater orbits the Earth slowly: its own distance, speed and starting angle
    let floaters: { el: HTMLElement; x: number; y: number; size: number; a: number; d: number; v: number; say?: HTMLElement }[] = [];
    // the speech bubbles: a layer above every floater, so no other floater covers what one says
    const sayLayer = view.querySelector<HTMLElement>('[data-mm-say-layer]')!;
    function placeSay(f: (typeof floaters)[number]) {
      const b = f.say;
      if (!b) return;
      const bw = b.offsetWidth;
      const bh = b.offsetHeight;
      const x = Math.min(Math.max(f.x - bw / 2, 8), W - bw - 8);
      // above the floater; below it when there is no room above
      let y = f.y - f.size / 2 - bh - 8;
      if (y < 60) y = Math.min(f.y + f.size / 2 + 8, H - bh - 8);
      b.style.setProperty('--sx', `${x.toFixed(1)}px`);
      b.style.setProperty('--sy', `${y.toFixed(1)}px`);
    }
    function buildSpace() {
      floaters.forEach((f) => {
        f.el.remove();
        f.say?.remove();
      });
      floaters = [];
      const n = 22;
      for (let i = 0; i < n; i++) {
        const k = spaceKinds[i % spaceKinds.length];
        const size = k.dataset.mmSpaceKind === 'chile' ? 26 : 44 + Math.random() * 26;
        // around the edges of the screen, where the globe does not reach at first
        const angle = (i / n) * Math.PI * 2 + Math.random() * 0.3;
        const x = W / 2 + Math.cos(angle) * W * (0.42 + Math.random() * 0.06) - size / 2;
        const y = H / 2 + Math.sin(angle) * H * (0.4 + Math.random() * 0.06) - size / 2;
        // distance from the globe's edge (px) and speed: one round in about 1.5–3 minutes
        const orbit = { a: angle, d: 30 + Math.random() * 0.22 * Math.min(W, H), v: (Math.PI * 2) / (90 + Math.random() * 90) };
        const el = document.createElement('div');
        el.className = 'mm-floater';
        el.style.setProperty('--x', `${x.toFixed(0)}px`);
        el.style.setProperty('--y', `${y.toFixed(0)}px`);
        el.style.setProperty('--size', `${size.toFixed(0)}px`);
        const bob = document.createElement('div');
        bob.style.setProperty('--bob', `${(2.4 + Math.random() * 2).toFixed(1)}s`);
        bob.innerHTML = k.innerHTML;
        el.append(bob);
        // its lines in a shuffled order: every one is said before any comes again
        const lines = (k.dataset.say ?? '').split('||').map((x) => x.trim()).filter(Boolean).sort(() => Math.random() - 0.5);
        let next = 0;
        const me = { el, x: x + size / 2, y: y + size / 2, size, ...orbit } as (typeof floaters)[number];
        el.addEventListener('click', () => {
          el.classList.remove('is-poked');
          void el.offsetWidth;
          el.classList.add('is-poked');
          // one bubble at a time: the others' close
          for (const o of floaters) {
            o.say?.remove();
            o.say = undefined;
            o.el.classList.remove('is-talking');
          }
          const say = document.createElement('span');
          say.className = 'mm-say';
          say.textContent = lines[next % lines.length] ?? '';
          next++;
          sayLayer.append(say);
          me.say = say;
          el.classList.add('is-talking');
          placeSay(me);
          // longer lines stay longer
          const life = Math.min(6000, 2600 + say.textContent.length * 40);
          say.style.setProperty('--life', `${life}ms`);
          window.setTimeout(() => {
            if (me.say !== say) return;
            say.remove();
            me.say = undefined;
            el.classList.remove('is-talking');
          }, life + 100);
        });
        spaceBox.append(el);
        floaters.push(me);
      }
      renderSpace();
    }
    /** Every floater circles the Earth just outside it (a slightly flattened orbit, wider on wide screens) */
    function renderSpace() {
      const R = base * view3d.k;
      const flat = Math.min(1.5, Math.max(1, W / H));
      for (const f of floaters) {
        const r = R + f.size / 2 + f.d;
        const near = R + f.size / 2 + 6;
        // on the screen when the globe is small enough; always just outside the globe
        const rx = Math.max(Math.min(r * flat, W / 2 - f.size / 2 - 12), near);
        const ry = Math.max(Math.min(r * 0.92, H / 2 - f.size / 2 - 12), near);
        f.x = W / 2 + Math.cos(f.a) * rx;
        f.y = H / 2 + Math.sin(f.a) * ry;
        f.el.style.setProperty('--x', `${(f.x - f.size / 2).toFixed(1)}px`);
        f.el.style.setProperty('--y', `${(f.y - f.size / 2).toFixed(1)}px`);
        placeSay(f);
      }
    }
    let lastOrbit = 0;
    const orbitStep = (now: number) => {
      const dt = lastOrbit ? Math.min(0.1, (now - lastOrbit) / 1000) : 0;
      lastOrbit = now;
      // only while the world map is on the screen
      if (isOnMap() && !document.hidden) {
        const slow = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0.25 : 1;
        for (const f of floaters) if (!f.say) f.a += f.v * dt * slow;
        renderSpace();
      }
      requestAnimationFrame(orbitStep);
    };
    const isOnMap = () => document.documentElement.classList.contains('map-mode');
    requestAnimationFrame(orbitStep);
    buildSpace();
    // start above Europe
    setView(europe());
  }
</script>
