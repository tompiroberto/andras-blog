---
import isoA2 from '../data/iso-a2.json';
import { MAIN_SITE as MAIN_SITE_URL } from '../lib/mainSite.mjs';
/**
 * Map mode: the whole site as a Google-Maps-like world map. The page itself is hidden
 * (html.map-mode rules in global.css); the content is pinned to places as cards that show more
 * detail the further you zoom in (pin → title → full card). Visited countries are coloured like
 * on the "Where I've been" map. The map data and d3 are only loaded when map mode is switched on.
 */
import Icon from './Icon.astro';
import IconCircle from './IconCircle.astro';
import { HTML_LANG, localePath, t, type Lang, type TKey } from '../i18n';
import worldCities from '../data/world-cities.json';
import geoMetas from '../data/geo-metas.json';
import { metaArt } from '../lib/metaArt';
import { getPosts } from '../lib/posts';
import { categoryMeta } from '../lib/categories';
import site from '../data/site.json';
import countriesData from '../data/countries.json';
import mapPins from '../data/map-pins.json';
import friends from '../data/friends.json';
import calendarData from '../data/calendar.json';
import racesData from '../data/races.json';
import nutella from '../data/nutella-factories.json';
import { SPACE_ART } from '../lib/spaceArt';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getPhotos } from '../lib/photos';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = localePath(lang);

/** Label points of the countries on the list (lat, lon). */
const COUNTRY_POINT: Record<string, [number, number]> = {
  HU: [46.9, 20.3],
  LT: [55.3, 23.9],
  PL: [52.1, 19.4],
  SK: [48.7, 19.6],
  RO: [45.9, 24.9],
  SI: [46.1, 14.8],
  HR: [45.2, 15.6],
  BA: [44.0, 17.8],
  AT: [47.5, 14.2],
  GR: [40.2, 22.3],
  DE: [51.1, 10.4],
  CZ: [49.8, 15.5],
  CL: [-27.0, -70.0],
  GE: [42.2, 43.5],
};
/** Posts without a country: adventures and random things on land around Hungary (not in the ocean). */
const ZONES: Record<string, [number, number][]> = {
  adventures: [[48.2, 16.6], [46.0, 21.8], [48.1, 22.4], [45.6, 18.4]],
  erasmus: [[50.5, 30.5], [41.5, 28.5]],
  random: [[46.25, 20.15], [47.95, 21.72], [47.23, 16.62], [46.07, 18.23], [48.1, 20.78], [47.69, 17.63], [46.9, 19.69], [47.53, 21.63]],
};

interface Link {
  href: string;
  label: string;
  external?: boolean;
  /** leaving map mode first (links into the normal page) */
  exit?: boolean;
}
interface Item {
  /** a photo on the card (pins added in developer mode) */
  img?: string;
  /** photos, videos and music with a place: shown with the "Music & photos" switch */
  media?: 'photo' | 'video' | 'music';
  video?: string;
  audio?: string;
  /** set for the pins added in developer mode (src/data/map-pins.json) */
  pinId?: string;
  /** photo:… / music:… – a copy on another host matches its pins with the main site by it */
  key?: string;
  id: string;
  lat: number;
  lon: number;
  title: string;
  text?: string;
  tag?: string;
  icon: string;
  tone: 'violet' | 'yellow';
  priority: number;
  links: Link[];
}

const items: Item[] = [
  {
    id: 'home',
    lat: 47.5,
    lon: 19.04,
    title: t(lang, 'hero.title'),
    text: t(lang, 'hero.tagline'),
    icon: 'house',
    tone: 'violet',
    priority: 10,
    links: [
      { href: `${home}#about`, label: t(lang, 'nav.about'), exit: true },
      { href: site.strava, label: 'Strava', external: true },
    ],
  },
  {
    id: 'about',
    lat: 46.8,
    lon: 17.7,
    title: t(lang, 'about.title'),
    text: t(lang, 'about.text'),
    icon: 'user',
    tone: 'yellow',
    priority: 8,
    links: [{ href: `${home}#about`, label: t(lang, 'posts.readMore'), exit: true }],
  },
  {
    id: 'pbs',
    lat: 43.51,
    lon: 16.44,
    title: t(lang, 'mapmode.pbs'),
    text: [...site.personalBests.map((p) => `${p.distance} · ${p.time}`), ...site.raceBadges.map((b) => t(lang, `race.${b.id}` as TKey))].join('\n'),
    icon: 'timer',
    tone: 'yellow',
    priority: 7,
    links: [{ href: site.strava, label: 'Strava', external: true }],
  },
  {
    id: 'contact',
    lat: 37.98,
    lon: 23.73,
    title: t(lang, 'contact.title'),
    text: t(lang, 'hero.status'),
    icon: 'mail',
    tone: 'violet',
    priority: 9,
    links: [
      { href: `${home}#message`, label: t(lang, 'msg.title'), exit: true },
      { href: `mailto:${site.email}`, label: 'E-mail' },
      { href: site.instagram.url, label: 'Instagram', external: true },
      { href: site.facebook, label: 'Facebook', external: true },
    ],
  },
  ...([1, 2, 3, 4, 5] as const).map((n) => {
    const where: [number, number] = ({ 1: [-37, -72], 2: [42.2, 43.5], 3: [43.6, 25.2], 4: [-47.5, -70.5], 5: [47.9, 18.9] } as const)[n] as [number, number];
    return {
      id: `plan${n}`,
      lat: where[0],
      lon: where[1],
      title: t(lang, `plan${n}.title` as TKey),
      text: t(lang, `plan${n}.text` as TKey),
      tag: t(lang, `plan${n}.tag` as TKey),
      icon: ({ 1: 'thumbs-up', 2: 'message-square', 3: 'backpack', 4: 'mountain-snow', 5: 'timer' } as const)[n],
      tone: n === 2 || n === 4 ? ('violet' as const) : ('yellow' as const),
      priority: 7,
      links: [{ href: `${home}#plans`, label: t(lang, 'plans.title'), exit: true }],
    };
  }),
];

// Prague, the KFC night
items.push({
  id: 'kfc',
  lat: 50.08,
  lon: 14.44,
  title: t(lang, 'mapmode.kfcTitle'),
  text: t(lang, 'mapmode.kfcText'),
  icon: 'utensils',
  tone: 'yellow',
  priority: 6,
  links: [],
});

// the bucket list, in the empty oceans (and South America, still waiting)
items.push(
  { id: 'bucket', lat: -42, lon: -128, title: t(lang, 'mapmode.bucketTitle'), text: t(lang, 'mapmode.bucketText'), icon: 'list-checks', tone: 'violet', priority: 7, links: [] },
  { id: 'sail', lat: 38.72, lon: -9.14, title: t(lang, 'mapmode.sailTitle'), text: t(lang, 'mapmode.sailText'), tag: t(lang, 'mapmode.bucketTitle'), icon: 'sailboat', tone: 'yellow', priority: 6, links: [] },
  { id: 'extreme', lat: -52, lon: 40, title: t(lang, 'mapmode.extremeTitle'), text: t(lang, 'mapmode.extremeText'), tag: t(lang, 'mapmode.bucketTitle'), icon: 'snowflake', tone: 'violet', priority: 6, links: [] },
  { id: 'walk', lat: -28, lon: 78, title: t(lang, 'mapmode.walkTitle'), text: t(lang, 'mapmode.walkText'), tag: t(lang, 'mapmode.bucketTitle'), icon: 'footprints', tone: 'yellow', priority: 6, links: [] },
  { id: 'southamerica', lat: -12, lon: -60, title: t(lang, 'mapmode.saTitle'), text: t(lang, 'mapmode.saText'), tag: t(lang, 'mapmode.bucketTitle'), icon: 'mountain-snow', tone: 'violet', priority: 6, links: [] },
);

// every post, pinned to its country (or its category's zone)
const posts = await getPosts();
const used: Record<string, number> = {};
for (const post of posts) {
  const { category, countries, title, excerpt, icon } = post.data;
  const meta = categoryMeta(category);
  let point: [number, number];
  const country = countries?.find((c) => COUNTRY_POINT[c]);
  if (post.data.lat !== undefined && post.data.lng !== undefined) {
    // written from the world map: exactly there
    point = [post.data.lat, post.data.lng];
  } else if (country) {
    const n = (used[country] = (used[country] ?? 0) + 1);
    const [la, lo] = COUNTRY_POINT[country];
    point = [la - (n - 1) * 1.2, lo + (n - 1) * 1.6]; // several posts in one country step aside
  } else {
    const zone = ZONES[category];
    const n = (used[category] = (used[category] ?? 0) + 1);
    point = zone[(n - 1) % zone.length];
  }
  items.push({
    id: `post-${post.id}`,
    lat: point[0],
    lon: point[1],
    title,
    text: excerpt,
    tag: t(lang, meta.titleKey),
    icon: icon ?? meta.icon,
    tone: meta.tone,
    priority: 5,
    links: [{ href: localePath(lang, `posts/${post.id}`), label: t(lang, 'posts.readMore'), exit: true }],
  });
}

// countries for colouring and the click tooltip (when / details / image: added in developer mode)
type CountryExtra = { when?: string; image?: string; i18n: Record<string, { name: string; text: string; details?: string }> };
const countryInfo = Object.fromEntries(
  countriesData.countries
    .filter((c) => c.isoNumeric)
    .map((c) => {
      const x = c as unknown as CountryExtra;
      const tr = x.i18n[lang] ?? x.i18n.en;
      return [c.isoNumeric as string, { status: c.status, name: tr.name, text: tr.text, when: x.when ?? '', details: tr.details ?? '', image: x.image ?? '' }];
    }),
);
// pins added in developer mode: a place with a title, a text and maybe a photo
type MapPin = { id: string; lat: number; lon: number; title: string; text: string; image?: string };
for (const p of mapPins as MapPin[]) {
  items.push({ id: `pin-${p.id}`, pinId: p.id, lat: p.lat, lon: p.lon, title: p.title, text: p.text, img: p.image, icon: 'map-pin', tone: 'yellow', priority: 6, links: [] });
}
// photos / videos (gallery) and music with a place: their own pins, shown with the "Music & photos" switch
for (const [i, p] of (await getPhotos(lang)).entries()) {
  if (p.lat === undefined || p.lng === undefined) continue;
  const img = p.video ? undefined : p.image ? (await getImage({ src: p.image, width: 480 })).src : p.src;
  items.push({
    id: `photo-${i}`,
    key: `photo:${p.key}`,
    lat: p.lat,
    lon: p.lng,
    title: p.caption,
    text: p.place,
    img,
    video: p.video,
    media: p.video ? 'video' : 'photo',
    icon: p.video ? 'video' : 'camera',
    tone: 'yellow',
    priority: 4,
    links: [{ href: localePath(lang, 'gallery'), label: t(lang, 'gallery.title'), exit: true }],
  });
}
for (const m of await getCollection('music')) {
  if (m.data.lat === undefined || m.data.lng === undefined) continue;
  items.push({
    id: `music-${m.id}`,
    key: `music:${m.id}`,
    lat: m.data.lat,
    lon: m.data.lng,
    title: m.data.artist ? `${m.data.artist} – ${m.data.title}` : m.data.title,
    text: [m.data.place, m.data.about, (m.data.tags ?? []).map((x) => `#${x}`).join(' ')].filter(Boolean).join(' · '),
    audio: m.data.file,
    media: 'music',
    icon: 'music',
    tone: 'violet',
    priority: 4,
    links: [{ href: localePath(lang, 'music'), label: t(lang, 'music.title'), exit: true }],
  });
}
const edWords = {
  statuses: ['visited', 'transit', 'planned', 'now', 'home', 'none'].map((s) => [s, s === 'none' ? t(lang, 'med.none') : t(lang, `legend.${s}` as TKey)]),
  country: t(lang, 'med.country'),
  pin: t(lang, 'med.pin'),
  name: t(lang, 'med.name'),
  when: t(lang, 'med.when'),
  why: t(lang, 'med.why'),
  details: t(lang, 'med.details'),
  photo: t(lang, 'med.photo'),
  removePhoto: t(lang, 'med.removePhoto'),
  done: t(lang, 'med.done'),
  remove: t(lang, 'med.remove'),
  note: t(lang, 'med.note'),
  addPin: t(lang, 'med.addPin'),
  here: t(lang, 'med.here'),
  photo2: t(lang, 'med.addPhoto'),
  post: t(lang, 'med.addPost'),
  music: t(lang, 'med.addMusic'),
  title: t(lang, 'med.title'),
  text: t(lang, 'med.text'),
};
// map mode only: Russia is on the wish list too
const regionName = new Intl.DisplayNames([HTML_LANG[lang]], { type: 'region' });
if (!countryInfo['643']) countryInfo['643'] = { status: 'planned', name: regionName.of('RU') ?? 'Russia', text: t(lang, 'mapmode.russia'), when: '', details: '', image: '' };

// GeoGuessr tips (own wording + own drawings), localised names; English text where there is no translation
type MetaEntry = { a2: string; plonk: string; clues: { type: string; extra?: string; en: string; hu: string }[] };
const metas = Object.fromEntries(
  Object.entries(geoMetas as unknown as Record<string, MetaEntry | string>)
    .filter((e): e is [string, MetaEntry] => typeof e[1] === 'object')
    .map(([id, m]) => [
      id,
      {
        name: regionName.of(m.a2) ?? m.a2,
        plonk: `https://www.plonkit.net/${m.plonk}`,
        clues: m.clues.map((c) => ({ art: metaArt(c.type, c.extra), text: lang === 'hu' ? c.hu : c.en })),
      },
    ]),
);
const cities = worldCities.cities.map((c) => [c.name, c.lat, c.lon, c.rank]);
// friends: the countries' alpha-2 codes (for their names in every language) by map id
const A2: Record<string, string> = Object.fromEntries(
  Object.entries(geoMetas as unknown as Record<string, { a2?: string } | string>)
    .filter((e): e is [string, { a2: string }] => typeof e[1] === 'object' && !!e[1].a2)
    .map(([id, m]) => [id, m.a2]),
);
for (const c of countriesData.countries as { isoNumeric?: string; id: string }[]) if (c.isoNumeric && /^[A-Z]{2}$/.test(c.id)) A2[c.isoNumeric] ??= c.id;
for (const f of friends.countries) A2[f.iso] ??= f.a2;
// and every other country of the map (src/data/iso-a2.json: map number → 2-letter code)
for (const [num, a2] of Object.entries(isoA2 as Record<string, string>)) A2[num] ??= a2;
const live = import.meta.env.PUBLIC_STATIC_EXPORT === '1' ? import.meta.env.PUBLIC_MAIN_SITE || MAIN_SITE_URL : '';
const frWords = {
  kicker: t(lang, 'mapmode.friendsKicker'),
  noNote: t(lang, 'mapmode.friendsNoNote'),
  count: t(lang, 'mapmode.friendsCount'),
  devHint: t(lang, 'mapmode.friendsDevHint'),
  has: t(lang, 'mapmode.friendsHas'),
  where: t(lang, 'mapmode.friendsWhere'),
  remove: t(lang, 'med.remove'),
};
const factories = nutella.factories.map((f) => ({ ...f, countryName: regionName.of(f.country) ?? f.country }));
const text = {
  write: t(lang, 'pm.kicker'),
  nutellaKicker: t(lang, 'mapmode.nutellaKicker'),
  opened: t(lang, 'mapmode.nutellaOpened'),
  uncertain: t(lang, 'mapmode.nutellaUncertain'),
  distResult: t(lang, 'mapmode.distResult'),
  distIp: t(lang, 'mapmode.distIp'),
  distLooking: t(lang, 'mapmode.distLooking'),
  distError: t(lang, 'mapmode.distError'),
  route: Object.fromEntries(
    ['total', 'hours', 'days', 'ground', 'walkNote', 'joke.water', 'joke.noRail', 'joke.noRoad', 'joke.here'].map((k) => [k, t(lang, `route.${k}` as TKey)]),
  ),
  kinds: Object.fromEntries(
    ['ocean', 'sea', 'lake', 'range', 'desert', 'peak', 'plateau', 'tundra', 'island', 'cape', 'waterfall', 'pole'].map((k) => [k, t(lang, `mapmode.kind.${k}` as TKey)]),
  ),
  unexplored: t(lang, 'mapmode.unexplored'),
  meta: t(lang, 'mapmode.meta'),
  plonk: t(lang, 'mapmode.plonk'),
  close: t(lang, 'facts.close'),
};

const LEGEND: { status: string; key: TKey }[] = [
  { status: 'visited', key: 'legend.visited' },
  { status: 'transit', key: 'legend.transit' },
  { status: 'now', key: 'legend.now' },
  { status: 'home', key: 'legend.home' },
  { status: 'planned', key: 'legend.planned' },
  { status: 'unexplored', key: 'mapmode.unexplored' },
];
// "Events" switch: every place András has been to (the calendar's trips) and every race he ran
const mapEvents = [
  ...(calendarData.events as { id: string; title: string; title_en?: string; place?: string; place_en?: string; from: string; to: string; lat?: number; lng?: number }[])
    .filter((e) => e.lat !== undefined && e.lng !== undefined)
    .map((e) => ({ kind: 'trip', title: lang === 'hu' ? e.title : e.title_en || e.title, place: lang === 'hu' ? e.place : e.place_en || e.place, from: e.from, to: e.to, lat: e.lat!, lng: e.lng! })),
  ...(racesData.races as { title: string; title_en?: string; place?: string; place_en?: string; date: string; time?: string; result?: string; result_en?: string; lat?: number; lng?: number }[])
    .filter((r) => r.lat !== undefined && r.lng !== undefined)
    .map((r) => ({ kind: 'race', title: lang === 'hu' ? r.title : r.title_en || r.title, place: lang === 'hu' ? r.place : r.place_en || r.place, from: r.date, to: r.date, time: r.time, result: lang === 'hu' ? r.result : r.result_en || r.result, lat: r.lat!, lng: r.lng! })),
];
---

<div class="map-mode-view" data-map-mode-view data-lang={lang} data-live={live || undefined} aria-label={t(lang, 'mapmode.toggle')} role="region">
  <!-- outer space around the globe: things float there – click them -->
  <div class="mm-space" data-mm-space>
    {Object.entries(SPACE_ART).map(([kind, svg]) => <template data-mm-space-kind={kind} data-say={t(lang, `mmspace.${kind}` as TKey)} set:html={svg} />)}
  </div>
  <div class="mm-canvas" data-mm-canvas></div>

  <!-- introduction in the Pacific Ocean -->
  <div class="mm-intro" data-mm-intro data-lat="6" data-lon="-148">
    <p class="mm-intro__title">{t(lang, 'hero.title')}</p>
    <p class="mm-intro__text">{t(lang, 'hero.tagline')}</p>
    <p class="mm-intro__hint">{t(lang, 'mapmode.explore')}</p>
  </div>
  <div class="mm-cities" data-mm-cities></div>
  <!-- the planned journey's stops ("distance from me" in the terrain view) -->
  <div class="mm-route-stops" data-mm-route-stops></div>
  <!-- Nutella factories (switch in the right bar): big jars that pop up -->
  <div class="mm-jars" data-mm-jars></div>
  <div class="mm-geo-labels" data-mm-geo-labels></div>

  <!-- content pinned to the world -->
  <div class="mm-items" data-mm-items>
    {
      items.map((it) => (
        <article class:list={['mm-item', `mm-item--${it.tone}`, { 'mm-item--media': it.media }]} data-mm-item data-media={it.media} data-lat={it.lat} data-lon={it.lon} data-priority={it.priority} data-pin-id={it.pinId} data-key={it.key} id={`mm-${it.id}`}>
          <button type="button" class="mm-pin" data-mm-pin aria-label={it.title}>
            <Icon name={it.icon} size={16} />
          </button>
          <span class="mm-label" data-mm-label>{it.title}</span>
          <div class="mm-card">
            {it.tag && <span class="mm-card__tag">{it.tag}</span>}
            {it.img && <img class="mm-card__img" src={it.img} alt={it.title} loading="lazy" data-mm-zoomable />}
            {it.video && <video class="mm-card__img" src={it.video} controls preload="metadata" playsinline />}
            {it.audio && <audio class="mm-card__audio" src={it.audio} controls preload="none" />}
            <h2 class="mm-card__title">{it.title}</h2>
            {it.text && <p class="mm-card__text">{it.text}</p>}
            {it.links.length > 0 && (
              <p class="mm-card__links">
                {it.links.map((l) => (
                  <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})} data-mm-exit={l.exit ? '' : undefined}>
                    {l.label}
                  </a>
                ))}
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <!-- top bar -->
  <div class="mm-bar mm-bar--left">
    <!-- the header's planet, here too: the door to developer mode (5 quick clicks) -->
    <button type="button" class="mm-dev-globe" data-mm-dev-globe aria-label="🌐"><IconCircle icon="globe" size="nav" variant="violet" /></button>
    <button type="button" class="mm-btn mm-btn--exit" data-mm-exit-mode>
      <Icon name="arrow-left" size={18} />
      <span>{t(lang, 'mapmode.exit')}</span>
    </button>
    <form class="mm-search" role="search" data-mm-search>
      <label class="visually-hidden" for="mm-search-input">{t(lang, 'search.label')}</label>
      <input id="mm-search-input" type="search" autocomplete="off" required maxlength="80" placeholder={t(lang, 'search.placeholder')} />
      <button type="submit" class="mm-btn mm-btn--icon" aria-label={t(lang, 'search.go')} title={t(lang, 'search.go')}>
        <Icon name="search" size={18} />
      </button>
    </form>
    <!-- only the music and the photos / videos (everything else hides) -->
    <label class="mm-media-switch">
      <input type="checkbox" data-mm-media />
      <span>🎵📷 {t(lang, 'mapmode.media')}</span>
    </label>
    <!-- the countries where András has friends (everything else hides) -->
    <label class="mm-media-switch mm-friends-switch">
      <input type="checkbox" data-mm-friends />
      <span>👥 {t(lang, 'mapmode.friends')}</span>
    </label>
    <!-- every place András has been to and every race (everything else hides) -->
    <label class="mm-media-switch mm-events-switch">
      <input type="checkbox" data-mm-events />
      <span>📍🏃 {t(lang, 'mapmode.events')}</span>
    </label>
  </div>
  <div class="mm-bar mm-bar--right">
    <button type="button" class="mm-btn mm-btn--icon" data-mm-zoom="in" aria-label={t(lang, 'map.zoomIn')} title={t(lang, 'map.zoomIn')}><Icon name="plus" size={18} /></button>
    <button type="button" class="mm-btn mm-btn--icon" data-mm-zoom="out" aria-label={t(lang, 'map.zoomOut')} title={t(lang, 'map.zoomOut')}><Icon name="minus" size={18} /></button>
    <button type="button" class="mm-btn mm-btn--icon" data-mm-zoom="europe" aria-label={t(lang, 'mapmode.europe')} title={t(lang, 'mapmode.europe')}><Icon name="locate" size={18} /></button>
    <button type="button" class="mm-btn mm-btn--icon" data-mm-zoom="world" aria-label={t(lang, 'mapmode.world')} title={t(lang, 'mapmode.world')}><Icon name="globe" size={18} /></button>
    <button type="button" class="mm-btn mm-btn--icon mm-btn--terrain" aria-pressed="false" aria-label={t(lang, 'mapmode.terrain')} title={t(lang, 'mapmode.terrain')} data-mm-terrain><Icon name="mountain" size={18} /></button>
    <button type="button" class="mm-btn mm-btn--icon" aria-label={t(lang, 'street.toggle')} title={t(lang, 'street.toggle')} data-mm-street><Icon name="person-standing" size={19} /></button>
