  /* ---- Nutella factories ---- */
  .mm-jars {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .mm-jars :global(.mm-jar) {
    position: absolute;
    left: 0;
    top: 0;
    display: none;
    width: 46px;
    height: 56px;
    padding: 0;
    border: 0;
    background: none;
    transform: translate(calc(var(--x) - 50%), calc(var(--y) - 100%));
    pointer-events: auto;
    cursor: pointer;
    filter: drop-shadow(3px 3px 0 rgb(0 0 0 / 0.25));
  }
  .mm-jars :global(.mm-jar.is-on) {
    display: block;
  }
  .mm-jars :global(.mm-jar svg) {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 50% 100%;
    animation: jar-pop 700ms cubic-bezier(0.34, 1.7, 0.5, 1) var(--pop-delay, 0ms) both;
  }
  .mm-jars :global(.mm-jar:hover svg),
  .mm-jars :global(.mm-jar:focus-visible svg) {
    animation: jar-wiggle 500ms ease-in-out;
  }
  .mm-jars :global(.mm-jar.is-uncertain) {
    opacity: 0.6;
  }
  @keyframes jar-pop {
    0% {
      transform: translateY(-60px) scale(0) rotate(-40deg);
    }
    60% {
      transform: translateY(0) scale(1.25, 0.85) rotate(8deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes jar-wiggle {
    30% {
      transform: rotate(-12deg) scale(1.1);
    }
    65% {
      transform: rotate(10deg) scale(1.1);
    }
  }
  .mm-btn--nutella[aria-pressed='true'] {
