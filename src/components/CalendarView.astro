</style>

<script>
  import { PLACE_MESSAGE_EVENT } from '../lib/constants';
  import { geocode } from '../lib/geocode';
  import { parseTags, showTags } from '../lib/tags';
  import { commitFiles, getToken } from '../lib/githubCommit';

  type Ev = { id: string; title: string; title_en?: string; place?: string; place_en?: string; country?: string; from: string; to: string; color: string; note?: string; note_en?: string; music?: string[]; tags?: string[]; docs?: { name: string; file: string }[] };
  type Plan = { id: string; text: string; text_en?: string; when?: string; when_en?: string };
  type Track = { id: string; file: string; title: string; artist?: string };
  const view = document.querySelector<HTMLElement>('[data-cal]');
  if (view) {
    const html = document.documentElement;
    const W = JSON.parse(view.querySelector('[data-cal-words]')!.textContent || '{}') as Record<string, string>;
    const data = JSON.parse(view.querySelector('[data-cal-data]')!.textContent || '{"events":[]}') as { events: Ev[]; plans?: Plan[] };
    const locale = view.dataset.lang || 'hu';
    const isHu = locale.startsWith('hu');
    /** a field in the page's language: Hungarian on the Hungarian page, English (when written) elsewhere */
    const tr = <T extends object>(o: T, k: keyof T & string) => {
      const hu = (o as Record<string, unknown>)[k] as string | undefined;
      const en = (o as Record<string, unknown>)[`${k}_en`] as string | undefined;
      return (isHu ? hu : en || hu) ?? '';
    };
    let tracks = JSON.parse(view.querySelector('[data-cal-tracks]')!.textContent || '[]') as Track[];
    type Pic = { large: string; thumb: string; caption: string; video?: string };
    let photos = JSON.parse(view.querySelector('[data-cal-photos]')!.textContent || '{}') as Record<string, Pic[]>;
    const picsOf = (id: string) => photos[id] ?? [];
    /** a copy on another host plays the main site's files (music uploaded later is only there) */
    const audioSrc = (tr: Track) => (view.dataset.live ? view.dataset.live + tr.file : tr.file);
    const trackName = (tr: Track) => (tr.artist ? `${tr.artist} – ${tr.title}` : tr.title);
    const body = view.querySelector<HTMLElement>('[data-cal-body]')!;
    const titleEl = view.querySelector<HTMLElement>('[data-cal-title]')!;
    let mode: 'month' | 'year' = 'month';
    const now = new Date();
    let cursor = new Date(now.getFullYear(), now.getMonth(), 1);

    const pad = (n: number) => String(n).padStart(2, '0');
    const iso = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const todayIso = iso(now);
    const parse = (s: string) => {
      const [y, m, d] = s.split('-').map(Number);
      return new Date(y, m - 1, d);
    };
    const on = (e: Ev, day: string) => e.from <= day && day <= e.to;
    /** readable text on the event's colour */
    const onColor = (hex: string) => {
      const n = parseInt(hex.slice(1), 16);
      const lum = (0.299 * ((n >> 16) & 255) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255;
      return lum > 0.6 ? '#1b1b24' : '#fff';
    };
    const sorted = () => [...data.events].sort((a, b) => a.from.localeCompare(b.from) || b.to.localeCompare(a.to));
    const fmtMonth = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });
    const fmtMonthOnly = new Intl.DateTimeFormat(locale, { month: 'long' });
    const fmtDay = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
    const fmtShort = new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric' });
    const weekdays = Array.from({ length: 7 }, (_, i) => new Intl.DateTimeFormat(locale, { weekday: 'short' }).format(new Date(2024, 0, 1 + i)));

    function render(fresh = false) {
      view!.classList.toggle('is-fresh', fresh);
      body.replaceChildren();
      if (mode === 'month') renderMonth();
      else renderYear();
      const legend = document.createElement('ul');
      legend.className = 'cal-legend';
      const inView = sorted().filter((e) => (mode === 'month' ? e.to >= iso(cursor) && e.from <= iso(new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0)) : e.to >= `${cursor.getFullYear()}-01-01` && e.from <= `${cursor.getFullYear()}-12-31`));
      for (const e of inView) {
        const li = document.createElement('li');
        li.style.setProperty('--c', e.color);
        li.addEventListener('click', () => openEvent(e.id));
        li.innerHTML = '<i></i>';
        li.append(`${tr(e, 'title')}${tr(e, 'place') ? ` · ${tr(e, 'place')}` : ''} (${fmtShort.format(parse(e.from))} – ${fmtShort.format(parse(e.to))})`);
        legend.append(li);
      }
      body.append(legend);
      renderSides();
    }

    // ---- the sides: timeline, countdown, plans ----
    const flagCodes = JSON.parse(view.querySelector('[data-cal-flags]')!.textContent || '[]') as string[];
    const regionNames = new Intl.DisplayNames([locale], { type: 'region' });
    const flagImg = (cc?: string) => {
      if (!cc || !flagCodes.includes(cc)) return null;
      const img = document.createElement('img');
      img.className = 'cal-flag';
      img.src = `/flags/${cc.toLowerCase()}.svg`;
      img.alt = regionNames.of(cc) ?? cc;
      img.width = 27;
      img.height = 18;
      return img;
    };
    const range = (e: Ev) => (e.from === e.to ? fmtShort.format(parse(e.from)) : `${fmtShort.format(parse(e.from))} – ${fmtShort.format(parse(e.to))}`);
    /** the next adventure (starts after today) and the one going on now */
    const nextEv = () => sorted().find((e) => e.from > iso(new Date()));
    const nowEv = () => sorted().filter((e) => on(e, iso(new Date()))).pop();
    function renderSides() {
      // timeline: every adventure up to now (scrolled to the latest ones), and the next one faded
      const today = iso(new Date());
      const done = sorted().filter((e) => e.from <= today);
      const next = nextEv();
      const list = view!.querySelector<HTMLElement>('[data-cal-tl]')!;
      const first = !list.childElementCount;
      const shown = [...done, ...(next ? [next] : [])];
      list.replaceChildren(
        ...shown.map((e, i) => {
          const li = document.createElement('li');
          li.className = 'cal-tl__item';
          const isNow = on(e, today);
          li.classList.toggle('is-now', isNow);
          li.classList.toggle('is-next', e === next);
          li.style.setProperty('--c', e.color);
          // the latest ones pop in first
          li.style.setProperty('--i', String(Math.min(6, shown.length - 1 - i)));
          if (isNow || e === next) {
            const badge = document.createElement('span');
            badge.className = 'cal-tl__badge';
            badge.textContent = isNow ? W.now : '⏳';
            li.append(badge);
          }
          const head = document.createElement('span');
          head.className = 'cal-tl__head';
          const flag = flagImg(e.country);
          if (flag) head.append(flag);
          head.append(tr(e, 'title'));
          const when = document.createElement('small');
          when.textContent = [tr(e, 'place'), range(e)].filter(Boolean).join(' · ');
          li.append(head, when);
          // a click: that month in the calendar
          li.addEventListener('click', () => {
            cursor = new Date(parse(e.from).getFullYear(), parse(e.from).getMonth(), 1);
            if (mode !== 'month') setMode('month');
            else render(true);
            openEvent(e.id);
          });
          return li;
        }),
      );
      // the first time: the timeline shows its end (the latest adventures and the next one)
      if (first) {
        const side = list.closest<HTMLElement>('.cal-side')!;
        requestAnimationFrame(() => (side.scrollTop = side.scrollHeight));
      }
      // the timeline's last row (developer mode): a new adventure, with the fields it will have
      const add = document.createElement('li');
      add.className = 'cal-tl__item cal-tl__add';
      add.style.setProperty('--c', '#39d353');
      add.style.setProperty('--i', '0');
      const addHead = document.createElement('span');
      addHead.className = 'cal-tl__head';
      addHead.textContent = `＋ ${W.tlAdd}`;
      const addHint = document.createElement('small');
      addHint.textContent = W.tlSchema;
      add.append(addHead, addHint);
      add.addEventListener('click', (ev) => {
        ev.stopPropagation();
        openForm(null, todayIso);
      });
      list.append(add);
      renderCountdown();
      const cur = nowEv();
      const nowBox = view!.querySelector<HTMLElement>('[data-cal-cd-now]')!;
      nowBox.hidden = !cur;
      if (cur) {
        const left = Math.round((parse(cur.to).getTime() - parse(today).getTime()) / 864e5);
        nowBox.textContent = `🎉 ${W.now}: ${tr(cur, 'title')} · ${W.untilEnd.replace('{n}', String(left + 1))}`;
      }
      // days abroad this year, up to today: every day of the trips (not in Hungary), each day once
      const year = new Date().getFullYear();
      const days = new Set<string>();
      for (const e of data.events) {
        if (e.country === 'HU') continue;
        for (let d = parse(e.from); iso(d) <= e.to && iso(d) <= today; d.setDate(d.getDate() + 1)) if (d.getFullYear() === year) days.add(iso(d));
      }
      abroad = { days: days.size, of: Math.round((parse(today).getTime() - new Date(year, 0, 1).getTime()) / 864e5) + 1, year };
      showAbroad();
      renderPlans();
    }
    const digits = Object.fromEntries(['d', 'h', 'm', 's'].map((u) => [u, view.querySelector<HTMLElement>(`[data-cd="${u}"]`)!]));
    // the countdown: to the next adventure – or (a click) the time since the last one ended; both follow the calendar
    let cdMode: 'to' | 'since' = 'to';
    const lastEv = () => sorted().filter((e) => e.to < iso(new Date())).sort((a, b) => a.to.localeCompare(b.to)).pop();
    /** the moment the last adventure ended: the day after its last day */
    const endOf = (e: Ev) => {
      const d = parse(e.to);
      d.setDate(d.getDate() + 1);
      return d.getTime();
    };
    let shownDay = '';
    function renderCountdown() {
      shownDay = iso(new Date());
      const box = view!.querySelector<HTMLElement>('[data-cal-cd]')!;
      box.classList.toggle('is-since', cdMode === 'since');
      view!.querySelector('[data-cal-cd-title]')!.textContent = cdMode === 'to' ? `⏳ ${W.countdown}` : `⏱ ${W.since}`;
      view!.querySelector('[data-cal-cd-hint]')!.textContent = cdMode === 'to' ? W.hintSince : W.hintTo;
      const e = cdMode === 'to' ? nextEv() : lastEv();
      const to = view!.querySelector<HTMLElement>('[data-cal-cd-to]')!;
      to.replaceChildren();
      if (e) {
        const flag = flagImg(e.country);
        if (flag) to.append(flag);
        to.append(tr(e, 'place') && e.country ? regionNames.of(e.country) ?? tr(e, 'title') : tr(e, 'title'));
        view!.querySelector('[data-cal-cd-date]')!.textContent = [...new Set([tr(e, 'title'), tr(e, 'place')].filter(Boolean))].concat(range(e)).join(' · ');
      } else {
        to.textContent = cdMode === 'to' ? W.noNext : W.noLast;
        view!.querySelector('[data-cal-cd-date]')!.textContent = '';
      }
      view!.querySelector<HTMLElement>('[data-cal-cd-digits]')!.hidden = !e;
      tick();
    }
    const cdToggle = view.querySelector<HTMLElement>('[data-cal-cd-toggle]')!;
    const flipMode = () => {
      cdMode = cdMode === 'to' ? 'since' : 'to';
      renderCountdown();
    };
    cdToggle.addEventListener('click', flipMode);
    cdToggle.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        flipMode();
      }
    });
    function tick() {
      // a new day (or the next adventure has begun): everything moves on by itself
      if (shownDay && shownDay !== iso(new Date())) return renderSides();
      const e = cdMode === 'to' ? nextEv() : lastEv();
      if (!e) return;
      const diff = cdMode === 'to' ? parse(e.from).getTime() - Date.now() : Date.now() - endOf(e);
      if (cdMode === 'to' && diff <= 0) return renderSides();
      let ms = Math.max(0, diff);
      const parts: Record<string, number> = { d: Math.floor(ms / 864e5) };
      ms -= parts.d * 864e5;
      parts.h = Math.floor(ms / 36e5);
      ms -= parts.h * 36e5;
      parts.m = Math.floor(ms / 6e4);
      parts.s = Math.floor((ms - parts.m * 6e4) / 1000);
      for (const [u, el] of Object.entries(digits)) {
        const v = u === 'd' ? String(parts[u]) : String(parts[u]).padStart(2, '0');
        if (el.textContent !== v) {
          el.textContent = v;
          el.classList.remove('is-tick');
          void el.offsetWidth;
          el.classList.add('is-tick');
        }
      }
    }
    window.setInterval(() => {
      if (html.classList.contains('cal-mode')) tick();
    }, 1000);

    // days abroad this year: the number, or (a click) the share of the year's days so far
    let abroad = { days: 0, of: 1, year: new Date().getFullYear() };
    let abroadPct = false;
    const abroadBtn = view.querySelector<HTMLButtonElement>('[data-cal-abroad-toggle]')!;
    function showAbroad() {
      abroadBtn.classList.toggle('is-pct', abroadPct);
      view!.querySelector('[data-cal-abroad]')!.textContent = abroadPct
        ? `${new Intl.NumberFormat(locale, { maximumFractionDigits: 1 }).format((abroad.days / abroad.of) * 100)}%`
        : String(abroad.days);
      view!.querySelector('[data-cal-abroad-label]')!.textContent = `🌍 ${(abroadPct ? W.abroadPct : W.abroad).replace('{year}', String(abroad.year))}`;
    }
    abroadBtn.addEventListener('click', () => {
      abroadPct = !abroadPct;
      showAbroad();
    });

    // planned – join me (a click: the message window); developer mode: add / change / delete
    const planForm = view.querySelector<HTMLFormElement>('[data-cal-plan-form]')!;
    const cp = (n: string) => planForm.querySelector<HTMLInputElement>(`[data-cp="${n}"]`)!;
    let planEditing: Plan | null = null;
    function renderPlans() {
      const ul = view!.querySelector<HTMLElement>('[data-cal-plans]')!;
      ul.replaceChildren(
        ...(data.plans ?? []).map((p, i) => {
          const li = document.createElement('li');
          li.style.setProperty('--i', String(i));
          const strong = document.createElement('strong');
          strong.append(tr(p, 'text'));
          const dev = document.createElement('span');
          dev.className = 'cal-plans__dev';
          const ed = document.createElement('button');
          ed.type = 'button';
          ed.textContent = '✎';
          ed.addEventListener('click', () => openPlan(p));
          const del = document.createElement('button');
          del.type = 'button';
          del.textContent = '🗑';
          del.addEventListener('click', async () => {
            if (!window.confirm(W.confirmPlan.replace('{title}', tr(p, 'text')))) return;
            const before = data.plans;
            data.plans = (data.plans ?? []).filter((x) => x !== p);
            try {
              await save(`🗑 💡 ${tr(p, 'text')}`);
              renderPlans();
            } catch (err) {
              data.plans = before;
              window.alert(err instanceof Error ? err.message : String(err));
            }
          });
          dev.append(ed, del);
          strong.append(dev);
          li.append(strong);
          if (tr(p, 'when')) {
            const s = document.createElement('small');
            s.textContent = `🗓 ${tr(p, 'when')}`;
            li.append(s);
          }
          const join = document.createElement('button');
          join.type = 'button';
          join.className = 'cal-btn cal-plans__join';
          join.textContent = `✋ ${W.join}`;
          join.addEventListener('click', () =>
            window.dispatchEvent(new CustomEvent(PLACE_MESSAGE_EVENT, { detail: { place: tr(p, 'when') ? `${tr(p, 'text')} (${tr(p, 'when')})` : tr(p, 'text'), topic: 'buddy', kind: 'date' } })),
          );
          li.append(join);
          return li;
        }),
      );
    }
    function openPlan(p: Plan | null) {
      planEditing = p;
      cp('text').value = p?.text ?? '';
      cp('when').value = p?.when ?? '';
      cp('text_en').value = p?.text_en ?? '';
      cp('when_en').value = p?.when_en ?? '';
      planForm.hidden = false;
      planForm.scrollIntoView({ block: 'nearest' });
      cp('text').focus();
    }
    view.querySelector('[data-cal-plan-add]')!.addEventListener('click', () => openPlan(null));
    planForm.querySelector('[data-cp-cancel]')!.addEventListener('click', () => (planForm.hidden = true));
    planForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const val = (k: string) => cp(k).value.trim();
      const item: Plan = {
        id: planEditing?.id ?? Math.random().toString(36).slice(2, 8),
        text: val('text'),
        ...(val('text_en') ? { text_en: val('text_en') } : {}),
        ...(val('when') ? { when: val('when') } : {}),
        ...(val('when_en') ? { when_en: val('when_en') } : {}),
      };
      const before = data.plans;
      data.plans = planEditing ? (data.plans ?? []).map((x) => (x.id === item.id ? item : x)) : [item, ...(data.plans ?? [])];
      try {
        await save(`💡 ${item.text}`);
        planForm.hidden = true;
        renderPlans();
      } catch (err) {
        data.plans = before;
        window.alert(err instanceof Error ? err.message : String(err));
      }
    });

    function renderMonth() {
      titleEl.textContent = fmtMonth.format(cursor);
      const head = document.createElement('div');
      head.className = 'cal-week-head';
      head.innerHTML = weekdays.map((w) => `<span>${w}</span>`).join('');
      body.append(head);
      // the weeks shown: from the Monday before the 1st to the Sunday after the last day
      const first = new Date(cursor);
      const start = new Date(first);
      start.setDate(1 - ((first.getDay() + 6) % 7));
      const last = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0);
      const end = new Date(last);
      end.setDate(last.getDate() + (6 - ((last.getDay() + 6) % 7)));
      // each event keeps one row ("lane"), so its bar runs straight across the days
      const evs = sorted().filter((e) => e.to >= iso(start) && e.from <= iso(end));
      const lanes: string[][] = [];
      const laneOf = new Map<string, number>();
      for (const e of evs) {
        let l = lanes.findIndex((lane) => lane.every((id) => {
          const o = evs.find((x) => x.id === id)!;
          return o.to < e.from || o.from > e.to;
        }));
        if (l < 0) l = lanes.push([]) - 1;
        lanes[l].push(e.id);
        laneOf.set(e.id, l);
      }
      let i = 0;
      for (const d = new Date(start); d <= end; ) {
        const week = document.createElement('div');
        week.className = 'cal-week';
        for (let k = 0; k < 7; k++, d.setDate(d.getDate() + 1)) {
          const day = iso(d);
          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'cal-day-cell';
          cell.classList.toggle('is-other', d.getMonth() !== cursor.getMonth());
          cell.classList.toggle('is-today', day === todayIso);
          cell.dataset.day = day;
          cell.setAttribute('aria-label', fmtDay.format(d));
          cell.innerHTML = `<span class="cal-num">${d.getDate()}</span>`;
          for (let l = 0; l < lanes.length; l++) {
            const e = evs.find((x) => laneOf.get(x.id) === l && on(x, day));
            const bar = document.createElement('span');
            bar.className = 'cal-ev';
            if (!e) {
              bar.classList.add('is-gap');
            } else {
              bar.style.setProperty('--c', e.color);
              bar.style.setProperty('--on', onColor(e.color));
              bar.style.setProperty('--i', String(i++));
              const startsHere = e.from === day || k === 0;
              bar.classList.toggle('is-start', e.from === day);
              bar.classList.toggle('is-end', e.to === day);
              bar.textContent = startsHere ? tr(e, 'title') : ' ';
              bar.dataset.ev = e.id;
              const marks = `${e.music?.length ? '♪' : ''}${picsOf(e.id).length ? '📷' : ''}`;
              bar.title = `${tr(e, 'title')}${tr(e, 'place') ? ` · ${tr(e, 'place')}` : ''}${marks ? ` · ${marks}` : ''}`;
              if (startsHere && marks) bar.textContent = `${marks} ${tr(e, 'title')}`;
            }
            cell.append(bar);
          }
          week.append(cell);
        }
        body.append(week);
      }
    }

    function renderYear() {
      titleEl.textContent = String(cursor.getFullYear());
      const wrap = document.createElement('div');
      wrap.className = 'cal-year';
      const evs = sorted();
      for (let m = 0; m < 12; m++) {
        const month = new Date(cursor.getFullYear(), m, 1);
        const box = document.createElement('div');
        box.className = 'cal-mini';
        const h = document.createElement('h3');
        h.textContent = fmtMonthOnly.format(month);
        h.addEventListener('click', () => {
          cursor = month;
          setMode('month');
        });
        const grid = document.createElement('div');
        grid.className = 'cal-mini__grid';
        for (let k = 0; k < (month.getDay() + 6) % 7; k++) grid.append(document.createElement('span'));
        const days = new Date(cursor.getFullYear(), m + 1, 0).getDate();
        for (let n = 1; n <= days; n++) {
          const d = new Date(cursor.getFullYear(), m, n);
          const day = iso(d);
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = String(n);
          b.dataset.day = day;
          b.setAttribute('aria-label', fmtDay.format(d));
          const e = evs.find((x) => on(x, day));
          if (e) {
            b.classList.add('has-ev');
            b.style.setProperty('--c', e.color);
            b.style.setProperty('--on', onColor(e.color));
            b.title = tr(e, 'title');
          }
          b.classList.toggle('is-today', day === todayIso);
          grid.append(b);
        }
        box.append(h, grid);
        wrap.append(box);
      }
      body.append(wrap);
    }

    function setMode(m: 'month' | 'year') {
      mode = m;
      view!.querySelectorAll<HTMLButtonElement>('[data-cal-view]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.calView === m)));
      render(true);
    }
    view.querySelectorAll<HTMLButtonElement>('[data-cal-view]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.calView as 'month' | 'year')));
    view.querySelectorAll<HTMLButtonElement>('[data-cal-step]').forEach((b) =>
      b.addEventListener('click', () => {
        const s = Number(b.dataset.calStep);
        cursor = mode === 'month' ? new Date(cursor.getFullYear(), cursor.getMonth() + s, 1) : new Date(cursor.getFullYear() + s, 0, 1);
        render(true);
      }),
    );
    view.querySelector('[data-cal-today]')!.addEventListener('click', () => {
      cursor = new Date(now.getFullYear(), now.getMonth(), 1);
      render(true);
    });

    // ---- a day ----
    const dayBox = view.querySelector<HTMLElement>('[data-cal-day]')!;
    const dayList = view.querySelector<HTMLElement>('[data-cal-day-list]')!;
    let openDay = '';
    let openTo = '';
    /** a day, or a period (dragged across the days): its events and the message button */
    function showDay(day: string, to = day) {
      openDay = day;
      openTo = to;
      view!.querySelector('[data-cal-day-title]')!.textContent = to === day ? fmtDay.format(parse(day)) : `${fmtShort.format(parse(day))} – ${fmtShort.format(parse(to))}`;
      const evs = sorted().filter((e) => e.from <= to && e.to >= day);
      dayList.replaceChildren(
        ...evs.map((e) => {
          const li = document.createElement('li');
          li.style.setProperty('--c', e.color);
          const strong = document.createElement('strong');
          strong.textContent = tr(e, 'title');
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.textContent = '✎';
          edit.title = W.edit;
          edit.addEventListener('click', () => openForm(e));
          strong.append(edit);
          const dev = document.createElement('span');
          dev.className = 'cal-day__quick';
          for (const [label, kind] of [[`📷 ${W.quickPhoto}`, 'photos'], [`🎵 ${W.quickMusic}`, 'music']] as const) {
            const b = document.createElement('button');
            b.type = 'button';
            b.textContent = label;
            b.addEventListener('click', () => uploadFor(e, kind));
            dev.append(b);
          }
          const when = document.createElement('small');
          when.textContent = [tr(e, 'place') && `📍 ${tr(e, 'place')}`, `${fmtShort.format(parse(e.from))} – ${fmtShort.format(parse(e.to))}`].filter(Boolean).join(' · ');
          li.append(strong, when);
          if (e.tags?.length) li.append(Object.assign(document.createElement('small'), { className: 'cal-day__tags', textContent: showTags(e.tags) }));
          if (e.docs?.length) {
            const docs = document.createElement('span');
            docs.className = 'cal-day__docs';
            for (const d of e.docs) docs.append(Object.assign(document.createElement('a'), { href: (view!.dataset.live ?? '') + d.file, target: '_blank', rel: 'noopener', textContent: `📄 ${d.name}` }));
            li.append(docs);
          }
          li.append(dev);
          if (tr(e, 'note')) {
            const p = document.createElement('span');
            p.textContent = tr(e, 'note');
            li.append(p);
          }
          // photos and music: a button for each (only when there are some); the event's own page always
          const music = (e.music ?? []).map((id) => tracks.find((x) => x.id === id)).filter((x): x is Track => !!x);
          const pics = picsOf(e.id);
          {
            const row = document.createElement('div');
            row.className = 'cal-day__media';
            const openB = Object.assign(document.createElement('button'), { type: 'button', className: 'cal-btn cal-day__open', textContent: `📂 ${W.open}` });
            openB.addEventListener('click', () => openEvent(e.id));
            row.append(openB);
            if (pics.length) {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'cal-btn';
              b.textContent = `📷 ${W.seePhotos} (${pics.length})`;
              b.addEventListener('click', () => openLb(pics, 0));
              row.append(b);
            }
            li.append(row);
            if (music.length) {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'cal-btn';
              b.textContent = `🎵 ${W.hearMusic} (${music.length})`;
              b.setAttribute('aria-expanded', 'false');
              row.append(b);
              b.addEventListener('click', () => {
                const box = li.querySelector<HTMLElement>('.cal-day__music')!;
                box.hidden = !box.hidden;
                b.setAttribute('aria-expanded', String(!box.hidden));
                if (box.hidden) box.querySelectorAll('audio').forEach((a) => a.pause());
                else box.querySelector('audio')?.play().catch(() => {});
              });
            }
          }
          if (music.length) {
            const box = document.createElement('div');
            box.className = 'cal-day__music';
            box.hidden = true;
            // its own playlist on the music page
            const a = document.createElement('a');
            a.className = 'cal-day__pl';
            a.href = `${W.musicPage}?playlist=${encodeURIComponent(e.id)}`;
            a.textContent = `🎧 ${W.playlist} ↗`;
            box.append(a);
            for (const tr of music) {
              const label = document.createElement('span');
              label.textContent = `🎵 ${trackName(tr)}`;
              const audio = document.createElement('audio');
              audio.controls = true;
              audio.preload = 'none';
              audio.src = audioSrc(tr);
              box.append(label, audio);
            }
            li.append(box);
          }
          return li;
        }),
      );
      view!.querySelector<HTMLElement>('[data-cal-day-none]')!.hidden = evs.length > 0;
      dayBox.hidden = false;
    }
    // press on a day and drag to another: a period is selected (a simple click: one day)
    let dragFrom = '';
    let dragTo = '';
    const mark = () => {
      const [a, b] = dragFrom <= dragTo ? [dragFrom, dragTo] : [dragTo, dragFrom];
      body.querySelectorAll<HTMLElement>('[data-day]').forEach((c) => c.classList.toggle('is-picked', !!dragFrom && c.dataset.day! >= a && c.dataset.day! <= b));
    };
    let downEv = '';
    body.addEventListener('pointerdown', (e) => {
      const cell = (e.target as Element).closest<HTMLElement>('[data-day]');
      if (!cell || e.button !== 0) return;
      downEv = (e.target as Element).closest<HTMLElement>('.cal-ev[data-ev]')?.dataset.ev ?? '';
      dragFrom = dragTo = cell.dataset.day!;
      mark();
      body.setPointerCapture(e.pointerId);
    });
    body.addEventListener('pointermove', (e) => {
      if (!dragFrom) return;
      const cell = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLElement>('[data-day]');
      if (cell && cell.dataset.day !== dragTo) {
        dragTo = cell.dataset.day!;
        mark();
      }
    });
    const endDrag = () => {
      if (!dragFrom) return;
      const [a, b] = dragFrom <= dragTo ? [dragFrom, dragTo] : [dragTo, dragFrom];
      dragFrom = '';
      if (a === b && downEv) openEvent(downEv);
      else showDay(a, b);
      window.setTimeout(mark, 0);
    };
    body.addEventListener('pointerup', endDrag);
    body.addEventListener('pointercancel', () => {
      dragFrom = '';
      mark();
    });
    body.addEventListener('keydown', (e) => {
      const cell = (e.target as Element).closest<HTMLElement>('[data-day]');
      if (cell && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        showDay(cell.dataset.day!);
      }
    });
    // closing the day box stops its music
    const stopMusic = () => dayBox.querySelectorAll('audio').forEach((a) => a.pause());
    view.querySelector('[data-cal-day-close]')!.addEventListener('click', () => {
      stopMusic();
      dayBox.hidden = true;
    });
    // a message about that day (the place-message window: "I'd like to do something then")
    view.querySelector('[data-cal-day-msg]')!.addEventListener('click', () => {
      const when = openTo === openDay ? fmtDay.format(parse(openDay)) : `${fmtShort.format(parse(openDay))} – ${fmtShort.format(parse(openTo))}`;
      window.dispatchEvent(new CustomEvent(PLACE_MESSAGE_EVENT, { detail: { place: when, topic: 'buddy', kind: 'date' } }));
    });

    // ---- developer mode: add / change / delete an event ----
    const form = view.querySelector<HTMLFormElement>('[data-cal-form]')!;
    const cf = (n: string) => form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[data-cf="${n}"]`)! as HTMLInputElement;
    const note = form.querySelector<HTMLElement>('[data-cf-note]')!;
    const del = form.querySelector<HTMLButtonElement>('[data-cf-delete]')!;
    let editing: Ev | null = null;
    /** the country list (for the flag), in the page's language, filled the first time */
    function fillCountries() {
      const sel = cf('country') as unknown as HTMLSelectElement;
      if (sel.options.length > 1) return;
      const names = new Intl.DisplayNames([locale], { type: 'region' });
      const nameOf = (c: string) => {
        try {
          return names.of(c) ?? c;
        } catch {
          return c; // not a country code (e.g. GB-ENG): left out below
        }
      };
      flagCodes
        .filter((c) => /^[A-Z]{2}$/.test(c))
        .map((c) => [c, nameOf(c)] as const)
        .filter(([c, n]) => n !== c)
        .sort((a, b) => a[1].localeCompare(b[1], locale))
        .forEach(([c, n]) => sel.add(new Option(n, c)));
    }
    // the music library as ticks; the ticked ones belong to the event
    const musicList = form.querySelector<HTMLElement>('[data-cf-music]')!;
    function renderMusic(chosen: string[]) {
      musicList.replaceChildren();
      if (!tracks.length) {
        const li = document.createElement('li');
        li.innerHTML = '<em></em>';
        li.querySelector('em')!.textContent = W.musicNone;
        musicList.append(li);
      }
      for (const tr of tracks) {
        const li = document.createElement('li');
        const label = document.createElement('label');
        const box = document.createElement('input');
        box.type = 'checkbox';
        box.value = tr.id;
        box.checked = chosen.includes(tr.id);
        label.append(box, trackName(tr));
        li.append(label);
        musicList.append(li);
      }
    }
    const chosenMusic = () => Array.from(musicList.querySelectorAll<HTMLInputElement>('input:checked')).map((b) => b.value);
    // upload new music right here: it is ticked for this event when the upload is done
    // the event's id is chosen when the form opens, so uploads can belong to a new event too
    let draftId = '';
    const formKey = () => editing?.id ?? draftId;
    const picBox = form.querySelector<HTMLElement>('[data-cf-pics]')!;
    function renderFormPics() {
      const pics = picsOf(formKey());
      picBox.replaceChildren();
      if (!pics.length) {
        const em = document.createElement('em');
        em.textContent = W.noPhotos;
        picBox.append(em);
      }
      for (const p of pics) {
        if (p.video) {
          const span = document.createElement('span');
          span.textContent = `🎬 ${p.caption}`;
          picBox.append(span);
          continue;
        }
        const img = document.createElement('img');
        img.src = p.thumb || p.large;
        img.alt = p.caption;
        picBox.append(img);
      }
    }
    form.querySelector('[data-cf-photo-upload]')!.addEventListener('click', () =>
      window.dispatchEvent(new CustomEvent('andras:upload-photos', { detail: { event: formKey(), tags: parseTags(cf('tags').value), date: cf('from').value, ...(cf('place').value.trim() ? { place: cf('place').value.trim() } : {}) } })),
    );
    window.addEventListener('andras:photos-uploaded', (ev) => {
      const d = (ev as CustomEvent<{ for: string; items: Pic[] }>).detail;
      if (!d.for) return;
      photos[d.for] = [...picsOf(d.for), ...d.items];
      renderFormPics();
      if (!evd.hidden && evdId === d.for) openEvent(d.for);
      if (html.classList.contains('cal-mode')) render();
    });
    // the lightbox
    const lb = view.querySelector<HTMLElement>('[data-cal-lb]')!;
    let lbPics: Pic[] = [];
    let lbAt = 0;
    function showLb() {
      const p = lbPics[lbAt];
      const media = lb.querySelector<HTMLElement>('[data-cal-lb-media]')!;
      media.replaceChildren();
      if (p.video) {
        const v = document.createElement('video');
        v.src = p.video;
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        media.append(v);
      } else {
        const img = document.createElement('img');
        img.src = p.large || p.thumb;
        img.alt = p.caption;
        media.append(img);
      }
      lb.querySelector('[data-cal-lb-cap]')!.textContent = `${p.caption}${lbPics.length > 1 ? `  ·  ${lbAt + 1} / ${lbPics.length}` : ''}`;
      lb.querySelectorAll<HTMLElement>('[data-cal-lb-step]').forEach((b) => (b.hidden = lbPics.length < 2));
    }
    function openLb(pics: Pic[], at: number) {
      lbPics = pics;
      lbAt = at;
      showLb();
      lb.hidden = false;
    }
    const closeLb = () => {
      lb.querySelector('video')?.pause();
      lb.hidden = true;
    };
    lb.querySelector('[data-cal-lb-close]')!.addEventListener('click', closeLb);
    lb.addEventListener('click', (e) => {
      if (e.target === lb) closeLb();
    });
    lb.querySelectorAll<HTMLElement>('[data-cal-lb-step]').forEach((b) =>
      b.addEventListener('click', () => {
        lbAt = (lbAt + Number(b.dataset.calLbStep) + lbPics.length) % lbPics.length;
        showLb();
      }),
    );
    window.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        lbAt = (lbAt + (e.key === 'ArrowRight' ? 1 : -1) + lbPics.length) % lbPics.length;
        showLb();
      }
    });
    form.querySelector('[data-cf-upload]')!.addEventListener('click', () =>
      window.dispatchEvent(new CustomEvent('andras:upload-music', { detail: { event: formKey(), tags: parseTags(cf('tags').value), date: cf('from').value, ...(cf('place').value.trim() ? { place: cf('place').value.trim() } : {}) } })),
    );
    /** from the day box (developer mode): photos / music for an event – with its place and hashtags */
    function uploadFor(e: Ev, kind: 'photos' | 'music') {
      window.dispatchEvent(new CustomEvent(`andras:upload-${kind}`, { detail: { event: e.id, tags: e.tags ?? [], date: e.from, ...(e.place ? { place: e.place } : {}) } }));
    }
    window.addEventListener('andras:music-uploaded', async (ev) => {
      const d = (ev as CustomEvent<{ items: Track[]; for?: string }>).detail;
      const keep = chosenMusic();
      tracks = [...tracks.filter((x) => !d.items.some((n) => n.id === x.id)), ...d.items];
      if (!form.hidden && d.for === formKey()) return renderMusic([...keep, ...d.items.map((x) => x.id)]);
      renderMusic(keep);
      // uploaded from the day box: it belongs to that event right away
      const target = data.events.find((x) => x.id === d.for);
      if (!target) return;
      target.music = [...new Set([...(target.music ?? []), ...d.items.map((x) => x.id)])];
      try {
        await save(`🎵 → 📅 ${target.title}`);
        render();
        if (!evd.hidden && evdId === target.id) openEvent(target.id);
        if (!dayBox.hidden) showDay(openDay, openTo);
      } catch (err) {
        window.alert(err instanceof Error ? err.message : String(err));
      }
    });
    // ---- the developer bar ----
    const devbar = view.querySelector<HTMLElement>('[data-cal-devbar]')!;
    const evSel = devbar.querySelector<HTMLSelectElement>('[data-cd-event]')!;
    const devNote = devbar.querySelector<HTMLElement>('[data-cd-note]')!;
    /** the event the bar works on: the one going on now, else the latest that has begun */
    function fillEventSelect() {
      const keep = evSel.value;
      const today = iso(new Date());
      const list = sorted();
      evSel.replaceChildren(...[...list].reverse().map((e) => new Option(`${e.title} (${range(e)})`, e.id)));
      const def = list.filter((e) => e.from <= today).pop() ?? list[0];
      evSel.value = list.some((e) => e.id === keep) ? keep : (def?.id ?? '');
    }
    const chosen = () => data.events.find((e) => e.id === evSel.value);
    devbar.addEventListener('focusin', fillEventSelect);
    devbar.addEventListener('pointerdown', (e) => {
      if (!(e.target as Element).closest('select')) fillEventSelect();
    });
    devbar.addEventListener('click', (ev) => {
      const what = (ev.target as Element).closest<HTMLElement>('[data-cd-do]')?.dataset.cdDo;
      if (!what) return;
      devNote.textContent = '';
      const e = chosen();
      if (what === 'new') return openForm(null, todayIso);
      if (what === 'last') {
        const last = sorted().filter((x) => x.from <= todayIso).pop();
        return last && openForm(last);
      }
      if (what === 'plan') return openPlan(null);
      if (what === 'where') {
        // the pill's editor is on the home page
        if (document.querySelector('[data-where]')) {
          html.classList.remove('cal-mode');
          window.setTimeout(() => document.querySelector<HTMLElement>('[data-where]')?.click(), 350);
        } else location.href = `${W.home}?where=edit`;
        return;
      }
      if (!e) return;
      if (what === 'edit') return openForm(e);
      if (what === 'photos' || what === 'music') return uploadFor(e, what);
      if (what === 'playlist') location.href = `${W.musicPage}?playlist=${encodeURIComponent(e.id)}`;
    });
    // documents (tickets, programmes, PDFs…) for the chosen event: public/docs, listed in its day box
    const toBase64 = (file: File) =>
      new Promise<string>((resolve, reject) => {
        const r = new FileReader();
        r.onload = () => resolve(String(r.result).replace(/^data:[^,]*,/, ''));
        r.onerror = () => reject(r.error);
        r.readAsDataURL(file);
      });
    const docsIn = devbar.querySelector<HTMLInputElement>('[data-cd-docs]')!;
    docsIn.addEventListener('change', async () => {
      const e = chosen();
      const files = Array.from(docsIn.files ?? []);
      docsIn.value = '';
      if (e) await uploadDocs(e, files, devNote);
    });
    async function uploadDocs(e: Ev, files: File[], devNote: HTMLElement) {
      if (!files.length) return;
      if (files.some((f) => f.size > 20 * 1024 * 1024)) return void (devNote.textContent = W.docsBig);
      let key = getToken();
      if (!key) key = (window.prompt(W.key) ?? '').trim();
      if (!key) return;
      devNote.textContent = '…';
      try {
        const added = files.map((f) => {
          const ext = (f.name.match(/\.([a-z0-9]{1,5})$/i)?.[1] ?? 'bin').toLowerCase();
          const base = f.name.replace(/\.[^.]+$/, '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase() || 'doc';
          return { f, name: f.name.replace(/\.[^.]+$/, ''), file: `/docs/${e.id}-${base}.${ext}` };
        });
        e.docs = [...(e.docs ?? []), ...added.map((x) => ({ name: x.name, file: x.file }))];
        const parts = await Promise.all(added.map(async (x) => ({ path: `public${x.file}`, base64: await toBase64(x.f) })));
        await commitFiles(key, [...parts, { path: 'src/data/calendar.json', text: `${JSON.stringify(data, null, 2)}\n` }], `Calendar: documents for ${e.title}`, added.map((x) => `📄 ${x.name} → 📅 ${e.title}`));
        devNote.textContent = W.docsSaved;
        if (!dayBox.hidden) showDay(openDay, openTo);
        if (!evd.hidden && evdId === e.id) openEvent(e.id);
      } catch (err) {
        devNote.textContent = err instanceof Error ? err.message : String(err);
      }
    }

    // ---- an event's page: description, photos / videos, music, documents ----
    const evd = view.querySelector<HTMLElement>('[data-cal-evd]')!;
    let evdId = '';
    const evdQ = <T extends Element = HTMLElement>(s: string) => evd.querySelector<T>(s)!;
    const evdNote = evdQ('[data-evd-note]');
    function openEvent(id: string) {
      const e = data.events.find((x) => x.id === id);
      if (!e) return;
      evdId = id;
      const dev = html.classList.contains('dev-mode') && !html.classList.contains('dev-preview');
      evdQ('[data-evd-when]').textContent = [tr(e, 'place') && `📍 ${tr(e, 'place')}`, range(e)].filter(Boolean).join(' · ');
      const title = evdQ('[data-evd-title]');
      title.replaceChildren();
      const flag = flagImg(e.country);
      if (flag) title.append(flag);
      title.append(tr(e, 'title'));
      evdQ('[data-evd-tags]').textContent = showTags(e.tags);
      // description (and its editor in developer mode)
      evdQ('[data-evd-desc]').textContent = tr(e, 'note');
      evdQ<HTMLTextAreaElement>('[data-evd-hu]').value = e.note ?? '';
      evdQ<HTMLTextAreaElement>('[data-evd-en]').value = e.note_en ?? '';
      evdNote.textContent = '';
      // photos and videos: a click opens them large
      const pics = picsOf(e.id);
      evdQ('[data-evd-pics]').replaceChildren(
        ...pics.map((p, i) => {
          const b = Object.assign(document.createElement('button'), { type: 'button', title: p.caption });
          if (p.video) b.textContent = '▶';
          else b.append(Object.assign(document.createElement('img'), { src: p.thumb || p.large, alt: p.caption, loading: 'lazy' }));
          b.addEventListener('click', () => openLb(pics, i));
          return b;
        }),
      );
      const music = (e.music ?? []).map((m) => tracks.find((x) => x.id === m)).filter((x): x is Track => !!x);
      evdQ('[data-evd-music]').replaceChildren(
        ...music.flatMap((tr2) => [
          Object.assign(document.createElement('span'), { textContent: `🎵 ${trackName(tr2)}` }),
          Object.assign(document.createElement('audio'), { controls: true, preload: 'none', src: audioSrc(tr2) }),
        ]),
      );
      const docs = e.docs ?? [];
      evdQ('[data-evd-docs]').replaceChildren(...docs.map((d) => Object.assign(document.createElement('a'), { href: (view!.dataset.live ?? '') + d.file, target: '_blank', rel: 'noopener', textContent: `📄 ${d.name}` })));
      const counts: Record<string, number> = { desc: tr(e, 'note') ? 1 : 0, pics: pics.length, music: music.length, docs: docs.length };
      evd.querySelectorAll<HTMLElement>('[data-evd-sec]').forEach((s) => (s.hidden = !dev && !counts[s.dataset.evdSec!]));
      evd.querySelectorAll<HTMLElement>('[data-evd-n]').forEach((n) => (n.textContent = counts[n.dataset.evdN!] ? `(${counts[n.dataset.evdN!]})` : ''));
      evdQ('[data-evd-empty]').hidden = dev || Object.values(counts).some(Boolean);
      stopMusic();
      dayBox.hidden = true;
      form.hidden = true;
      evd.hidden = false;
    }
    const closeEvd = () => {
      evd.querySelectorAll('audio').forEach((a) => a.pause());
      evd.hidden = true;
    };
    evdQ('[data-cal-evd-close]').addEventListener('click', closeEvd);
    evdQ<HTMLFormElement>('[data-evd-desc-form]').addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const e = data.events.find((x) => x.id === evdId);
      if (!e) return;
      const hu = evdQ<HTMLTextAreaElement>('[data-evd-hu]').value.trim();
      const en = evdQ<HTMLTextAreaElement>('[data-evd-en]').value.trim();
      const before = { note: e.note, note_en: e.note_en };
      if (hu) e.note = hu;
      else delete e.note;
      if (en) e.note_en = en;
      else delete e.note_en;
      evdNote.textContent = '…';
      try {
        await save(`📝 ${e.title}`);
        evdNote.textContent = W.saved;
        evdQ('[data-evd-desc]').textContent = tr(e, 'note');
      } catch (err) {
        Object.assign(e, before);
        evdNote.textContent = err instanceof Error ? err.message : String(err);
      }
    });
    evd.querySelector('.cal-evd__dev')!.addEventListener('click', (ev) => {
      const what = (ev.target as Element).closest<HTMLElement>('[data-evd-do]')?.dataset.evdDo;
      const e = data.events.find((x) => x.id === evdId);
      if (!what || !e) return;
      if (what === 'edit') {
        closeEvd();
        openForm(e);
      } else uploadFor(e, what as 'photos' | 'music');
    });
    evdQ<HTMLInputElement>('[data-evd-docs-in]').addEventListener('change', async (ev) => {
      const input = ev.target as HTMLInputElement;
      const files = Array.from(input.files ?? []);
      input.value = '';
      const e = data.events.find((x) => x.id === evdId);
      if (e) await uploadDocs(e, files, evdNote);
    });
    evdQ('[data-evd-msg]').addEventListener('click', () => {
      const e = data.events.find((x) => x.id === evdId);
      if (e) window.dispatchEvent(new CustomEvent(PLACE_MESSAGE_EVENT, { detail: { place: `${tr(e, 'title')} (${range(e)})`, topic: 'buddy', kind: 'date' } }));
    });

    // the place → its country (the flag), found by itself; changed by hand, it stays
    let countryByHand = false;
    const found = form.querySelector<HTMLElement>('[data-cf-found]')!;
    cf('country').addEventListener('change', () => (countryByHand = true));
    cf('place').addEventListener('change', async () => {
      const q = cf('place').value.trim();
      found.textContent = '';
      if (!q) return;
      const hit = (await geocode(q, 'hu').catch(() => []))[0];
      const cc = hit?.country_code?.toUpperCase();
      if (!cc) return;
      found.textContent = `📍 ${W.foundCountry.replace('{country}', regionNames.of(cc) ?? cc)}`;
      if (!countryByHand || !cf('country').value) {
        fillCountries();
        cf('country').value = cc;
      }
    });
    function openForm(e: Ev | null, day = openDay || todayIso) {
      editing = e;
      form.querySelector('[data-cal-form-title]')!.textContent = e ? `✎ ${W.edit}` : `＋ ${W.add}`;
      cf('title').value = e?.title ?? '';
      cf('title_en').value = e?.title_en ?? '';
      cf('place_en').value = e?.place_en ?? '';
      cf('note_en').value = e?.note_en ?? '';
      cf('place').value = e?.place ?? '';
      fillCountries();
      cf('country').value = e?.country ?? '';
      countryByHand = !!e?.country;
      found.textContent = '';
      cf('tags').value = showTags(e?.tags);
      cf('from').value = e?.from ?? day;
      cf('to').value = e?.to ?? (day === openDay && openTo ? openTo : day);
      cf('note').value = e?.note ?? '';
      renderMusic(e?.music ?? []);
      draftId = e?.id ?? `${day}-${Math.random().toString(36).slice(2, 6)}`;
      renderFormPics();
      const color = e?.color ?? '#7B2FF7';
      form.querySelectorAll<HTMLInputElement>('input[name="cal-color"]').forEach((r) => (r.checked = r.value.toLowerCase() === color.toLowerCase()));
      del.hidden = !e;
      note.textContent = '';
      stopMusic();
      dayBox.hidden = true;
      form.hidden = false;
      cf('title').focus();
    }
    view.querySelector('[data-cal-add]')!.addEventListener('click', () => openForm(null, todayIso));
    view.querySelector('[data-cal-day-add]')!.addEventListener('click', () => openForm(null));
    form.querySelector('[data-cf-cancel]')!.addEventListener('click', () => (form.hidden = true));
    const save = async (line: string) => {
      let key = getToken();
      if (!key) key = (window.prompt(W.key) ?? '').trim();
      if (!key) throw new Error('—');
      await commitFiles(key, [{ path: 'src/data/calendar.json', text: `${JSON.stringify(data, null, 2)}\n` }], 'Calendar: changed on the site', [line]);
    };
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const from = cf('from').value;
      const to = cf('to').value < from ? from : cf('to').value;
      const item: Ev = {
        id: formKey(),
        title: cf('title').value.trim(),
        ...(cf('title_en').value.trim() ? { title_en: cf('title_en').value.trim() } : {}),
        ...(cf('place').value.trim() ? { place: cf('place').value.trim() } : {}),
        ...(cf('place_en').value.trim() ? { place_en: cf('place_en').value.trim() } : {}),
        ...(cf('country').value ? { country: cf('country').value } : {}),
        from,
        to,
        color: form.querySelector<HTMLInputElement>('input[name="cal-color"]:checked')?.value ?? '#7B2FF7',
        ...(cf('note').value.trim() ? { note: cf('note').value.trim() } : {}),
        ...(cf('note_en').value.trim() ? { note_en: cf('note_en').value.trim() } : {}),
        ...(chosenMusic().length ? { music: chosenMusic() } : {}),
        ...(parseTags(cf('tags').value).length ? { tags: parseTags(cf('tags').value) } : {}),
      };
      const before = data.events;
      data.events = [...data.events.filter((x) => x.id !== item.id), item];
      try {
        await save(`📅 ${item.title} (${item.from} – ${item.to})`);
        note.textContent = W.saved;
        cursor = new Date(parse(from).getFullYear(), parse(from).getMonth(), 1);
        render(true);
        window.setTimeout(() => (form.hidden = true), 900);
      } catch (err) {
        data.events = before;
        note.textContent = err instanceof Error ? err.message : String(err);
      }
    });
    del.addEventListener('click', async () => {
      if (!editing || !window.confirm(W.confirmDelete.replace('{title}', editing.title))) return;
      const before = data.events;
      data.events = data.events.filter((x) => x.id !== editing!.id);
      try {
        await save(`🗑 📅 ${editing.title}`);
        form.hidden = true;
        render();
      } catch (err) {
        data.events = before;
        note.textContent = err instanceof Error ? err.message : String(err);
      }
    });

    // ?event=<id> (e.g. from the search): that event's page
    const askedEvent = new URLSearchParams(location.search).get('event');
    if (askedEvent && view.classList.contains('is-page')) {
      const e0 = data.events.find((x) => x.id === askedEvent);
      if (e0) {
        cursor = new Date(parse(e0.from).getFullYear(), parse(e0.from).getMonth(), 1);
        window.setTimeout(() => openEvent(askedEvent), 700);
      }
    }

    // ---- open / close (the header button toggles html.cal-mode) ----
    let wasOn = html.classList.contains('cal-mode');
    if (wasOn) render(true);
    new MutationObserver(() => {
      const isOn = html.classList.contains('cal-mode');
      if (isOn === wasOn) return;
      wasOn = isOn;
      if (isOn) {
        view.classList.remove('is-closing');
        render(true);
      } else {
        stopMusic();
        closeEvd();
        dayBox.hidden = true;
        form.hidden = true;
        view.classList.add('is-closing');
        window.setTimeout(() => view.classList.remove('is-closing'), 400);
      }
    }).observe(html, { attributes: true, attributeFilter: ['class'] });
    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !html.classList.contains('cal-mode')) return;
      if (!lb.hidden) closeLb();
      else if (!evd.hidden) closeEvd();
      else if (!form.hidden) form.hidden = true;
      else if (!dayBox.hidden) {
        stopMusic();
        dayBox.hidden = true;
      }
    });

    // a copy on another host: the main site's calendar
    if (view.dataset.live) {
      fetch(`${view.dataset.live}/calendar.json`, { cache: 'no-cache' })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((d: { events: Ev[]; plans?: Plan[] }) => {
          data.events = d.events;
          data.plans = d.plans ?? [];
          renderSides();
          if (html.classList.contains('cal-mode')) render();
        })
        .catch((err) => console.warn('[calendar] the main site could not be reached', err));
      fetch(`${view.dataset.live}/gallery.json`, { cache: 'no-cache' })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((d: { items: { event?: string; large: string; thumb: string; caption: string; video?: string }[] }) => {
          const abs = (u: string) => (u && u.startsWith('/') ? view.dataset.live + u : u);
          const next: Record<string, Pic[]> = {};
          for (const x of d.items.filter((i) => i.event)) (next[x.event!] ??= []).push({ large: abs(x.large), thumb: abs(x.thumb), caption: x.caption, ...(x.video ? { video: abs(x.video) } : {}) });
          photos = next;
          if (html.classList.contains('cal-mode')) render();
        })
        .catch(() => {});
      fetch(`${view.dataset.live}/music.json`, { cache: 'no-cache' })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((d: { items: Track[] }) => {
          tracks = d.items.map((x) => ({ id: x.id, file: x.file, title: x.title, ...(x.artist ? { artist: x.artist } : {}) })).sort((a, b) => a.title.localeCompare(b.title));
        })
        .catch(() => {});
    }
  }
</script>
