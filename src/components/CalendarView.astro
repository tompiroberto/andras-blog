---
/**
 * The calendar (header button, html.cal-mode): where András is going and when. It opens like a wall
 * calendar flipping down under the header (the header stays), in the theme's colours. Month or year view;
 * events are coloured bars. A click on a day shows its events and a "message me about this day" button
 * (the place-message window). In developer mode events are added / changed / deleted here (dates,
 * place, colour) and saved to src/data/calendar.json (GitHub; 🚀 Publish puts them online).
 * A copy of the site on another host reads the main site's /calendar.json, so it stays up to date.
 */
import Icon from './Icon.astro';
import calendar from '../data/calendar.json';
import { getCollection } from 'astro:content';
import { countries as FLAG_CODES } from 'country-flag-icons';
import { getImage } from 'astro:assets';
import { getPhotos } from '../lib/photos';
import { HTML_LANG, localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** the calendar page: a page of its own, not laid over another one */
  page?: boolean;
}

const { lang, page = false } = Astro.props;
const live = import.meta.env.PUBLIC_STATIC_EXPORT === '1' ? import.meta.env.PUBLIC_MAIN_SITE || 'https://lambent-platypus-c39161.netlify.app' : '';
const words = {
  month: t(lang, 'cal.month'),
  year: t(lang, 'cal.year'),
  today: t(lang, 'cal.today'),
  add: t(lang, 'cal.add'),
  none: t(lang, 'cal.none'),
  message: t(lang, 'cal.message'),
  title: t(lang, 'cal.eventTitle'),
  place: t(lang, 'cal.place'),
  from: t(lang, 'cal.from'),
  to: t(lang, 'cal.to'),
  note: t(lang, 'cal.note'),
  color: t(lang, 'cal.color'),
  save: t(lang, 'gal.save'),
  delete: t(lang, 'cal.delete'),
  confirmDelete: t(lang, 'cal.confirmDelete'),
  saved: t(lang, 'gal.saved'),
  key: t(lang, 'dev.msgKey'),
  edit: t(lang, 'cal.edit'),
  musicNone: t(lang, 'cal.musicNone'),
  seePhotos: t(lang, 'cal.seePhotos'),
  hearMusic: t(lang, 'cal.hearMusic'),
  noPhotos: t(lang, 'cal.noPhotos'),
  now: t(lang, 'cal.now'),
  untilEnd: t(lang, 'cal.untilEnd'),
  noNext: t(lang, 'cal.noNext'),
  join: t(lang, 'cal.join'),
  planText: t(lang, 'cal.planText'),
  planWhen: t(lang, 'cal.planWhen'),
  planAdd: t(lang, 'cal.planAdd'),
  confirmPlan: t(lang, 'cal.confirmPlan'),
  abroad: t(lang, 'cal.abroad'),
  open: t(lang, 'cal.evdOpen'),
  docs: t(lang, 'cal.docs'),
  docsSaved: t(lang, 'cal.docsSaved'),
  docsBig: t(lang, 'cal.docsBig'),
  home: localePath(lang),
  quickPhoto: t(lang, 'cal.quickPhoto'),
  quickMusic: t(lang, 'cal.quickMusic'),
  foundCountry: t(lang, 'cal.foundCountry'),
  abroadPct: t(lang, 'cal.abroadPct'),
  since: t(lang, 'cal.since'),
  countdown: t(lang, 'cal.countdown'),
  noLast: t(lang, 'cal.noLast'),
  hintSince: t(lang, 'cal.hintSince'),
  hintTo: t(lang, 'cal.hintTo'),
  tlAdd: t(lang, 'cal.tlAdd'),
  tlSchema: t(lang, 'cal.tlSchema'),
  playlist: t(lang, 'cal.playlist'),
  musicPage: localePath(lang, 'music'),
  d: t(lang, 'cal.cd.d'),
  h: t(lang, 'cal.cd.h'),
  m: t(lang, 'cal.cd.m'),
  s: t(lang, 'cal.cd.s'),
};
// the music library: tracks can be linked to an event (its "music" list of track ids)
const tracks = (await getCollection('music'))
  .map((e) => ({ id: e.id, file: e.data.file, title: e.data.title, ...(e.data.artist ? { artist: e.data.artist } : {}) }))
  .sort((a, b) => a.title.localeCompare(b.title));
// the photos / videos uploaded to an event (their yml says event: <id>)
type Pic = { large: string; thumb: string; caption: string; video?: string };
const eventPhotos: Record<string, Pic[]> = {};
for (const p of (await getPhotos(lang)).filter((x) => x.event)) {
  const pic: Pic = p.image
    ? { large: (await getImage({ src: p.image, width: Math.min(1800, p.image.width) })).src, thumb: (await getImage({ src: p.image, width: 360 })).src, caption: p.caption }
    : { large: '', thumb: '', caption: p.caption, video: p.video };
  (eventPhotos[p.event!] ??= []).push(pic);
}
---

{page && <script is:inline>document.documentElement.classList.add('cal-mode', 'cal-page');</script>}
<section class:list={['cal-view', { 'is-page': page }]} data-cal data-lang={HTML_LANG[lang]} data-live={live || undefined} aria-label={t(lang, 'cal.toggle')}>
  <div class="cal-layout">
  <!-- left: the last adventures and the next one (faded), on a vertical timeline -->
  <aside class="cal-side cal-side--left cal-tl" aria-label={t(lang, 'cal.timeline')}>
    <h3 class="cal-side__title">🧭 {t(lang, 'cal.timeline')}</h3>
    <ol class="cal-tl__list" data-cal-tl></ol>
  </aside>
  <div class="cal-main">
  <div class="cal-sheet" data-cal-sheet>
    <span class="cal-rings" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
    <header class="cal-bar">
      <div class="cal-nav">
        <button type="button" class="cal-btn cal-btn--icon" data-cal-step="-1" aria-label="‹"><Icon name="chevron-left" size={20} /></button>
        <h2 class="cal-title" data-cal-title></h2>
        <button type="button" class="cal-btn cal-btn--icon" data-cal-step="1" aria-label="›"><Icon name="chevron-right" size={20} /></button>
        <button type="button" class="cal-btn cal-btn--add" data-cal-add>＋ {words.add}</button>
      </div>
      <div class="cal-tools">
        <button type="button" class="cal-btn" data-cal-today>{words.today}</button>
        <div class="cal-switch" role="radiogroup">
          <button type="button" role="radio" aria-checked="true" data-cal-view="month">{words.month}</button>
          <button type="button" role="radio" aria-checked="false" data-cal-view="year">{words.year}</button>
        </div>
      </div>
    </header>
    <!-- developer mode: everything the calendar needs, one click each -->
    <div class="cal-devbar" data-dev-ui data-cal-devbar>
      <button type="button" data-cd-do="new">＋ {t(lang, 'cal.devNew')}</button>
      <button type="button" data-cd-do="last">✎ {t(lang, 'cal.devLast')}</button>
      <span class="cal-devbar__sep"></span>
      <label class="cal-devbar__for">{t(lang, 'cal.devFor')}<select data-cd-event></select></label>
      <button type="button" data-cd-do="edit">✎</button>
      <button type="button" data-cd-do="photos">📷🎬 {t(lang, 'cal.quickPhoto')}</button>
      <button type="button" data-cd-do="music">🎵 {t(lang, 'cal.quickMusic')}</button>
      <label class="cal-devbar__file">📄 {t(lang, 'cal.devDocs')}<input type="file" multiple data-cd-docs /></label>
      <button type="button" data-cd-do="playlist">🎧</button>
      <span class="cal-devbar__sep"></span>
      <button type="button" data-cd-do="plan">💡 {t(lang, 'cal.planAdd')}</button>
      <button type="button" data-cd-do="where">📍 {t(lang, 'cal.devWhere')}</button>
      <small data-cd-note></small>
    </div>
    <p class="cal-hint">{t(lang, 'cal.hint')}</p>
    <div class="cal-body" data-cal-body></div>
  </div>
  </div>
  <!-- right: the countdown to the next adventure; below: planned – join me -->
  <aside class="cal-side cal-side--right">
    <div class="cal-cd" data-cal-cd>
      <!-- a click: the time since the last adventure (and back) -->
      <div class="cal-cd__top" role="button" tabindex="0" data-cal-cd-toggle>
        <p class="cal-side__title" data-cal-cd-title>⏳ {t(lang, 'cal.countdown')}</p>
        <p class="cal-cd__to" data-cal-cd-to></p>
        <div class="cal-cd__digits" data-cal-cd-digits>
          {['d', 'h', 'm', 's'].map((u) => (
            <span class="cal-cd__unit"><b data-cd={u}>0</b><small>{words[u as 'd']}</small></span>
          ))}
        </div>
        <p class="cal-cd__date" data-cal-cd-date></p>
        <small class="cal-cd__hint" data-cal-cd-hint></small>
      </div>
      <p class="cal-cd__now" hidden data-cal-cd-now></p>
      <!-- days spent abroad this year (so far) -->
      <button type="button" class="cal-cd__abroad" data-cal-abroad-toggle><b data-cal-abroad>0</b><span data-cal-abroad-label></span></button>
    </div>
    <div class="cal-plans">
      <p class="cal-side__title">💡 {t(lang, 'cal.plans')}</p>
      <button type="button" class="cal-btn cal-btn--add cal-plans__add" data-cal-plan-add>＋ {words.planAdd}</button>
      <!-- developer mode: a new plan is written straight into a card that looks like the others -->
      <form class="cal-plans__form" hidden data-cal-plan-form>
        <input class="cal-plans__in-text" type="text" maxlength="120" required data-cp="text" placeholder={`🇭🇺 ${words.planText}`} />
        <input class="cal-plans__in-small" type="text" maxlength="120" data-cp="text_en" placeholder="🇬🇧 English" />
        <span class="cal-plans__when">🗓 <input class="cal-plans__in-small" type="text" maxlength="40" data-cp="when" placeholder={`🇭🇺 ${words.planWhen}`} /></span>
        <span class="cal-plans__when">🗓 <input class="cal-plans__in-small" type="text" maxlength="40" data-cp="when_en" placeholder="🇬🇧 When? (e.g. around spring)" /></span>
        <span class="cal-btn cal-plans__join cal-plans__preview" aria-hidden="true">✋ {words.join}</span>
        <div class="cal-form__actions">
          <button type="button" class="cal-btn" data-cp-cancel>✕</button>
          <button type="submit" class="cal-btn cal-btn--add">{words.save}</button>
        </div>
      </form>
      <ul class="cal-plans__list" data-cal-plans></ul>
    </div>
  </aside>
  </div>

  <!-- a day: its events, a message about it; in developer mode: add / change events -->
  <aside class="cal-day" hidden data-cal-day>
    <button type="button" class="cal-day__x" aria-label="✕" data-cal-day-close>✕</button>
    <h3 data-cal-day-title></h3>
    <ul class="cal-day__list" data-cal-day-list></ul>
    <p class="cal-day__none" data-cal-day-none>{words.none}</p>
    <button type="button" class="btn btn--primary cal-day__msg" data-cal-day-msg><Icon name="message-circle" size={18} />{words.message}</button>
    <button type="button" class="cal-btn cal-btn--add cal-day__add" data-cal-day-add>＋ {words.add}</button>
  </aside>

  <!-- an event: its description and everything that belongs to it (photos, videos, music, documents) -->
  <aside class="cal-day cal-evd" hidden data-cal-evd>
    <button type="button" class="cal-day__x" aria-label="✕" data-cal-evd-close>✕</button>
    <p class="cal-evd__when" data-evd-when></p>
    <h3 class="cal-evd__title" data-evd-title></h3>
    <p class="cal-evd__tags" data-evd-tags></p>
    <section class="cal-evd__sec" data-evd-sec="desc">
      <h4>📝 {t(lang, 'cal.evdDesc')}</h4>
      <p class="cal-evd__desc" data-evd-desc></p>
      <form class="cal-evd__desc-ed" data-dev-ui data-evd-desc-form>
        <textarea rows="3" maxlength="2000" data-evd-hu placeholder={`🇭🇺 ${t(lang, 'cal.evdDescPh')}`}></textarea>
        <textarea rows="2" maxlength="2000" data-evd-en placeholder="🇬🇧 English"></textarea>
        <div class="cal-evd__row"><small data-evd-note></small><button type="submit">✓ {t(lang, 'gal.save')}</button></div>
      </form>
    </section>
    <section class="cal-evd__sec" data-evd-sec="pics">
      <h4>📷 {t(lang, 'cal.evdPics')} <small data-evd-n="pics"></small></h4>
      <div class="cal-evd__pics" data-evd-pics></div>
    </section>
    <section class="cal-evd__sec" data-evd-sec="music">
      <h4>🎵 {t(lang, 'cal.evdMusic')} <small data-evd-n="music"></small></h4>
      <div class="cal-evd__music" data-evd-music></div>
    </section>
    <section class="cal-evd__sec" data-evd-sec="docs">
      <h4>📄 {t(lang, 'cal.docs')} <small data-evd-n="docs"></small></h4>
      <div class="cal-evd__docs" data-evd-docs></div>
    </section>
    <p class="cal-evd__empty" data-evd-empty>{t(lang, 'cal.evdEmpty')}</p>
    <div class="cal-evd__dev" data-dev-ui>
      <button type="button" data-evd-do="photos">📷🎬 {t(lang, 'cal.quickPhoto')}</button>
      <button type="button" data-evd-do="music">🎵 {t(lang, 'cal.quickMusic')}</button>
      <label>📄 {t(lang, 'cal.devDocs')}<input type="file" multiple data-evd-docs-in /></label>
      <button type="button" data-evd-do="edit">✎ {t(lang, 'cal.edit')}</button>
    </div>
    <button type="button" class="btn btn--primary cal-day__msg" data-evd-msg><Icon name="message-circle" size={18} />{words.message}</button>
  </aside>

  <form class="cal-form" hidden data-cal-form>
    <strong data-cal-form-title>＋ {words.add}</strong>
    <div class="cal-form__row">
      <label>{words.title} 🇭🇺<input type="text" maxlength="80" required data-cf="title" placeholder={t(lang, 'cal.phTitle')} /></label>
      <label>English 🇬🇧<input type="text" maxlength="80" data-cf="title_en" placeholder="e.g. Greece – Erasmus+" /></label>
    </div>
    <div class="cal-form__row">
      <label>{words.place} 🇭🇺<input type="text" maxlength="80" data-cf="place" placeholder={t(lang, 'cal.phPlace')} /></label>
      <label>English 🇬🇧<input type="text" maxlength="80" data-cf="place_en" placeholder="e.g. Elafonisos" /></label>
    </div>
    <label>{t(lang, 'cal.country')}<select data-cf="country"><option value="">—</option></select></label>
    <small class="cal-form__found" data-cf-found></small>
    <label>#️⃣ {t(lang, 'cal.tags')}<input type="text" maxlength="200" data-cf="tags" placeholder={t(lang, 'cal.tagsPh')} /></label>
    <div class="cal-form__row">
      <label>{words.from}<input type="date" required data-cf="from" /></label>
      <label>{words.to}<input type="date" required data-cf="to" /></label>
    </div>
    <label>{words.note} 🇭🇺<textarea rows="2" maxlength="300" data-cf="note"></textarea></label>
    <label>English 🇬🇧<textarea rows="2" maxlength="300" data-cf="note_en"></textarea></label>
    <fieldset class="cal-form__music">
      <legend>🎵 {t(lang, 'cal.music')}</legend>
      <ul data-cf-music></ul>
      <button type="button" class="cal-btn" data-cf-upload>⬆ {t(lang, 'cal.musicUpload')}</button>
    </fieldset>
    <fieldset class="cal-form__music">
      <legend>📷 {t(lang, 'cal.photos')}</legend>
      <div class="cal-form__pics" data-cf-pics></div>
      <button type="button" class="cal-btn" data-cf-photo-upload>⬆ {t(lang, 'cal.photosUpload')}</button>
    </fieldset>
    <fieldset class="cal-form__colors">
      <legend>{words.color}</legend>
      {['#7B2FF7', '#FFD60A', '#E63946', '#FF5FA2', '#FF8C1A', '#2DBE6C', '#2F86D6', '#1B1B24'].map((c, i) => (
        <label class="cal-swatch" style={`--c:${c}`}>
          <input type="radio" name="cal-color" value={c} checked={i === 0} />
          <span></span>
        </label>
      ))}
    </fieldset>
    <small data-cf-note></small>
    <div class="cal-form__actions">
      <button type="button" class="cal-btn cal-form__del" hidden data-cf-delete>🗑 {words.delete}</button>
      <button type="button" class="cal-btn" data-cf-cancel>✕</button>
      <button type="submit" class="cal-btn cal-btn--add">{words.save}</button>
    </div>
  </form>
  <script type="application/json" data-cal-data set:html={JSON.stringify(calendar)} />
  <script type="application/json" data-cal-words set:html={JSON.stringify(words)} />
  <script type="application/json" data-cal-tracks set:html={JSON.stringify(tracks)} />
  <script type="application/json" data-cal-flags set:html={JSON.stringify(FLAG_CODES)} />
  <script type="application/json" data-cal-photos set:html={JSON.stringify(eventPhotos)} />
  <!-- an event's photos, one by one -->
  <div class="cal-lb" hidden data-cal-lb>
    <button type="button" class="cal-lb__x" aria-label="✕" data-cal-lb-close>✕</button>
    <button type="button" class="cal-lb__nav cal-lb__nav--prev" aria-label="‹" data-cal-lb-step="-1">‹</button>
    <figure>
      <div class="cal-lb__media" data-cal-lb-media></div>
      <figcaption data-cal-lb-cap></figcaption>
    </figure>
    <button type="button" class="cal-lb__nav cal-lb__nav--next" aria-label="›" data-cal-lb-step="1">›</button>
  </div>
</section>

<style is:global>
  .cal-view {
    position: fixed;
    left: 0;
    right: 0;
    top: calc(var(--header-h) * var(--tz, 1));
    bottom: 0;
    z-index: calc(var(--z-header) - 1);
    display: none;
    padding: clamp(10px, 2.4vw, 28px);
    overflow: auto;
    container-type: size;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(6px);
    perspective: 1600px;
  }
  :root.cal-mode .cal-view {
    display: block;
  }
  :root.cal-mode:not(.cal-page) {
    overflow: hidden;
  }
  /* the calendar page: below the header, as high as the window; it opens with a reveal from the corner */
  .cal-view.is-page {
    position: relative;
    inset: auto;
    z-index: calc(var(--z-header) - 1);
    display: block;
    height: calc(100dvh - var(--header-h) * var(--tz, 1));
    min-height: 600px;
    animation: cal-page-in 800ms cubic-bezier(0.25, 0.8, 0.25, 1) both;
  }
  @keyframes cal-page-in {
    from {
      clip-path: circle(0 at var(--cal-x, 88%) 0);
    }
    to {
      clip-path: circle(150% at var(--cal-x, 88%) 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cal-view.is-page {
      animation: none;
    }
  }
  /* the scrollbar ribbon (and its switches) step aside while the calendar is open */
  :root.cal-mode .chile,
  :root.cal-mode [data-chile-ribbon],
  :root.cal-mode .ribbon-switch--floating {
    visibility: hidden;
  }
  /* developer mode on a wide screen: room for the developer panel on the right */
  @media (min-width: 1000px) {
    :root.cal-mode:has(.dev-panel:not([hidden])) .cal-view {
      padding-right: calc(min(340px, 100vw - 32px) + 36px);
    }
  }
  /* timeline | calendar | countdown + plans. On a wide screen the sides stand still and fill the height,
     only the calendar scrolls; on a narrow one everything is under each other (the whole view scrolls). */
  .cal-layout {
    display: grid;
    grid-template-areas: 'main' 'right' 'left';
    gap: 18px;
    max-width: 1720px;
    margin: 0 auto;
  }
  .cal-main {
    grid-area: main;
    min-width: 0;
    padding: 16px 10px 10px 0;
  }
  .cal-side--left {
    grid-area: left;
  }
  .cal-side--right {
    grid-area: right;
    display: grid;
    gap: 18px;
    align-content: space-between;
  }
  @container (min-width: 1080px) and (min-height: 480px) {
    .cal-layout {
      grid-template-areas: 'left main right';
      grid-template-columns: minmax(200px, 250px) minmax(0, 1fr) minmax(240px, 290px);
      height: 100%;
    }
    .cal-main {
      overflow: auto;
      overscroll-behavior: contain;
    }
    .cal-side {
      min-height: 0;
      overflow: hidden;
      padding-top: 16px;
    }
    /* the timeline scrolls on its own (the latest adventures at the bottom are in view) */
    .cal-side--left {
      overflow: auto;
      overscroll-behavior: contain;
      margin-top: 16px;
      padding-top: 0;
    }
    .cal-side--right {
      grid-template-rows: auto minmax(0, 1fr);
    }
    .cal-plans {
      align-self: end;
      max-height: 100%;
      overflow: hidden;
    }
  }
  .cal-side--right > *,
  .cal-tl {
    border: var(--border, 3px solid var(--ink));
    border-radius: 18px;
    background: var(--surface, #fff);
    color: var(--ink);
    box-shadow: 5px 5px 0 var(--violet);
  }
  .cal-side--left.cal-tl {
    padding: 0 16px 10px;
  }
  /* the timeline's title stays on top while it scrolls */
  .cal-tl .cal-side__title {
    position: sticky;
    top: 0;
    z-index: 2;
    margin: 0 -16px 12px;
    padding: 14px 16px 8px;
    background: var(--surface, #fff);
  }
  :root.cal-mode .cal-side--left {
    animation: cal-in-left 700ms 150ms cubic-bezier(0.2, 0.9, 0.25, 1.1) both;
  }
  :root.cal-mode .cal-side--right {
    animation: cal-in-right 700ms 150ms cubic-bezier(0.2, 0.9, 0.25, 1.1) both;
  }
  @keyframes cal-in-left {
    from {
      transform: translateX(-40px);
      opacity: 0;
    }
  }
  @keyframes cal-in-right {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
  }
  .cal-side__title {
    margin: 0 0 12px;
    font: 800 17px / 1.2 var(--font-heading);
  }
  /* the timeline */
  .cal-tl__list {
    position: relative;
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0 0 0 26px;
    list-style: none;
  }
  .cal-tl__list::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 6px;
    bottom: 6px;
    width: 4px;
    border-radius: 4px;
    background: linear-gradient(var(--violet), var(--yellow));
    transform-origin: top;
    animation: cal-line 900ms 300ms ease both;
  }
  @keyframes cal-line {
    from {
      transform: scaleY(0);
    }
  }
  .cal-tl__item {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 8px 10px;
    border: 2px solid transparent;
    border-radius: 12px;
    cursor: pointer;
    animation: cal-tl-in 500ms cubic-bezier(0.3, 1.4, 0.5, 1) both;
    animation-delay: calc(400ms + var(--i) * 140ms);
  }
  .cal-tl__item:hover {
    border-color: var(--c);
  }
  @keyframes cal-tl-in {
    from {
      transform: translateX(-16px);
      opacity: 0;
    }
  }
  .cal-tl__item::before {
    content: '';
    position: absolute;
    left: -24px;
    top: 12px;
    width: 14px;
    height: 14px;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--c);
  }
  .cal-tl__item.is-now::before {
    box-shadow: 0 0 0 0 var(--c);
    animation: cal-pulse 1.6s ease-out infinite;
  }
  @keyframes cal-pulse {
    to {
      box-shadow: 0 0 0 12px transparent;
    }
  }
  .cal-tl__item.is-next {
    opacity: 0.45;
    border-style: dashed;
    border-color: var(--muted, #888);
  }
  .cal-tl__item.is-next::before {
    background: var(--surface, #fff);
    border-style: dashed;
  }
  .cal-tl__head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    line-height: 1.2;
  }
  .cal-flag {
    flex: none;
    width: 27px;
    height: 18px;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    object-fit: cover;
  }
  .cal-tl__item small {
    color: var(--muted);
  }
  .cal-tl__badge {
    justify-self: start;
    padding: 1px 8px;
    border-radius: 99px;
    background: var(--violet);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }
  .cal-tl__item.is-next .cal-tl__badge {
    background: var(--muted, #888);
  }
  /* the countdown */
  .cal-cd {
    padding: 16px;
    text-align: center;
  }
  .cal-cd__to {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0 0 12px;
    font: 900 clamp(20px, 2vw, 26px) / 1.1 var(--font-heading);
  }
  .cal-cd__to .cal-flag {
    width: 36px;
    height: 24px;
  }
  .cal-cd__digits {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .cal-cd__unit {
    display: grid;
    gap: 2px;
    padding: 8px 2px 6px;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--yellow);
    color: var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .cal-cd__unit b {
    display: block;
    font: 900 clamp(20px, 2vw, 28px) / 1 var(--font-heading);
    font-variant-numeric: tabular-nums;
  }
  .cal-cd__unit b.is-tick {
    animation: cal-tick 380ms ease;
  }
  @keyframes cal-tick {
    from {
      transform: rotateX(90deg);
    }
  }
  .cal-cd__unit small {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .cal-cd__date {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 14px;
  }
  .cal-cd__now {
    margin: 10px 0 0;
    padding: 6px 10px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--violet) 14%, transparent);
    font-size: 14px;
    font-weight: 700;
  }
  .cal-cd__top {
    border-radius: 12px;
    cursor: pointer;
  }
  .cal-cd__top:focus-visible {
    outline: 3px solid var(--violet);
    outline-offset: 4px;
  }
  .cal-cd.is-since .cal-cd__unit {
    background: color-mix(in srgb, var(--violet) 22%, var(--surface, #fff));
  }
  .cal-cd__hint {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 11px;
  }
  .cal-cd__abroad {
    width: 100%;
    border-right: 0;
    border-bottom: 0;
    border-left: 0;
    background: none;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
  }
  .cal-cd__abroad b {
    transition: background-color 200ms ease;
  }
  .cal-cd__abroad.is-pct b {
    background: var(--yellow);
  }
  .cal-cd__abroad {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 12px 0 0;
    padding-top: 10px;
    border-top: 2px dashed color-mix(in srgb, var(--ink) 25%, transparent);
    font-size: 13px;
    font-weight: 700;
    text-align: left;
  }
  .cal-cd__abroad b {
    padding: 2px 10px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--surface, #fff);
    box-shadow: 2px 2px 0 var(--violet);
    font: 900 18px / 1.2 var(--font-heading);
    font-variant-numeric: tabular-nums;
  }
  .cal-cd__now[hidden],
  .cal-cd__digits[hidden],
  .cal-plans__form[hidden] {
    display: none;
  }
  /* planned – join me */
  .cal-plans {
    padding: 16px;
    box-shadow: 5px 5px 0 var(--yellow);
  }
  .cal-plans__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cal-plans__list li {
    display: grid;
    gap: 6px;
    padding: 10px;
    border: 2px dashed var(--ink);
    border-radius: 12px;
    animation: cal-tl-in 500ms cubic-bezier(0.3, 1.4, 0.5, 1) both;
    animation-delay: calc(500ms + var(--i) * 120ms);
  }
  .cal-plans__list strong {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    line-height: 1.25;
  }
  .cal-plans__list small {
    color: var(--muted);
  }
  .cal-plans__join {
    justify-self: start;
    font-size: 13px;
  }
  .cal-plans__dev {
    display: none;
    flex: none;
    gap: 2px;
  }
  .cal-plans__dev button {
    padding: 0 4px;
    border: 0;
    background: none;
    color: #1f8a3a;
    font-size: 15px;
    cursor: pointer;
  }
  :root.dev-mode:not(.dev-preview) .cal-plans__dev {
    display: inline-flex;
  }
  .cal-plans__add {
    display: none;
    margin-top: 10px;
  }
  :root.dev-mode:not(.dev-preview) .cal-plans__add {
    display: inline-flex;
  }
  /* the new plan: a card like the others, its fields written in place */
  .cal-plans__form {
    display: grid;
    gap: 6px;
    margin: 0 0 10px;
    padding: 10px;
    border: 2px dashed #1f8a3a;
    border-radius: 12px;
    background: color-mix(in srgb, #39d353 8%, transparent);
    animation: cal-tl-in 400ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .cal-plans__form input {
    width: 100%;
    padding: 2px 0;
    border: 0;
    border-bottom: 1.5px dashed color-mix(in srgb, var(--ink) 35%, transparent);
    background: none;
    color: inherit;
    font: inherit;
  }
  .cal-plans__form input:focus {
    outline: 0;
    border-bottom-color: var(--violet);
  }
  .cal-plans__in-text {
    font-weight: 800 !important;
    line-height: 1.25;
  }
  .cal-plans__in-small {
    color: var(--muted) !important;
    font-size: 13px !important;
  }
  .cal-plans__when {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
  }
  .cal-plans__preview {
    opacity: 0.5;
    pointer-events: none;
  }
  @container (min-width: 1080px) and (min-height: 480px) {
    .cal-plans {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    /* the plans scroll on their own */
    .cal-plans__list {
      flex: 0 1 auto;
      min-height: 0;
      overflow: auto;
      overscroll-behavior: contain;
      padding: 2px 4px 2px 0;
    }
  }
  /* developer mode: "+ new adventure" at the end of the timeline */
  .cal-tl__add {
    display: none !important;
    border: 2px dashed #1f8a3a !important;
    background: color-mix(in srgb, #39d353 8%, transparent);
    color: #1f8a3a;
  }
  .cal-tl__add::before {
    background: #39d353 !important;
  }
  :root.dev-mode:not(.dev-preview) .cal-tl__add {
    display: grid !important;
  }
  /* the sheet flips down from the top, like a wall calendar's page */
  .cal-sheet {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    padding: 30px clamp(12px, 2.4vw, 28px) 22px;
    border: var(--border, 3px solid var(--ink));
    border-radius: 22px;
    background: var(--surface, #fff);
    color: var(--ink);
    box-shadow: 8px 8px 0 var(--violet);
    transform-origin: 50% 0;
  }
  :root.cal-mode .cal-sheet {
    animation: cal-flip 750ms cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
  }
  .cal-view.is-closing {
    display: block;
    animation: cal-fade 380ms ease forwards;
  }
  .cal-view.is-closing .cal-sheet {
    animation: cal-flip-out 380ms ease-in forwards;
  }
  @keyframes cal-flip {
    from {
      transform: rotateX(-88deg);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes cal-flip-out {
    to {
      transform: rotateX(-80deg);
      opacity: 0;
    }
  }
  @keyframes cal-fade {
    to {
      opacity: 0;
    }
  }
  .cal-rings {
    position: absolute;
    top: -14px;
    left: 8%;
    right: 8%;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }
  .cal-rings i {
    width: 14px;
    height: 30px;
    border: 3px solid var(--ink);
    border-radius: 99px;
    background: var(--yellow);
  }
  .cal-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  .cal-nav,
  .cal-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .cal-title {
    min-width: 9ch;
    margin: 0;
    font: 800 clamp(20px, 3vw, 30px) / 1.1 var(--font-heading);
    text-align: center;
    text-transform: capitalize;
  }
  .cal-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--surface, #fff);
    color: var(--ink);
    font: 700 14px var(--font-body);
    cursor: pointer;
  }
  .cal-btn--icon {
    width: 40px;
    height: 40px;
    padding: 0;
    justify-content: center;
  }
  .cal-btn:hover {
    background: var(--yellow);
    color: #1b1b24;
  }
  .cal-btn--add {
    display: none;
    border-color: #39d353;
    background: #0d1117;
    color: #39d353;
  }
  :root.dev-mode:not(.dev-preview) .cal-btn--add {
    display: inline-flex;
  }
  .cal-switch {
    display: inline-flex;
    padding: 3px;
    border: 2px solid var(--ink);
    border-radius: 999px;
  }
  .cal-switch button {
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font: 700 14px var(--font-body);
    cursor: pointer;
  }
  .cal-switch button[aria-checked='true'] {
    background: var(--violet);
    color: #fff;
  }
  .cal-hint {
    margin: -6px 0 12px;
    color: var(--muted);
    font-size: 14px;
  }
  /* month */
  .cal-week-head,
  .cal-week {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }
  .cal-week-head span {
    padding: 4px 6px 8px;
    font: 700 12px var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cal-day-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-height: clamp(70px, 11vh, 118px);
    padding: 6px 0 6px;
    border-top: 1.5px solid color-mix(in srgb, var(--ink) 16%, transparent);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .cal-day-cell:hover,
  .cal-day-cell:focus-visible {
    background: color-mix(in srgb, var(--violet) 9%, transparent);
    outline: none;
  }
  .cal-day-cell.is-picked,
  .cal-mini__grid button.is-picked {
    background: color-mix(in srgb, var(--yellow) 45%, transparent);
  }
  .cal-day-cell,
  .cal-mini__grid button {
    touch-action: none;
    user-select: none;
  }
  .cal-day-cell.is-other {
    opacity: 0.38;
  }
  .cal-num {
    align-self: flex-start;
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    margin-left: 6px;
    border-radius: 50%;
    font: 700 14px var(--font-body);
    font-variant-numeric: tabular-nums;
  }
  .cal-day-cell.is-today .cal-num {
    background: var(--yellow);
    color: #1b1b24;
    box-shadow: 0 0 0 2px var(--ink);
  }
  .cal-ev {
    display: block;
    height: 22px;
    padding: 0 8px;
    overflow: hidden;
    background: var(--c);
    color: var(--on, #fff);
    font: 700 12px/22px var(--font-body);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .cal-ev.is-start {
    margin-left: 4px;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
  }
  .cal-ev.is-end {
    margin-right: 4px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
  }
  .cal-ev.is-gap {
    visibility: hidden;
  }
  .cal-view.is-fresh .cal-ev {
    animation: cal-ev-in 500ms both cubic-bezier(0.3, 1.4, 0.5, 1);
    animation-delay: calc(var(--i, 0) * 25ms + 300ms);
  }
  @keyframes cal-ev-in {
    from {
      transform: scaleX(0.2);
      opacity: 0;
    }
  }
  /* year */
  .cal-year {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }
  .cal-mini {
    padding: 10px 12px 12px;
    border: 2px solid color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: 16px;
  }
  .cal-mini h3 {
    margin: 0 0 8px;
    font: 800 15px var(--font-heading);
    text-transform: capitalize;
    cursor: pointer;
  }
  .cal-mini h3:hover {
    color: var(--violet);
  }
  .cal-mini__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }
  .cal-mini__grid button,
  .cal-mini__grid span {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: none;
    color: inherit;
    font: 600 11px var(--font-body);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .cal-mini__grid button.has-ev {
    background: var(--c);
    color: var(--on, #fff);
  }
  .cal-mini__grid button.is-today {
    box-shadow: 0 0 0 2px var(--ink);
  }
  .cal-mini__grid button:hover {
    outline: 2px solid var(--violet);
  }
  .cal-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  .cal-legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .cal-legend i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--c);
  }
  /* the day */
  .cal-day,
  .cal-form {
    position: fixed;
    z-index: 5;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: min(400px, calc(100% - 24px));
    max-height: calc(100% - 40px);
    overflow: auto;
    padding: 20px;
    border: var(--border, 3px solid var(--ink));
    border-radius: 18px;
    background: var(--surface, #fff);
    color: var(--ink);
    box-shadow: 6px 6px 0 var(--yellow);
    animation: cal-pop 280ms cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .cal-day[hidden],
  .cal-form[hidden] {
    display: none;
  }
  @keyframes cal-pop {
    from {
      scale: 0.85;
      opacity: 0;
    }
  }
  .cal-day h3 {
    margin: 0 30px 12px 0;
    font: 800 20px var(--font-heading);
  }
  .cal-day__x {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .cal-day__list {
    display: grid;
    gap: 8px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }
  .cal-day__list li {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border-left: 6px solid var(--c);
    border-radius: 10px;
    background: color-mix(in srgb, var(--c) 12%, transparent);
  }
  .cal-day__list strong {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .cal-day__list small {
    color: var(--muted);
  }
  .cal-day__list strong > button {
    display: none;
    padding: 0 6px;
    border: 0;
    background: none;
    color: #1f8a3a;
    font-size: 16px;
    cursor: pointer;
  }
  :root.dev-mode:not(.dev-preview) .cal-day__list strong > button {
    display: inline;
  }
  /* an event's page */
  .cal-evd {
    width: min(580px, calc(100% - 24px)) !important;
  }
  .cal-evd__when {
    margin: 0 30px 2px 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
  }
  .cal-evd__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 30px 6px 0;
    font: 900 clamp(22px, 3vw, 28px) / 1.15 var(--font-heading);
  }
  .cal-evd__title img {
    width: 36px;
    height: 24px;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    object-fit: cover;
  }
  .cal-evd__tags {
    margin: 0 0 8px;
    color: var(--violet);
    font-weight: 700;
  }
  .cal-evd__tags:empty {
    display: none;
  }
  .cal-evd__sec {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 2px dashed color-mix(in srgb, var(--ink) 20%, transparent);
  }
  .cal-evd__sec[hidden],
  .cal-evd__empty[hidden] {
    display: none;
  }
  .cal-evd__sec h4 {
    margin: 0 0 8px;
    font-size: 16px;
  }
  .cal-evd__sec h4 small {
    color: var(--muted);
  }
  .cal-evd__desc {
    margin: 0;
    white-space: pre-line;
  }
  .cal-evd__desc:empty {
    display: none;
  }
  .cal-evd__pics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 8px;
  }
  .cal-evd__pics button {
    position: relative;
    aspect-ratio: 1;
    padding: 0;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: #111;
    color: #fff;
    font-size: 28px;
    cursor: pointer;
    transition: transform 150ms ease;
  }
  .cal-evd__pics button:hover {
    transform: scale(1.04);
  }
  .cal-evd__pics img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cal-evd__music {
    display: grid;
    gap: 4px;
  }
  .cal-evd__music span {
    font-size: 14px;
    font-weight: 700;
  }
  .cal-evd__music audio {
    width: 100%;
    height: 34px;
  }
  .cal-evd__docs {
    display: grid;
    gap: 6px;
  }
  .cal-evd__docs a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border: 2px solid var(--ink);
    border-radius: 10px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .cal-evd__docs a:hover {
    background: var(--yellow);
  }
  .cal-evd__empty {
    margin: 14px 0 0;
    color: var(--muted);
  }
  .cal-evd__desc-ed,
  .cal-evd__dev {
    display: none;
  }
  :root.dev-mode:not(.dev-preview) .cal-evd__desc-ed {
    display: grid;
    gap: 6px;
    margin-top: 8px;
  }
  :root.dev-mode:not(.dev-preview) .cal-evd__dev {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0;
    padding: 10px;
    border: 2px solid #39d353;
    border-radius: 12px;
    background: #0d1117;
  }
  .cal-evd__desc-ed textarea {
    width: 100%;
    padding: 8px 10px;
    border: 1.5px dashed #1f8a3a;
    border-radius: 10px;
    background: color-mix(in srgb, #39d353 6%, transparent);
    color: inherit;
    font: inherit;
  }
  .cal-evd__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .cal-evd__row small {
