---
/**
 * Inline Lucide icon (bold: stroke 2.5, round caps/joins), rendered at build time.
 * Also provides two brand glyphs Lucide does not ship: "strava" and "instagram".
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  /** Accessible label; when omitted the icon is decorative (aria-hidden). */
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;

const lucide = import.meta.glob<string>('../../node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const CUSTOM: Record<string, { body: string; filled?: boolean }> = {
  // Compass for the page-direction switch: the needle points north–south, and turns east–west on the
  // horizontal page (see .compass-needle in global.css)
  // a jar of chocolate spread (map mode's Nutella factories, the Nutella rain)
  jar: {
    body: '<rect x="7" y="2.5" width="10" height="4" rx="1"/><path d="M6 6.5h12a2 2 0 0 1 2 2V19a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 19V8.5a2 2 0 0 1 2-2Z"/><path d="M7.5 11.5h9v5h-9z"/>',
  },
  'compass-dir': {
    body: '<circle cx="12" cy="12" r="10"/><g class="compass-needle"><path d="M12 4.5 15 12H9Z" fill="currentColor"/><path d="M12 19.5 9 12h6Z"/></g><circle cx="12" cy="12" r="1" fill="currentColor"/>',
  },
  // Strava "double chevron" mark
  strava: {
    filled: true,
    body: '<path d="M10.1 2 4 14h3.6l2.5-4.9 2.5 4.9h3.6L10.1 2Z"/><path d="m16.2 14-1.8 3.5L12.6 14H10l4.4 8 4.4-8h-2.6Z"/>',
  },
  facebook: {
    body: '<circle cx="12" cy="12" r="9.5"/><path d="M15.5 7.5h-1.8a2.7 2.7 0 0 0-2.7 2.7V21.5"/><path d="M8.5 13.5h6"/>',
  },
  // Where András has slept (Random Things)
  'bus-stop': {
    body: '<path d="M2 6h12"/><path d="M3.5 6v15"/><path d="M12.5 6v15"/><path d="M5.5 15h5"/><path d="M6.5 15v3"/><path d="M9.5 15v3"/><path d="M19 21v-10"/><circle cx="19" cy="7" r="3"/>',
  },
  forest: {
    body: '<path d="M8 2.5 3.5 10h2.8L3 15.5h10L9.7 10h2.8Z"/><path d="M8 15.5V21"/><path d="M17 7l-3.2 5.5h2L13.5 17h7l-2.3-4.5h2Z"/><path d="M17 17v4"/><path d="M2 21h20"/>',
  },
  'castle-ruin': {
    body: '<path d="M3 21V5h2v2h2V5h2v2h2V5h1.5l-.5 3 1.8 1.5-.8 2.3 2.2 1.2L16 16l1.5 1.5V21"/><path d="M6 21v-4a1.5 1.5 0 0 1 3 0v4"/><path d="M18.5 19.5h2"/><path d="M19.5 17h1.5"/><path d="M2 21h20"/>',
  },
  motorboat: {
    body: '<path d="M2.5 13h17l-2.8 4.5H5.5Z"/><path d="M7 13V9.5h5.5L15 13"/><path d="M20.5 10.5V16"/><path d="M19.5 10.5h2"/><path d="M2 21c1.7 0 1.7-1 3.3-1s1.7 1 3.4 1 1.6-1 3.3-1 1.7 1 3.3 1 1.7-1 3.4-1 1.6 1 3.3 1"/>',
  },
  instagram: {
    body: '<rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor"/>',
  },
};

let body = '';
let filled = false;
if (CUSTOM[name]) {
  body = CUSTOM[name].body;
  filled = CUSTOM[name].filled ?? false;
} else {
  const raw = lucide[`../../node_modules/lucide-static/icons/${name}.svg`];
  if (!raw) throw new Error(`[Icon] Unknown Lucide icon "${name}"`);
  body = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();
}
---

<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={body}
/>
