---
import Icon from './Icon.astro';
import IconCircle from './IconCircle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import HtmlToggle from './HtmlToggle.astro';
import CitySearch from './CitySearch.astro';
import ZoomControl from './ZoomControl.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import RibbonSwitch from './RibbonSwitch.astro';
import { localePath, t, type Lang, type TKey } from '../i18n';
import { BG_EVENT, BG_STORAGE_KEY, CITIES_EVENT, CITIES_STORAGE_KEY, GRID_EVENT, GRID_STORAGE_KEY, MAP_MODE_EVENT, MAP_MODE_STORAGE_KEY, HORIZONTAL_EVENT, HORIZONTAL_STORAGE_KEY, CV_EVENT, CV_STORAGE_KEY, } from '../lib/constants';
import site from '../data/site.json';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const home = localePath(lang);

const links: { key: TKey; hash: string }[] = [
  { key: 'nav.about', hash: 'about' },
  { key: 'nav.explore', hash: 'explore' },
  { key: 'nav.plans', hash: 'plans' },
  { key: 'nav.message', hash: 'message' },
];
const contactHref = `${home}#contact`;
const bgToggle = {
  htmlClass: 'bg-dynamic',
  pressedWhen: 'present' as const,
  storageKey: BG_STORAGE_KEY,
  eventName: BG_EVENT,
  icon: 'images',
  label: t(lang, 'bg.toggle'),
};
const gridToggle = {
  htmlClass: 'grid-on',
  pressedWhen: 'present' as const,
  storageKey: GRID_STORAGE_KEY,
  eventName: GRID_EVENT,
  icon: 'grid-3x3',
  label: t(lang, 'grid.toggle'),
};
const cvToggle = {
  htmlClass: 'cv-mode',
  pressedWhen: 'present' as const,
  storageKey: CV_STORAGE_KEY,
  eventName: CV_EVENT,
  icon: 'file-user',
  label: t(lang, 'cv.toggle'),
};
const horizontalToggle = {
  htmlClass: 'horizontal',
  pressedWhen: 'present' as const,
  storageKey: HORIZONTAL_STORAGE_KEY,
  eventName: HORIZONTAL_EVENT,
  icon: 'compass-dir',
  label: t(lang, 'horizontal.toggle'),
};
const mapModeToggle = {
  htmlClass: 'map-mode',
  pressedWhen: 'present' as const,
  storageKey: MAP_MODE_STORAGE_KEY,
  eventName: MAP_MODE_EVENT,
  icon: 'map',
  label: t(lang, 'mapmode.toggle'),
};
const citiesToggle = {
  htmlClass: 'cities-off',
  pressedWhen: 'absent' as const,
  storageKey: CITIES_STORAGE_KEY,
  eventName: CITIES_EVENT,
  icon: 'map-pinned',
  label: t(lang, 'cities.toggle'),
};
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={home}>
      <IconCircle icon="globe" size="nav" variant="violet" />
      <span class="brand__name">{site.owner}</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={`${home}#${l.hash}`}>{t(lang, l.key)}</a></li>)}
      </ul>
      <a class="btn btn--yellow nav-contact" href={contactHref}>
        <Icon name="mail" size={18} />
        {t(lang, 'nav.contact')}
      </a>
      <LanguageSwitcher lang={lang} path={path} uid="header" />
    </nav>

    <div class="header-tools">
      <CitySearch lang={lang} />
      <ZoomControl lang={lang} uid="header" />
      <ThemeSwitch lang={lang} uid="header" />
      <HtmlToggle {...gridToggle} class="desktop-tool" />
      <HtmlToggle {...citiesToggle} class="desktop-tool" />
      <HtmlToggle {...bgToggle} class="desktop-tool" />
      <HtmlToggle {...mapModeToggle} class="desktop-tool" />
      <HtmlToggle {...horizontalToggle} class="desktop-tool" />
      <HtmlToggle {...cvToggle} class="desktop-tool" />
      <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menu"
      data-menu-toggle
    >
      <span class="menu-toggle__open"><Icon name="menu" size={24} /></span>
      <span class="menu-toggle__close"><Icon name="x" size={24} /></span>
    </button>
    </div>
    <!-- the motto, in the free space after the buttons -->
    <button type="button" class="pum" data-pum data-info-title={t(lang, 'pum.title')} data-ideas={JSON.stringify(t(lang, 'pum.ideas').split('|'))} aria-label={t(lang, 'pum.label')} title={t(lang, 'pum.label')}>PUM!</button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav class="container" aria-label="Main">
      <ul class="mobile-menu__links">
        {
          links.map((l, i) => (
            <li>
              <a href={`${home}#${l.hash}`} data-menu-link>
                <span class:list={['mobile-menu__dot', i % 2 ? 'is-yellow' : 'is-violet']} aria-hidden="true" />
                {t(lang, l.key)}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--yellow" href={contactHref} data-menu-link>
        <Icon name="mail" size={18} />
        {t(lang, 'nav.contact')}
      </a>
      <div class="mobile-menu__lang">
        <LanguageSwitcher lang={lang} path={path} uid="mobile" inline />
      </div>
      <RibbonSwitch lang={lang} variant="inline" />
      <ul class="mobile-tools">
        <li><ZoomControl lang={lang} uid="mobile" inline /><span>{t(lang, 'zoom.label')}</span></li>
        <li><ThemeSwitch lang={lang} uid="mobile" inline /><span>{t(lang, 'theme.label')}</span></li>
        <li><HtmlToggle {...gridToggle} /><span>{t(lang, 'grid.toggle')}</span></li>
        <li><HtmlToggle {...citiesToggle} /><span>{t(lang, 'cities.toggle')}</span></li>
        <li><HtmlToggle {...bgToggle} /><span>{t(lang, 'bg.toggle')}</span></li>
        <li><HtmlToggle {...mapModeToggle} /><span>{t(lang, 'mapmode.toggle')}</span></li>
        <li><HtmlToggle {...horizontalToggle} /><span>{t(lang, 'horizontal.toggle')}</span></li>
        <li><HtmlToggle {...cvToggle} /><span>{t(lang, 'cv.toggle')}</span></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 2px solid transparent;
    transition: border-color var(--t-med) var(--ease);
  }
  /* The blur lives on a pseudo-element: backdrop-filter on the header itself would make it the
     containing block of the fixed mobile menu and trap the overlay inside the header bar. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* diagonal stripes in the theme's two colours (they follow the theme switch) */
    background:
      repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--violet) 13%, transparent) 0 14px,
        transparent 14px 28px,
        color-mix(in srgb, var(--yellow) 24%, transparent) 28px 42px,
        transparent 42px 56px
      ),
      rgb(255 255 255 / 0.8);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--ink);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: var(--header-h);
  }
  /* the motto: a slightly tilted stamp on the header's right side (it takes no room from the buttons);
     on wide screens it moves in towards the buttons, as far as the free space allows */
  .pum {
    position: absolute;
    top: min(50%, 52px);
    right: clamp(14px, calc((100vw - 1450px) * 0.29 + 14px), 170px);
    z-index: 2;
    font-family: 'Unbounded', var(--font-heading);
    font-size: 44px;
    font-weight: 900;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--violet);
    -webkit-text-stroke: 2px var(--ink);
    text-shadow: 4px 4px 0 var(--yellow);
    transform: translateY(-50%) rotate(-8deg);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    user-select: none;
    animation: pum-in 900ms cubic-bezier(0.34, 1.56, 0.64, 1) both 300ms;
  }
  .pum:hover {
    color: var(--yellow);
    text-shadow: 4px 4px 0 var(--violet);
  }
  .pum.is-boom {
    animation: pum-boom 760ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes pum-boom {
    15% {
      transform: translateY(-50%) rotate(-30deg) scale(1.6);
    }
    35% {
      transform: translateY(-50%) rotate(350deg) scale(0.8);
    }
    60% {
      transform: translateY(-50%) rotate(345deg) scale(1.2);
    }
    100% {
      transform: translateY(-50%) rotate(352deg) scale(1);
    }
  }
  /* mid-size screens: the buttons reach the right edge, so the stamp is smaller and sits in the corner */
  @media (max-width: 1279px) {
    .pum {
      top: 26px;
      font-size: 28px;
    }
  }
  @keyframes pum-in {
    from {
      transform: translateY(-50%) rotate(-30deg) scale(0.2);
      opacity: 0;
    }
  }
  @media (max-width: 899px) {
    .pum {
      top: 26px;
      right: 116px;
      font-size: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pum {
      animation: none;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
    flex: none;
  }
  .brand__name {
    /* the name is Latin in every language */
    font-family: 'Unbounded', var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .nav-desktop {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.2vw, 20px);
    min-width: 0;
  }
  .nav-desktop ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 2px clamp(8px, 1.2vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-desktop ul a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    color: var(--ink);
    font-weight: 500;
    font-size: var(--fs-small);
    text-decoration: none;
    white-space: nowrap;
    background: linear-gradient(var(--yellow), var(--yellow)) no-repeat left 78% / 0 6px;
    transition: background-size var(--t-med) var(--ease);
  }
  .nav-desktop ul a:hover {
    background-size: 100% 6px;
  }
  .nav-contact {
    padding: 8px 18px;
    white-space: nowrap;
    box-shadow: 3px 3px 0 var(--ink);
  }

  .mobile-tools {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mobile-tools li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    font-size: var(--fs-small);
  }
  /* on phones these live in the menu instead */
  @media (max-width: 899px) {
    .header-tools > :global(.desktop-tool),
    .header-tools > :global(.theme-switch),
    .header-tools > :global(.zoom-control) {
      display: none;
    }
  }
  .header-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .menu-toggle {
    display: none;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    border: var(--border);
    border-radius: 50%;
    background: var(--surface);
    cursor: pointer;
  }
  .menu-toggle__close {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__close {
    display: contents;
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: var(--z-overlay);
    overflow-y: auto;
    background: var(--bg);
    padding-block: 24px 48px;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .mobile-menu__links {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  .mobile-menu__links a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(22px, 6vw, 30px);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px dashed var(--globe-line);
  }
  .mobile-menu__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: var(--border);
    flex: none;
  }
  .mobile-menu__dot.is-violet {
    background: var(--violet);
  }
  .mobile-menu__dot.is-yellow {
    background: var(--yellow);
  }

  @media (max-width: 1100px) {
    .nav-desktop ul a {
      font-size: 14px;
    }
  }
  @media (max-width: 899px) {
    .nav-desktop {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
  .nav-desktop + .header-tools {
    margin-left: 0;
  }
  @media (max-width: 899px) {
    .nav-desktop + .header-tools {
      margin-left: auto;
    }
  }
  @media (min-width: 900px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && menu) {
    const setOpen = (open: boolean, returnFocus = false) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLElement>('a, button')?.focus({ preventScroll: true });
      else if (returnFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(Boolean(menu.hidden)));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false, true);
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) setOpen(false);
    });
  }
</script>

<script>
  import { showInfoBox } from '../lib/infobox';

  // PUM!: every click bursts (comic words, confetti, Nutella jars) and suggests a random adventure
  document.querySelectorAll<HTMLButtonElement>('[data-pum]').forEach((pum) => {
    const ideas: string[] = JSON.parse(pum.dataset.ideas || '[]');
    const WORDS = ['PUM!', 'BUMM!', 'ZÚM!', 'PUFF!', 'WOW!', 'PUM PUM!'];
    const COLORS = ['#ffd60a', '#7b2ff7', '#ff4d6d', '#39d353', '#00c2ff', '#ff8a00'];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let last = -1;

    const burst = () => {
      if (reduced) return;
      const r = pum.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const layer = document.createElement('div');
      layer.className = 'pum-burst';
      layer.setAttribute('aria-hidden', 'true');
      document.body.append(layer);
      const at = (el: HTMLElement, x = cx, y = cy) => {
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
        layer.append(el);
        return el;
      };
      const piece = (html: string, cls: string, dist: number, angle: number, spin: number, ms: number, delay = 0) => {
        const el = document.createElement('span');
        el.className = cls;
        el.innerHTML = html;
        at(el);
        const dx = Math.cos(angle) * dist;
        const dy = Math.sin(angle) * dist;
        el.animate(
          [
            { transform: 'translate(-50%, -50%) scale(0.1) rotate(0deg)', opacity: 1 },
            { transform: `translate(calc(-50% + ${dx * 0.75}px), calc(-50% + ${dy * 0.75}px)) scale(1.25) rotate(${spin * 0.6}deg)`, opacity: 1, offset: 0.55 },
            { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy + 70}px)) scale(0.9) rotate(${spin}deg)`, opacity: 0 },
          ],
          { duration: ms, delay, easing: 'cubic-bezier(0.15, 0.85, 0.3, 1)', fill: 'both' },
        );
      };
      // 1) a flash and two shock-wave rings
      const flash = at(Object.assign(document.createElement('span'), { className: 'pum-burst__flash' }));
      flash.animate([{ opacity: 0.9, transform: 'translate(-50%, -50%) scale(0.2)' }, { opacity: 0, transform: 'translate(-50%, -50%) scale(3)' }], { duration: 450, easing: 'ease-out', fill: 'forwards' });
      [0, 140].forEach((delay, i) => {
        const ring = at(Object.assign(document.createElement('span'), { className: `pum-burst__ring pum-burst__ring--${i}` }));
        ring.animate([{ opacity: 1, transform: 'translate(-50%, -50%) scale(0.1)' }, { opacity: 0, transform: 'translate(-50%, -50%) scale(5)' }], { duration: 900, delay, easing: 'cubic-bezier(0.2, 0.7, 0.3, 1)', fill: 'both' });
      });
      // 2) comic action lines all around
      for (let i = 0; i < 16; i++) {
        const line = at(Object.assign(document.createElement('span'), { className: 'pum-burst__line' }));
        const a = (i / 16) * 360 + Math.random() * 10;
        line.animate(
          [
            { transform: `translate(-50%, -50%) rotate(${a}deg) translateX(30px) scaleX(0.1)`, opacity: 1 },
            { transform: `translate(-50%, -50%) rotate(${a}deg) translateX(150px) scaleX(1)`, opacity: 1, offset: 0.5 },
            { transform: `translate(-50%, -50%) rotate(${a}deg) translateX(240px) scaleX(0.2)`, opacity: 0 },
          ],
          { duration: 650, easing: 'ease-out', fill: 'both' },
        );
      }
      // 3) a giant PUM! in the middle of the screen
      const big = at(Object.assign(document.createElement('span'), { className: 'pum-burst__big', textContent: 'PUM!' }), window.innerWidth / 2, window.innerHeight / 2);
      big.animate(
        [
          { transform: 'translate(-50%, -50%) scale(0.2) rotate(-25deg)', opacity: 0 },
          { transform: 'translate(-50%, -50%) scale(1.25) rotate(-8deg)', opacity: 1, offset: 0.25 },
          { transform: 'translate(-50%, -50%) scale(1) rotate(-6deg)', opacity: 1, offset: 0.7 },
          { transform: 'translate(-50%, -50%) scale(1.6) rotate(-4deg)', opacity: 0 },
        ],
        { duration: 1300, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)', fill: 'both' },
      );
      // 4) words, confetti and Nutella jars
      const words = [...WORDS].sort(() => Math.random() - 0.5).slice(0, 5);
      words.forEach((w, i) => piece(w, 'pum-burst__word', 140 + Math.random() * 90, Math.PI * (0.05 + 0.9 * (i / (words.length - 1))), (Math.random() - 0.5) * 50, 1300, i * 60));
      for (let i = 0; i < 40; i++) {
        const c = COLORS[i % COLORS.length];
        piece(`<i style="background:${c}"></i>`, 'pum-burst__confetti', 90 + Math.random() * 260, Math.random() * Math.PI * 2, (Math.random() - 0.5) * 900, 1000 + Math.random() * 700);
      }
      for (let i = 0; i < 4; i++) piece('🫙', 'pum-burst__jar', 140 + Math.random() * 140, Math.PI * (0.1 + Math.random() * 0.8), (Math.random() - 0.5) * 720, 1500, 80 * i);
      // 5) the page content shakes once (not <body>: a transform there would move the fixed layers)
      document.querySelector('main')?.animate(
        [{ transform: 'translate(0, 0)' }, { transform: 'translate(-6px, 3px)' }, { transform: 'translate(5px, -4px)' }, { transform: 'translate(-3px, 2px)' }, { transform: 'translate(0, 0)' }],
        { duration: 380, easing: 'ease-out' },
      );
      setTimeout(() => layer.remove(), 2300);
    };

    pum.addEventListener('click', (e) => {
      e.stopPropagation();
      pum.classList.remove('is-boom');
      void pum.offsetWidth;
      pum.classList.add('is-boom');
      burst();
      if (!ideas.length) return;
      let i = Math.floor(Math.random() * ideas.length);
      if (i === last) i = (i + 1) % ideas.length;
      last = i;
      pum.dataset.infoText = ideas[i];
      showInfoBox(pum);
    });
  });
</script>
