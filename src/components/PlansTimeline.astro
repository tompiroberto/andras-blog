---
import Globe from './Globe.astro';
import IconCircle from './IconCircle.astro';
import SectionHeading from './SectionHeading.astro';
import { t, type Lang, type TKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const STATIONS: { n: 1 | 2 | 3 | 4 | 5; icon: string; tone: 'yellow' | 'violet' }[] = [
  { n: 1, icon: 'thumbs-up', tone: 'yellow' },
  { n: 2, icon: 'message-square', tone: 'violet' },
  { n: 3, icon: 'backpack', tone: 'yellow' },
  { n: 4, icon: 'mountain-snow', tone: 'violet' },
  { n: 5, icon: 'timer', tone: 'yellow' },
];
/** a slight tilt per note, so the board looks hand-pinned (not a sequence) */
const TILT = [-2.2, 1.6, -1, 2.4, -1.8];
const k = (n: number, field: 'tag' | 'title' | 'text') => `plan${n}.${field}` as TKey;
---

<section class="section plans" id="plans" data-lay="plans" aria-labelledby="plans-title">
  <div class="bg-layer">
    <Globe size="min(700px, 110vw)" right="-18%" top="-10%" speed={65} direction="ccw" dots={false} />
  </div>
  <div class="container">
    <SectionHeading icon="route" id="plans-title">{t(lang, 'plans.title')}</SectionHeading>

    <p class="plans__note">{t(lang, 'plans.note')}</p>
    <ul class="plans-board reveal">
      {
        STATIONS.map((s, i) => (
          <li class:list={['plan-note', `plan-note--${s.tone}`]} style={`--tilt:${TILT[i % TILT.length]}deg`}>
            <span class="plan-note__pin" aria-hidden="true" />
            <IconCircle icon={s.icon} variant={s.tone} size="lg" />
            <span class:list={['pill', 'station__tag', `station__tag--${s.tone}`]}>{t(lang, k(s.n, 'tag'))}</span>
            <h3>{t(lang, k(s.n, 'title'))}</h3>
            <p>{t(lang, k(s.n, 'text'))}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .plans__note {
    margin: -8px 0 28px;
    color: var(--muted);
    font-size: var(--fs-small);
  }
  /* a pin board: notes wrap and stay centred (3 + 2), no order implied */
  .plans-board {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(22px, 3vw, 36px);
    margin: 0;
    padding: 12px 0 0;
    list-style: none;
  }
  .plan-note {
    flex: 0 1 clamp(calc(220px * var(--tz)), 30%, calc(320px * var(--tz)));
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 26px 20px 22px;
    border: var(--border);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: 6px 6px 0 var(--yellow);
    transform: rotate(var(--tilt, 0deg));
    transition:
      transform var(--t-med) var(--ease),
      box-shadow var(--t-med) var(--ease);
  }
  .plan-note--violet {
    box-shadow: 6px 6px 0 var(--violet);
  }
  .plan-note:hover {
    transform: rotate(0deg) translateY(-6px) scale(1.03);
  }
  .plan-note__pin {
    position: absolute;
    top: -11px;
    left: 50%;
    width: 20px;
    height: 20px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--violet);
    transform: translateX(-50%);
  }
  .plan-note--violet .plan-note__pin {
    background: var(--yellow);
  }
  .plan-note h3 {
    margin: 4px 0 0;
    font-size: var(--fs-h3);
  }
  .plan-note p {
    margin: 0;
    color: var(--muted);
  }
  .station__tag {
    font-size: var(--fs-tiny);
    letter-spacing: 0.08em;
  }
  .station__tag--yellow {
    background: var(--yellow-tint);
  }
  .station__tag--violet {
    background: var(--violet-tint);
    color: var(--violet-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .plan-note {
      transform: none;
    }
  }
</style>
