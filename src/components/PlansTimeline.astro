---
import Globe from './Globe.astro';
import IconCircle from './IconCircle.astro';
import SectionHeading from './SectionHeading.astro';
import { t, type Lang, type TKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const STATIONS: { n: 1 | 2 | 3 | 4 | 5; icon: string; tone: 'yellow' | 'violet' }[] = [
  { n: 1, icon: 'thumbs-up', tone: 'yellow' },
  { n: 2, icon: 'message-square', tone: 'violet' },
  { n: 3, icon: 'backpack', tone: 'yellow' },
  { n: 4, icon: 'mountain-snow', tone: 'violet' },
  { n: 5, icon: 'timer', tone: 'yellow' },
];
// station, arrows, station, arrows … station
const columns = STATIONS.map(() => 'minmax(0, 1fr)').join(' auto ');
const k = (n: number, field: 'tag' | 'title' | 'text') => `plan${n}.${field}` as TKey;
---

<section class="section plans" id="plans" data-lay="plans" aria-labelledby="plans-title">
  <div class="bg-layer">
    <Globe size="min(700px, 110vw)" right="-18%" top="-10%" speed={65} direction="ccw" dots={false} />
  </div>
  <div class="container">
    <SectionHeading icon="route" id="plans-title">{t(lang, 'plans.title')}</SectionHeading>

    <ol class="timeline reveal" data-timeline style={`--timeline-cols:${columns}`}>
      {
        STATIONS.map((s, i) => (
          <>
            <li class="station">
              <IconCircle icon={s.icon} variant={s.tone} size="xl" />
              <span class:list={['pill', 'station__tag', `station__tag--${s.tone}`]}>{t(lang, k(s.n, 'tag'))}</span>
              <h3>{t(lang, k(s.n, 'title'))}</h3>
              <p>{t(lang, k(s.n, 'text'))}</p>
            </li>
            {i < STATIONS.length - 1 && (
              <li class="arrows" aria-hidden="true">
                {[0, 1, 2].map((j) => (
                  <span class:list={['arrow', `arrow--${j}`]} style={`--i:${i * 3 + j}`} />
                ))}
              </li>
            )}
          </>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    grid-template-columns: var(--timeline-cols);
    align-items: start;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .station {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    min-width: 0;
  }
  .station h3 {
    margin: 4px 0 0;
  }
  .station p {
    margin: 0;
    color: var(--muted);
    max-width: 32ch;
  }
  .station__tag {
    font-size: var(--fs-tiny);
    letter-spacing: 0.08em;
  }
  .station__tag--yellow {
    background: var(--yellow-tint);
  }
  .station__tag--violet {
    background: var(--violet-tint);
    color: var(--violet-dark);
  }
  .arrows {
    display: flex;
    gap: 4px;
    align-items: center;
    height: var(--icon-xl);
  }
  .arrow {
    width: 12px;
    height: 16px;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    transition:
      opacity 400ms var(--ease),
      transform 400ms var(--ease);
    transition-delay: calc(var(--i) * 140ms + 200ms);
  }
  .arrow--0 {
    background: var(--globe-line);
  }
  .arrow--1 {
    background: var(--violet);
  }
  .arrow--2 {
    background: var(--yellow);
    /* yellow never sits on the page without a dark edge */
    filter: drop-shadow(0 0 0 var(--ink)) drop-shadow(1px 0 0 var(--ink));
  }
  :global(.js) .timeline:not(.is-visible) .arrow {
    opacity: 0;
    transform: translateX(-12px);
  }

  @media (max-width: 899px) {
    .timeline {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }
    .arrows {
      flex-direction: column;
      height: auto;
      padding-block: 8px;
    }
    .arrow {
      transform: rotate(90deg);
    }
    :global(.js) .timeline:not(.is-visible) .arrow {
      transform: rotate(90deg) translateX(-12px);
    }
  }
</style>
