---
import Globe from './Globe.astro';
import IconCircle from './IconCircle.astro';
import SectionHeading from './SectionHeading.astro';
import { localePath, t, type Lang, type TKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const STATIONS: { n: 1 | 2 | 3 | 4 | 5; icon: string; tone: 'yellow' | 'violet' }[] = [
  { n: 1, icon: 'thumbs-up', tone: 'yellow' },
  { n: 2, icon: 'message-square', tone: 'violet' },
  { n: 3, icon: 'backpack', tone: 'yellow' },
  { n: 4, icon: 'mountain-snow', tone: 'violet' },
  { n: 5, icon: 'timer', tone: 'yellow' },
];
/** a slight tilt per note, so the board looks hand-pinned (not a sequence) */
const TILT = [-2.2, 1.6, -1, 2.4, -1.8];
const k = (n: number, field: 'tag' | 'title' | 'text' | 'story' | 'facts') => `plan${n}.${field}` as TKey;
---

<section class="section plans" id="plans" data-lay="plans" aria-labelledby="plans-title">
  <div class="bg-layer">
    <Globe size="min(700px, 110vw)" right="-18%" top="-10%" speed={65} direction="ccw" dots={false} />
  </div>
  <div class="container">
    <SectionHeading icon="route" id="plans-title">{t(lang, 'plans.title')}</SectionHeading>

    <p class="plans__note">{t(lang, 'plans.note')}</p>
    <ul class="plans-board reveal">
      {
        STATIONS.map((s, i) => (
          <li class:list={['plan-note', `plan-note--${s.tone}`]} style={`--tilt:${TILT[i % TILT.length]}deg`}>
            <span class="plan-note__pin" aria-hidden="true" />
            {/* the whole note is a button: a click opens the longer story in an info box */}
            <button
              type="button"
              class="plan-note__btn"
              data-info-title={t(lang, k(s.n, 'title'))}
              data-info-text={t(lang, k(s.n, 'story'))}
              data-info-facts={t(lang, k(s.n, 'facts'))}
              data-info-icon=".icon-circle svg"
            >
              <IconCircle icon={s.icon} variant={s.tone} size="lg" />
              <span class:list={['pill', 'station__tag', `station__tag--${s.tone}`]}>{t(lang, k(s.n, 'tag'))}</span>
              <h3>{t(lang, k(s.n, 'title'))}</h3>
              <p>{t(lang, k(s.n, 'text'))}</p>
              <span class="plan-note__hint" aria-hidden="true">＋</span>
            </button>
          </li>
        ))
      }
      <!-- the last note: more is coming – and the visitor can join in -->
      <li class="plan-note plan-note--more" style="--tilt:1.2deg">
        <span class="plan-note__pin" aria-hidden="true" />
        <IconCircle icon="sparkles" variant="yellow" size="lg" />
        <span class="pill station__tag station__tag--yellow">{t(lang, 'plans.more.tag')}</span>
        <h3>{t(lang, 'plans.more.title')}</h3>
        <p>{t(lang, 'plans.more.text')}</p>
        <a class="link-arrow plan-note__link" href={`${localePath(lang)}#message`}>{t(lang, 'plans.more.link')}</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .plans__note {
    margin: -8px 0 28px;
    color: var(--muted);
    font-size: var(--fs-small);
  }
  /* a pin board: notes wrap and stay centred (3 + 2), no order implied */
  .plans-board {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(22px, 3vw, 36px);
    margin: 0;
    padding: 12px 0 0;
    list-style: none;
  }
  .plan-note {
    flex: 0 1 clamp(calc(220px * var(--tz)), 30%, calc(320px * var(--tz)));
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 26px 20px 22px;
    border: var(--border);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: 6px 6px 0 var(--yellow);
    transform: rotate(var(--tilt, 0deg));
    transition:
      transform var(--t-med) var(--ease),
      box-shadow var(--t-med) var(--ease);
  }
  .plan-note--violet {
    box-shadow: 6px 6px 0 var(--violet);
  }
  .plan-note:hover {
    transform: rotate(0deg) translateY(-6px) scale(1.03);
  }
  .plan-note__btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .plan-note__hint {
    position: absolute;
    right: 12px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
    font-weight: 800;
    line-height: 1;
    transition: transform var(--t-med) cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .plan-note__btn:hover .plan-note__hint,
  .plan-note__btn[aria-expanded='true'] .plan-note__hint {
    transform: rotate(90deg) scale(1.15);
    background: var(--yellow);
  }
  .plan-note--more {
    border-style: dashed;
    background: var(--yellow-tint);
  }
  .plan-note__link {
    margin-top: auto;
    padding-top: 6px;
    font-weight: 700;
  }
  .plan-note__pin {
    position: absolute;
    top: -11px;
    left: 50%;
    width: 20px;
    height: 20px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--violet);
    transform: translateX(-50%);
  }
  .plan-note--violet .plan-note__pin {
    background: var(--yellow);
  }
  .plan-note h3 {
    margin: 4px 0 0;
    font-size: var(--fs-h3);
  }
  .plan-note p {
    margin: 0;
    color: var(--muted);
  }
  .station__tag {
    font-size: var(--fs-tiny);
    letter-spacing: 0.08em;
  }
  .station__tag--yellow {
    background: var(--yellow-tint);
  }
  .station__tag--violet {
    background: var(--violet-tint);
    color: var(--violet-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .plan-note {
      transform: none;
    }
  }
</style>

<script>
  import { wireInfoBoxes } from '../lib/infobox';

  wireInfoBoxes(document.querySelector('.plans-board') ?? document);
</script>
