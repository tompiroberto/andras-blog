---
/**
 * Home-page "Photos" section: the newest photos and a link to the full gallery (/[lang]/gallery/).
 * Photos come from src/lib/photos.ts (uploaded in developer mode).
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { getPhotos } from '../lib/photos';
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const SHOWN = 6;
const all = await getPhotos(lang);
// the home strip shows pictures only (videos are in the gallery)
const photos = all.filter((p) => !p.video).slice(0, SHOWN);
---

<section class="section photos" id="photos" data-lay="photos" data-dev-add="photo" aria-labelledby="photos-title">
  <div class="container">
    <SectionHeading icon="camera" id="photos-title">
      {t(lang, 'gallery.title')}
    </SectionHeading>
    {
      photos.length === 0 ? (
        <p class="photos__empty">{t(lang, 'gallery.empty')}</p>
      ) : (
        <ul class="photos__grid">
          {photos.map((p) => (
            <li class="photos__item reveal">
              <a href={localePath(lang, 'gallery')}>
                {p.image ? (
                  <Image src={p.image} alt={p.caption} widths={[320, 640]} sizes="(max-width: 600px) 100vw, 320px" loading="lazy" />
                ) : (
                  <img src={p.src} alt={p.caption} loading="lazy" />
                )}
              </a>
              <p class="photos__caption">
                {p.caption}
                {p.place && <span> · {p.place}</span>}
              </p>
            </li>
          ))}
        </ul>
      )
    }
    {
      all.length > 0 && (
        <p class="photos__more">
          <a class="btn btn--primary" href={localePath(lang, 'gallery')}>
            <Icon name="images" size={20} />
            {t(lang, 'gallery.all')} ({all.length})
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .photos__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .photos__item {
    margin: 0;
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-yellow);
  }
  .photos__item:nth-child(even) {
    box-shadow: var(--shadow-violet);
  }
  .photos__item :global(img) {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    transition: transform var(--t-med) var(--ease);
  }
  .photos__item a:hover :global(img),
  .photos__item a:focus-visible :global(img) {
    transform: scale(1.05);
  }
  .photos__caption {
    margin: 0;
    padding: 10px 14px;
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .photos__empty {
    font-size: var(--fs-body);
    font-weight: 700;
  }
  .photos__more {
    margin: 28px 0 0;
    text-align: center;
  }
  .photos__caption span {
    font-weight: 400;
    color: var(--muted);
  }
</style>
