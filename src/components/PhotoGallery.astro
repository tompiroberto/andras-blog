---
/**
 * Home-page "Photos" section: at most eight tiles (two rows) of the newest pictures and videos and a
 * link to the full gallery (/[lang]/gallery/). Pictures sharing a hashtag (their first one) make one
 * album tile – a little stack of them – that opens that folder of the gallery; so a new upload with
 * a hashtag joins its album (or starts a new one) by itself. Photos come from src/lib/photos.ts.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { getPhotos, type Photo } from '../lib/photos';
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const TILES = 8;
const all = await getPhotos(lang);
// newest first: each picture joins the tile of its first hashtag, or gets one of its own
const groups = new Map<string, { tag?: string; items: Photo[] }>();
for (const p of all) {
  const tag = p.tags?.[0];
  const id = tag ? `#${tag}` : p.key;
  if (!groups.has(id)) {
    if (groups.size >= TILES) continue;
    groups.set(id, { tag, items: [] });
  }
  groups.get(id)!.items.push(p);
}
const tiles = [...groups.values()];
const galleryHref = localePath(lang, 'gallery');
---

<section class="section photos" id="photos" data-lay="photos" data-dev-add="photo" aria-labelledby="photos-title">
  <div class="container">
    <SectionHeading icon="camera" id="photos-title">
      {t(lang, 'gallery.title')}
    </SectionHeading>
    {
      tiles.length === 0 ? (
        <p class="photos__empty">{t(lang, 'gallery.empty')}</p>
      ) : (
        <ul class="photos__grid">
          {tiles.map(({ tag, items }) => {
            const album = items.length > 1;
            const p = items[0];
            return (
              <li class:list={['photos__item reveal', { 'photos__item--album': album }]}>
                <a href={album && tag ? `${galleryHref}?tag=${encodeURIComponent(tag)}` : galleryHref}>
                  <span class="photos__stack">
                    {/* an album: up to three of its pictures, the newest on top */}
                    {items.slice(0, album ? 3 : 1).reverse().map((x) =>
                      x.video ? (
                        <span class="photos__video">
                          <video src={`${x.video}#t=0.5`} preload="metadata" muted playsinline />
                          <span class="photos__play" aria-hidden="true">▶</span>
                        </span>
                      ) : x.image ? (
                        <Image src={x.image} alt={x.caption} widths={[320, 640]} sizes="(max-width: 600px) 100vw, 320px" loading="lazy" />
                      ) : (
                        <img src={x.src} alt={x.caption} loading="lazy" />
                      ),
                    )}
                    {album && <span class="photos__count">📁 {items.length}</span>}
                  </span>
                </a>
                <p class="photos__caption">
                  {album ? `#${tag}` : p.caption}
                  {!album && p.place && <span> · {p.place}</span>}
                  {album && <span> · {items.length} {t(lang, 'gal.items')}</span>}
                </p>
              </li>
            );
          })}
        </ul>
      )
    }
    {
      all.length > 0 && (
        <p class="photos__more">
          <a class="btn btn--primary" href={localePath(lang, 'gallery')}>
            <Icon name="images" size={20} />
            {t(lang, 'gallery.all')} ({all.length})
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  /* eight tiles at most: four columns, two rows */
  .photos__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .photos__item {
    margin: 0;
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-yellow);
  }
  .photos__item:nth-child(even) {
    box-shadow: var(--shadow-violet);
  }
  .photos__item a {
    display: block;
    overflow: hidden;
  }
  .photos__item :global(img),
  .photos__video video {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    transition: transform var(--t-med) var(--ease);
  }
  .photos__video {
    position: relative;
    display: block;
  }
  .photos__video video {
    background: #000;
  }
  .photos__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 42px;
    text-shadow: 0 2px 10px rgb(0 0 0 / 0.6);
  }
  .photos__item a:hover :global(img),
  .photos__item a:focus-visible :global(img),
  .photos__item a:hover video,
  .photos__item a:focus-visible video {
    transform: scale(1.05);
  }
  .photos__caption {
    margin: 0;
    padding: 10px 14px;
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .photos__empty {
    font-size: var(--fs-body);
    font-weight: 700;
  }
  .photos__more {
    margin: 28px 0 0;
    text-align: center;
  }
  .photos__caption span {
    font-weight: 400;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .photos__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .photos__grid {
      grid-template-columns: 1fr;
    }
  }
  .photos__stack {
    position: relative;
    display: block;
  }
  /* an album: its pictures stacked like prints on a table, a little apart; they fan out when pointed at */
  .photos__item--album .photos__stack {
    height: 220px;
    background: color-mix(in srgb, var(--violet) 10%, var(--surface));
  }
  .photos__item--album .photos__stack > :not(.photos__count) {
    position: absolute;
    top: 18px;
    left: 26px;
    width: calc(100% - 52px);
    height: calc(100% - 34px);
    overflow: hidden;
    border: 3px solid #fff;
    border-radius: 10px;
    object-fit: cover;
    box-shadow: 0 3px 10px rgb(0 0 0 / 0.3);
    transition: rotate var(--t-med) var(--ease), translate var(--t-med) var(--ease);
  }
  .photos__item--album .photos__stack > .photos__video video {
    width: 100%;
    height: 100%;
  }
  .photos__item--album .photos__stack > :nth-last-child(4) {
    rotate: -8deg;
    translate: -10px 2px;
  }
  .photos__item--album .photos__stack > :nth-last-child(3) {
    rotate: 6deg;
    translate: 10px 0;
  }
  .photos__item--album .photos__stack > :nth-last-child(2) {
    rotate: -1.5deg;
  }
  .photos__item--album a:hover .photos__stack > :nth-last-child(4) {
    rotate: -14deg;
    translate: -26px 4px;
  }
  .photos__item--album a:hover .photos__stack > :nth-last-child(3) {
    rotate: 12deg;
    translate: 26px 2px;
  }
  .photos__item--album a:hover :global(img),
  .photos__item--album a:hover video {
    transform: none;
  }
  .photos__count {
    position: absolute;
    right: 10px;
    bottom: 8px;
    z-index: 1;
    padding: 3px 10px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--yellow);
    color: var(--ink);
    font-size: 13px;
    font-weight: 800;
  }
</style>
