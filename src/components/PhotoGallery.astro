---
/**
 * Photos: every image uploaded into src/assets/photos (developer mode → "Upload a photo" on GitHub).
 * The caption comes from the file name ("Bali-rizsteraszok.jpg" → "Bali rizsteraszok"); a yml file in
 * src/content/photos can still give a photo a caption, place and date. Newest first; the section is left
 * out completely while there are no photos.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
type Photo = { data: { image: ImageMetadata; caption: string; place?: string; date?: Date } };
const described: Photo[] = (await getCollection('photos')).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
const files = import.meta.glob<ImageMetadata>('../assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}', { eager: true, import: 'default' });
const usedSrc = new Set(described.map((p) => p.data.image.src));
const fromFolder: Photo[] = Object.entries(files)
  .filter(([, img]) => !usedSrc.has(img.src))
  .sort(([a], [b]) => b.localeCompare(a))
  .map(([path, image]) => ({
    data: {
      image,
      caption: path.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ').trim(),
    },
  }));
const photos = [...described, ...fromFolder];
---

{
  photos.length > 0 && (
    <section class="section photos" id="photos" aria-labelledby="photos-title">
      <div class="container">
        <SectionHeading icon="camera" id="photos-title">
          {t(lang, 'photos.title')}
        </SectionHeading>
        <ul class="photos__grid">
          {photos.map((p) => (
            <li class="photos__item reveal">
              <a href={p.data.image.src} target="_blank" rel="noopener">
                <Image src={p.data.image} alt={p.data.caption} widths={[320, 640]} sizes="(max-width: 600px) 100vw, 320px" loading="lazy" />
              </a>
              <p class="photos__caption">
                {p.data.caption}
                {p.data.place && <span> · {p.data.place}</span>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .photos__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .photos__item {
    margin: 0;
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-yellow);
  }
  .photos__item:nth-child(even) {
    box-shadow: var(--shadow-violet);
  }
  .photos__item :global(img) {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    transition: transform var(--t-med) var(--ease);
  }
  .photos__item a:hover :global(img),
  .photos__item a:focus-visible :global(img) {
    transform: scale(1.05);
  }
  .photos__caption {
    margin: 0;
    padding: 10px 14px;
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .photos__caption span {
    font-weight: 400;
    color: var(--muted);
  }
</style>
