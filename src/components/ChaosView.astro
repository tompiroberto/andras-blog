---
/**
 * The "Chaos" theme: the website disappears (see the :root[data-theme='chaos'] rules in global.css)
 * and only a full-screen, fully zoomed-out world map is left – loud colours, tilted city names,
 * no scrolling. A search bar zooms in on a city and shows facts about it (FactCard).
 */
import Icon from './Icon.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { t, type Lang, type TKey } from '../i18n';
import continentCities from '../data/continent-cities.json';
import worldCities from '../data/world-cities.json';
import { continentOf } from '../lib/continents';
import { jarSvg } from '../lib/jar';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** Continents for the zoom menu: bounding boxes in degrees (west, south, east, north). */
const CONTINENTS = [
  { id: 'northAmerica', key: 'continent.northAmerica', box: [-168, 7, -52, 72], color: '#ff6b00' },
  { id: 'southAmerica', key: 'continent.southAmerica', box: [-82, -56, -34, 13], color: '#c6ff00' },
  { id: 'europe', key: 'continent.europe', box: [-25, 34, 45, 71], color: '#00f0ff' },
  { id: 'africa', key: 'continent.africa', box: [-18, -35, 52, 38], color: '#ffe600' },
  { id: 'asia', key: 'continent.asia', box: [26, -11, 150, 72], color: '#ff00c8' },
  { id: 'oceania', key: 'continent.oceania', box: [110, -48, 180, -1], color: '#ffffff' },
] as const;

/** Continent of every always-visible city, so a continent view can hide all the others. */
const baseContinents = Object.fromEntries(worldCities.cities.map((c) => [c.name, continentOf(c.name, c.lat, c.lon)]));

/** A clean, not-to-scale solar system: orbit radius, planet size, colour, seconds per orbit. */
const PLANETS = [
  { id: 'mercury', r: 17, size: 2.2, color: '#b8b8b8', period: 9 },
  { id: 'venus', r: 25, size: 3.3, color: '#e8c07a', period: 15 },
  { id: 'earth', r: 34, size: 3.6, color: '#3a8dde', period: 22 },
  { id: 'mars', r: 43, size: 2.8, color: '#d9553a', period: 32 },
  { id: 'jupiter', r: 55, size: 7, color: '#d8a86a', period: 50 },
  { id: 'saturn', r: 67, size: 5.6, color: '#e6cf8f', period: 66, ring: true },
  { id: 'uranus', r: 78, size: 4.4, color: '#8fd8e0', period: 82 },
  { id: 'neptune', r: 88, size: 4.2, color: '#4a6fe0', period: 98 },
] as const;
const planetStart = (i: number) => (i * 137) % 360; // spread the planets around their orbits
---


<div class="chaos-view" data-chaos-view data-lang={lang} data-base-continents={JSON.stringify(baseContinents)}>
  <div class="chaos-bg" aria-hidden="true"></div>

  <svg class="chaos-map" viewBox="0 0 360 180" preserveAspectRatio="xMidYMid meet" role="img" aria-label={t(lang, 'chaos.map')} data-chaos-map>
    <defs>
      <pattern id="chaos-stripes" patternUnits="userSpaceOnUse" width="4" height="4" patternTransform="rotate(35)">
        <rect width="4" height="4" fill="#1B0033" />
        <rect width="2" height="4" fill="#2B0052" />
      </pattern>
    </defs>
    <rect class="chaos-ocean" x="0" y="0" width="360" height="180" fill="url(#chaos-stripes)" />
    <g class="chaos-graticule" aria-hidden="true">
      {[30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330].map((x) => <line x1={x} y1="0" x2={x} y2="180" />)}
      {[30, 60, 90, 120, 150].map((y) => <line x1="0" y1={y} x2="360" y2={y} />)}
    </g>
    <g class="chaos-land-glitch" data-chaos-land-glitch aria-hidden="true"></g>
    <g class="chaos-land" data-chaos-land aria-hidden="true"></g>
    <g data-chaos-cities></g>
    <g class="chaos-pin" data-chaos-pin>
      <path d="M0 0C0 0 -4 -5 -4 -8.3a4 4 0 1 1 8 0c0 3.3-4 8.3-4 8.3Z" />
      <circle cx="0" cy="-8.3" r="1.6" />
    </g>
  </svg>

  <!-- the solar system (instead of the map) -->
  <div class="chaos-solar" hidden data-chaos-solar>
    <svg class="chaos-solar__svg" viewBox="-100 -100 200 200" role="img" aria-label={t(lang, 'solar.title')}>
      <g class="solar-stars" data-solar-stars aria-hidden="true"></g>
      <defs>
        <radialGradient id="solar-glow">
          <stop offset="0.45" stop-color="#ffd23f" stop-opacity="0.9" />
          <stop offset="1" stop-color="#ff9f1c" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle class="solar-sun-glow" r="17" fill="url(#solar-glow)" />
      <circle class="solar-sun" r="9.5" />
      <text class="solar-label solar-label--sun" y="15">{t(lang, 'solar.sun')}</text>
      {
        PLANETS.map((pl, i) => (
          <>
            <circle class="solar-orbit" r={pl.r} />
            <g class="solar-spin" style={`--period:${pl.period}s;--start:${planetStart(i)}deg`}>
              <g transform={`translate(${pl.r} 0)`}>
                <g class="solar-counter" style={`--period:${pl.period}s;--start:${planetStart(i)}deg`}>
                  <g class:list={['solar-planet', { 'is-earth': pl.id === 'earth' }]} data-planet={pl.id}>
                    {pl.id === 'earth' && <title>{t(lang, 'solar.back')}</title>}
                    {'ring' in pl && pl.ring && <ellipse class="solar-ring" rx={pl.size * 2} ry={pl.size * 0.62} />}
                    <circle r={pl.size} fill={pl.color} />
                    <text class="solar-label" y={pl.size + 4.6}>
                      {t(lang, `solar.${pl.id}` as TKey)}
                    </text>
                  </g>
                </g>
              </g>
            </g>
          </>
        ))
      }
      <!-- a jar of chocolate spread orbiting in the asteroid belt -->
      <circle class="solar-orbit solar-orbit--jar" r="49" />
      <g class="solar-spin" style="--period:40s;--start:200deg">
        <g transform="translate(49 0)">
          <g class="solar-counter" style="--period:40s;--start:200deg">
            <g class="solar-planet solar-jar" data-solar-jar data-solar-name="Nutella">
              <g class="solar-jar__wobble">
                <svg x="-4.6" y="-5.6" width="9.2" height="11.2" viewBox="0 0 46 56" set:html={jarSvg().replace(/^<svg[^>]*>|<\/svg>$/g, '')} />
              </g>
              <text class="solar-label" y="10">Nutella</text>
            </g>
          </g>
        </g>
      </g>
    </svg>
    <div class="chaos-ufos" data-chaos-ufos aria-hidden="true"></div>
  </div>

  <template data-ufo-template>
    <svg class="ufo" viewBox="0 0 165 110" width="165" height="110">
      <g class="ufo__bubble">
        <path d="M96 6h58a6 6 0 0 1 6 6v14a6 6 0 0 1-6 6h-38l-8 8 1-8h-13a6 6 0 0 1-6-6V12a6 6 0 0 1 6-6Z" />
        <text x="125" y="24">nom nom!</text>
      </g>
      <ellipse class="ufo__glass" cx="60" cy="50" rx="24" ry="26" />
      <g class="ufo__alien">
        <path d="M52 30l-5-9M68 30l5-9" />
        <circle cx="47" cy="20" r="2.6" />
        <circle cx="73" cy="20" r="2.6" />
        <ellipse cx="60" cy="44" rx="12" ry="14" />
        <ellipse class="ufo__eye" cx="55" cy="41" rx="3.4" ry="4.6" />
        <ellipse class="ufo__eye" cx="65" cy="41" rx="3.4" ry="4.6" />
        <path class="ufo__mouth" d="M56 51q4 4 8 0" />
      </g>
      <g class="ufo__food ufo__food--pizza">
        <path d="M70 46l20-9-2 16z" class="ufo__crust" />
        <path d="M72 46l16-7-1.7 12.5z" class="ufo__cheese" />
        <circle cx="80" cy="44" r="1.8" class="ufo__pep" />
        <circle cx="84.5" cy="48" r="1.5" class="ufo__pep" />
      </g>
      <g class="ufo__food ufo__food--jar">
        <rect x="70" y="36" width="15" height="17" rx="3" class="ufo__jar" />
        <rect x="69" y="32" width="17" height="5" rx="1.5" class="ufo__lid" />
        <rect x="71" y="41" width="13" height="6" rx="1" class="ufo__label" />
        <path d="M76 44h3" class="ufo__label-line" />
      </g>
      <ellipse class="ufo__saucer" cx="60" cy="68" rx="56" ry="15" />
      <ellipse class="ufo__belly" cx="60" cy="74" rx="30" ry="7" />
      <circle class="ufo__light" cx="22" cy="69" r="3.2" />
      <circle class="ufo__light" cx="41" cy="73" r="3.2" />
      <circle class="ufo__light" cx="60" cy="75" r="3.2" />
      <circle class="ufo__light" cx="79" cy="73" r="3.2" />
      <circle class="ufo__light" cx="98" cy="69" r="3.2" />
    </svg>
  </template>

  <!-- left: back to the website, city search -->
  <div class="chaos-rail chaos-rail--left">
    <button type="button" class="chaos-icon chaos-back" data-chaos-exit>
      <Icon name="arrow-left" size={18} />
      <span>{t(lang, 'chaos.exit')}</span>
    </button>
    <div class="chaos-search-wrap">
      <button
        type="button"
        class="chaos-icon"
        aria-expanded="false"
        aria-controls="chaos-search"
        aria-label={t(lang, 'search.label')}
        title={t(lang, 'search.label')}
        data-chaos-search-toggle
      >
        <Icon name="search" size={18} />
      </button>
      <form class="chaos-search" id="chaos-search" role="search" hidden data-chaos-form>
        <label class="visually-hidden" for="chaos-search-input">{t(lang, 'search.label')}</label>
        <input id="chaos-search-input" type="search" autocomplete="off" required maxlength="80" placeholder={t(lang, 'search.placeholder')} data-chaos-input />
        <button type="submit" class="chaos-icon chaos-icon--go" aria-label={t(lang, 'search.go')} title={t(lang, 'search.go')} data-chaos-go>
          <Icon name="arrow-right" size={18} />
        </button>
      </form>
    </div>
  </div>

  <!-- right: whole world + continents, colour theme -->
  <div class="chaos-rail chaos-rail--right">
    <button
      type="button"
      class="chaos-icon"
      aria-expanded="false"
      aria-controls="chaos-continents"
      aria-label={t(lang, 'chaos.zoomOut')}
      title={t(lang, 'chaos.zoomOut')}
      data-chaos-world
    >
      <Icon name="globe" size={18} />
    </button>
    <ul class="chaos-continents" id="chaos-continents" hidden data-chaos-continents>
      {
        CONTINENTS.map((c) => (
          <li>
            <button type="button" data-continent-btn={c.id} data-box={c.box.join(',')} aria-pressed="false">
              <span class="chaos-continents__dot" style={`background:${c.color}`} aria-hidden="true" />
              {t(lang, c.key as TKey)}
            </button>
          </li>
        ))
      }
      <li class="chaos-continents__sep" aria-hidden="true"></li>
      <li>
        <button type="button" data-solar-btn aria-pressed="false">
          <span class="chaos-continents__dot chaos-continents__dot--sun" aria-hidden="true" />
          {t(lang, 'solar.title')}
        </button>
      </li>
    </ul>
    <ThemeSwitch lang={lang} uid="chaos" />
  </div>

  <p class="chaos-status" role="status" aria-live="polite" data-chaos-status>{t(lang, 'chaos.hint')}</p>

  <script type="application/json" data-chaos-extra-data set:html={JSON.stringify(continentCities)} />
  <template data-chaos-msg-searching>{t(lang, 'search.searching')}</template>
  <template data-chaos-msg-none>{t(lang, 'search.none')}</template>
  <template data-chaos-msg-error>{t(lang, 'search.error')}</template>
  <template data-chaos-msg-hint>{t(lang, 'chaos.hint')}</template>
</div>

<style>
  .chaos-view {
    display: none;
    position: fixed;
    /* never affected by the page zoom slider: undo it completely */
    zoom: var(--inv-zoom, 1);
    inset: 0;
    z-index: 600;
    overflow: hidden;
    color: #fff;
    font-family: 'Unbounded', 'Noto Sans Georgian', 'Noto Sans', system-ui, sans-serif;
  }
  :global(:root[data-theme='chaos']) .chaos-view {
    display: block;
  }

  /* loud, shifting background */
  .chaos-bg {
    position: absolute;
    inset: -20%;
    background:
      repeating-conic-gradient(from 0deg at 30% 40%, #ff00c8 0 12deg, #00f0ff 12deg 24deg, #c6ff00 24deg 36deg, #ff6b00 36deg 48deg, #7b2ff7 48deg 60deg);
    filter: saturate(1.4);
    animation: chaos-hue 9s linear infinite, chaos-spin 60s linear infinite;
  }
  @keyframes chaos-hue {
    to {
      filter: saturate(1.4) hue-rotate(360deg);
    }
  }
  @keyframes chaos-spin {
    to {
      transform: rotate(360deg) scale(1.1);
    }
  }

  .chaos-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: manipulation;
  }
  .chaos-ocean {
    stroke: #c6ff00;
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }
  .chaos-graticule line {
    stroke: #00f0ff;
    stroke-width: 1;
    stroke-dasharray: 6 5;
    opacity: 0.6;
    vector-effect: non-scaling-stroke;
  }
  .chaos-land :global(path) {
    fill: #c6ff00;
    stroke: #ff00c8;
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .chaos-land-glitch :global(path) {
    fill: #00f0ff;
    opacity: 0.75;
    animation: chaos-glitch 1.7s steps(2, jump-none) infinite;
  }
  @keyframes chaos-glitch {
    0% {
      transform: translate(0.8px, 0.5px);
    }
    50% {
      transform: translate(-0.9px, -0.4px);
    }
    100% {
      transform: translate(0.5px, -0.7px);
    }
  }

  .chaos-map :global([data-chaos-city]) {
    cursor: pointer;
  }
  .chaos-map :global([data-chaos-city].is-crowded) {
    visibility: hidden;
  }
  .chaos-map :global([data-chaos-city] circle) {
    /* dots shrink back as the map zooms in, like the labels (the r attribute is the fallback) */
    r: calc(var(--r, 1) * var(--inv, 1) * 1px);
    stroke: #1b0033;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .chaos-map :global([data-chaos-city] text) {
    font-family: 'Unbounded', 'DM Sans', sans-serif;
    font-weight: 800;
    font-size: calc(var(--fs) * var(--inv, 1) * 1px);
    paint-order: stroke;
    stroke: #1b0033;
    stroke-width: 3px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .chaos-map :global([data-chaos-city]:hover text) {
    fill: #fff !important;
  }
  .chaos-pin:not(.is-on) {
    display: none;
  }
  .chaos-pin path {
    fill: #ff00c8;
    stroke: #1b0033;
    stroke-width: 2.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .chaos-pin circle {
    fill: #c6ff00;
    stroke: #1b0033;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  /* ---- side rails with small icon buttons ---- */
  .chaos-rail {
    position: absolute;
    top: 16px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .chaos-rail--left {
    left: 16px;
    align-items: flex-start;
  }
  .chaos-rail--right {
    right: 16px;
    align-items: flex-end;
  }
  .chaos-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: var(--touch);
    min-height: var(--touch);
    padding: 0 12px;
    border: 3px solid #1b0033;
    border-radius: 14px 6px 14px 6px;
    background: #c6ff00;
    color: #1b0033;
    font-family: 'DM Sans', 'Noto Sans', 'Noto Sans Georgian', sans-serif;
    font-weight: 800;
    font-size: 14px;
    box-shadow: 3px 3px 0 #1b0033;
    transition: transform var(--t-fast);
  }
  .chaos-icon:hover {
    transform: rotate(-4deg) scale(1.06);
  }
  .chaos-icon[aria-expanded='true'] {
    background: #ff00c8;
    color: #fff;
  }
  .chaos-back {
    background: #fff;
    box-shadow: 3px 3px 0 #ff00c8;
  }
  .chaos-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .chaos-search {
    display: flex;
    gap: 6px;
  }
  .chaos-search input {
    width: min(320px, calc(100vw - 150px));
    min-height: var(--touch);
    padding: 8px 14px;
    border: 3px solid #1b0033;
    border-radius: 12px 4px 14px 6px;
    background: #fff;
    color: #141a33;
    font-family: 'DM Sans', 'Noto Sans', 'Noto Sans Georgian', sans-serif;
    font-size: 16px;
    font-weight: 700;
    box-shadow: 4px 4px 0 #ff00c8;
  }
  .chaos-icon--go {
    background: #ff00c8;
    color: #fff;
  }
  .chaos-continents {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chaos-continents button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 38px;
    padding: 4px 12px;
    border: 2px solid #1b0033;
    border-radius: 999px;
    background: #1b0033;
    color: #fff;
    font-family: 'DM Sans', 'Noto Sans', 'Noto Sans Georgian', sans-serif;
    font-weight: 700;
    font-size: 13px;
    white-space: nowrap;
  }
  .chaos-continents button:hover,
  .chaos-continents button[aria-pressed='true'] {
    background: #fff;
    color: #1b0033;
  }
  .chaos-continents__dot {
    width: 12px;
    height: 12px;
    flex: none;
    border-radius: 50%;
    border: 2px solid #1b0033;
    box-shadow: 0 0 0 1.5px #fff;
  }
  .chaos-status {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    z-index: 2;
    max-width: calc(100% - 32px);
    margin: 0;
    padding: 5px 12px;
    border-radius: 999px;
    background: #1b0033;
    color: #fff;
    font-family: 'DM Sans', 'Noto Sans', 'Noto Sans Georgian', sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-align: center;
  }
  .chaos-view :global(.theme-switch__btn) {
    border-width: 3px;
    border-color: #1b0033;
    box-shadow: 3px 3px 0 #1b0033;
  }

  .chaos-continents__sep {
    height: 2px;
    margin: 2px 8px;
    background: #1b0033;
    border-radius: 2px;
  }
  .chaos-continents__dot--sun {
    background: radial-gradient(circle, #fff6b0, #ffc400 60%, #ff7a00);
  }

  /* ---- solar system ---- */
  .chaos-bg,
  .chaos-map {
    transition:
      opacity 700ms ease,
      transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .chaos-view.is-space .chaos-bg,
  .chaos-view.is-space .chaos-map {
    opacity: 0;
    transform: scale(0.2) rotate(40deg);
    pointer-events: none;
  }
  .chaos-solar {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(ellipse at 50% 50%, #151a45 0%, #070920 60%, #02030d 100%);
    animation: solar-in 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    overflow: hidden;
  }
  @keyframes solar-in {
    from {
      opacity: 0;
      transform: scale(1.6);
    }
  }
  .chaos-solar__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .chaos-solar :global(.solar-star) {
    fill: #fff;
    animation: solar-twinkle 3s ease-in-out infinite alternate;
  }
  @keyframes solar-twinkle {
    from {
      opacity: 0.25;
    }
    to {
      opacity: 0.9;
    }
  }
  .solar-sun-glow {
    opacity: 0.7;
    animation: solar-pulse 4s ease-in-out infinite alternate;
    transform-origin: 0 0;
  }
  @keyframes solar-pulse {
    to {
      transform: scale(1.2);
      opacity: 0.4;
    }
  }
  .solar-sun {
    fill: #ffd23f;
    stroke: #ff9f1c;
    stroke-width: 1.2;
  }
  .solar-orbit {
    fill: none;
    stroke: rgb(255 255 255 / 0.16);
    stroke-width: 0.35;
  }
  .solar-spin {
    transform-origin: 0 0;
    animation: solar-orbit var(--period) linear infinite;
  }
  .solar-counter {
    transform-origin: 0 0;
    animation: solar-counter var(--period) linear infinite;
  }
  @keyframes solar-orbit {
    from {
      transform: rotate(var(--start));
    }
    to {
      transform: rotate(calc(var(--start) + 360deg));
    }
  }
  @keyframes solar-counter {
    from {
      transform: rotate(calc(var(--start) * -1));
    }
    to {
      transform: rotate(calc(var(--start) * -1 - 360deg));
    }
  }
  .solar-ring {
    fill: none;
    stroke: #f3e3b3;
    stroke-width: 0.9;
  }
  .solar-planet circle {
    stroke: rgb(0 0 0 / 0.35);
    stroke-width: 0.4;
  }
  .solar-planet,
  .solar-sun {
    cursor: pointer;
  }
  .solar-planet:hover circle,
  .solar-sun:hover {
    stroke: #fff;
    stroke-width: 0.8;
  }
  .solar-orbit--jar {
    stroke-dasharray: 1 2;
  }
  .solar-jar__wobble {
    animation: jar-float 3s ease-in-out infinite alternate;
  }
  @keyframes jar-float {
    from {
      transform: rotate(-14deg);
    }
    to {
      transform: rotate(14deg);
    }
  }
  .solar-planet.is-earth:hover circle {
    stroke: #fff;
