  .chaos-ufos :global(.ufo.eats-pizza .ufo__food--jar),
  .chaos-ufos :global(.ufo.eats-jar .ufo__food--pizza) {
    display: none;
  }
  .chaos-ufos :global(.ufo__food) {
    animation: ufo-bite 0.7s ease-in-out infinite alternate;
    transform-box: fill-box;
