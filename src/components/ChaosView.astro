  .chaos-ufos :global(.ufo__bubble text) {
    fill: #1b0033;
    font-family: 'DM Sans', sans-serif;
    font-weight: 800;
    font-size: 11px;
    text-anchor: middle;
  }

  /* zoomed onto a continent: every city outside it is hidden */
  .chaos-map :global([data-focus='northAmerica'] [data-chaos-city]:not([data-continent='northAmerica'])),
  .chaos-map :global([data-focus='southAmerica'] [data-chaos-city]:not([data-continent='southAmerica'])),
  .chaos-map :global([data-focus='europe'] [data-chaos-city]:not([data-continent='europe'])),
  .chaos-map :global([data-focus='africa'] [data-chaos-city]:not([data-continent='africa'])),
  .chaos-map :global([data-focus='asia'] [data-chaos-city]:not([data-continent='asia'])),
  .chaos-map :global([data-focus='oceania'] [data-chaos-city]:not([data-continent='oceania'])) {
    display: none;
