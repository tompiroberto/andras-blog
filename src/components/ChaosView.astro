  .chaos-map :global(.chaos-extra.is-shown) {
    display: inline;
  }
  .chaos-map :global(.chaos-extra.is-shown [data-chaos-city]) {
    animation: chaos-city-pop 450ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: var(--pop, 0ms);
    transform-box: fill-box;
    transform-origin: center;
  }

  /* ---- Entrance, right after the page has fallen apart (class set by the script) ---- */
  .chaos-view.is-entering .chaos-bg {
    animation:
      chaos-burst 900ms cubic-bezier(0.2, 0.9, 0.3, 1) both,
      chaos-hue 9s linear infinite,
      chaos-spin 60s linear infinite;
  }
  @keyframes chaos-burst {
    from {
      clip-path: circle(0% at 50% 50%);
    }
    to {
      clip-path: circle(75% at 50% 50%);
    }
  }
  .chaos-view.is-entering .chaos-map {
    animation: chaos-map-in 1000ms cubic-bezier(0.34, 1.56, 0.64, 1) 150ms both;
  }
  @keyframes chaos-map-in {
    from {
      opacity: 0;
      transform: scale(0.55) rotate(-8deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .chaos-view.is-entering :global([data-chaos-city]) {
    animation: chaos-city-pop 450ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: var(--pop, 600ms);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes chaos-city-pop {
    from {
      opacity: 0;
      scale: 0;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  .chaos-view.is-entering .chaos-rail,
  .chaos-view.is-entering .chaos-status {
    animation: chaos-drop 700ms cubic-bezier(0.34, 1.56, 0.64, 1) 700ms both;
  }
  @keyframes chaos-drop {
    from {
      opacity: 0;
      translate: 0 -120px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (max-width: 599px) {
    .chaos-back span {
      display: none;
    }
    .chaos-rail {
      top: 10px;
    }
    .chaos-rail--left {
      left: 10px;
    }
    .chaos-rail--right {
      right: 10px;
    }
  }
</style>

<script>
  import { FACTS_EVENT, PLACE_MESSAGE_EVENT, THEME_EVENT, type SearchTarget } from '../lib/constants';
  import { geocode } from '../lib/geocode';
  import { jarSvg } from '../lib/jar';

  type City = [name: string, lat: number, lon: number, rank?: number];
  type Box = { x: number; y: number; w: number; h: number };
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const COLORS = ['#c6ff00', '#ff00c8', '#00f0ff', '#ff6b00', '#ffffff', '#ffe600'];
  const ZOOM = 3.4; // how far a city search zooms in
  const WORLD: Box = { x: 0, y: 0, w: 360, h: 180 };

  const view = document.querySelector<HTMLElement>('[data-chaos-view]');
  if (view) setup(view);

  function setup(view: HTMLElement) {
    const html = document.documentElement;
    const map = view.querySelector<SVGSVGElement>('[data-chaos-map]')!;
    const land = view.querySelector<SVGGElement>('[data-chaos-land]')!;
    const glitch = view.querySelector<SVGGElement>('[data-chaos-land-glitch]')!;
    const citiesG = view.querySelector<SVGGElement>('[data-chaos-cities]')!;
    const pin = view.querySelector<SVGGElement>('[data-chaos-pin]')!;
    const form = view.querySelector<HTMLFormElement>('[data-chaos-form]')!;
    const input = view.querySelector<HTMLInputElement>('[data-chaos-input]')!;
    const go = view.querySelector<HTMLButtonElement>('[data-chaos-go]')!;
    const searchToggle = view.querySelector<HTMLButtonElement>('[data-chaos-search-toggle]')!;
    const worldBtn = view.querySelector<HTMLButtonElement>('[data-chaos-world]')!;
    const continentList = view.querySelector<HTMLElement>('[data-chaos-continents]')!;
    const continentBtns = Array.from(continentList.querySelectorAll<HTMLButtonElement>('[data-continent-btn]'));
    const solarBtn = continentList.querySelector<HTMLButtonElement>('[data-solar-btn]')!;
    const solar = view.querySelector<HTMLElement>('[data-chaos-solar]')!;
    const ufoBox = view.querySelector<HTMLElement>('[data-chaos-ufos]')!;
    const ufoTemplate = view.querySelector<HTMLTemplateElement>('[data-ufo-template]')!;
    const baseContinents: Record<string, string | null> = JSON.parse(view.dataset.baseContinents || '{}');
    const status = view.querySelector<HTMLElement>('[data-chaos-status]')!;
    const msg = (n: string) => view.querySelector<HTMLTemplateElement>(`[data-chaos-msg-${n}]`)!.content.textContent ?? '';
    const lang = view.dataset.lang ?? 'en';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const extraGroups = new Map<string, SVGGElement>();
    let ready = false;
    let box = { ...WORLD };
    let frame = 0;

    const isChaos = () => html.dataset.theme === 'chaos';
    const toXY = (lat: number, lon: number) => ({ x: lon + 180, y: 90 - lat });
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    const setBox = (b: Box) => {
      box = b;
      map.setAttribute('viewBox', `${b.x} ${b.y} ${b.w} ${b.h}`);
      // labels and the pin grow only gently while zooming in
      map.style.setProperty('--inv', String(Math.sqrt(b.w / WORLD.w)));
      window.clearTimeout(declutterTimer);
      declutterTimer = window.setTimeout(declutter, 140);
    };
    /** No city name covers another, and the names are spread evenly: the screen is a grid with at most
     *  one city per cell (the bigger names win); the rest wait until you zoom in closer. */
    let declutterTimer = 0;
    function declutter() {
      const groups = Array.from(citiesG.querySelectorAll<SVGGElement>('[data-chaos-city]'));
      groups.forEach((g) => g.classList.remove('is-crowded'));
      const items = groups
        .map((g) => ({ g, r: g.getBoundingClientRect(), fs: Number(g.querySelector('text')?.style.getPropertyValue('--fs')) || 0 }))
        .filter((it) => it.r.width > 0 && it.r.height > 0)
        .sort((a, b) => b.fs - a.fs);
      const kept: DOMRect[] = [];
      const GAP = 22;
      const area = map.getBoundingClientRect();
      const cols = Math.max(3, Math.round(area.width / 260));
      const rows = Math.max(2, Math.round(area.height / 170));
      const taken = new Set<string>();
      for (const it of items) {
        const cx = (it.r.left + it.r.width / 2 - area.left) / area.width;
        const cy = (it.r.top + it.r.height / 2 - area.top) / area.height;
        const cell = `${Math.floor(cx * cols)}:${Math.floor(cy * rows)}`;
        const hit = taken.has(cell) || kept.some((k) => it.r.left < k.right + GAP && it.r.right > k.left - GAP && it.r.top < k.bottom + GAP && it.r.bottom > k.top - GAP);
        if (hit) it.g.classList.add('is-crowded');
        else {
          kept.push(it.r);
          taken.add(cell);
        }
      }
    }
    function animateTo(target: Box, duration = 900): Promise<void> {
      cancelAnimationFrame(frame);
      if (reduced.matches) {
        setBox(target);
        return Promise.resolve();
      }
      const from = { ...box };
      const t0 = performance.now();
      return new Promise((resolve) => {
        const step = (now: number) => {
          const p = Math.min(1, (now - t0) / duration);
          const e = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
          setBox({
            x: from.x + (target.x - from.x) * e,
            y: from.y + (target.y - from.y) * e,
            w: from.w + (target.w - from.w) * e,
            h: from.h + (target.h - from.h) * e,
          });
          if (p < 1) frame = requestAnimationFrame(step);
          else resolve();
        };
        frame = requestAnimationFrame(step);
      });
    }
    /** A view box around a region, widened to the screen's shape so the map fills the screen. */
    function fitBox(west: number, south: number, east: number, north: number): Box {
      const pad = 0.08;
      let w = (east - west) * (1 + 2 * pad);
      let h = (north - south) * (1 + 2 * pad);
      const cx = (west + east) / 2 + 180;
      const cy = 90 - (south + north) / 2;
      const screen = map.clientWidth / Math.max(1, map.clientHeight);
      if (w / h < screen) w = h * screen;
      else h = w / screen;
      return { x: cx - w / 2, y: cy - h / 2, w, h };
    }

    function cityGroup(name: string, lat: number, lon: number, size: number, dotR: number, pop: number, continent?: string | null): SVGGElement {
      const { x, y } = toXY(lat, lon);
      const g = document.createElementNS(SVG_NS, 'g');
      g.setAttribute('data-chaos-city', '');
      if (continent) g.setAttribute('data-continent', continent);
      g.setAttribute('transform', `translate(${x} ${y}) rotate(${rand(-7, 7).toFixed(1)})`);
      g.style.setProperty('--pop', `${Math.round(pop)}ms`);
      const color = COLORS[Math.floor(Math.random() * COLORS.length)];
      const dot = document.createElementNS(SVG_NS, 'circle');
      dot.setAttribute('r', String(dotR));
      dot.style.setProperty('--r', String(dotR));
      dot.setAttribute('fill', color);
      const label = document.createElementNS(SVG_NS, 'text');
      label.setAttribute('x', '1.8');
      label.setAttribute('y', '0.9');
      label.setAttribute('fill', color);
      label.style.setProperty('--fs', size.toFixed(2));
      label.textContent = name;
      const titleEl = document.createElementNS(SVG_NS, 'title');
      titleEl.textContent = name;
      g.append(titleEl, dot, label);
      g.addEventListener('click', () => {
        showPin(lat, lon);
        window.dispatchEvent(new CustomEvent(FACTS_EVENT, { detail: { name, lat, lon } }));
      });
      return g;
    }

    async function init() {
      if (ready) return;
      ready = true;
      // continents (same outline file as the page background)
      try {
        const svg = await (await fetch('/world-land.svg')).text();
        const d = new DOMParser().parseFromString(svg, 'image/svg+xml').querySelector('path')?.getAttribute('d');
        if (d) {
          for (const g of [glitch, land]) {
            const p = document.createElementNS(SVG_NS, 'path');
            p.setAttribute('d', d);
            g.replaceChildren(p);
          }
        }
      } catch (err) {
        console.error('[chaos] land', err);
      }
      // the always-visible cities, tilted and coloured at random
      const base: City[] = JSON.parse(document.querySelector('[data-world-data]')?.textContent || '[]');
      const baseNames = new Set(base.map((c) => c[0]));
      citiesG.replaceChildren(
        ...base.map(([name, lat, lon, rank]) =>
          cityGroup(name, lat, lon, rank === 1 ? rand(2.6, 3.6) : rand(1.8, 2.6), rank === 1 ? 1.3 : 0.9, 600 + Math.random() * 900, baseContinents[name]),
        ),
      );
      // more cities per continent, shown when the map is zoomed onto it
      const extra: Record<string, City[]> = JSON.parse(view.querySelector('[data-chaos-extra-data]')?.textContent || '{}');
      for (const [continent, list] of Object.entries(extra)) {
        if (!Array.isArray(list)) continue; // skip the _comment entry
        const g = document.createElementNS(SVG_NS, 'g');
        g.classList.add('chaos-extra');
        g.append(
          ...list
            .filter(([name]) => !baseNames.has(name))
            .map(([name, lat, lon]) => cityGroup(name, lat, lon, rand(1.5, 2.1), 0.7, Math.random() * 700, continent)),
        );
        citiesG.append(g);
        extraGroups.set(continent, g);
      }
      setBox({ ...WORLD });
    }

    function showPin(lat: number, lon: number) {
      const { x, y } = toXY(lat, lon);
      const scale = Math.sqrt(box.w / WORLD.w) * 1.2;
      pin.setAttribute('transform', `translate(${x} ${y}) scale(${scale.toFixed(3)})`);
      pin.classList.add('is-on');
    }
    const hidePin = () => pin.classList.remove('is-on');

    /** Show one continent's extra cities and hide every city outside it (null = the whole world). */
    function showContinent(id: string | null) {
      extraGroups.forEach((g, key) => g.classList.toggle('is-shown', key === id));
      if (id) citiesG.dataset.focus = id;
      else delete citiesG.dataset.focus;
      continentBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.continentBtn === id)));
    }

    // ---- solar system ----
    let ufoTimer = 0;
    const inSpace = () => view.classList.contains('is-space');
    function spawnUfo() {
      if (!inSpace()) return;
      const svg = ufoTemplate.content.firstElementChild!.cloneNode(true) as SVGSVGElement;
      svg.classList.add(Math.random() < 0.5 ? 'eats-pizza' : 'eats-jar');
      ufoBox.append(svg);
      const W = view.clientWidth;
      const H = view.clientHeight;
      const leftToRight = Math.random() < 0.5;
      const y = rand(0.08, 0.7) * H;
      const from = leftToRight ? -180 : W + 30;
      const to = leftToRight ? W + 30 : -180;
      const frames = Array.from({ length: 7 }, (_, i) => {
        const p = i / 6;
        const x = from + (to - from) * p;
        const bob = Math.sin(p * Math.PI * 3) * 36;
        const tilt = Math.sin(p * Math.PI * 4) * 7 * (leftToRight ? 1 : -1);
        return { transform: `translate(${x.toFixed(0)}px, ${(y + bob).toFixed(0)}px) rotate(${tilt.toFixed(1)}deg)` };
      });
      const flight = svg.animate(frames, { duration: rand(9000, 14000), easing: 'linear' });
      flight.finished.then(() => svg.remove(), () => undefined);
      svg.addEventListener('click', () => explode(svg, flight), { once: true });
    }
    /** Clicked UFO: its Nutella blows up – chocolate and jars everywhere. */
    function explode(svg: SVGSVGElement, flight: Animation) {
      const r = svg.getBoundingClientRect();
      const v = ufoBox.getBoundingClientRect();
      const x = r.left - v.left + r.width * 0.45;
      const y = r.top - v.top + r.height * 0.45;
      flight.pause();
      svg.animate(
        [
          { transform: getComputedStyle(svg).transform, opacity: 1 },
          { transform: `translate(${x - 82}px, ${y - 55}px) scale(1.5) rotate(25deg)`, opacity: 0 },
        ],
        { duration: 420, easing: 'ease-out', fill: 'forwards' },
      ).finished.then(() => svg.remove(), () => svg.remove());
      const bit = (cls: string, html = '') => {
        const el = document.createElement('div');
        el.className = `boom-bit ${cls}`;
        el.innerHTML = html;
        ufoBox.append(el);
        return el;
      };
      const flash = bit('boom-flash');
      flash.animate([{ transform: `translate(${x}px, ${y}px) scale(0.1)`, opacity: 1 }, { transform: `translate(${x}px, ${y}px) scale(1.6)`, opacity: 0 }], { duration: 600, easing: 'ease-out' }).finished.then(() => flash.remove());
      const word = bit('boom-word', 'NUTELLA!');
      word.animate(
        [
          { transform: `translate(${x}px, ${y}px) translate(-50%, -50%) scale(0.2) rotate(-12deg)`, opacity: 1 },
          { transform: `translate(${x}px, ${y - 60}px) translate(-50%, -50%) scale(1.3) rotate(6deg)`, opacity: 1, offset: 0.4 },
          { transform: `translate(${x}px, ${y - 90}px) translate(-50%, -50%) scale(1.1) rotate(6deg)`, opacity: 0 },
        ],
        { duration: 1300, easing: 'ease-out' },
      ).finished.then(() => word.remove());
      for (let i = 0; i < 34; i++) {
        const isJar = i % 4 === 0;
        const el = bit(isJar ? 'boom-jar' : 'boom-blob', isJar ? jarSvg() : '');
        const angle = Math.random() * Math.PI * 2;
        const dist = rand(120, 420);
        const dx = Math.cos(angle) * dist;
        const dy = Math.sin(angle) * dist;
        const s0 = isJar ? rand(0.6, 1.1) : rand(0.5, 1.6);
        const spin = rand(-720, 720);
        el.animate(
          [
            { transform: `translate(${x}px, ${y}px) scale(${s0}) rotate(0deg)`, opacity: 1 },
            { transform: `translate(${x + dx * 0.7}px, ${y + dy * 0.7 - 40}px) scale(${s0}) rotate(${spin / 2}deg)`, opacity: 1, offset: 0.5 },
            { transform: `translate(${x + dx}px, ${y + dy + 160}px) scale(${s0 * 0.8}) rotate(${spin}deg)`, opacity: 0 },
          ],
          { duration: rand(1000, 1700), easing: 'cubic-bezier(0.2, 0.7, 0.4, 1)' },
        ).finished.then(() => el.remove());
      }
    }
    function scheduleUfo(first = false) {
      window.clearTimeout(ufoTimer);
      if (!inSpace() || reduced.matches) return;
      ufoTimer = window.setTimeout(() => {
        spawnUfo();
        scheduleUfo();
      }, first ? 1600 : rand(5000, 11000));
    }
    function stars() {
      const g = view.querySelector<SVGGElement>('[data-solar-stars]')!;
      if (g.childElementCount) return;
      for (let i = 0; i < 140; i++) {
        const c = document.createElementNS(SVG_NS, 'circle');
        c.setAttribute('class', 'solar-star');
        c.setAttribute('cx', rand(-160, 160).toFixed(1));
        c.setAttribute('cy', rand(-100, 100).toFixed(1));
        c.setAttribute('r', rand(0.15, 0.55).toFixed(2));
        c.style.animationDelay = `${rand(-3, 0).toFixed(2)}s`;
        g.append(c);
      }
    }
    function showSolar() {
      stars();
      hidePin();
      showContinent(null);
      solar.hidden = false;
      view.classList.add('is-space');
      solarBtn.setAttribute('aria-pressed', 'true');
      status.textContent = solarBtn.textContent?.trim() ?? '';
      scheduleUfo(true);
    }
    function hideSolar() {
      if (!inSpace()) return;
      view.classList.remove('is-space');
      solarBtn.setAttribute('aria-pressed', 'false');
      window.clearTimeout(ufoTimer);
      ufoBox.replaceChildren();
      solar.hidden = true;
    }
    solarBtn.addEventListener('click', showSolar);
    // every other body of the solar system: "message me about it"
    view.querySelectorAll<SVGGElement>('.solar-planet:not(.is-earth), .solar-sun').forEach((body) =>
      body.addEventListener('click', () => {
        const name =
          body.dataset.solarName ?? body.querySelector('.solar-label')?.textContent?.trim() ?? view.querySelector('.solar-label--sun')?.textContent?.trim() ?? '';
        window.dispatchEvent(new CustomEvent(PLACE_MESSAGE_EVENT, { detail: { place: name } }));
      }),
    );
    view.querySelector('.solar-planet.is-earth')!.addEventListener('click', () => {
      hideSolar();
      status.textContent = msg('hint');
      animateTo({ ...WORLD });
    });

    function zoomTo(target: SearchTarget) {
      const { x, y } = toXY(target.lat, target.lon);
      const w = WORLD.w / ZOOM;
      const h = WORLD.h / ZOOM;
      const b = {
        x: Math.min(Math.max(0, x - w / 2), WORLD.w - w),
        y: Math.min(Math.max(0, y - h / 2), WORLD.h - h),
        w,
        h,
      };
      hideSolar();
      showContinent(null);
      animateTo(b).then(() => showPin(target.lat, target.lon));
    }

    // ---- search (left rail) ----
    const setSearchOpen = (open: boolean) => {
      form.hidden = !open;
      searchToggle.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
    };
    searchToggle.addEventListener('click', () => setSearchOpen(Boolean(form.hidden)));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      status.textContent = msg('searching');
      go.disabled = true;
      try {
        const list = await geocode(q, lang);
        if (!list.length) {
          status.textContent = msg('none');
          return;
        }
        const r = list[0];
        const target = { name: r.name, lat: r.latitude, lon: r.longitude };
        status.textContent = [r.name, r.admin1, r.country].filter(Boolean).join(', ');
        zoomTo(target);
        window.dispatchEvent(new CustomEvent(FACTS_EVENT, { detail: target }));
      } catch (err) {
        console.error('[chaos] search', err);
        status.textContent = msg('error');
      } finally {
        go.disabled = false;
      }
    });

    // ---- whole world + continents (right rail) ----
    const setContinentsOpen = (open: boolean) => {
      continentList.hidden = !open;
      worldBtn.setAttribute('aria-expanded', String(open));
    };
    worldBtn.addEventListener('click', () => {
      const opening = continentList.hidden;
      setContinentsOpen(Boolean(opening));
      // always back to the whole world; the list lets you pick a continent to zoom onto
      hideSolar();
      hidePin();
      showContinent(null);
      status.textContent = msg('hint');
      animateTo({ ...WORLD });
    });
    continentBtns.forEach((b) =>
      b.addEventListener('click', async () => {
        const [west, south, east, north] = (b.dataset.box ?? '').split(',').map(Number);
        hideSolar();
        hidePin();
        status.textContent = b.textContent?.trim() ?? '';
        showContinent(null);
        await animateTo(fitBox(west, south, east, north), 1100);
        showContinent(b.dataset.continentBtn ?? null); // more cities pop up once the zoom has landed
      }),
    );

    view.querySelector('[data-chaos-exit]')!.addEventListener('click', () => {
      // same as picking the default theme in the palette menu (plays the rebuild animation)
      document.querySelector<HTMLButtonElement>('[data-theme-option="violet"]')?.click();
    });
    view.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!form.hidden) setSearchOpen(false);
      if (!continentList.hidden) setContinentsOpen(false);
    });

    let wasChaos = isChaos();
    const sync = () => {
      const chaos = isChaos();
      if (chaos) {
        void init();
        if (!wasChaos && !reduced.matches) {
          // just switched in (after the page fell apart): play the entrance once
          view.classList.add('is-entering');
          window.setTimeout(() => view.classList.remove('is-entering'), 2400);
        }
      }
      if (!chaos) hideSolar();
      wasChaos = chaos;
    };
    window.addEventListener(THEME_EVENT, sync);
    if (isChaos()) void init();
  }
</script>
