---
/**
 * Developer mode → "New post": write a post on the site (title, category, language, date, short text,
 * cover photo, the text with pictures inserted) and publish it – one commit straight to GitHub
 * (src/content/posts/<slug>.md + pictures in src/assets/posts), Netlify rebuilds in about a minute.
 * Opened with window.dispatchEvent(new CustomEvent('andras:new-post', { detail: { category? } })).
 */
import Icon from './Icon.astro';
import TokenField from './TokenField.astro';
import { LOCALES, NATIVE_NAMES, t, type Lang } from '../i18n';
import { CATEGORIES } from '../lib/constants';
import { categoryMeta } from '../lib/categories';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<dialog class="ped" data-post-editor data-lang={lang} aria-labelledby="ped-title">
  <form class="ped__form" novalidate data-ped-form>
    <div class="ped__head">
      <h2 id="ped-title"><Icon name="file-plus" size={22} />{t(lang, 'post.new')}</h2>
      <button type="button" class="ped__x" aria-label={t(lang, 'facts.close')} data-ped-close><Icon name="x" size={20} /></button>
    </div>

    <label class="ped__field">
      <span>{t(lang, 'post.title')} *</span>
      <input name="title" type="text" maxlength="120" required />
    </label>

    <!-- the category: big cards; the post will look like the others there (see the preview below) -->
    <div class="ped__field">
      <span>{t(lang, 'post.category')}</span>
      <div class="ped__cats" role="radiogroup" data-ped-cats>
        {
          CATEGORIES.map((c) => (
            <button type="button" role="radio" aria-checked="false" class:list={['ped__cat', `is-${categoryMeta(c).tone}`]} data-cat={c}>
              <span class="ped__cat-icon"><Icon name={categoryMeta(c).icon} size={20} /></span>
              {t(lang, categoryMeta(c).titleKey)}
            </button>
          ))
        }
      </div>
      <select name="category" hidden>
        {CATEGORIES.map((c) => <option value={c}>{t(lang, categoryMeta(c).titleKey)}</option>)}
      </select>
    </div>
    <div class="ped__row ped__row--two">
      <label class="ped__field">
        <span>{t(lang, 'post.lang')}</span>
        <select name="lang">
          {LOCALES.map((l) => <option value={l} selected={l === lang}>{NATIVE_NAMES[l]}</option>)}
        </select>
      </label>
      <label class="ped__field">
        <span>{t(lang, 'upload.date')}</span>
        <input name="date" type="date" />
      </label>
    </div>

    <label class="ped__field">
      <span>{t(lang, 'post.excerpt')} *</span>
      <input name="excerpt" type="text" maxlength="220" required />
    </label>
    <!-- opened from the world map: the post is pinned to this place -->
    <p class="ped__place" hidden data-ped-place></p>

    <!-- how its card will look among the category's posts -->
    <div class="ped__preview">
      <span class="ped__preview-label">👀 {t(lang, 'post.preview')}</span>
      <article class="ped-card" data-ped-card>
        <div class="ped-card__cover" data-ped-card-cover>
          <img alt="" hidden data-ped-card-img />
          <span class="ped-card__ph" data-ped-card-ph>
            {CATEGORIES.map((c) => <span class="ped-card__icon" data-icon-for={c} hidden><Icon name={categoryMeta(c).icon} size={34} /></span>)}
          </span>
          <span class="ped-card__tri"></span>
        </div>
        <div class="ped-card__body">
          <span class="ped-card__tag" data-ped-card-tag></span>
          <strong data-ped-card-title></strong>
          <time data-ped-card-date></time>
          <p data-ped-card-excerpt></p>
          <span class="ped-card__link">{t(lang, 'posts.readMore')} →</span>
        </div>
      </article>
    </div>

    <div class="ped__cover">
      <label class="ped__pick">
        <Icon name="image" size={20} />
        <span data-ped-cover-label>{t(lang, 'post.cover')}</span>
        <input type="file" accept="image/*" data-ped-cover />
      </label>
    </div>
    <div class="ped__crop" hidden data-ped-crop>
      <p class="ped__crop-hint">{t(lang, 'post.cropHint')}</p>
      <div class="ped__frame" data-ped-frame>
        <img alt="" data-ped-cover-img />
        <div class="ped__grid">
          {
            ['left top', 'top', 'right top', 'left', 'center', 'right', 'left bottom', 'bottom', 'right bottom'].map((pos) => (
              <button type="button" data-pos={pos} aria-label={pos} />
            ))
          }
        </div>
        <span class="ped__auto-badge" data-ped-auto-badge>{t(lang, 'post.cropAuto')}</span>
      </div>
      <button type="button" class="ped__auto" data-pos="attention">{t(lang, 'post.cropAuto')}</button>
    </div>

    <div class="ped__field">
      <span class="ped__label-row">
        <label for="ped-body">{t(lang, 'post.body')} *</label>
        <label class="ped__insert">
          <Icon name="image-plus" size={16} />{t(lang, 'post.insert')}
          <input type="file" accept="image/*" multiple data-ped-insert />
        </label>
      </span>
      <textarea id="ped-body" name="body" rows="12" required placeholder={t(lang, 'post.bodyHint')} data-ped-body></textarea>
      <ul class="ped__thumbs" data-ped-thumbs></ul>
    </div>

    <TokenField lang={lang} />

    <p class="ped__status" role="status" aria-live="polite" data-ped-status></p>
    <button type="submit" class="btn btn--primary" data-ped-send>
      <Icon name="send" size={18} />
      <span data-ped-send-label>{t(lang, 'post.publish')}</span>
    </button>
  </form>
  <template data-ped-text-loading>{t(lang, 'post.loading')}</template>
  <template data-ped-text-editing>{t(lang, 'post.editing')}</template>
  <template data-ped-text-saved>{t(lang, 'post.saved')}</template>
  <template data-ped-text-publish>{t(lang, 'post.publish')}</template>
  <template data-ped-text-publishing>{t(lang, 'post.publishing')}</template>
  <template data-ped-text-done>{t(lang, 'post.done')}</template>
  <template data-ped-text-open>{t(lang, 'post.open')}</template>
  <template data-ped-text-required>{t(lang, 'post.required')}</template>
  <template data-ped-text-needtoken>{t(lang, 'upload.needToken')}</template>
  <template data-ped-text-error>{t(lang, 'upload.error')}</template>
  <template data-ped-text-badimage>{t(lang, 'upload.badImage')}</template>
</dialog>

<style>
  .ped__place {
    margin: 0;
    font-weight: 700;
  }
  .ped__place[hidden] {
    display: none;
  }
  .ped {
    width: min(760px, calc(100vw - 24px));
    max-height: calc(100vh - 24px);
    padding: 0;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 6px 6px 0 #39d353;
    zoom: var(--inv-zoom, 1);
  }
  .ped::backdrop {
    background: color-mix(in srgb, var(--ink) 50%, transparent);
  }
  .ped__form {
    display: grid;
    gap: 14px;
    padding: 18px 20px 20px;
  }
  .ped__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .ped__head h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 22px;
  }
  .ped__x {
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    border: var(--border);
    border-radius: 50%;
    background: var(--surface);
  }
  .ped__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .ped__row--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* the category cards */
  .ped__cats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 8px;
  }
  .ped__cat {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px 8px 8px;
    border: 2px solid var(--ink);
    border-radius: 14px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 800;
    text-align: left;
    cursor: pointer;
    transition: transform 150ms ease;
  }
  .ped__cat:hover {
    transform: translateY(-2px);
  }
  .ped__cat[aria-checked='true'] {
    box-shadow: 4px 4px 0 var(--ink);
  }
  .ped__cat.is-yellow[aria-checked='true'] {
    background: var(--yellow);
  }
  .ped__cat.is-violet[aria-checked='true'] {
    background: var(--violet-tint);
  }
  .ped__cat-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--violet);
    color: #fff;
  }
  .ped__cat.is-violet .ped__cat-icon {
    background: var(--yellow);
    color: var(--ink);
  }
  /* the preview card: like PostCard */
  .ped__preview {
    display: grid;
    gap: 6px;
  }
  .ped__preview-label {
    font-size: 14px;
    font-weight: 700;
  }
  .ped-card {
    width: min(100%, 320px);
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-card, 18px);
    background: var(--surface);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .ped-card.is-violet {
    box-shadow: 6px 6px 0 var(--violet);
  }
  .ped-card__cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: var(--border);
    background: var(--yellow-tint);
  }
  .ped-card.is-violet .ped-card__cover {
    background: var(--violet-tint);
  }
  .ped-card__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ped-card__ph {
    position: absolute;
    left: 14%;
    top: 22%;
    display: grid;
    place-items: center;
    width: 38%;
    aspect-ratio: 1;
    border: var(--border);
    border-radius: 50%;
    background: var(--violet);
    color: #fff;
  }
  .ped-card.is-violet .ped-card__ph {
    background: var(--yellow);
    color: var(--ink);
  }
  .ped-card__icon[hidden],
  .ped-card__cover img[hidden] + .ped-card__ph[hidden] {
    display: none;
  }
  .ped-card__tri {
    position: absolute;
    right: 14%;
    bottom: 16%;
    width: 30%;
    aspect-ratio: 1;
    background: var(--ink);
    clip-path: polygon(0 100%, 50% 0, 100% 100%);
  }
  .ped-card.has-cover .ped-card__ph,
  .ped-card.has-cover .ped-card__tri {
    display: none;
  }
  .ped-card__body {
    display: grid;
    gap: 6px;
    padding: 16px 18px 14px;
  }
  .ped-card__tag {
    justify-self: start;
    padding: 2px 10px;
    border: 2px solid var(--ink);
    border-radius: 99px;
    background: var(--yellow);
    font-size: 12px;
    font-weight: 800;
  }
  .ped-card.is-violet .ped-card__tag {
    background: var(--violet-tint);
    color: var(--violet-dark);
  }
  .ped-card strong {
    font: 800 20px / 1.15 var(--font-heading);
    overflow-wrap: anywhere;
  }
  .ped-card strong:empty::before {
    content: '…';
    opacity: 0.4;
  }
  .ped-card time {
    color: var(--muted);
    font-size: 13px;
  }
  .ped-card p {
    margin: 0;
    font-size: 14px;
  }
  .ped-card__link {
    color: var(--violet);
    font-weight: 800;
    font-size: 14px;
  }
  .ped__field {
    display: grid;
    gap: 4px;
    font-size: 14px;
    font-weight: 700;
  }
  .ped__field input,
  .ped__field select,
  .ped__field textarea {
    width: 100%;
    padding: 8px 12px;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-weight: 400;
    font-size: 15px;
  }
  .ped__field textarea {
    resize: vertical;
    line-height: 1.5;
  }
  .ped__field [aria-invalid='true'] {
    border-color: #c0142b;
    box-shadow: 0 0 0 2px #c0142b;
  }
  .ped__label-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .ped__insert,
  .ped__pick {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--violet-tint);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .ped__insert input,
  .ped__pick input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .ped__insert:focus-within,
  .ped__pick:focus-within {
    outline: 3px solid var(--violet);
    outline-offset: 2px;
  }
  .ped__cover {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .ped__crop {
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .ped__crop[hidden] {
    display: none;
  }
  .ped__crop-hint {
    margin: 0;
    font-size: 14px;
  }
  /* the same 16:9 frame as the post cards */
  .ped__frame {
    position: relative;
    width: min(360px, 100%);
    aspect-ratio: 16 / 9;
    border: var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--violet-tint);
  }
  .ped__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: object-position 250ms;
  }
  .ped__grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template: repeat(3, 1fr) / repeat(3, 1fr);
  }
  .ped__grid button {
    border: 1px dashed rgba(255, 255, 255, 0.55);
    background: transparent;
    cursor: crosshair;
  }
  .ped__grid button:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .ped__grid button[aria-pressed='true'] {
    background: rgba(57, 211, 83, 0.35);
    outline: 3px solid #39d353;
    outline-offset: -3px;
  }
  .ped__auto-badge {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 2px 10px;
    border-radius: 999px;
    background: #0d1117;
    color: #39d353;
    font: 700 12px ui-monospace, monospace;
  }
  .ped__auto-badge[hidden] {
    display: none;
  }
  .ped__auto {
    padding: 4px 12px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
  }
  .ped__auto[aria-pressed='true'] {
    background: #39d353;
  }
  .ped__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .ped__thumbs img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border: 2px solid var(--ink);
    border-radius: 8px;
  }
  .ped__status {
    margin: 0;
    font-weight: 700;
    min-height: 1.2em;
  }
  .ped__status.is-error {
    color: #c62828;
  }
  .ped__status.is-ok {
    color: #1f7a3a;
  }
  .ped__status a {
    margin-left: 6px;
  }
  @media (max-width: 560px) {
    .ped__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { commitFiles, fileExists, getToken, readFile, shrinkToJpeg, slugify, wireTokenField, type NewFile } from '../lib/githubCommit';
  // (a post written from the world map gets place / lat / lng in its front matter)
  import { fieldValue, parsePost, setFields, writePost, type ParsedPost } from '../lib/frontmatter';

  const dialog = document.querySelector<HTMLDialogElement>('[data-post-editor]');
  if (dialog) {
    const q = <T extends Element>(sel: string) => dialog.querySelector<T>(sel)!;
    const text = (n: string) => q<HTMLTemplateElement>(`[data-ped-text-${n}]`).content.textContent ?? '';
    const form = q<HTMLFormElement>('[data-ped-form]');
    const field = <T extends HTMLElement>(name: string) => form.elements.namedItem(name) as unknown as T;
    const body = q<HTMLTextAreaElement>('[data-ped-body]');
    const coverInput = q<HTMLInputElement>('[data-ped-cover]');
    const coverImg = q<HTMLImageElement>('[data-ped-cover-img]');
    const crop = q<HTMLElement>('[data-ped-crop]');
    const autoBadge = q<HTMLElement>('[data-ped-auto-badge]');
    const posButtons = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-pos]'));
    /** where the card crops the cover: 'attention' (smart) or one of nine spots */
    let coverPosition = 'attention';
    const setPosition = (pos: string) => {
      coverPosition = pos;
      posButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pos === pos)));
      autoBadge.hidden = pos !== 'attention';
      coverImg.style.objectPosition = pos === 'attention' ? 'center' : pos;
    };
    posButtons.forEach((b) => b.addEventListener('click', () => setPosition(b.dataset.pos!)));
    const insertInput = q<HTMLInputElement>('[data-ped-insert]');
    const thumbs = q<HTMLUListElement>('[data-ped-thumbs]');
    const status = q<HTMLElement>('[data-ped-status]');
    const send = q<HTMLButtonElement>('[data-ped-send]');
    const sendLabel = q<HTMLElement>('[data-ped-send-label]');
    const token = wireTokenField(dialog);
    let cover: File | null = null;
    /** pictures put into the text: placeholder name in the markdown → file */
    let inline = new Map<string, File>();

    const say = (msg: string, kind: '' | 'ok' | 'error' = '') => {
      status.textContent = msg;
      status.className = `ped__status${kind ? ` is-${kind}` : ''}`;
    };

    /** set while an existing post is being edited (its file name stays the same) */
    let editing: { slug: string; post: ParsedPost } | null = null;
    const heading = q<HTMLElement>('#ped-title');
    const headingNew = heading.innerHTML;

    window.addEventListener('andras:edit-post', async (e) => {
      const slug = (e as CustomEvent<{ slug: string }>).detail.slug;
      let key = getToken();
      if (!key) key = (window.prompt(text('needtoken')) ?? '').trim();
      if (!key) return;
      form.reset();
      token.refresh();
      say(text('loading'));
      if (!dialog.open) dialog.showModal();
      try {
        const post = parsePost(await readFile(key, `src/content/posts/${slug}.md`));
        editing = { slug, post };
        heading.textContent = text('editing');
        field<HTMLInputElement>('title').value = fieldValue(post, 'title');
        field<HTMLInputElement>('excerpt').value = fieldValue(post, 'excerpt');
        field<HTMLInputElement>('date').value = fieldValue(post, 'date').slice(0, 10);
        field<HTMLSelectElement>('category').value = fieldValue(post, 'category') || 'random';
        field<HTMLSelectElement>('lang').value = fieldValue(post, 'lang') || 'en';
        body.value = post.body.trim();
        say('');
      } catch (err) {
        say(text('error').replace('{msg}', err instanceof Error ? err.message : String(err)), 'error');
      }
    });

    // ---- the category cards and the preview card ----
    const catSel = field<HTMLSelectElement>('category');
    const card = q<HTMLElement>('[data-ped-card]');
    const cats = Array.from(dialog!.querySelectorAll<HTMLButtonElement>('[data-cat]'));
    const fmtDate = new Intl.DateTimeFormat(document.documentElement.lang || 'hu', { year: 'numeric', month: 'long', day: 'numeric' });
    function preview() {
      const c = catSel.value;
      const btn = cats.find((b) => b.dataset.cat === c);
      cats.forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
      card.classList.toggle('is-violet', !!btn?.classList.contains('is-violet'));
      dialog!.querySelectorAll<HTMLElement>('[data-icon-for]').forEach((i) => (i.hidden = i.dataset.iconFor !== c));
      q<HTMLElement>('[data-ped-card-tag]').textContent = btn?.textContent?.trim() ?? '';
      q<HTMLElement>('[data-ped-card-title]').textContent = field<HTMLInputElement>('title').value.trim();
      q<HTMLElement>('[data-ped-card-excerpt]').textContent = field<HTMLInputElement>('excerpt').value.trim();
      const d = field<HTMLInputElement>('date').value;
      q<HTMLElement>('[data-ped-card-date]').textContent = d ? fmtDate.format(new Date(`${d}T12:00:00`)) : '';
      const img = q<HTMLImageElement>('[data-ped-card-img]');
      img.hidden = !cover;
      card.classList.toggle('has-cover', !!cover);
      if (cover && img.dataset.for !== cover.name) {
        img.src = URL.createObjectURL(cover);
        img.dataset.for = cover.name;
      }
      img.style.objectPosition = coverPosition === 'attention' ? 'center' : coverPosition;
    }
    cats.forEach((b) =>
      b.addEventListener('click', () => {
        catSel.value = b.dataset.cat!;
        preview();
      }),
    );
    form.addEventListener('input', preview);
    form.addEventListener('change', preview);
    form.addEventListener('click', () => window.setTimeout(preview, 0));
    dialog.addEventListener('toggle', preview);

    let pinned: { place?: string; lat?: number; lng?: number } | null = null;
    const placeNote = q<HTMLElement>('[data-ped-place]');
    window.addEventListener('andras:new-post', (e) => {
      editing = null;
      heading.innerHTML = headingNew;
      const d = (e as CustomEvent<{ category?: string; place?: string; lat?: number; lng?: number }>).detail;
      pinned = d?.lat !== undefined && d?.lng !== undefined ? { place: d.place, lat: d.lat, lng: d.lng } : null;
      placeNote.hidden = !pinned;
      if (pinned) placeNote.textContent = `📍 ${pinned.place ?? ''} · ${pinned.lat!.toFixed(3)}, ${pinned.lng!.toFixed(3)}`;
      const category = d?.category;
      if (category) field<HTMLSelectElement>('category').value = category;
      const date = field<HTMLInputElement>('date');
      if (!date.value) date.value = new Date().toISOString().slice(0, 10);
      token.refresh();
      say('');
      if (!dialog.open) dialog.showModal();
      preview();
      field<HTMLInputElement>('title').focus();
    });
    q('[data-ped-close]').addEventListener('click', () => dialog.close());

    coverInput.addEventListener('change', () => {
      cover = coverInput.files?.[0] ?? null;
      crop.hidden = !cover;
      if (cover) coverImg.src = URL.createObjectURL(cover);
      setPosition('attention');
    });

    // "Insert picture": a placeholder line at the cursor; the real file name is set when publishing
    insertInput.addEventListener('change', () => {
      let snippet = '';
      for (const file of Array.from(insertInput.files ?? [])) {
        const key = `kep-${inline.size + 1}`;
        inline.set(key, file);
        snippet += `\n\n![${file.name.replace(/\.[^.]+$/, '')}](${key})\n\n`;
        const li = document.createElement('li');
        const img = document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.alt = key;
        li.append(img);
        thumbs.append(li);
      }
      const at = body.selectionStart ?? body.value.length;
      body.value = body.value.slice(0, at) + snippet + body.value.slice(at);
      body.focus();
      insertInput.value = '';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = field<HTMLInputElement>('title');
      const excerpt = field<HTMLInputElement>('excerpt');
      const missing = [title, excerpt, body].filter((el) => !el.value.trim());
      [title, excerpt, body].forEach((el) => el.toggleAttribute('aria-invalid', missing.includes(el)));
      if (missing.length) return say(text('required'), 'error');
      const key = token.read();
      if (!key) return say(text('needtoken'), 'error');

      send.disabled = true;
      sendLabel.textContent = text('publishing');
      say('');
      try {
        const date = field<HTMLInputElement>('date').value || new Date().toISOString().slice(0, 10);
        const postLang = field<HTMLSelectElement>('lang').value;
        let slug = editing?.slug ?? slugify(title.value);
        if (!editing) for (let n = 2; await fileExists(key, `src/content/posts/${slug}.md`); n++) slug = `${slugify(title.value)}-${n}`;
        // new pictures never overwrite earlier ones of the same post
        const stamp = Date.now().toString(36);

        const files: NewFile[] = [];
        const shrink = async (file: File) => {
          try {
            return await shrinkToJpeg(file, 2000);
          } catch {
            throw new Error(`${text('badimage')} (${file.name})`);
          }
        };
        let markdown = body.value.trim();
        let i = 1;
        for (const [placeholder, file] of inline) {
          if (!markdown.includes(`(${placeholder})`)) continue; // the picture was deleted from the text
          const name = editing ? `${slug}-${stamp}-${i++}.jpg` : `${slug}-${i++}.jpg`;
          files.push({ path: `src/assets/posts/${name}`, base64: await shrink(file) });
          markdown = markdown.replaceAll(`(${placeholder})`, `(../../assets/posts/${name})`);
        }
        if (editing) {
          const post = editing.post;
          setFields(post, {
            title: JSON.stringify(title.value.trim()),
            date,
            category: field<HTMLSelectElement>('category').value,
            lang: postLang,
            excerpt: JSON.stringify(excerpt.value.trim()),
          });
          if (cover) {
            const coverName = `${slug}-cover-${stamp}.jpg`;
            files.push({ path: `src/assets/posts/${coverName}`, base64: await shrink(cover) });
            setFields(post, { cover: `../../assets/posts/${coverName}`, coverAlt: JSON.stringify(title.value.trim()), coverPosition });
          }
          post.body = markdown;
          files.push({ path: `src/content/posts/${slug}.md`, text: writePost(post) });
          await commitFiles(key, files, `Post edited on the site: ${title.value.trim()}`);
          token.saved();
          say(text('saved'), 'ok');
          cover = null;
          crop.hidden = true;
          inline = new Map();
          thumbs.replaceChildren();
          return;
        }
        const front = [
          '---',
          `title: ${JSON.stringify(title.value.trim())}`,
          `date: ${date}`,
          `category: ${field<HTMLSelectElement>('category').value}`,
          `lang: ${postLang}`,
          `excerpt: ${JSON.stringify(excerpt.value.trim())}`,
        ];
        if (pinned) front.push(...[pinned.place && `place: ${JSON.stringify(pinned.place)}`, `lat: ${Math.round(pinned.lat! * 1e5) / 1e5}`, `lng: ${Math.round(pinned.lng! * 1e5) / 1e5}`].filter((x): x is string => !!x));
        if (cover) {
          files.push({ path: `src/assets/posts/${slug}-cover.jpg`, base64: await shrink(cover) });
          front.push(`cover: ../../assets/posts/${slug}-cover.jpg`, `coverAlt: ${JSON.stringify(title.value.trim())}`, `coverPosition: ${coverPosition}`);
        }
        front.push('---');
        files.push({ path: `src/content/posts/${slug}.md`, text: `${front.join('\n')}\n\n${markdown}\n` });

        await commitFiles(key, files, `Post: ${title.value.trim()} (written on the site)`);
        token.saved();
        window.dispatchEvent(
          new CustomEvent('andras:post-created', {
            detail: {
              slug,
              category: field<HTMLSelectElement>('category').value,
              title: title.value.trim(),
              excerpt: excerpt.value.trim(),
              date,
              cover: cover ? q<HTMLImageElement>('[data-ped-card-img]').src : '',
              lang: dialog.dataset.lang,
            },
          }),
        );
        form.reset();
        field<HTMLSelectElement>('lang').value = dialog.dataset.lang!;
        cover = null;
        crop.hidden = true;
        inline = new Map();
        thumbs.replaceChildren();
        say(text('done'), 'ok');
        const link = document.createElement('a');
        link.href = `/${dialog.dataset.lang}/posts/${slug}/`;
        link.textContent = text('open');
        status.append(link);
      } catch (err) {
        console.error('[new post]', err);
        say(text('error').replace('{msg}', err instanceof Error ? err.message : String(err)), 'error');
      } finally {
        send.disabled = false;
        sendLabel.textContent = text('publish');
      }
    });
  }
</script>
