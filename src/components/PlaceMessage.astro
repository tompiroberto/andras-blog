---
/**
 * "Write to me about this place" window. Anything can open it with
 * window.dispatchEvent(new CustomEvent(PLACE_MESSAGE_EVENT, { detail: { place, topic? } })) – the fact
 * card (city labels, scrollbar cities, search results, the chaos map), map mode, the country pages,
 * the solar system and a double-click on the coordinate grid. It is a <dialog>, so it opens above every
 * view. Picking a topic opens the visitor's e-mail app with a started letter (mailto:) – nothing is
 * stored on the site.
 */
import Icon from './Icon.astro';
import site from '../data/site.json';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const TOPICS = [
  { id: 'say', icon: 'message-circle' },
  { id: 'host', icon: 'bed-double' },
  { id: 'buddy', icon: 'users' },
] as const;
---

<dialog class="place-msg" data-place-msg data-email={site.email} aria-labelledby="place-msg-title">
  <div class="place-msg__body">
    <div class="place-msg__head">
      <span class="place-msg__icon" aria-hidden="true"><Icon name="map-pin" size={22} /></span>
      <div>
        <p class="place-msg__kicker">{t(lang, 'pm.kicker')}</p>
        <h2 class="place-msg__title" id="place-msg-title" data-place-msg-title></h2>
      </div>
      <button type="button" class="place-msg__close" aria-label={t(lang, 'facts.close')} title={t(lang, 'facts.close')} data-place-msg-close>
        <Icon name="x" size={20} />
      </button>
    </div>

    <p class="place-msg__hint">{t(lang, 'msg.pick')}</p>
    <div class="place-msg__topics">
      {
        TOPICS.map((tp) => (
          <button type="button" class="place-msg__topic" data-topic={tp.id} data-label={t(lang, `pm.topic.${tp.id}`)} data-start={t(lang, `pm.start.${tp.id}`)}>
            <Icon name={tp.icon} size={18} />
            <span>{t(lang, `pm.topic.${tp.id}`)}</span>
            <Icon name="mail" size={16} class="place-msg__mail" />
          </button>
        ))
      }
    </div>

    <p class="place-msg__fallback">
      {t(lang, 'msg.fallback')}
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <button type="button" class="place-msg__copy" data-copy={site.email} data-copied={t(lang, 'msg.copied')}>{t(lang, 'msg.copy')}</button>
    </p>
    <p class="place-msg__privacy">{t(lang, 'msg.privacy')}</p>
  </div>
  <template data-pm-title>{t(lang, 'pm.title')}</template>
</dialog>

<style>
  .place-msg {
    width: min(520px, calc(100vw - 24px));
    max-height: calc(100vh - 24px);
    padding: 0;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 6px 6px 0 var(--yellow);
    overflow: auto;
  }
  .place-msg[open] {
    animation: pm-in 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .place-msg::backdrop {
    background: color-mix(in srgb, var(--ink) 45%, transparent);
    backdrop-filter: blur(2px);
  }
  .place-msg__body {
    display: grid;
    gap: 14px;
    padding: 18px 20px 20px;
  }
  .place-msg__head {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .place-msg__head > div {
    flex: 1;
    min-width: 0;
  }
  .place-msg__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--violet);
    color: #fff;
    border: var(--border);
  }
  .place-msg__kicker {
    margin: 0;
    font-size: var(--fs-tiny);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--violet-dark);
  }
  .place-msg__title {
    margin: 2px 0 0;
    font-size: 21px;
    line-height: 1.2;
  }
  .place-msg__close {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--touch);
    height: var(--touch);
    border: var(--border);
    border-radius: 50%;
    background: var(--surface);
  }
  .place-msg__hint {
    margin: 0;
    font-size: 15px;
  }
  .place-msg__topics {
    display: grid;
    gap: 8px;
  }
  .place-msg__topic {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--t-fast), box-shadow var(--t-fast), transform var(--t-fast);
  }
  .place-msg__topic span {
    flex: 1;
  }
  .place-msg__topic:hover,
  .place-msg__topic:focus-visible {
    background: var(--yellow);
    box-shadow: 3px 3px 0 var(--ink);
    transform: translate(-1px, -1px);
  }
  .place-msg__fallback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    font-size: 14px;
  }
  .place-msg__fallback a {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .place-msg__copy {
    padding: 4px 12px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--violet-tint);
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    font-weight: 700;
  }
  .place-msg__privacy {
    margin: 0;
    font-size: var(--fs-tiny);
    color: var(--muted);
  }
  @keyframes pm-in {
    from {
      transform: translateY(30px) scale(0.94);
      opacity: 0;
    }
  }
</style>

<script>
  import { PLACE_MESSAGE_EVENT, type PlaceMessageDetail } from '../lib/constants';
  import { openMail, wireCopyButtons } from '../lib/mail';

  const dialog = document.querySelector<HTMLDialogElement>('[data-place-msg]');
  if (dialog) {
    const title = dialog.querySelector<HTMLElement>('[data-place-msg-title]')!;
    const titleTpl = dialog.querySelector<HTMLTemplateElement>('[data-pm-title]')!.content.textContent ?? '{place}';
    const email = dialog.dataset.email!;
    let place = '';

    function open(detail: PlaceMessageDetail) {
      place = detail.place;
      title.textContent = titleTpl.replace('{place}', place);
      if (!dialog!.open) dialog!.showModal();
      const first = dialog!.querySelector<HTMLButtonElement>(`[data-topic="${detail.topic ?? 'say'}"]`);
      first?.focus();
    }

    window.addEventListener(PLACE_MESSAGE_EVENT, (e) => open((e as CustomEvent<PlaceMessageDetail>).detail));
    dialog.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((b) =>
      b.addEventListener('click', () => {
        openMail(email, `${place} – ${b.dataset.label}`, b.dataset.start!.replace('{place}', place));
      }),
    );
    wireCopyButtons(dialog);
    dialog.querySelector('[data-place-msg-close]')!.addEventListener('click', () => dialog.close());
    // click on the dimmed backdrop closes it
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
