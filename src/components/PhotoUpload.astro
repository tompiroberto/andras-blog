---
/**
 * Developer mode → "Upload photos": pick photos, write a description (and place) for each, press Upload.
 * The photos (shrunk to JPEG) go to src/assets/photos and their descriptions to src/content/photos/*.yml,
 * in one commit straight to GitHub (src/lib/githubCommit.ts); Netlify rebuilds, and the gallery shows them.
 */
import Icon from './Icon.astro';
import TokenField from './TokenField.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<dialog class="upl" data-upload aria-labelledby="upl-title">
  <form class="upl__form" novalidate data-upload-form>
    <div class="upl__head">
      <h2 id="upl-title"><Icon name="image-plus" size={22} />{t(lang, 'upload.title')}</h2>
      <button type="button" class="upl__x" aria-label={t(lang, 'facts.close')} data-upload-close><Icon name="x" size={20} /></button>
    </div>

    <label class="upl__pick">
      <Icon name="images" size={22} />
      <span>{t(lang, 'upload.pick')}</span>
      <input type="file" accept="image/*" multiple data-upload-files />
    </label>

    <ul class="upl__list" data-upload-list></ul>

    <label class="upl__field upl__date">
      <span>{t(lang, 'upload.date')}</span>
      <input type="date" name="date" data-upload-date />
    </label>

    <TokenField lang={lang} />

    <p class="upl__status" role="status" aria-live="polite" data-upload-status></p>
    <button type="submit" class="btn btn--primary" data-upload-send>
      <Icon name="upload" size={18} />
      <span data-upload-send-label>{t(lang, 'upload.send')}</span>
    </button>
  </form>

  <template data-upl-row>
    <li class="upl__row">
      <img class="upl__thumb" alt="" />
      <div class="upl__inputs">
        <input class="upl__caption" type="text" maxlength="200" placeholder={t(lang, 'upload.caption')} aria-label={t(lang, 'upload.caption')} />
        <input class="upl__place" type="text" maxlength="80" placeholder={t(lang, 'upload.place')} aria-label={t(lang, 'upload.place')} />
      </div>
      <button type="button" class="upl__remove" aria-label={t(lang, 'upload.remove')} title={t(lang, 'upload.remove')}><Icon name="trash-2" size={16} /></button>
    </li>
  </template>
  <template data-upl-text-send>{t(lang, 'upload.send')}</template>
  <template data-upl-text-sending>{t(lang, 'upload.sending')}</template>
  <template data-upl-text-done>{t(lang, 'upload.done')}</template>
  <template data-upl-text-error>{t(lang, 'upload.error')}</template>
  <template data-upl-text-needphoto>{t(lang, 'upload.needPhoto')}</template>
  <template data-upl-text-needcaption>{t(lang, 'upload.needCaption')}</template>
  <template data-upl-text-needtoken>{t(lang, 'upload.needToken')}</template>
  <template data-upl-text-live>{t(lang, 'upload.live')}</template>
  <template data-upl-text-badimage>{t(lang, 'upload.badImage')}</template>
</dialog>

<style>
  .upl {
    width: min(620px, calc(100vw - 24px));
    max-height: calc(100vh - 24px);
    padding: 0;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 6px 6px 0 #39d353;
    zoom: var(--inv-zoom, 1);
  }
  .upl::backdrop {
    background: color-mix(in srgb, var(--ink) 50%, transparent);
  }
  .upl__form {
    display: grid;
    gap: 14px;
    padding: 18px 20px 20px;
  }
  .upl__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .upl__head h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 22px;
  }
  .upl__x {
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    border: var(--border);
    border-radius: 50%;
    background: var(--surface);
  }
  .upl__pick {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px;
    border: 3px dashed var(--ink);
    border-radius: 18px;
    background: var(--violet-tint);
    font-weight: 700;
    cursor: pointer;
  }
  .upl__pick input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .upl__pick:focus-within {
    outline: 3px solid var(--violet);
    outline-offset: 2px;
  }
  .upl__list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .upl__list:empty {
    display: none;
  }
  .upl__row {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 8px;
    border: 2px solid var(--ink);
    border-radius: 14px;
  }
  .upl__thumb {
    width: 76px;
    height: 76px;
    object-fit: cover;
    border-radius: 10px;
  }
  .upl__inputs {
    display: grid;
    gap: 6px;
  }
  .upl__inputs input,
  .upl__field input {
    width: 100%;
    padding: 8px 12px;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: 15px;
  }
  .upl__caption[aria-invalid='true'] {
    border-color: #c0142b;
    box-shadow: 0 0 0 2px #c0142b;
  }
  .upl__remove {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
  }
  .upl__field {
    display: grid;
    gap: 4px;
    font-size: 14px;
    font-weight: 700;
  }
  .upl__date {
    max-width: 220px;
  }
  .upl__status {
    margin: 0;
    font-weight: 700;
    min-height: 1.2em;
  }
  .upl__status.is-error {
    color: #c62828;
  }
  .upl__status.is-ok {
    color: #1f7a3a;
  }
  @media (max-width: 480px) {
    .upl__row {
      grid-template-columns: 60px 1fr auto;
    }
    .upl__thumb {
      width: 60px;
      height: 60px;
    }
  }
</style>

<script>
  import { commitFiles, shrinkToJpeg, slugify, wireTokenField, type NewFile } from '../lib/githubCommit';

  const dialog = document.querySelector<HTMLDialogElement>('[data-upload]');
  if (dialog) {
    const q = <T extends Element>(sel: string) => dialog.querySelector<T>(sel)!;
    const text = (n: string) => q<HTMLTemplateElement>(`[data-upl-text-${n}]`).content.textContent ?? '';
    const form = q<HTMLFormElement>('[data-upload-form]');
    const picker = q<HTMLInputElement>('[data-upload-files]');
    const list = q<HTMLUListElement>('[data-upload-list]');
    const rowTpl = q<HTMLTemplateElement>('[data-upl-row]');
    const dateInput = q<HTMLInputElement>('[data-upload-date]');
    const status = q<HTMLElement>('[data-upload-status]');
    const send = q<HTMLButtonElement>('[data-upload-send]');
    const sendLabel = q<HTMLElement>('[data-upload-send-label]');
    const picked = new Map<HTMLLIElement, File>();

    const token = wireTokenField(dialog);

    /** the new photos show up in the gallery on this page right away (the live site follows in ~1 minute) */
    const preview = (src: string, caption: string, place: string) => {
      const grid = document.querySelector('.photos__grid, .gallery__grid');
      if (!grid) return;
      const li = document.createElement('li');
      li.style.cssText = 'margin:0 0 18px;border:3px solid var(--ink);border-radius:var(--radius-card);overflow:hidden;background:var(--surface);box-shadow:5px 5px 0 #39d353;break-inside:avoid;position:relative';
      const img = document.createElement('img');
      img.src = src;
      img.alt = caption;
      img.style.cssText = 'display:block;width:100%;height:auto;max-height:420px;object-fit:cover';
      const p = document.createElement('p');
      p.style.cssText = 'margin:0;padding:10px 14px;font-weight:700';
      p.textContent = place ? `${caption} · ${place}` : caption;
      const badge = document.createElement('span');
      badge.textContent = text('live');
      badge.style.cssText = 'position:absolute;top:8px;left:8px;padding:3px 10px;border-radius:999px;background:#0d1117;color:#39d353;font:700 12px ui-monospace,monospace';
      li.append(img, p, badge);
      grid.prepend(li);
    };
    const say = (msg: string, kind: '' | 'ok' | 'error' = '') => {
      status.textContent = msg;
      status.className = `upl__status${kind ? ` is-${kind}` : ''}`;
    };

    const open = () => {
      if (!dateInput.value) dateInput.value = new Date().toISOString().slice(0, 10);
      token.refresh();
      say('');
      if (!dialog.open) dialog.showModal();
    };
    window.addEventListener('andras:upload-photos', open);

    picker.addEventListener('change', () => {
      for (const file of Array.from(picker.files ?? [])) {
        const row = rowTpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        const thumb = row.querySelector<HTMLImageElement>('.upl__thumb')!;
        thumb.src = URL.createObjectURL(file);
        row.querySelector('.upl__remove')!.addEventListener('click', () => {
          URL.revokeObjectURL(thumb.src);
          picked.delete(row);
          row.remove();
        });
        row.querySelector('.upl__caption')!.addEventListener('input', (e) => (e.target as HTMLInputElement).removeAttribute('aria-invalid'));
        picked.set(row, file);
        list.append(row);
      }
      picker.value = '';
      list.querySelector<HTMLInputElement>('.upl__row:last-child .upl__caption')?.focus();
    });

    q('[data-upload-close]').addEventListener('click', () => dialog.close());

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const rows = Array.from(picked.keys());
      if (!rows.length) return say(text('needphoto'), 'error');
      const missing = rows.filter((r) => !r.querySelector<HTMLInputElement>('.upl__caption')!.value.trim());
      missing.forEach((r) => r.querySelector('.upl__caption')!.setAttribute('aria-invalid', 'true'));
      if (missing.length) return say(text('needcaption'), 'error');
      const key = token.read();
      if (!key) return say(text('needtoken'), 'error');

      send.disabled = true;
      sendLabel.textContent = text('sending');
      say('');
      try {
        const date = dateInput.value || new Date().toISOString().slice(0, 10);
        const files: NewFile[] = [];
        const previews: [string, string, string][] = [];
        for (const row of rows) {
          const caption = row.querySelector<HTMLInputElement>('.upl__caption')!.value.trim();
          const place = row.querySelector<HTMLInputElement>('.upl__place')!.value.trim();
          const name = `${date}-${slugify(caption)}-${Math.random().toString(36).slice(2, 6)}`;
          let base64: string;
          try {
            base64 = await shrinkToJpeg(picked.get(row)!);
          } catch {
            throw new Error(`${text('badimage')} (${picked.get(row)!.name})`);
          }
          files.push({ path: `src/assets/photos/${name}.jpg`, base64 });
          previews.push([`data:image/jpeg;base64,${base64}`, caption, place]);
          // JSON strings are valid YAML, so quotes and colons in the description cannot break the file
          const yml = [`image: ../../assets/photos/${name}.jpg`, `caption: ${JSON.stringify(caption)}`, place && `place: ${JSON.stringify(place)}`, `date: ${date}`].filter(Boolean).join('\n');
          files.push({ path: `src/content/photos/${name}.yml`, text: `${yml}\n` });
        }
        await commitFiles(key, files, `Photos: ${rows.length} new (uploaded from the site)`);
        token.saved();
        previews.reverse().forEach(([src, caption, place]) => preview(src, caption, place));
        rows.forEach((r) => {
          URL.revokeObjectURL(r.querySelector<HTMLImageElement>('.upl__thumb')!.src);
          picked.delete(r);
          r.remove();
        });
        say(text('done'), 'ok');
      } catch (err) {
        console.error('[photo upload]', err);
        say(text('error').replace('{msg}', err instanceof Error ? err.message : String(err)), 'error');
      } finally {
        send.disabled = false;
        sendLabel.textContent = text('send');
      }
    });
  }
</script>
